{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace.local/schema/remote-transaction-1.json",
  "title": "AI-Workspace remote transaction ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "transactionId",
    "transactionKind",
    "projectId",
    "taskId",
    "candidate",
    "gitCloser",
    "authorizationLocator",
    "evidenceReceipt",
    "protectedExcludes",
    "evidencePaths",
    "aggregateStatus",
    "remotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "transactionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "transactionKind": {
      "enum": ["PRIMARY", "COMPENSATION"]
    },
    "sourceTransactionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "gitCloser": {
      "type": "string",
      "minLength": 1
    },
    "authorizationLocator": {
      "$ref": "#/$defs/repoPath"
    },
    "evidenceReceipt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "protectedExcludes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "evidencePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repoPath"
      }
    },
    "aggregateStatus": {
      "enum": [
        "PENDING",
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN",
        "PARTIAL",
        "COMPENSATION_REQUIRED"
      ]
    },
    "remotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/remoteRecord"
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://).+$"
    },
    "gitHead": {
      "type": "string",
      "pattern": "^(?:[0-9A-Fa-f]{40}|[0-9A-Fa-f]{64}|ABSENT)$"
    },
    "remoteRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remoteId",
        "endpointFingerprint",
        "action",
        "refspec",
        "authorizationLocator",
        "authorizationIdentity",
        "expectedLocalHead",
        "expectedRemoteHead",
        "idempotencyKey",
        "attempted",
        "status",
        "observedHead",
        "receipt",
        "errorClass"
      ],
      "properties": {
        "remoteId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "endpointFingerprint": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "action": {
          "enum": ["PUSH_REF", "CREATE_TAG", "DELETE_REF", "COMPENSATE_REF"]
        },
        "refspec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "authorizationLocator": {
          "$ref": "#/$defs/repoPath"
        },
        "authorizationIdentity": {
          "type": "string",
          "pattern": "^[0-9]+\\|[A-F0-9]{64}$"
        },
        "expectedLocalHead": {
          "$ref": "#/$defs/gitHead"
        },
        "expectedRemoteHead": {
          "$ref": "#/$defs/gitHead"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-F0-9]{64}$"
        },
        "attempted": {
          "type": "boolean"
        },
        "status": {
          "enum": ["PENDING", "SUCCEEDED", "FAILED", "UNKNOWN", "COMPENSATION_REQUIRED"]
        },
        "observedHead": {
          "oneOf": [
            {"$ref": "#/$defs/gitHead"},
            {"const": "UNVERIFIED"}
          ]
        },
        "receipt": {
          "type": "string",
          "maxLength": 2048
        },
        "errorClass": {
          "type": "string",
          "pattern": "^(?:NONE|[A-Z][A-Z0-9_]*)$"
        },
        "originalReceipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "compensationAuthorizationLocator": {
          "$ref": "#/$defs/repoPath"
        },
        "compensationAuthorizationIdentity": {
          "type": "string",
          "pattern": "^[0-9]+\\|[A-F0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"transactionKind": {"const": "COMPENSATION"}}},
      "then": {
        "required": ["sourceTransactionId"],
        "properties": {
          "remotes": {
            "items": {
              "required": ["originalReceipt", "compensationAuthorizationLocator", "compensationAuthorizationIdentity"],
              "properties": {"action": {"const": "COMPENSATE_REF"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"transactionKind": {"const": "PRIMARY"}}},
      "then": {
        "properties": {
          "remotes": {
            "items": {
              "properties": {"action": {"enum": ["PUSH_REF", "CREATE_TAG", "DELETE_REF"]}}
            }
          }
        }
      }
    }
  ]
}
