{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Workspace repo-local project control configuration",
  "$comment": "routineExcludedPaths is a routine recovery/search/Git presentation and operation exclusion list, not a secrecy or source-authorization policy. Runtime consumers fail closed with UNVERIFIED when an entry cannot be used safely.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "controlPlaneLayout", "repositoryRoot", "frameworkVersion", "routineExcludedPaths", "frameworkCapabilities"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "controlPlaneLayout": { "const": "repo-local" },
    "repositoryRoot": { "const": ".." },
    "frameworkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "routineExcludedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "frameworkCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "KNOWLEDGE_REFERENCE": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": { "enabled": { "const": false } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "indexLocator"],
              "properties": {
                "enabled": { "const": true },
                "indexLocator": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    }
  }
}
