{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Workspace Framework maintenance sibling-target configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "controlPlaneLayout", "repositoryRoot", "frameworkVersion", "frameworkToolBackend", "routineExcludedPaths", "frameworkCapabilities", "processPolicy", "frameworkTarget"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "id": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "controlPlaneLayout": { "const": "framework-maintenance-sibling" },
    "repositoryRoot": { "const": ".." },
    "frameworkVersion": { "const": "1.15.1" },
    "frameworkToolBackend": { "const": "powershell7" },
    "routineExcludedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "frameworkCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "processPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "locator"],
      "properties": {
        "schemaVersion": {"const": 1},
        "locator": {"const": ".ai-workspace/process-policy.json"}
      }
    },
    "frameworkTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "siblingDirectory", "routineExcludedPaths"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "siblingDirectory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\/:*?\"<>|]+$"
        },
        "routineExcludedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
