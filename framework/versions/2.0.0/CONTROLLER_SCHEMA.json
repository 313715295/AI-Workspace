{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Workspace project controller lifecycle object",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "controllerId", "controllerEpoch", "state"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "controllerId": { "type": "string", "minLength": 1 },
    "controllerEpoch": { "type": "integer", "minimum": 1 },
    "state": { "const": "CURRENT" },
    "transitionRef": { "type": "object", "additionalProperties": false, "required": ["planPath", "planIdentity"], "properties": { "planPath": { "type": "string", "minLength": 1 }, "planIdentity": { "type": "string", "pattern": "^[0-9]+\\|[A-F0-9]{64}$" } } }
  }
}
