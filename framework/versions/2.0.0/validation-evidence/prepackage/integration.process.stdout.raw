b9a\u8fd0\u884c\u6765\u6e90\uff0c\u6309\u5b9e\u9645REGISTER/UPGRADE/REFRESH\u5b8c\u6210\u94fe\u6838\u5bf9\u5e76\u8bfb\u53d6TOOLCHAIN\u3002\u5f00\u53d1HEAD\u3001\u7f51\u7edc\u3001\u5176\u4ed6\u9879\u76ee\u6216\u4efb\u610f\u65b0\u5305\u4e0d\u4f5cfallback\u3002\u9996\u6b21/\u65b0\u6765\u6e90\u987b\u5b8c\u6574\u8d44\u683c\u9a8c\u8bc1\uff1b\u666e\u901a\u5df2\u91c7\u7528\u6765\u6e90\u6838\u771f\u5b9e\u5f53\u524d\u5b8c\u6210\u94fe\u3001\u72ec\u7acb\u56fa\u5b9a\u7ed1\u5b9a\u3001manifest\u539f\u59cb\u8eab\u4efd\u4e0e\u58f0\u660e\uff0c\u4ee5\u53ca\u5b9e\u9645\u6d88\u8d39\u7684\u5b9e\u73b0/catalog/\u89c4\u5219\u548c\u5fc5\u8981\u4f9d\u8d56\uff0c\u4e0d\u9012\u5f52\u626b\u63cf\u672a\u6d88\u8d39\u6d4b\u8bd5\u3001\u5386\u53f2\u6216\u5176\u4ed6\u5305\u6210\u5458\uff0c\u4e5f\u4e0d\u4ee5\u8f7b\u91cf\u4e8b\u5b9e\u58f0\u79f0\u5168\u5305\u5065\u5eb7\u3002\u5b8c\u6574\u91c7\u7528\u3001\u8d44\u683c\u548c\u5206\u53d1\u9a8c\u8bc1\u4ecd\u5b8c\u6574\u6838\u5305\uff0c\u4e0d\u628a\u58f0\u660e\u5408\u6210\u4e3a\u5b8c\u6574Facts\u6216\u65b0Proof\uff1b\u4e0d\u52a0\u8de8\u8bf7\u6c42\u7f13\u5b58\u3002\u5f31\u7ed1\u5b9a\u3001\u4ec5\u6807\u8bb0true\u6216\u5b9e\u9645\u6f02\u79fb\u5747\u4e0d\u8db3\uff0c\u672a\u5b8c\u6210\u91c7\u7528\u5148\u6062\u590d\u539f\u4e8b\u52a1\u3002\n\n\u5df2\u6709taskId\u76f4\u63a5\u8bfb\u53d6\u539f\u5361\u53ca\u5fc5\u8981\u9879\u76ee\u4e8b\u5b9e\uff0c\u672a\u77e5\u4efb\u52a1\u624d\u7528\u7d22\u5f15\u5b9a\u4f4d\uff1bSTATUS\u6309\u5168\u5c40\u4e8b\u5b9e\u9700\u8981\u8bfb\u53d6\u3002\u65b0\u8bf7\u6c42\u5148\u6309\u7a33\u5b9a\u6210\u679csubject\u3001\u9879\u76ee\u5361/\u8d28\u91cf\u7b56\u7565\u53ca\u5f53\u524d\u4eba\u7c7b\u51b3\u5b9a\u9009\u62e9\u771f\u5b9e\u4e0a\u4e0b\u6587\uff1a\u9700\u5361\u7528TASK\uff0c\u5141\u8bb8\u7701\u5361\u4f46\u6709\u6210\u679c\u95e8\u6216\u6709\u9650\u5199\u5165/\u591a\u6b65\u6210\u679c\u7528PROJECT_WORK\uff0c\u65e0\u9002\u7528\u4efb\u52a1\u7684\u53ea\u8bfb\u7528PROJECT_READ_ONLY\uff0c\u53ea\u6709\u65e0\u9700\u5361\u6216\u6210\u679c\u95e8\u4e14\u8bb8\u53ef\u8986\u76d6\u7684\u666e\u901a\u5de5\u5177\u7528PROJECT_EXTERNAL\u3002\u7ed1\u5b9a\u539f\u8bf7\u6c42\u3001\u6210\u679cOwner\u3001\u5b9e\u9645actor/role/phase\u3001profile\u3001\u52a8\u4f5c/\u7ed3\u679c\u3001\u7cbe\u786e\u8303\u56f4/\u4fdd\u62a4\u548c\u9002\u7528\u8d28\u91cf\uff0c\u4e0d\u628a\u5f53\u524d\u64cd\u4f5cworkType\u66ff\u4ee3\u53d1\u8d77\u6210\u679cworkType\u3002DISCOVER\u524d\u4f9dTOOL_CONTRACT\u5f62\u6210\u771f\u5b9eIntentEnvelope\uff0c\u53d6\u5f97\u5f53\u524d\u5b8c\u6574\u5fc5\u8981\u6b63\u6587\uff1b\u52a0\u8f7d\u4e0d\u6267\u884c\u52a8\u4f5c\u6216\u4ea7\u751f\u8bb8\u53ef\u3002\u7f3a\u7701LEGACY\u548c\u65e7\u8f93\u5165\u6cbf\u539f\u517c\u5bb9\u6761\u4ef6\uff0c\u672a\u77e5\u4e0d\u964d\u95e8\u3002\n\n\u65b0\u4e8b\u5b9e\u53ea\u91cd\u5efa\u53d7\u5f71\u54cd\u6765\u6e90\u3001\u51b3\u5b9a\u6216\u6b63\u6587\uff1b\u538b\u7f29/\u6362\u4e3b\u4f53/\u6b63\u6587\u4e0d\u786e\u5b9a\u987b\u5b8c\u6574\u6062\u590d\u5f53\u524d\u5fc5\u9700\u6b63\u6587\uff0c\u5065\u5eb7\u8c03\u7528\u4e0d\u9010\u6b65FULL_COLD\u3002LOAD_PLAN_RESOLVE\u53ea\u670d\u52a1\u652f\u6301\u6750\u6599\u3001Framework\u7ef4\u62a4\u8bf4\u660e\u3001\u539f\u517c\u5bb9\u6216\u65e0\u6cd5\u8bc1\u660e\u6620\u5c04\u65f6\u7684\u6709\u754c\u6a21\u5757\u56de\u9000\uff0c\u4e0d\u7b5bcatalog\u6216\u7ed5\u4fdd\u62a4\u3002\u5b9e\u9645Git\u518d\u6838\u5bf9\u5e94\u4ed3\u5e93\u3002\u666e\u901a\u89c2\u5bdf\u4e0d\u53d6\u9879\u76ee/source\u534f\u8c03\u9501\uff0c\u4e0d\u81ea\u52a8\u91cd\u653epublication journal\uff1b\u771f\u5b9e\u4e8b\u52a1\u5199\u8005\u7ade\u4e89\u7684BUSY\u4fdd\u6301holder=UNKNOWN\uff0c\u6536\u8d77\u672c\u6b21\u5c1d\u8bd5\u3002\u663e\u5f0f\u76f8\u5173journal\u7684IN_PROGRESS\u6cbf\u539f\u6062\u590d\u5165\u53e3\uff1b\u4e0d\u5220\u540c\u6b65\u5bf9\u8c61\u3001\u6539pin\u6216\u8865\u8f7d\u5f00\u53d1\u6a21\u5757\u3002\u62a5\u544a\u771f\u5b9e\u4e0b\u4e00\u52a8\u4f5c\u53ca\u8bc1\u636e\u4e0a\u9650\u3002","preparationRequirements":["CURRENT_AUTHORITY_BOUND"],"resultRequirements":[],"selectorIdentity":"225|00AFDA43FF5