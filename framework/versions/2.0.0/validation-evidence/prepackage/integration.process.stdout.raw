4ee3\u771f\u5b9e\u63a5\u6536\u8005\u6216\u5ba3\u79f0\u5df2\u9001\u8fbe\u3002\n\n\u5b9e\u9645\u53d1\u9001\u540e\u5728\u540c\u4e00\u5de5\u5177\u7f16\u6392\u4fdd\u5b58\u5b8c\u6574\u539f\u59cb\u8fd4\u56de\u5e76OBSERVE\uff1a\u975e\u9519\u8befMCP text JSON\u4e2d\u552f\u4e00\u5339\u914dthreadId\u8868\u793a\u5bbf\u4e3b\u53d7\u7406\uff1b\u660e\u786e\u62d2\u7edd\u4e3aFAILURE\uff0c\u65e0\u53ef\u786e\u5b9a\u7ed3\u679c\u4e3aUNKNOWN\u3002\u6309TOOL_CONTRACT\u540c\u65f6\u6838\u5bf9\u5f53\u524d\u6d88\u8d39\u8005\u4e0e\u8fd4\u56de\u539f\u5b57\u8282\uff1b\u672a\u77e5/\u5931\u8d25\u505c\u6b62\u4f9d\u8d56\u53d1\u9001\uff0c\u4e0d\u5236\u9020\u672a\u6765\u56de\u6267\u3001ACK\u6216\u989d\u5916\u767b\u8bb0\u56de\u5408\uff0c\u91cd\u8bd5\u8d44\u683c\u53ea\u53d6\u771f\u5b9e\u5bbf\u4e3b\u660e\u786e\u6709\u754c\u4fe1\u53f7\u3002\u53d1\u9001\u53d7\u7406\u4e0d\u7b49\u4e8e\u5bf9\u65b9\u6267\u884c\u3001\u5ba1\u6838\u6216\u63a5\u53d7\u3002\n\u666e\u901aUSER\u7b54\u590d\u80fd\u5426\u7701\u673a\u68b0\u6536\u53e3\uff0c\u53d6\u5f53\u524d\u540c\u65f6\u5fc5\u9009\u7684RECOVERY_CORE / PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES\u5b8c\u6574\u6761\u4ef6\u3002\n","preparationRequirements":[],"resultRequirements":[],"selectorIdentity":"488|83F11DDD34F47080EB410AC9144AD64C3A6608A5675A920E13E39DD6444C5E3C","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","sourceIdentity":"7845|DEDF5E5A1B3196F187F9E5560C102390DB44B79CF3F01810FA986977AF547978","fullText":"\u901a\u7528\u7ec8\u6001\u3001\u6d88\u8d39\u8005\u3001Controller\u4f8b\u5916\u548c\u7b49\u5f85\u53d6TASK\uff1b\u672c\u5757\u53ea\u6620\u5c04Codex\u771f\u5b9e\u6295\u9012\u3002\u4f18\u5148turn boundary\uff0c\u5b89\u5168\u4f8b\u5916\u53ef\u7acb\u5373steer\uff1b\u7f3a\u771f\u5b9e\u6027/\u9001\u8fbe\u4fe1\u53f7\u5982\u5b9e\u9650\u5236\u4e3acapability ceiling\u6216REPORT_CHANNEL_UNAVAILABLE\uff0c\u4e0d\u5efaheartbeat\u6216\u6295\u9012\u53f0\u8d26\u3002\n\n\u53d1\u9001\u524d\u6838\u5bf9\u539f\u59cb\u4eba\u7c7b\u5de5\u4f5c\u6d41\u6765\u6e90\u3001\u7cbe\u786e\u6d88\u8d39\u8005\u53ca\u540e\u7eed\u6536\u7a84/\u64a4\u56de\uff1b\u53e6\u4e00\u4efb\u52a1\u8981\u6c42\u672c\u8eab\u4e0d\u63d0\u4f9b\u6d88\u606f\u6388\u6743\u3002\u539f\u751ffinal\u4ec5\u5bf9\u7ed1\u5b9aUSER\u6d88\u8d39\u8005\u4f7f\u7528PREPARE\uff0c\u8de8\u4efb\u52a1PREPARE\u53ea\u662fREADY_TO_SEND\uff0c\u4e0d\u80fd\u7528USER\u66ff\u4ee3\u771f\u5b9e\u63a5\u6536\u8005\u6216\u5ba3\u79f0\u5df2\u9001\u8fbe\u3002\n\n\u5b9e\u9645\u53d1\u9001\u540e\u5728\u540c\u4e00\u5de5\u5177\u7f16\u6392\u4fdd\u5b58\u5b8c\u6574\u539f\u59cb\u8fd4\u56de\u5e76OBSERVE\uff1a\u975e\u9519\u8befMCP text JSON\u4e2d\u552f\u4e00\u5339\u914dthreadId\u8868\u793a\u5bbf\u4e3b\u53d7\u7406\uff1b\u660e\u786e\u62d2\u7edd\u4e3aFAILURE\uff0c\u65e0\u53ef\u786e\u5b9a\u7ed3\u679c\u4e3aUNKNOWN\u3002\u6309TOOL_CONTRACT\u540c\u65f6\u6838\u5bf9\u5f53\u524d\u6d88\u8d39\u8005\u4e0e\u8fd4\u56de\u539f\u5b57\u8282\uff1b\u672a\u77e5/\u5931\u8d25\u505c\u6b62\u4f9d\u8d56\u53d1\u9001\uff0c\u4e0d\u5236\u9020\u672a\u6765\u56de\u6267\u3001ACK\u6216\u989d\u5916\u767b\u8bb0\u56de\u5408\uff0c\u91cd\u8bd5\u8d44\u683c\u53ea\u53d6\u771f\u5b9e\u5bbf\u4e3b\u660e\u786e\u6709\u754c\u4fe1\u53f7\u3002\u53d1\u9001\u53d7\u7406\u4e0d\u7b49\u4e8e\u5bf9\u65b9\u6267\u884c\u3001\u5ba1\u6838\u6216\u63a5\u53d7\u3002\n\u666e\u901aUSER\u7b54\u590d\u80fd\u5426\u7701\u673a\u68b0\u6536\u53e3\uff0c\u53d6\u5f53\u524d\u540c\u65f6\u5fc5\u9009\u7684RECOVERY_CORE / PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES\u5b8c\u6574\u6761\u4ef6\u3002\n","orderedDependencies":[]}],"declarationIdentity":"1025|0CA203156C94374ED68EE4A09514F36683A7CBEAA705BD95C18BA8F804A637CC"},{"requirementId":"framework:PR_DYNAMIC_ROLE_DIRECT_ISSUANCE","source":"FRAMEWORK","ownerModule":"AUTHORIZATION_MODEL.md","semanticApplicability":"DETERMINISTIC","fullText":"controller.json\u552f\u4e00\u786e\u5b9a\u5f53\u524dController ID/epoch\uff1bPROJECT_CONTROLLER\u7b7e\u53d1\u8005\u987b\u5339\u914d\uff0cTASK_OWNER\u4e0d\u5f97\u5192\u5145\u3002\u540c\u4e00actor\u53ef\u517c\u4efb\uff0c\u4f46\u7b7e\u53d1\u3001\u63a5\u53d7\u548c\u72ec\u7acb\u5ba1\u6838\u5173\u7cfb\u5206\u522b\u6210\u7acb\u3002Controller\u627f\u62c5\u9879\u76ee\u6301\u7eed\u8d23\u4efb\uff0c\u5bf9\u81ea\u8eab\u7ec4\u7ec7\u3001\u516c\u5171/\u8de8\u57df\u53ca\u8d44\u6e90\u51b3\u5b9a\u7684\u4f9d\u636e\u4e0e\u7ed3\u679c\u8d1f\u8d23\uff1b\u59d4\u6d3e\u6216\u4e13\u5bb6\u7ed3\u8bba\u4e0d\u8f6c\u79fb\u8fd9\u9879\u8d23\u4efb\u3002Owner\u627f\u62c5TASK_AND_SCOPE\u5b9a\u4e49\u7684\u5f53\u524d\u6709\u9650\u6210\u679c\u4e0e\u6574\u5408\u8d23\u4efb\uff0c\u4e34\u65f6\u4e3b\u4f53\u4f9d\u539f\u53d7\u6258\u8303\u56f4\u5c65\u804c\u3002\n\nTASK_OWNER\u5728\u672a\u53d8domain\u6210\u679c\u5185\u76f4\u63a5\u6267\u884c\uff0c\u6216\u9009\u62e9temporary actor/Reviewer\u3001\u7b7e\u7cbe\u786e\u5305\u5e76\u6d88\u8d39\u7ed3\u679c\u3002grantee\u53ea\u6709\u672c\u52a8\u4f5c\u6216\u660e\u786e\u8fde\u7eed\u6279\u6b21\u7684\u4e34\u65f6\u6267\u884c\u8d44\u683c\uff0c\u4e0d\u53d6\u5f97Owner\u6743\u529b\uff0c\u4e0d\u6539Work route\u3002\u672a\u77e5\u63a5\u6536\u8005\u4f7f\u7528TOOL_CONTRACT\u7684\u4e0d\u53ef\u6267\u884c\u5f85\u7ed1\u5b9a\u539f\u4ef6\u53caHOST\u7684\u771f\u5b9e\u81ea\u8eab\u8eab\u4efd\u6838\u5bf9\uff1b\u5df2\u77e5ID\u76f4\u63a5\u7ed1\u5b9a\uff0c\u5065\u5eb7\u7eed\u4f5c\u4e0d\u91cd\u590d\u81ea\u7ed1\u5b9a\u3002\n\nidentity/model\u7684\u5408\u6cd5\u7ed1\u5b9a\u53d8\u5316\u4e0eeffort\u8c03\u6574\u5206\u5f00\uff1beffort\u672c\u8eab\u4e0d\u8f6c\u79fb\u8d23\u4efb\u3001\u4e0d\u6388\u4e88\u6743\u9650\uff0c\u4e0d\u81ea\u52a8\u8981\u6c42handoff\u3001\u65b0\u4efb\u52a1\u6216FULL_COLD\u3002\u8d44\u6e90\u5224\u65ad\u53d6PR_TASK_RESOURCE_SELECTION\uff0c\u5bbf\u4e3b\u5b9e\u9645\u914d\u7f6e\u53d6HOST_CODEX\u3002\n\n\u53ea\u6709Controller\u62e5\u6709\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\uff0c\u6216\u5f53\u524dOwner/\u516c\u5171\u51b3\u5b9a\u3001\u8de8\u57df\u5408\u540c\u3001\u4fdd\u62a4\u3001\u