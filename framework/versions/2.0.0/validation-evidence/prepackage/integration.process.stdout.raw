fb\u5206\u522b\u6838\u5bf9\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u6216\u6362\u4e3b\u4f53\u6309RECOVERY\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\uff1b\u5065\u5eb7\u4e0a\u4e0b\u6587\u6309RECOVERY\u590d\u7528\uff0c\u540c\u6d3b\u52a8\u666e\u901a\u8303\u56f4\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u9a8c\u5f53\u524d\u51c6\u5165\u4e0e\u9002\u7528\u8981\u6c42\uff0c\u4e0d\u4e3a\u6bcf\u6b21action/final\u91cd\u8f7d\u3002\u65e0\u5173\u4f1a\u8bdd\u4e0d\u542f\u52a8\u9879\u76ee\u6062\u590d\u3002\n\n\u65e7nav1/nav2\u9879\u76ee\u53ca\u5728\u9014\u91c7\u7528\u7ee7\u7eed\u4f7f\u7528\u5404\u81ea\u539f\u56fa\u5b9a\u5165\u53e3\uff0c\u539fFINALIZE\u5b8c\u6210\u540e\u624d\u8bfb\u65b0AGENTS/Bootstrap\uff1b\u90e8\u5206\u6587\u4ef6\u53d8\u5316\u4e0d\u4ee3\u8868\u5207\u6362\u5b8c\u6210\u3002\u65e7Skill\u4ec5\u5728\u771f\u5b9e\u4f9d\u8d56\u7ed3\u675f\u4e14\u6709\u5bbf\u4e3b\u6743\u9650\u65f6\u9000\u5f79\uff0c\u4e0d\u5efa\u6d88\u8d39\u8005\u767b\u8bb0\u6216\u6bcf\u9879\u76ee\u526f\u672c\u3002\u8f93\u5165/\u8bc1\u636e\u4ecd\u53d6\u5f53\u524dTOOL_CONTRACT\uff0c\u5bfc\u822a\u672c\u8eab\u4e0d\u6388\u6743\u3002","preparationRequirements":["PROJECT_ENTRY_CONTEXT_BOUND"],"resultRequirements":["PROJECT_ENTRY_FINAL_READBACK"],"selectorIdentity":"471|2577D7A2AC74DDF06C5538EB79EA806DBB5433C7B8A690636D0BDE0F03CD98A7","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","sourceIdentity":"7658|CB634103890E122BD3E5D7F8899C94D2DD65190C0C449E5E0EA049E2CC7DB6D8","fullText":"\u672c\u76ee\u6807\u4f7f\u7528navigationContractVersion=3\u7684PROJECT_BOOTSTRAP\u5165\u53e3\u3002\u9879\u76eeAGENTS\u53ea\u5bfc\u822a\u660e\u786e\u9879\u76ee\u7684.ai-workspace/BOOTSTRAP.md\uff1bBootstrap\u6309\u9879\u76eepin\u53ca\u539f\u91c7\u7528\u8bb0\u5f55\u7ed1\u5b9a\u56fa\u5b9a\u6765\u6e90\u548cTOOLCHAIN\uff0c\u4e0d\u8981\u6c42\u65b0Skill\u3001\u5b89\u88c5\u53d1\u73b0\u6216\u517c\u5bb9\u8f6c\u53d1\u3002\u5bbf\u4e3bAGENTS\u53ef\u89c1\u3001\u6587\u4ef6\u53ef\u8bfb\u548c\u5b9e\u9645\u6b63\u6587\u5df2\u8bfb\u5206\u522b\u6838\u5bf9\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u6216\u6362\u4e3b\u4f53\u6309RECOVERY\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\uff1b\u5065\u5eb7\u4e0a\u4e0b\u6587\u6309RECOVERY\u590d\u7528\uff0c\u540c\u6d3b\u52a8\u666e\u901a\u8303\u56f4\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u9a8c\u5f53\u524d\u51c6\u5165\u4e0e\u9002\u7528\u8981\u6c42\uff0c\u4e0d\u4e3a\u6bcf\u6b21action/final\u91cd\u8f7d\u3002\u65e0\u5173\u4f1a\u8bdd\u4e0d\u542f\u52a8\u9879\u76ee\u6062\u590d\u3002\n\n\u65e7nav1/nav2\u9879\u76ee\u53ca\u5728\u9014\u91c7\u7528\u7ee7\u7eed\u4f7f\u7528\u5404\u81ea\u539f\u56fa\u5b9a\u5165\u53e3\uff0c\u539fFINALIZE\u5b8c\u6210\u540e\u624d\u8bfb\u65b0AGENTS/Bootstrap\uff1b\u90e8\u5206\u6587\u4ef6\u53d8\u5316\u4e0d\u4ee3\u8868\u5207\u6362\u5b8c\u6210\u3002\u65e7Skill\u4ec5\u5728\u771f\u5b9e\u4f9d\u8d56\u7ed3\u675f\u4e14\u6709\u5bbf\u4e3b\u6743\u9650\u65f6\u9000\u5f79\uff0c\u4e0d\u5efa\u6d88\u8d39\u8005\u767b\u8bb0\u6216\u6bcf\u9879\u76ee\u526f\u672c\u3002\u8f93\u5165/\u8bc1\u636e\u4ecd\u53d6\u5f53\u524dTOOL_CONTRACT\uff0c\u5bfc\u822a\u672c\u8eab\u4e0d\u6388\u6743\u3002","orderedDependencies":[]}],"declarationIdentity":"937|BB539B17256DAD819641DB11C62EB09115C32FA348B7BAFF992CA5A968EC78B6"},{"requirementId":"framework:PR_CODEX_TOOL_OPERATION_RESOLUTION","source":"FRAMEWORK","ownerModule":"HOST_CODEX.md","semanticApplicability":"DETERMINISTIC","fullText":"\u6309RECOVERY\u7684\u5df2\u7ed1\u5b9abackend/TOOLCHAIN\u53d6\u5f97\u7cbe\u786eoperation\u5165\u53e3\uff0c\u5065\u5eb7\u8c03\u7528\u590d\u7528\u3002\u5df2\u77e5\u72ec\u7acb\u8bfb\u67e5\u540c\u6279\u6267\u884c\uff1b\u6709\u4f9d\u8d56\u4e14\u65e0\u9700\u65b0\u8bed\u4e49\u5224\u65ad\u7684\u673a\u68b0\u6b65\u9aa4\u8fde\u7eed\u7f16\u6392\uff0c\u9010\u95e8\u68c0\u67e5\u5b9e\u9645\u7ed3\u679c\uff0c\u5931\u8d25\u505c\u4f9d\u8d56\u94fe\u3002\u65b0\u4e8b\u5b9e\u3001\u8bed\u4e49\u53d6\u820d\u6216\u771f\u5b9e\u5931\u8d25\u624d\u8fd4\u56de\u6a21\u578b\uff0c\u4e0d\u81ea\u52a8\u586b\u6388\u6743\u3001Review\u6216\u63a5\u53d7PASS\uff1b\u8bb0\u5f55\u3001\u4ea4\u4ed8\u4e0e\u5fc5\u8981\u5f52\u6863\u5728\u539f\u81ea\u7136\u6536\u5c3e\u5b8c\u6210\u3002\n\n\u65b0\u6709\u9650\u6210\u679c\u3001\u65b0\u72ec\u5ba1\u6309TASK\u9ed8\u8ba4\u65b0\u5efa\u53ef\u89c1\u4f1a\u8bdd\uff1b\u540c\u4e00\u539f\u6210\u679c\u6216\u540c\u5ba1\u6709\u754c\u4fee\u590d\u590d\u5ba1\u53ef\u7eed\u4ecd\u5065\u5eb7\u3001\u5408\u683c\u7684\u539f\u4f1a\u8bdd\u3002\u521b\u5efa\u65f6\u540c\u4e00\u6b21\u5b9e\u9645\u8c03\u7528\u843d\u5b9e\u9009\u5b9amodel\u3001effort\u3001\u73af\u5883\u548c\u5bbf\u4e3b\u652f\u6301\u7684\u7cbe\u786e\u8d77\u70b9\uff0c\u4f7f\u7528\u6807\u9898\u53c2\u6570\uff0c\u5e76\u6838\u5bf9\u771f\u5b9ethread ID\u3001\u914d\u7f6e\u53ca\u8bfb\u53d6\u57fa\u7ebf\u3002clientThreadId\u4e0d\u4f5c\u6b63\u5f0f\u4e3b\u4f53\u3002\u5f53\u524d\u672a\u63d0\u4ea4\u6750\u6599\u3001\u9694\u79bb\u9700\u8981\u548c\u7528\u6237\u6307\u5b9a\u5f71\u54cd\u8d77\u70b9\uff0c\u4e0d\u56e0\u201c\u72ec\u5ba1\u201d\u6216Git\u540d\u79f0\u81ea\u52a8\u5f3a\u5236worktree\uff1b\u5bbf\u4e3b\u4e0d\u652f\u6301\u4e0e\u7528\u6237\u6ca1\u6388\u6743\u5206\u522b\u62a5\u544a\uff0c\u4e0d\u9759\u9ed8\u6362\u73af\u5883\u3002\u660e\u786econtrolRoot\u53caexecutionTarget\u7684\u521d\u59cb\u6307\u4ee4\u4f18\u5148\u4e8e\u6267\u884c\u76ee\u5f55\u5185\u5386\u53f2\u590d\u5236\u5165\u53e3\uff0c\u5b9e\u9645authority/\u4fdd\u62a4\u4ecd\u7531\u5f53\u524d\u5de5\u5177\u6838\u5bf9\u3002\n\n\u5df2\u77e5\u63a5\u6536\u8005\u76f4\u63a5\u4f7f\u7528\u771f\u5b9eID\u3002\u65b0\u5efa\u672a\u77e5\u4e34\u65f6actor\u65f6\uff0c\u521b\u5efa\u63d0\u793a\u4e00\u6b21\u4ea4\u9f50\u5b8c\u6574\u5de5\u4f5c/\u9a8c\u6536/\u5019\u9009/\u6d88\u8d39\u8005\u3001\u539f\u59cb\u4eba\u7c7b\u6765\u6e90\u53ca\u4e0d\u53ef\u6267\u884c\u5f85\u7ed1\u5b9a\u539f\u4ef6\u8def\u5f84\u3001identity\u3001delegationId\u3002\u63a5\u6536\u8005\u6838\u81ea\u5df1\u7684\u771f\u5b9e\u521d\u59cb\u59d4\u6d3e\u540e\uff0cAUTHORIZATION_RECEIVER_BIND\u4ec5\u4eceCODEX_THREAD_ID\u7ed1\u5b9agrantee\uff1b\u4e0d\u80fd\u6539Owner/issuer/\u8303\u56f4/\u52a8\u4f5c/\u5019\u9009\u3002\u65b0\u6709\u9650\u4efb\u52a1\u7684Owner\u767b\u8bb0\u662f\u53e6\u4e00\u60c5\u5f62\uff1a\u521b\u5efa\u524d\u5907\u9f50\u975e\u6267\u884c\u767b\u8bb0\u6a21\u677f\u548c\u5b8c\u6574\u7b80\u62a5\uff0c\u8fd4\u56de\u771f\u5b9ethreadId\u540e\u7531\u53d1\u8d77\u65b9\u8fde\u7eed\u767b\u8bb0\u771f\u5b9eOwner/route\u53ca\u5f53\u524d\u7cbe\u786e\u5305\u5e76\u5b8c\u6210\u539fF\u3002\u521b\u5efa\u63d0\u793a\u5982\u5b9e\u8bf4\u660e\u767b\u8bb0\u5f85\u5b8c\u6210\u5e76\u4e00\u6b21\u4ea4\u9f50\u53ef\u9884\u5907\u5f15\u7528\uff1b\u6267\u884c\u8d44\u683c\u552f\u4e00\u53d6TASK_AND_SCOPE\u7684PR_TASK_LAUNCH_AND_ROUTE\uff0c\u4ee5\u63a5\u6536\u8005\u5b9e\u9645\u8bfb\u53d6\u65f6\u4e8b\u5b9e\u4e3a\u51c6\u3002\u786e\u56e0\u7f3a\u9879\u505c\u6b62\u9700\u6062\u590d\u6216\u521d\u59cb\u5f15\u7528\u4e0d\u5168\u65f6\uff0c\u767b\u8bb0\u65b9\u8865\u5fc5\u8981\u6750\u6599\u3002receiverBinding\u4e0d\u80fd\u767b\u8bb0\u65b0Owner\u3002\u5173\u7cfb\u4fdd\u6301INSTRUCTION_BOUND\uff0c\u4e0d\u58f0\u79f0\u5de5\u5177\u8ba4\u8bc1\u63d0\u793a\uff1b\u5177\u4f53\u5b57\u6bb5\u552f\u4e00TOOL_CONTRACT\uff0c\u5065\u5eb7\u7eed\u4f5c\u4e0d\u91cd\u590d\u7ed1\u5b9a\u3002\n\n\u5bbf\u4e3b\u660e\u786e\u8981\u6c42\u521b\u5efa\u540e\u9996\u6b21\u8fdb\u5ea6\u89c2\u5bdf\u65f6\uff0c\u5728\u53d6\u5f97\u771f\u5b9e\u53ef\u7528ID\u540e\u4ec5\u505a\u4e00\u6b21\u7acb\u5373\u5feb\u7167\uff0c\u672a\u5c31\u7eea\u7ed3\u675f\u672c\u8f6e\uff1b\u8d85\u65f6/commentary\u4e0d\u89e6\u53d1\u7ee7\u7eed\u7b49\u5f85\u3002\u5f53\u524d\u547d\u4ee4\u5fc5\u8981\u7b49\u5f85\u4e0epeer\u7b49\u5f85\u5206\u5f00\uff0c\u540e\u8005\u9075\u5faaTASK\u3002\u4f1a\u8bdd\u7ee7\u7eed\u3001\u91ca\u653e\u4e0e\u5e94\u5f52\u6863\u6761\u4ef6\u53d6TASK\uff1b\u843d\u5b9e\u65f6\u7528\u771f\u5b9eID\u8c03\u7528\u6807\u9898/\u5f52\u6863\u5de5\u5177\u5e76\u6838\u5bf9\u5bbf\u4e3b\u8fd4\u56de\uff0c\u6807\u9898\u4e0d\u53d1\u9001\u5de5\u4f5c\u6307\u4ee4\uff0c\u4efb\u52a1\u5361\u5f52\u6863\u4e0d\u66ff\u4ee3\u4f1a\u8bdd\u5f52\u6863\u3002\u5b9e\u9645\u4ea4\u5ba1\u4f9d\u8d56\u987a\u5e8f\u552f\u4e00\u53d6REVIEW_AND_EVIDENCE\u3002","preparationRequirements":["TOOLCHAIN_IDENTITY_BOUND"],"resultRequirements":["SEALED_ENTRYPOINT_INVOKED"],"selectorIdentity":"653|3DE8F0AE2CEEB69FDFB22709B65ACCD511878EB6398FDC73CAEA3B4D0FB40582","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","sourceIdentity":"7658|CB634103890E122BD3E5D7F8899C94D2DD65190C0C449E5E0EA049E2CC7DB6D8","fullText":"\u6309RECOVERY\u7684\u5df2\u7ed1\u5b9abackend/TOOLCHAIN\u53d6\u5f97\u7cbe\u786eoperation\u5165\u53e3\uff0c\u5065\u5eb7\u8c03\u7528\u590d\u7528\u3002\u5df2\u77e5\u72ec\u7acb\u8bfb\u67e5\u540c\u6279\u6267\u884c\uff1b\u6709\u4f9d\u8d56\u4e14\u65e0\u9700\u65b0\u8bed\u4e49\u5224\u65ad\u7684\u673a\u68b0\u6b65\u9aa4\u8fde\u7eed\u7f16\u6392\uff0c\u9010\u95e8\u68c0\u67e5\u5b9e\u9645\u7ed3\u679c\uff0c\u5931\u8d25\u505c\u4f9d\u8d56\u94fe\u3002\u65b0\u4e8b\u5b9e\u3001\u8bed\u4e49\u53d6\u820d\u6216\u771f\u5b9e\u5931\u8d25\u624d\u8fd4\u56de\u6a21\u578b\uff0c\u4e0d\u81ea\u52a8\u586b\u6388\u6743\u3001Review\u6216\u63a5\u53d7PASS\uff1b\u8bb0\u5f55\u3001\u4ea4\u4ed8\u4e0e\u5fc5\u8981\u5f52\u6863\u5728\u539f\u81ea\u7136\u6536\u5c3e\u5b8c\u6210\u3002\n\n\u65b0\u6709\u9650\u6210\u679c\u3001\u65b0\u72ec\u5ba1\u6309TASK\u9ed8\u8ba4\u65b0\u5efa\u53ef\u89c1\u4f1a\u8bdd\uff1b\u540c\u4e00\u539f\u6210\u679c\u6216\u540c\u5ba1\u6709\u754c\u4fee\u590d\u590d\u5ba1\u53ef\u7eed\u4ecd\u5065\u5eb7\u3001\u5408\u683c\u7684\u539f\u4f1a\u8bdd\u3002\u521b\u5efa\u65f6\u540c\u4e00\u6b21\u5b9e\u9645\u8c03\u7528\u843d\u5b9e\u9009\u5b9amodel\u3001effort\u3001\u73af\u5883\u548c\u5bbf\u4e3b\u652f\u6301\u7684\u7cbe\u786e\u8d77\u70b9\uff0c\u4f7f\u7528\u6807\u9898\u53c2\u6570\uff0c\u5e76\u6838\u5bf9\u771f\u5b9ethread ID\u3001\u914d\u7f6e\u53ca\u8bfb\u53d6\u57fa\u7ebf\u3002clientThreadId\u4e0d\u4f5c\u6b63\u5f0f\u4e3b\u4f53\u3002\u5f53\u524d\u672a\u63d0\u4ea4\u6750\u6599\u3001\u9694\u79bb\u9700\u8981\u548c\u7528\u6237\u6307\u5b9a\u5f71\u54cd\u8d77\u70b9\uff0c\u4e0d\u56e0\u201c\u72ec\u5ba1\u201d\u6216Git\u540d\u79f0\u81ea\u52a8\u5f3a\u5236worktree\uff1b\u5bbf\u4e3b\u4e0d\u652f\u6301\u4e0e\u7528\u6237\u6ca1\u6388\u6743\u5206\u522b\u62a5\u544a\uff0c\u4e0d\u9759\u9ed8\u6362\u73af\u5883\u3002\u660e\u786econtrolRoot\u53caexecutionTarget\u7684\u521d\u59cb\u6307\u4ee4\u4f18\u5148\u4e8e\u6267\u884c\u76ee\u5f55\u5185\u5386\u53f2\u590d\u5236\u5165\u53e3\uff0c\u5b9e\u9645authority/\u4fdd\u62a4\u4ecd\u7531\u5f53\u524d\u5de5\u5177\u6838\u5bf9\u3002\n\n\u5df2\u77e5\u63a5\u6536\u8005\u76f4\u63a5\u4f7f\u7528\u771f\u5b9eID\u3002\u65b0\u5efa\u672a\u77e5\u4e34\u65f6actor\u65f6\uff0c\u521b\u5efa\u63d0\u793a\u4e00\u6b21\u4ea4\u9f50\u5b8c\u6574\u5de5\u4f5c/\u9a8c\u6536/\u5019\u9009/\u6d88\u8d39\u8005\u3001\u539f\u59cb\u4eba\u7c7b\u6765\u6e90\u53ca\u4e0d\u53ef\u6267\u884c\u5f85\u7ed1\u5b9a\u539f\u4ef6\u8def\u5f84\u3001identity\u3001delegationId\u3002\u63a5\u6536\u8005\u6838\u81ea\u5df1\u7684\u771f\u5b9e\u521d\u59cb\u59d4\u6d3e\u540e\uff0cAUTHORIZATION_RECEIVER_BIND\u4ec5\u4eceCODEX_THREAD_ID\u7ed1\u5b9agrantee\uff1b\u4e0d\u80fd\u6539Owner/issuer/\u8303\u56f4/\u52a8\u4f5c/\u5019\u9009\u3002\u65b0\u6709\u9650\u4efb\u52a1\u7684Owner\u767b\u8bb0\u662f\u53e6\u4e00\u60c5\u5f62\uff1a\u521b\u5efa\u524d\u5907\u9f50\u975e\u6267\u884c\u767b\u8bb0\u6a21\u677f\u548c\u5b8c\u6574\u7b80\u62a5\uff0c\u8fd4\u56de\u771f\u5b9ethreadId\u540e\u7531\u53d1\u8d77\u65b9\u8fde\u7eed\u767b\u8bb0\u771f\u5b9eOwner/route\u53ca\u5f53\u524d\u7cbe\u786e\u5305\u5e76\u5b8c\u6210\u539fF\u3002\u521b\u5efa\u63d0\u793a\u5982\u5b9e\u8bf4\u660e\u767b\u8bb0\u5f85\u5b8c\u6210\u5e76\u4e00\u6b21\u4ea4\u9f50\u53ef\u9884\u5907\u5f15\u7528\uff1b\u6267\u884c\u8d44\u683c\u552f\u4e00\u53d6TASK_AND_SCOPE\u7684PR_TASK_LAUNCH_AND_ROUTE\uff0c\u4ee5\u63a5\u6536\u8005\u5b9e\u9645\u8bfb\u53d6\u65f6\u4e8b\u5b9e\u4e3a\u51c6\u3002\u786e\u56e0\u7f3a\u9879\u505c\u6b62\u9700\u6062\u590d\u6216\u521d\u59cb\u5f15\u7528\u4e0d\u5168\u65f6\uff0c\u767b\u8bb0\u65b9\u8865\u5fc5\u8981\u6750\u6599\u3002receiverBinding\u4e0d\u80fd\u767b\u8bb0\u65b0Owner\u3002\u5173\u7cfb\u4fdd\u6301INSTRUCTION_BOUND\uff0c\u4e0d\u58f0\u79f0\u5de5\u5177\u8ba4\u8bc1\u63d0\u793a\uff1b\u5177\u4f53\u5b57\u6bb5\u552f\u4e00TOOL_CONTRACT\uff0c\u5065\u5eb7\u7eed\u4f5c\u4e0d\u91cd\u590d\u7ed1\u5b9a\u3002\n\n\u5bbf\u4e3b\u660e\u786e\u8981\u6c42\u521b\u5efa\u540e\u9996\u6b21\u8fdb\u5ea6\u89c2\u5bdf\u65f6\uff0c\u5728\u53d6\u5f97\u771f\u5b9e\u53ef\u7528ID\u540e\u4ec5\u505a\u4e00\u6b21\u7acb\u5373\u5feb\u7167\uff0c\u672a\u5c31\u7eea\u7ed3\u675f\u672c\u8f6e\uff1b\u8d85\u65f6/commentary\u4e0d\u89e6\u53d1\u7ee7\u7eed\u7b49\u5f85\u3002\u5f53\u524d\u547d\u4ee4\u5fc5\u8981\u7b49\u5f85\u4e0epeer\u7b49\u5f85\u5206\u5f00\uff0c\u540e\u8005\u9075\u5faaTASK\u3002\u4f1a\u8bdd\u7ee7\u7eed\u3001\u91ca\u653e\u4e0e\u5e94\u5f52\u6863\u6761\u4ef6\u53d6TASK\uff1b\u843d\u5b9e\u65f6\u7528\u771f\u5b9eID\u8c03\u7528\u6807\u9898/\u5f52\u6863\u5de5\u5177\u5e76\u6838\u5bf9\u5bbf\u4e3b\u8fd4\u56de\uff0c\u6807\u9898\u4e0d\u53d1\u9001\u5de5\u4f5c\u6307\u4ee4\uff0c\u4efb\u52a1\u5361\u5f52\u6863\u4e0d\u66ff\u4ee3\u4f1a\u8bdd\u5f52\u6863\u3002\u5b9e\u9645\u4ea4\u5ba1\u4f9d\u8d56\u987a\u5e8f\u552f\u4e00\u53d6REVIEW_AND_EVIDENCE\u3002","orderedDependencies":[]}],"declarationIdentity":"1128|A7BE0B7E10122246F80D24F1EA1147779BBA0EB3BE8F7E1E8530D7BD7B381DEC"},{"requirementId":"framework:PR_COMPACT_NON_INTERRUPT_DELIVERY","source":"FRAMEWORK","ownerModule":"HOST_CODEX.md","semanticApplicability":"DETERMINISTIC","fullText":"\u901a\u7528\u7ec8\u6001\u3001\u6d88\u8d39\u8005\u3001Controller\u4f8b\u5916\u548c\u7b49\u5f85\u53d6TASK\uff1b\u672c\u5757\u53ea\u6620\u5c04Codex\u771f\u5b9e\u6295\u9012\