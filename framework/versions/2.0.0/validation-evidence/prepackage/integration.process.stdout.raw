3a5\u5b8c\u6210\uff0c\u9879\u76ee\u6301\u7eed\u4e8b\u5b9e\u7531Controller\u7ef4\u62a4\u3002\u53d1\u73b0\u4efb\u52a1\u6216Controller\u7684\u5728\u9014\u8f6c\u6362\u6807\u8bb0\u65f6\uff0c\u5148\u6cbfRECOVERY_CORE\u548cTOOL_CONTRACT\u6062\u590d\u539f\u4e8b\u52a1\uff0c\u4e0d\u80fd\u7528\u65b0\u7684\u5361\u7247\u6216\u6388\u6743\u8ffd\u8ba4\u672a\u95ed\u5408\u5199\u5165\u3002","preparationRequirements":["DOMAIN_TASK_OWNER_BOUND"],"resultRequirements":["DIRECT_CONSUMER_BOUND"],"selectorIdentity":"445|6549ED3854A8D18903C7D98B457BF5A1B32583DCF80C6AE38A99FB4AF96CD8D3","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\PROJECT_CONTROL.md","sourceIdentity":"9905|494BD73F695661DB53B1EBB1CD83380D1C4820862B9740D2502587D7E5FC9AD6","fullText":"\u9879\u76ee\u91c7\u7528\u52a0\u8f7d\u76ee\u6807starter\u548c\u4efb\u52a1\u5408\u540c\uff0c\u4e0d\u6279\u91cf\u91cd\u5199\u5df2\u6709\u4efb\u52a1\u6216\u4f1a\u8bdd\u3002\u5f53\u524d\u6210\u679c\u7684Owner\u3001\u6267\u884c\u8def\u7ebf\u53ca\u4e34\u65f6\u4e3b\u4f53\u6309TASK_AND_SCOPE\u7ed1\u5b9a\uff1b\u7b7e\u53d1\u4e0e\u771f\u6b63Controller\u4f8b\u5916\u53ea\u53d6AUTHORIZATION_MODEL\uff0c\u4e0d\u56e0\u65b0\u5305\u6216\u4e34\u65f6\u8d44\u6e90\u53d8\u5316\u5f3a\u5236\u4e3b\u63a7\u4e2d\u8f6c\u3002\n\n\u9879\u76ee\u7ed3\u679c\u6d88\u8d39\u7531\u5f53\u524d\u6709\u9650\u6210\u679c\u8d23\u4efb\u4eba\u76f4\u63a5\u5b8c\u6210\uff0c\u9879\u76ee\u6301\u7eed\u4e8b\u5b9e\u7531Controller\u7ef4\u62a4\u3002\u53d1\u73b0\u4efb\u52a1\u6216Controller\u7684\u5728\u9014\u8f6c\u6362\u6807\u8bb0\u65f6\uff0c\u5148\u6cbfRECOVERY_CORE\u548cTOOL_CONTRACT\u6062\u590d\u539f\u4e8b\u52a1\uff0c\u4e0d\u80fd\u7528\u65b0\u7684\u5361\u7247\u6216\u6388\u6743\u8ffd\u8ba4\u672a\u95ed\u5408\u5199\u5165\u3002","orderedDependencies":[]}],"declarationIdentity":"896|25820F9E8CBC16F98BD24CA6E5FFE4DBCA2E8EEECA71ECEBB5223282FAD75F90"},{"requirementId":"framework:PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES","source":"FRAMEWORK","ownerModule":"RECOVERY_CORE.md","semanticApplicability":"DETERMINISTIC","fullText":"DISCOVER\u9a8c\u8bc1\u5fc5\u8981\u5168\u5c40\u4e09\u6e90\u58f0\u660e\u4e0e\u5f53\u524d\u6743\u5a01\uff0c\u6309\u540c\u4e00\u771f\u5b9eIntent\u9009\u62e9\uff0c\u518d\u9a8c\u8bc1\u547d\u4e2d\u89c4\u5219\u7684\u5b8c\u6574\u516c\u5171\u6761\u4ef6\u3001\u4f9d\u8d56\u548c\u6b63\u6587\uff0c\u8fd4\u56de\u5f53\u524d\u4e49\u52a1\u53ca\u6240\u9700\u5168\u6587\uff0c\u4e0d\u6388\u6743\u3002\u672a\u547d\u4e2d\u7684\u72ec\u7acb\u5916\u90e8\u6b63\u6587\u4e0d\u8bfb\u53d6\uff0c\u4e0d\u8bc1\u660e\u5176\u5065\u5eb7\uff1b\u771f\u5b9e\u91c7\u7528/\u53d8\u66f4\u8fb9\u754c\u4ecd\u9a8c\u8bc1\u5b8c\u6574\u76ee\u6807\u96c6\u5408\u3002\u6309\u6b21\u53d7\u6cbb\u7406\u52a8\u4f5c\u5404\u81eachecker/ADMIT\uff0c\u6b63\u5f0f\u8f93\u51fa\u6309\u771f\u5b9e\u7ed3\u679c\u548c\u6d88\u8d39\u8005FINALIZE\uff1bPROJECT_PREAUTHORIZED\u8986\u76d6\u5185\u666e\u901a\u5916\u90e8\u5de5\u5177\u8c03\u7528\u6cbf\u5f53\u524d\u9879\u76ee\u8bb8\u53ef\u76f4\u63a5\u6267\u884c\u5e76\u4fdd\u539f\u5de5\u5177\u8fd4\u56de\uff0c\u4e0d\u9010\u6b21\u91cd\u5efaD/A/F\u3002\u6ca1\u6709\u9002\u7528\u4efb\u52a1\u7684\u5408\u6cd5\u53ea\u8bfb\u89e3\u91ca\u3001\u67e5\u8bc1\u548c\u65b9\u6848\u53ef\u7ec4\u6210\u4e00\u4e2a\u6709\u754cNONE\u6279\u6b21\uff0c\u4e0d\u9010\u6587\u4ef6ADMIT\u6216\u7f16\u9020\u4efb\u52a1\uff1b\u8f6c\u4e3a\u771f\u5b9e\u526f\u4f5c\u7528\u3001\u6b63\u5f0f\u5ba1\u6838\u6216\u65b0\u8fb9\u754c\u65f6\u6309\u5b9e\u9645\u6a21\u5f0f\u91cd\u65b0\u5224\u65ad\uff1b\u9879\u76ee\u9884\u6388\u6743\u76f4\u63a5\u8c03\u7528\u4e0d\u91cd\u590d\u52a8\u4f5c\u5305\u94fe\uff0c\u5176\u4ed6\u52a8\u4f5c\u4ecd\u72ec\u7acb\u51c6\u5165\u3002\n\n\u5206\u5f00\u5904\u7406\u6765\u6e90\u7ec4\u5408\u3001\u5f53\u524d\u52a8\u4f5c\u51b3\u5b9a\u53ca\u6b63\u6587\u53ef\u7528\u6027\uff1a\u6765\u6e90/\u89c4\u8303\u5355\u5143\u53ca\u6709\u5e8f\u4f9d\u8d56\u7684\u53d8\u5316\u91cd\u7ed1\u76f8\u5e94\u5185\u5bb9\uff0c\u6743\u9650\u3001\u4efb\u52a1\u8def\u7ebf\u3001\u9636\u6bb5\u3001\u51b3\u5b9a\u6216\u6267\u884c\u76ee\u6807\u53d8\u5316\u91cd\u9a8c\u5f53\u524d\u52a8\u4f5c\uff1bfresh\u5305\u3001\u5de5\u5177\u8c03\u7528\u3001\u6b63\u5e38\u8fdb\u5c55\u548c\u5df2\u6388\u6743\u540e\u50cf\u672c\u8eab\u4e0d\u8981\u6c42\u5168\u90e8\u91cd\u8bfb\u3002scoped\u6765\u6e90\u8eab\u4efd\u53ea\u8bc1\u660e\u5f53\u524d\u5b8c\u6574\u9009\u62e9\u95ed\u5305\uff1b\u6388\u6743/\u4e0d\u53ef\u53d8\u5bf9\u8c61\u53ca\u5b9e\u9645\u6d88\u8d39\u6210\u5458\u4ecd\u6309\u5404\u81ea\u5b8c\u6574\u5b57\u8282\u4e25\u683c\u6838\u5bf9\u3002\n\n\u9996\u6b21\u3001\u538b\u7f29\u3001\u6362\u4e3b\u4f53\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8bf7\u6c42FULL\uff0c\u6309\u5f53\u524d\u610f\u56fe\u9009\u62e9\u5b8c\u6574\u6761\u4ef6\u4e0e\u4f9d\u8d56\uff0c\u540c\u6b21\u53bb\u91cd\u540e\u7ec4\u88c5\u5168\u90e8\u5f53\u524d\u5fc5\u9700\u6b63\u6587\u3002\u5de5\u4f5c\u6d3b\u52a8\u4e0e\u6743\u9650\u64cd\u4f5c\u5206\u522b\u5224\u65ad\uff1a\u5b9e\u73b0\u4e2d\u7684\u8bfb\u53d6\u3001\u6e90\u7801/\u6d4b\u8bd5\u4ee3\u7801\u4fee\u6539\u548c\u8bb0\u5f55\u53ef\u5c5e\u4e8e\u540c\u4e00\u6d3b\u52a8\uff1b\u8fdb\u5165\u5b9e\u9645TEST_RUN\u3001\u81ea\u67e5\u3001\u5ba1\u6838\u6216\u7531\u9a8c\u8bc1\u8f6c\u8fd4\u4fee\u662f\u6d3b\u52a8\u5207\u6362\uff0c\u987b\u5b8c\u6574\u52a0\u8f7d\u3002\u65b0\u589e\u9002\u7528\u8981\u6c42\u3001\u771f\u5b9e\u4efb\u52a1\u8def\u7ebf\u6216\u6765\u6e90\u5b9e\u53d8\u540c\u6837FULL\u3002\u9000\u51facoverage\u5dee\u96c6\u6267\u884c\u548c\u672a\u6765\u6b63\u6587\u9884\u8f7d\uff1b\u65e7REUSE\u4ec5\u517c\u5bb9\u4e3aFULL\uff0c\u4e0d\u6253\u5f00previousCoverageRef\uff0c\u4e0d\u8fd4\u56deREUSED\u96f6\u6b63\u6587\u6216DELTA\u5c40\u90e8\u6b63\u6587\u3002coverage\u4ec5\u4e3a\u672c\u6b21\u6765\u6e90\u7d22\u5f15\uff0c\u4e0d\u8bc1\u660e\u6a21\u578b\u8bb0\u5fc6\u6216attention\uff0c\u4e0d\u8981\u6c42\u5bbf\u4e3b\u63d0\u4f9b\u4e0d\u5b58\u5728\u7684\u201c\u5f53\u524d\u6a21\u578b\u6301\u6709\u5168\u6587\u8bc1\u660e\u201d\u3002\u771f\u5b9e\u6765\u6e90\u62d2\u7edd\u3001\u64a4\u6743\u3001\u4fdd\u62a4\u6216\u672a\u5b8c\u91c7\u7528\u4e0d\u80fd\u4ee5FULL\u53d8\u6210PASS\u3002\n\n\u540c\u4e00\u5065\u5eb7\u5de5\u4f5c\u6d3b\u52a8\u4e2d\u7684\u666e\u901a\u6587\u4ef6\u3001\u5305\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\uff0c\u5148\u7ecf\u539fchecker/ADMIT\u6838\u5f53\u524d\u6743\u9650\u3001\u8303\u56f4\u3001\u771f\u5b9e\u4efb\u52a1\u8def\u7ebf\u53ca\u6765\u6e90\u3002\u5b8c\u6574\u52a0\u8f7d\u96c6\u5408\u4fdd\u7559\u672c\u6d3b\u52a8\u5fc5\u8981\u6b63\u6587\uff0c\u5f53\u524d\u4e49\u52a1\u7531\u540c\u4e00\u9009\u62e9\u5668\u6309\u6b64\u523b\u64cd\u4f5c\u91cd\u7b97\uff1b\u4e49\u52a1\u9000\u51fa\u4e0d\u5220\u9664\u5df2\u8bfb\u6b63\u6587\uff0c\u5df2\u8bfb\u89c4\u5219\u518d\u6b21\u9002\u7528\u4e5f\u4e0d\u7b49\u4e8e\u65b0\u589e\u6b63\u6587\u3002\u5f53\u524d\u5fc5\u8981\u6b63\u6587\u4ecd\u5168\u90e8\u5728\u539fFULL\u5b9e\u9645\u8bfb\u53d6\u96c6\u5408\u5185\uff0c\u4e14\u6765\u6e90\u3001\u6d3b\u52a8\u53ca\u771f\u5b9e\u8def\u7ebf\u672a\u53d8\u65f6\uff0c\u53ea\u91cd\u7ed1\u5f53\u524d\u64cd\u4f5c\uff0c\u4e0d\u8c03\u7528\u6b63\u6587\u88c5\u914d\u6216\u663e\u793a\u3002\u65b0\u589e\u5fc5\u8981\u6b63\u6587\u3001\u6765\u6e90/\u6d3b\u52a8/\u8def\u7ebf\u53d8\u5316\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8fd4\u56deRULE_LOAD_REQUIRED\u5e76\u5b8c\u6574\u52a0\u8f7d\uff1b\u672a\u77e5\u6743\u9650\u53ca\u4fdd\u62a4\u4ecd\u72ec\u7acb\u62d2\u7edd\u3002\u4fdd\u5b58\u7684\u65b0compact\u4ee5\u5f53\u524d\u5b8c\u6574selectedObligations\u7ed1\u5b9araw\u3001view\u3001identity\u53ca\u539fFINALIZE\uff0c\u542b\u7a7a\u4e49\u52a1\u884c\uff1b\u5386\u53f2\u6d88\u8d39\u8005\u8bfb\u53d6\u539f\u51bb\u7ed3\u4e49\u52a1\uff0c\u4e0d\u4ee5\u4eca\u65e5policy\u91cd\u7b97\u65e7\u6210\u529f\u3002\u4e0d\u80fd\u5148\u88c5\u914d\u5168\u6587\u518d\u4ee5\u96f6\u8f93\u51fa\u58f0\u79f0\u590d\u7528\uff0c\u4e0d\u9884\u8f7d\u672a\u6765\u6d3b\u52a8\uff0c\u4e0d\u589e\u52a0\u7f13\u5b58\u3001\u53f0\u8d26\u6216\u6a21\u578b\u8bb0\u5fc6\u8bc1\u660e\u3002\u7cbe\u786eB/O\u96c6\u5408\u3001\u683c\u5f0f\u53ca\u91cd\u7ed1\u5b9a\u6761\u4ef6\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\n\n\u6a21\u578b\u89c6\u56fe\u4ee5\u5355\u4e00text\u8f93\u51fa\u6a21\u5f0f\u3001\u771f\u5b9e\u517c\u5bb9\u8bf4\u660e\u4e0e\u9650\u5236\u3001\u77ed\u6765\u6e90\u3001\u6bcf\u89c4\u5219\u6709\u5e8f\u77ed\u5f15\u7528\u548c\u5f53\u524d\u4e49\u52a1\uff1b\u540c\u6b21\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\u53ea\u663e\u793a\u4e00\u6b21\uff0c\u4e0d\u88c1\u526a\u6761\u4ef6\u3001\u4f9d\u8d56\u6216\u91cd\u53e0\u6b63\u6587\u3002\u673a\u5668\u6765\u6e90\u7d22\u5f15\u7559\u7a0b\u5e8f\u4fa7\u3002\u8c03\u7528\u524d\u4e3a\u5916\u5c42\u7f16\u6392\u548c\u5185\u5c42\u547d\u4ee4\u6309\u5b8c\u6574\u6b63\u6587\u5206\u522b\u7559\u8db3\u9884\u7b97\uff0c\u63d0\u5347\u5185\u5c42\u4e0d\u6539\u53d8\u5916\u5c42\uff1b\u53ea\u66b4\u9732\u4e00\u4efd\u5b98\u65b9text\uff0c\u4e0d\u6df7\u5165\u673a\u5668JSON\u6216\u5176\u4ed6\u957f\u8f93\u51fa\u3002\u9ed8\u8ba4\u4e00\u6b21\u5b8c\u6574\u8f93\u51fa\uff1b\u5b9e\u9645\u5bbf\u4e3b\u622a\u65ad\u65f6\u4ece\u540c\u4e00\u7ed3\u679c\u8865\u8bfb\u771f\u5b9e\u7f3a\u5931\u7684\u5b8c\u6574\u5355\u5143\u53ca\u4e49\u52a1\uff0c\u4e0d\u4e3b\u52a8\u5206\u9875\u3001\u4e0d\u5efa\u9875\u7968\u636e\u3001\u4e0d\u91cd\u8dd1\u9009\u62e9\u3002\u5931\u8d25\u548c\u672a\u77e5\u4fdd\u7559\uff0c\u4e0d\u80fd\u53d8\u6210\u7a7a\u89c4\u5219\u6210\u529f\u3002summary\u3001hash\u3001\u65e7receipt\u6216\u673a\u68b0PASS\u4e0d\u80fd\u66ff\u4ee3\u5b9e\u9645\u7f3a\u5931\u6b63\u6587\u3002\n\n\u5b9e\u9645\u5bbf\u4e3b\u8de8\u8fdb\u7a0b\u7f16\u7801/\u8f93\u51fa\u9650\u5236\u9700\u8981\u65f6\uff0c\u6309TOOL_CONTRACT\u5728\u540c\u6b21DISCOVER\u663e\u5f0f\u4fdd\u7559\u5b98\u65b9UTF-8 text\u526f\u672c\uff08DisplayPath\uff09\uff1b\u673a\u5668AsJson\u7531\u7a0b\u5e8f\u6355\u83b7\uff0c\u4e0d\u6253\u5370\u7ed9\u6a21\u578b\u3002\u8865\u6587\u53ea\u6d88\u8d39\u540c\u4e00\u7ed3\u679c/\u5b98\u65b9\u526f\u672c\uff0c\u4e0d\u91cd\u8dd1\u89e3\u6790\u6216\u91cd\u626b\u9879\u76ee\u6e90\u6587\u4ef6\uff1b\u9ed8\u8ba4\u4e0d\u4fdd\u5b58\u3001\u4e0d\u5206\u9875\uff0c\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u6309\u539fruntime\u751f\u547d\u5468\u671f\u91ca\u653e\u3002\u65e7\u56fa\u5b9a\u7248\u672c\u4f7f\u7528\u540c\u6b21AsJson\u7ed3\u679c\u53ca\u539f\u5b98\u65b9renderer\uff0c\u4e0d\u70ed\u6539\u8fd0\u884c\u5305\u3002\n\n\u8f93\u5165\u3001compact\u3001continuation\u53ca\u6b63\u5f0f\u8bc1\u636e\u7684\u5b58\u653e/\u6e05\u7406\u53d6TOOL_CONTRACT\uff1b\u6700\u540e\u6d88\u8d39\u8005\u672a\u5b8c\u6210\u524d\u4fdd\u7559\u5176\u539f\u5f15\u7528\u3002\u8fd9\u91cc\u4e0d\u65b0\u589e\u7f13\u5b58\u53f0\u8d26\u3001\u610f\u56fe\u670d\u52a1\u6216\u6a21\u578b\u8bf7\u6c42\u6b65\u9aa4\u3002\u7ed3\u6784\u901a\u8fc7\u4e0d\u8bc1\u660e\u8bed\u4e49\u6b63\u786e\u6216\u5b9e\u9645\u5bbf\u4e3b\u6267\u884c\u3002\n\u4ec5\u672c\u6b21\u5b9e\u9645NONE\u3001\u65e0\u5305\u65e0\u526f\u4f5c\u7528\uff0c\u5411\u5f53\u524dUSER\u4f5c\u666e\u901aPLAN/USER_RESPONSE\uff0c\u4e14\u65e0\u6b63\u5f0fReview/\u63a5\u53d7\u3001TASK_MESSAGE\u3001\u5173\u95ed/\u8d23\u4efb\u8f6c\u6362\u6216continuation\u6d88\u8d39\u8005\u65f6\uff0c\u53ef\u7701\u72ec\u7acb\u673a\u68b0FINALIZE\u3002\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u89c4\u5219\u4ecd\u5b9e\u9645\u8bfb\u53d6\uff0c\u4e8b\u5b9e/\u6765\u6e90/\u9650\u5236/\u672a\u77e5\u4ecd\u5982\u5b9e\u8bf4\u660e\uff1b\u4e0d\u4ea7\u751f\u5047PASS\u6216\u53ef\u88ab\u540e\u7ee7\u501f\u7528\u7684\u6210\u529f\u6536\u636e\u3002\u4efb\u4e00\u6761\u4ef6\u4e0d\u7b26\u4ecd\u8d70\u539f\u6536\u53e3\uff1bPROJECT_PREAUTHORIZED\u76f4\u63a5\u5de5\u5177\u8c03\u7528\u6309AUTHORIZATION_MODEL\u4fdd\u539f\u8fd4\u56de\u5e76\u81ea\u7136\u4ea4\u4ed8\uff0c\u4e0d\u4f2a\u9020\u673a\u68b0\u6536\u636e\u3002\u771f\u5b9eTASK_MESSAGE\u3001\u6b63\u5f0fReview/\u63a5\u53d7\u6216\u8d23\u4efb\u8f6c\u6362\u4ecd\u6ee1\u8db3\u5404\u81ea\u95e8\uff1b\u663e\u5f0fFINALIZE\u516c\u5171\u5165\u53e3\u4fdd\u6301\u4e25\u683c\u3002\n\n\u8d28\u91cf\u7b56\u7565\u542f\u7528\u4e0d\u6539\u53d8\u56fa\u5b9a\u8fd0\u884c\u6765\u6e90\u6216\u6062\u590d\u6743\u5a01\uff1b\u5f53\u524d\u4e0e\u539f\u6210\u529f\u5386\u53f2\u5206\u522b\u6309TOOL_CONTRACT\u6838\u7ed1\u5b9a\uff0c\u4e0d\u80fd\u7528\u4eca\u65e5policy\u91cd\u7b97\u65e7\u63a5\u53d7\uff0c\u4e5f\u4e0d\u56e0C\u800c\u7ed9\u53ea\u8bfb\u95ee\u9898\u9020\u5361\u3002\n","preparationRequirements":["DISCOVER_RECEIPT_BOUND","SELECTED_RULE_BLOCKS_LOADED"],"resultRequirements":["BOUNDARY_RECEIPT_REUSED"],"selectorIdentity":"225|00AFDA43FF5054E997C982EA1FA60FD16FB9840B89561F1EF6C88ED8980BAF33","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","sourceIdentity":"9991|2AF5E3F3573B6FC1327D460081C7207C12E492BCD79B8608A4C6F429A4554BF4","fullText":"DISCOVER\u9a8c\u8bc1\u5fc5\u8981\u5168\u5c40\u4e09\u6e90\u58f0\u660e\u4e0e\u5f53\u524d\u6743\u5a01\uff0c\u6309\u540c\u4e00\u771f\u5b9eIntent\u9009\u62e9\uff0c\u518d\u9a8c\u8bc1\u547d\u4e2d\u89c4\u5219\u7684\u5b8c\u6574\u516c\u5171\u6761\u4ef6\u3001\u4f9d\u8d56\u548c\u6b63\u6587\uff0c\u8fd4\u56de\u5f53\u524d\u4e49\u52a1\u53ca\u6240\u9700\u5168\u6587\uff0c\u4e0d\u6388\u6743\u3002\u672a\u547d\u4e2d\u7684\u72ec\u7acb\u5916\u90e8\u6b63\u6587\u4e0d\u8bfb\u53d6\uff0c\u4e0d\u8bc1\u660e\u5176\u5065\u5eb7\uff1b\u771f\u5b9e\u91c7\u7528/\u53d8\u66f4\u8fb9\u754c\u4ecd\u9a8c\u8bc1\u5b8c\u6574\u76ee\u6807\u96c6\u5408\u3002\u6309\u6b21\u53d7\u6cbb\u7406\u52a8\u4f5c\u5404\u81eachecker/ADMIT\uff0c\u6b63\u5f0f\u8f93\u51fa\u6309\u771f\u5b9e\u7ed3\u679c\u548c\u6d88\u8d39\u8005FINALIZE\uff1bPROJECT_PREAUTHORIZED\u8986\u76d6\u5185\u666e\u901a\u5916\u90e8\u5de5\u5177\u8c03\u7528\u6cbf\u5f53\u524d\u9879\u76ee\u8bb8\u53ef\u76f4\u63a5\u6267\u884c\u5e76\u4fdd\u539f\u5de5\u5177\u8fd4\u56de\uff0c\u4e0d\u9010\u6b21\u91cd\u5efaD/A/F\u3002\u6ca1\u6709\u9002\u7528\u4efb\u52a1\u7684\u5408\u6cd5\u53ea\u8bfb\u89e3\u91ca\u3001\u67e5\u8bc1\u548c\u65b9\u6848\u53ef\u7ec4\u6210\u4e00\u4e2a\u6709\u754cNONE\u6279\u6b21\uff0c\u4e0d\u9010\u6587\u4ef6ADMIT\u6216\u7f16\u9020\u4efb\u52a1\uff1b\u8f6c\u4e3a\u771f\u5b9e\u526f\u4f5c\u7528\u3001\u6b63\u5f0f\u5ba1\u6838\u6216\u65b0\u8fb9\u754c\u65f6\u6309\u5b9e\u9645\u6a21\u5f0f\u91cd\u65b0\u5224\u65ad\uff1b\u9879\u76ee\u9884\u6388\u6743\u76f4\u63a5\u8c03\u7528\u4e0d\u91cd\u590d\u52a8\u4f5c\u5305\u94fe\uff0c\u5176\u4ed6\u52a8\u4f5c\u4ecd\u72ec\u7acb\u51c6\u5165\u3002\n\n\u5206\u5f00\u5904\u7406\u6765\u6e90\u7ec4\u5408\u3001\u5f53\u524d\u52a8\u4f5c\u51b3\u5b9a\u53ca\u6b63\u6587\u53ef\u7528\u6027\uff1a\u6765\u6e90/\u89c4\u8303\u5355\u5143\u53ca\u6709\u5e8f\u4f9d\u8d56\u7684\u53d8\u5316\u91cd\u7ed1\u76f8\u5e94\u5185\u5bb9\uff0c\u6743\u9650\u3001\u4efb\u52a1\u8def\u7ebf\u3001\u9636\u6bb5\u3001\u51b3\u5b9a\u6216\u6267\u884c\u76ee\u6807\u53d8\u5316\u91cd\u9a8c\u5f53\u524d\u52a8\u4f5c\uff1bfresh\u5305\u3001\u5de5\u5177\u8c03\u7528\u3001\u6b63\u5e38\u8fdb\u5c55\u548c\u5df2\u6388\u6743\u540e\u50cf\u672c\u8eab\u4e0d\u8981\u6c42\u5168\u90e8\u91cd\u8bfb\u3002scoped\u6765\u6e90\u8eab\u4efd\u53ea\u8bc1\u660e\u5f53\u524d\u5b8c\u6574\u9009\u62e9\u95ed\u5305\uff1b\u6388\u6743/\u4e0d\u53ef\u53d8\u5bf9\u8c61\u53ca\u5b9e\u9645\u6d88\u8d39\u6210\u5458\u4ecd\u6309\u5404\u81ea\u5b8c\u6574\u5b57\u8282\u4e25\u683c\u6838\u5bf9\u3002\n\n\u9996\u6b21\u3001\u538b\u7f29\u3001\u6362\u4e3b\u4f53\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8bf7\u6c42FULL\uff0c\u6309\u5f53\u524d\u610f\u56fe\u9009\u62e9\u5b8c\u6574\u6761\u4ef6\u4e0e\u4f9d\u8d56\uff0c\u540c\u6b21\u53bb\u91cd\u540e\u7ec4\u88c5\u5168\u90e8\u5f53\u524d\u5fc5\u9700\u6b63\u6587\u3002\u5de5\u4f5c\u6d3b\u52a8\u4e0e\u6743\u9650\u64cd\u4f5c\u5206\u522b\u5224\u65ad\uff1a\u5b9e\u73b0\u4e2d\u7684\u8bfb\u53d6\u3001\u6e90\u7801/\u6d4b\u8bd5\u4ee3\u7801\u4fee\u6539\u548c\u8bb0\u5f55\u53ef\u5c5e\u4e8e\u540c\u4e00\u6d3b\u52a8\uff1b\u8fdb\u5165\u5b9e\u9645TEST_RUN\u3001\u81ea\u67e5\u3001\u5ba1\u6838\u6216\u7531\u9a8c\u8bc1\u8f6c\u8fd4\u4fee\u662f\u6d3b\u52a8\u5207\u6362\uff0c\u987b\u5b8c\u6574\u52a0\u8f7d\u3002\u65b0\u589e\u9002\u7528\u8981\u6c42\u3001\u771f\u5b9e\u4efb\u52a1\u8def\u7ebf\u6216\u6765\u6e90\u5b9e\u53d8\u540c\u6837FULL\u3002\u9000\u51facoverage\u5dee\u96c6\u6267\u884c\u548c\u672a\u6765\u6b63\u6587\u9884\u8f7d\uff1b\u65e7REUSE\u4ec5\u517c\u5bb9\u4e3aFULL\uff0c\u4e0d\u6253\u5f00previousCoverageRef\uff0c\u4e0d\u8fd4\u56deREUSED\u96f6\u6b63\u6587\u6216DELTA\u5c40\u90e8\u6b63\u6587\u3002coverage\u4ec5\u4e3a\u672c\u6b21\u6765\u6e90\u7d22\u5f15\uff0c\u4e0d\u8bc1\u660e\u6a21\u578b\u8bb0\u5fc6\u6216attention\uff0c\u4e0d\u8981\u6c42\u5bbf\u4e3b\u63d0\u4f9b\u4e0d\u5b58\u5728\u7684\u201c\u5f53\u524d\u6a21\u578b\u6301\u6709\u5168\u6587\u8bc1\u660e\u201d\u3002\u771f\u5b9e\u6765\u6e90\u62d2\u7edd\u3001\u64a4\u6743\u3001\u4fdd\u62a4\u6216\u672a\u5b8c\u91c7\u7528\u4e0d\u80fd\u4ee5FULL\u53d8\u6210PASS\u3002\n\n\u540c\u4e00\u5065\u5eb7\u5de5\u4f5c\u6d3b\u52a8\u4e2d\u7684\u666e\u901a\u6587\u4ef6\u3001\u5305\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\uff0c\u5148\u7ecf\u539fchecker/ADMIT\u6838\u5f53\u524d\u6743\u9650\u3001\u8303\u56f4\u3001\u771f\u5b9e\u4efb\u52a1\u8def\u7ebf\u53ca\u6765\u6e90\u3002\u5b8c\u6574\u52a0\u8f7d\u96c6\u5408\u4fdd\u7559\u672c\u6d3b\u52a8\u5fc5\u8981\u6b63\u6587\uff0c\u5f53\u524d\u4e49\u52a1\u7531\u540c\u4e00\u9009\u62e9\u5668\u6309\u6b64\u523b\u64cd\u4f5c\u91cd\u7b97\uff1b\u4e49\u52a1\u9000\u51fa\u4e0d\u5220\u9664\u5df2\u8bfb\u6b63\u6587\uff0c\u5df2\u8bfb\u89c4\u5219\u518d\u6b21\u9002\u7528\u4e5f\u4e0d\u7b49\u4e8e\u65b0\u589e\u6b63\u6587\u3002\u5f53\u524d\u5fc5\u8981\u6b63\u6587\u4ecd\u5168\u90e8\u5728\u539fFULL\u5b9e\u9645\u8bfb\u53d6\u96c6\u5408\u5185\uff0c\u4e14\u6765\u6e90\u3001\u6d3b\u52a8\u53ca\u771f\u5b9e\u8def\u7ebf\u672a\u53d8\u65f6\uff0c\u53ea\u91cd\u7ed1\u5f53\u524d\u64cd\u4f5c\uff0c\u4e0d\u8c03\u7528\u6b63\u6587\u88c5\u914d\u6216\u663e\u793a\u3002\u65b0\u589e\u5fc5\u8981\u6b63\u6587\u3001\u6765\u6e90/\u6d3b\u52a8/\u8def\u7ebf\u53d8\u5316\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8fd4\u56deRULE_LOAD_REQUIRED\u5e76\u5b8c\u6574\u52a0\u8f7d\uff1b\u672a\u77e5\u6743\u9650\u53ca\u4fdd\u62a4\u4ecd\u72ec\u7acb\u62d2\u7edd\u3002\u4fdd\u5b58\u7684\u65b0compact\u4ee5\u5f53\u524d\u5b8c\u6574selectedObligations\u7ed1\u5b9araw\u3001view\u3001identity\u53ca\u539fFINALIZE\uff0c\u542b\u7a7a\u4e49\u52a1\u884c\uff1b\u5386\u53f2\u6d88\u8d39\u8005\u8bfb\u53d6\u539f\u51bb\u7ed3\u4e49\u52a1\uff0c\u4e0d\u4ee5\u4eca\u65e5policy\u91cd\u7b97\u65e7\u6210\u529f\u3002\u4e0d\u80fd\u5148\u88c5\u914d\u5168\u6587\u518d\u4ee5\u96f6\u8f93\u51fa\u58f0\u79f0\u590d\u7528\uff0c\u4e0d\u9884\u8f7d\u672a\u6765\u6d3b\u52a8\uff0c\u4e0d\u589e\u52a0\u7f13\u5b58\u3001\u53f0\u8d26\u6216\u6a21\u578b\u8bb0\u5fc6\u8bc1\u660e\u3002\u7cbe\u786eB/O\u96c6\u5408\u3001\u683c\u5f0f\u53ca\u91cd\u7ed1\u5b9a\u6761\u4ef6\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\n\n\u6a21\u578b\u89c6\u56fe\u4ee5\u5355\u4e00text\u8f93\u51fa\u6a21\u5f0f\u3001\u771f\u5b9e\u517c\u5bb9\u8bf4\u660e\u4e0e\u9650\u5236\u3001\u77ed\u6765\u6e90\u3001\u6bcf\u89c4\u5219\u6709\u5e8f\u77ed\u5f15\u7528\u548c\u5f53\u524d\u4e49\u52a1\uff1b\u540c\u6b21\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\u53ea\u663e\u793a\u4e00\u6b21\uff0c\u4e0d\u88c1\u526a\u6761\u4ef6\u3001\u4f9d\u8d56\u6216\u91cd\u53e0\u6b63\u6587\u3002\u673a\u5668\u6765\u6e90\u7d22\u5f15\u7559\u7a0b\u5e8f\u4fa7\u3002\u8c03\u7528\u524d\u4e3a\u5916\u5c42\u7f16\u6392\u548c\u5185\u5c42\u547d\u4ee4\u6309\u5b8c\u6574\u6b63\u6587\u5206\u522b\u7559\u8db3\u9884\u7b97\uff0c\u63d0\u5347\u5185\u5c42\u4e0d\u6539\u53d8\u5916\u5c42\uff1b\u53ea\u66b4\u9732\u4e00\u4efd\u5b98\u65b9text\uff0c\u4e0d\u6df7\u5165\u673a\u5668JSON\u6216\u5176\u4ed6\u957f\u8f93\u51fa\u3002\u9ed8\u8ba4\u4e00\u6b21\u5b8c\u6574\u8f93\u51fa\uff1b\u5b9e\u9645\u5bbf\u4e3b\u622a\u65ad\u65f6\u4ece\u540c\u4e00\u7ed3\u679c\u8865\u8bfb\u771f\u5b9e\u7f3a\u5931\u7684\u5b8c\u6574\u5355\u5143\u53ca\u4e49\u52a1\uff0c\u4e0d\u4e3b\u52a8\u5206\u9875\u3001\u4e0d\u5efa\u9875\u7968\u636e\u3001\u4e0d\u91cd\u8dd1\u9009\u62e9\u3002\u5931\u8d25\u548c\u672a\u77e5\u4fdd\u7559\uff0c\u4e0d\u80fd\u53d8\u6210\u7a7a\u89c4\u5219\u6210\u529f\u3002summary\u3001hash\u3001\u65e7receipt\u6216\u673a\u68b0PASS\u4e0d\u80fd\u66ff\u4ee3\u5b9e\u9645\u7f3a\u5931\u6b63\u6587\u3002\n\n\u5b9e\u9645\u5bbf\u4e3b\u8de8\u8fdb\u7a0b\u7f16\u7801/\u8f93\u51fa\u9650\u5236\u9700\u8981\u65f6\uff0c\u6309TOOL_CONTRACT\u5728\u540c\u6b21DISCOVER\u663e\u5f0f\u4fdd\u7559\u5b98\u65b9UTF-8 text\u526f\u672c\uff08DisplayPath\uff09\uff1b\u673a\u5668AsJson\u7531\u7a0b\u5e8f\u6355\u83b7\uff0c\u4e0d\u6253\u5370\u7ed9\u6a21\u578b\u3002\u8865\u6587\u53ea\u6d88\u8d39\u540c\u4e00\u7ed3\u679c/\u5b98\u65b9\u526f\u672c\uff0c\u4e0d\u91cd\u8dd1\u89e3\u6790\u6216\u91cd\u626b\u9879\u76ee\u6e90\u6587\u4ef6\uff1b\u9ed8\u8ba4\u4e0d\u4fdd\u5b58\u3001\u4e0d\u5206\u9875\uff0c\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u6309\u539fruntime\u751f\u547d\u5468\u671f\u91ca\u653e\u3002\u65e7\u56fa\u5b9a\u7248\u672c\u4f7f\u7528\u540c\u6b21AsJson\u7ed3\u679c\u53ca\u539f\u5b98\u65b9renderer\uff0c\u4e0d\u70ed\u6539\u8fd0\u884c\u5305\u3002\n\n\u8f93\u5165\u3001compact\u3001continuation\u53ca\u6b63\u5f0f\u8bc1\u636e\u7684\u5b58\u653e/\u6e05\u7406\u53d6TOOL_CONTRACT\uff1b\u6700\u540e\u6d88\u8d39\u8005\u672a\u5b8c\u6210\u524d\u4fdd\u7559\u5176\u539f\u5f15\u7528\u3002\u8fd9\u91cc\u4e0d\u65b0\u589e\u7f13\u5b58\u53f0\u8d26\u3001\u610f\u56fe\u670d\u52a1\u6216\u6a21\u578b\u8bf7\u6c42\u6b65\u9aa4\u3002\u7ed3\u6784\u901a\u8fc7\u4e0d\u8bc1\u660e\u8bed\u4e49\u6b63\u786e\u6216\u5b9e\u9645\u5bbf\u4e3b\u6267\u884c\u3002\n\u4ec5\u672c\u6b21\u5b9e\u9645NONE\u3001\u65e0\u5305\u65e0\u526f\u4f5c\u7528\uff0c\u5411\u5f53\u524dUSER\u4f5c\u666e\u901aPLAN/USER_RESPONSE\uff0c\u4e14\u65e0\u6b63\u5f0fReview/\u63a5\u53d7\u3001TASK_MESSAGE\u3001\u5173\u95ed/\u8d23\u4efb\u8f6c\u6362\u6216continuation\u6d88\u8d39\u8005\u65f6\uff0c\u53ef\u7701\u72ec\u7acb\u673a\u68b0FINALIZE\u3002\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u89c4\u5219\u4ecd\u5b9e\u9645\u8bfb\u53d6\uff0c\u4e8b\u5b9e/\u6765\u6e90/\u9650\u5236/\u672a\u77e5\u4ecd\u5982\u5b9e\u8bf4\u660e\uff1b\u4e0d\u4ea7\u751f\u5047PASS\u6216\u53ef\u88ab\u540e\u7ee7\u501f\u7528\u7684\u6210\u529f\u6536\u636e\u3002\u4efb\u4e00\u6761\u4ef6\u4e0d\u7b26\u4ecd\u8d70\u539f\u6536\u53e3\uff1bPROJECT_PREAUTHORIZED\u76f4\u63a5\u5de5\u5177\u8c03\u7528\u6309AUTHORIZATION_MODEL\u4fdd\u539f\u8fd4\u56de\u5e76\u81ea\u7136\u4ea4\u4ed8\uff0c\u4e0d\u4f2a\u9020\u673a\u68b0\u6536\u636e\u3002\u771f\u5b9eTASK_MESSAGE\u3001\u6b63\u5f0fReview/\u63a5\u53d7\u6216\u8d23\u4efb\u8f6c\u6362\u4ecd\u6ee1\u8db3\u5404\u81ea\u95e8\uff1b\u663e\u5f0fFINALIZE\u516c\u5171\u5165\u53e3\u4fdd\u6301\u4e25\u683c\u3002\n\n\u8d28\u91cf\u7b56\u7565\u542f\u7528\u4e0d\u6539\u53d8\u56fa\u5b9a\u8fd0\u884c\u6765\u6e90\u6216\u6062\u590d\u6743\u5a01\uff1b\u5f53\u524d\u4e0e\u539f\u6210\u529f\u5386\u53f2\u5206\u522b\u6309TOOL_CONTRACT\u6838\u7ed1\u5b9a\uff0c\u4e0d\u80fd\u7528\u4eca\u65e5policy\u91cd\u7b97\u65e7\u63a5\u53d7\uff0c\u4e5f\u4e0d\u56e0C\u800c\u7ed9\u53ea\u8bfb\u95ee\u9898\u9020\u5361\u3002\n","orderedDependencies":[]}],"declarationIdentity":"800|A818CBB29237502E223DEE53F65AF1CD87D5B0DCFEAC291648A1DD8E32930947"},{"requirementId":"framework:PR_PROTECTED_PATH_FAIL_CLOSED","source":"FRAMEWORK","ownerModule":"AUTHORIZATION_MODEL.md","semanticApplicability":"DETERMINISTIC","fullText":"protected \u6216 excluded \u7684 read/hash/diff/index/write \u8fb9\u754c\u5fc5\u987b\u7cbe\u786e\u4e14 fail closed\u3002scope \u4e3a UNKNOWN \u6216 bounded helper \u4e0d\u53ef\u7528\u65f6\uff0c\u53ea\u8fd4\u56de\u6700\u7a84 blocker\uff1b\u4e0d\u5f97\u6269\u5927\u641c\u7d22\u3001\u4f7f\u7528\u7ed5\u884c\u8bfb\u53d6\u6216\u653e\u5bbd path set\u3002","preparationRequirements":["PROTECTION_BOUNDARY_PROVEN"],"resultRequirements":["ZERO_BOUNDARY_VIOLATION"],"selectorIdentity":"225|00AFDA43FF5054E997C982EA1FA60FD16FB9840B89561F1EF6C88ED8980BAF33","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","sourceIdentity":"9011|E7A761F976853B25A8C2FDBC8FD3552B5F0354964B171DD014D06F867F6F29F1","fullText":"protected \u6216 excluded \u7684 read/hash/diff/index/write \u8fb9\u754c\u5fc5\u987b\u7cbe\u786e\u4e14 fail closed\u3002scope \u4e3a UNKNOWN \u6216 bounded helper \u4e0d\u53ef\u7528\u65f6\uff0c\u53ea\u8fd4\u56de\u6700\u7a84 blocker\uff1b\u4e0d\u5f97\u6269\u5927\u641c\u7d22\u3001\u4f7f\u7528\u7ed5\u884c\u8bfb\u53d6\u6216\u653e\u5bbd path set\u3002","orderedDependencies":[]}],"declarationIdentity":"643|1546C2C9876230A72E006ACAA513CDF4E12B31BAFC34D380DE7FF51951AE076D"},{"requirementId":"framework:PR_RECOVERY_CURRENT_AUTHORITY","source":"FRAMEWORK","ownerModule":"RECOVERY_CORE.md","semanticApplicability":"DETERMINISTIC","fullText":"\u6062\u590d\u53ea\u8bc1\u660e\u5f53\u524d\u6743\u5a01\u53ca\u4e8b\u5b9e\uff0c\u4e0d\u6388\u4e88\u5199\u3001\u6d4b\u8bd5\u3001Review\u3001Git\u3001\u6d4f\u89c8\u5668/\u8bbe\u5907\u6216\u5916\u90e8\u6743\u9650\u3002\u5148\u4ece\u660e\u786e\u9879\u76ee\u6839\u53ca\u5176AGENTS\u8fdb\u5165\u56fa\u5b9aBOOTSTRAP\uff0c\u6821\u9a8c\u771f\u5b9e\u8def\u5f84\u548c\u62d3\u6251\uff1b\u666e\u901a\u975eGit\u9879\u76ee\u4e0d\u4ee5Git\u51b3\u5b9a\u9879\u76ee\u6839\u3002\u53ef\u9009GIT_WORKTREE\u6cbf\u539f\u4efb\u52a1descriptor\u9a8c\u8bc1\u552f\u4e00controlRoot\u4e0eexecutionRoot\uff0c\u65e7\u590d\u5236\u63a7\u5236\u6750\u6599\u4e0d\u80fd\u66ff\u4ee3\u539f\u6743\u5a01\uff1bMaintenance\u4ecd\u6309\u81ea\u5df1\u7684CONTROL/TARGET\u62d3\u6251\u89e3\u6790\u3002\n\n\u8bfb\u53d6\u5f53\u524dproject\u3001Controller\u3001\u6709\u6548\u7ea0\u6b63\u3001policy\u53ca\u5fc5\u8981\u91c7\u7528\u5b8c\u6210\u4e8b\u5b9e\uff0c\u4ece\u9879\u76eepin\u548c\u539fdistribution binding\u5b9a\u4f4d\u552f\u4e00\u56fa\u5b9a\u8fd0\u884c\u6765\u6e90\uff0c\u6838\u5bf9TOOLCHAIN\u3002\u5f00\u53d1HEAD\u3001\u7f51\u7edc\u3001\u5176\u4ed6\u9879\u76ee\u6216\u4efb\u610f\u65b0\u5305\u4e0d\u4f5cfallback\u3002\u9996\u6b21/\u65b0\u6765\u6e90\u987b\u5b8c\u6574\u8d44\u683c\u9a8c\u8bc1\uff1b\u666e\u901a\u5df2\u91c7\u7528\u6765\u6e90\u6838\u771f\u5b9e\u5f53\u524d\u5b8c\u6210\u94fe\u3001\u72ec\u7acb\u56fa\u5b9a\u7ed1\u5b9a\u3001manifest\u539f\u59cb\u8eab\u4efd\u4e0e\u58f0\u660e\uff0c\u4ee5\u53ca\u5b9e\u9645\u6d88\u8d39\u7684\u5b9e\u73b0/catalog/\u89c4\u5219\u548c\u5fc5\u8981\u4f9d\u8d56\uff0c\u4e0d\u9012\u5f52\u626b\u63cf\u672a\u6d88\u8d39\u6d4b\u8bd5\u3001\u5386\u53f2\u6216\u5176\u4ed6\u5305\u6210\u5458\uff0c\u4e5f\u4e0d\u4ee5\u8f7b\u91cf\u4e8b\u5b9e\u58f0\u79f0\u5168\u5305\u5065\u5eb7\u3002\u5b8c\u6574\u91c7\u7528\u3001\u8d44\u683c\u548c\u5206\u53d1\u9a8c\u8bc1\u4ecd\u5b8c\u6574\u6838\u5305\uff0c\u4e0d\u628a\u58f0\u660e\u5408\u6210\u4e3a\u5b8c\u6574Facts\u6216\u65b0Proof\uff1b\u4e0d\u52a0\u8de8\u8bf7\u6c42\u7f13\u5b58\u3002\u5f31\u7ed1\u5b9a\u3001\u4ec5\u6807\u8bb0true\u6216\u5b9e\u9645\u6f02\u79fb\u5747\u4e0d\u8db3\uff0c\u672a\u5b8c\u6210\u91c7\u7528\u5148\u6062\u590d\u539f\u4e8b\u52a1\u3002\n\n\u5df2\u77e5taskId\u76f4\u63a5\u8bfb\u8be5\u5361\u53ca\u5fc5\u8981\u9879\u76ee\u4e8b\u5b9e\uff0c\u672a\u77e5\u624d\u8bfb\u7d22\u5f15\u5b9a\u4f4d\uff1bSTATUS\u6309\u5168\u5c40\u4e8b\u5b9e\u5b9e\u9645\u9700\u8981\u8bfb\u53d6\u3002\u7ed1\u5b9a\u5f53\u524d\u8bf7\u6c42\u3001Owner\u3001\u771f\u5b9eactor/role/phase\u3001profile\u3001\u52a8\u4f5c/\u7ed3\u679c\u3001\u7cbe\u786e\u8303\u56f4/\u4fdd\u62a4\u3001\u80fd\u529b\u548c\u9002\u7528Review\u8981\u6c42\uff1b\u65e0\u9002\u7528\u4efb\u52a1\u7684\u53ea\u8bfb\u95ee\u9898\u7528PROJECT_READ_ONLY\uff1b\u9879\u76ee\u5df2\u660e\u786e\u9884\u6388\u6743\u7684\u666e\u901a\u5916\u90e8\u5de5\u5177\u8bf7\u6c42\u7528PROJECT_EXTERNAL\u52a0\u8f7d\u771f\u5b9eEXTERNAL\u610f\u56fe\uff0c\u4e0d\u6539\u79f0NONE\u6216\u7f16\u9020\u4efb\u52a1\u3002\u4e24\u8005\u90fd\u53ea\u53d6\u5f97\u89c4\u5219\uff0c\u4e0d\u6267\u884c\u5de5\u5177\u6216\u4ea7\u751f\u52a8\u4f5c\u51c6\u5165\u3002DISCOVER\u524d\u7531\u5f53\u524d\u6a21\u578b\u6309TOOL_CONTRACT\u552f\u4e00IntentEnvelope\u6bb5\u5f62\u6210\u771f\u5b9e\u610f\u56fe\uff0c\u518d\u6309PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES\u52a0\u8f7d\u6b63\u6587\u3002\n\n\u65b0\u4e8b\u5b9e\u53ea\u91cd\u5efa\u53d7\u5f71\u54cd\u6765\u6e90\u3001\u51b3\u5b9a\u6216\u6b63\u6587\uff1b\u538b\u7f29/\u6362\u4e3b\u4f53/\u6b63\u6587\u4e0d\u786e\u5b9a\u987b\u5b8c\u6574\u6062\u590d\u5f53\u524d\u5fc5\u9700\u6b63\u6587\uff0c\u5065\u5eb7\u8c03\u7528\u4e0d\u9010\u6b65FULL_COLD\u3002LOAD_PLAN_RESOLVE\u53ea\u670d\u52a1\u652f\u6301\u6750\u6599\u3001Framework\u7ef4\u62a4\u8bf4\u660e\u3001\u539f\u517c\u5bb9\u6216\u65e0\u6cd5\u8bc1\u660e\u6620\u5c04\u65f6\u7684\u6709\u754c\u6a21\u5757\u56de\u9000\uff0c\u4e0d\u7b5bcatalog\u6216\u7ed5\u4fdd\u62a4\u3002\u5b9e\u9645Git\u518d\u6838\u5bf9\u5e94\u4ed3\u5e93\u3002\u666e\u901a\u89c2\u5bdf\u4e0d\u53d6\u9879\u76ee/source\u534f\u8c03\u9501\uff0c\u4e0d\u81ea\u52a8\u91cd\u653epublication journal\uff1b\u771f\u5b9e\u4e8b\u52a1\u5199\u8005\u7ade\u4e89\u7684BUSY\u4fdd\u6301holder=UNKNOWN\uff0c\u6536\u8d77\u672c\u6b21\u5c1d\u8bd5\u3002\u663e\u5f0f\u76f8\u5173journal\u7684IN_PROGRESS\u6cbf\u539f\u6062\u590d\u5165\u53e3\uff1b\u4e0d\u5220\u540c\u6b65\u5bf9\u8c61\u3001\u6539pin\u6216\u8865\u8f7d\u5f00\u53d1\u6a21\u5757\u3002\u62a5\u544a\u771f\u5b9e\u4e0b\u4e00\u52a8\u4f5c\u53ca\u8bc1\u636e\u4e0a\u9650\u3002","preparationRequirements":["CURRENT_AUTHORITY_BOUND"],"resultRequirements":[],"selectorIdentity":"225|00AFDA43FF5054E997C982EA1FA60FD16FB9840B89561F1EF6C88ED8980BAF33","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","sourceIdentity":"9991|2AF5E3F3573B6FC1327D460081C7207C12E492BCD79B8608A4C6F429A4554BF4","fullText":"\u6062\u590d\u53ea\u8bc1\u660e\u5f53\u524d\u6743\u5a01\u53ca\u4e8b\u5b9e\uff0c\u4e0d\u6388\u4e88\u5199\u3001\u6d4b\u8bd5\u3001Review\u3001Git\u3001\u6d4f\u89c8\u5668/\u8bbe\u5907\u6216\u5916\u90e8\u6743\u9650\u3002\u5148\u4ece\u660e\u786e\u9879\u76ee\u6839\u53ca\u5176AGENTS\u8fdb\u5165\u56fa\u5b9aBOOTSTRAP\uff0c\u6821\u9a8c\u771f\u5b9e\u8def\u5f84\u548c\u62d3\u6251\uff1b\u666e\u901a\u975eGit\u9879\u76ee\u4e0d\u4ee5Git\u51b3\u5b9a\u9879\u76ee\u6839\u3002\u53ef\u9009GIT_WORKTREE\u6cbf\u539f\u4efb\u52a1descriptor\u9a8c\u8bc1\u552f\u4e00controlRoot\u4e0eexecutionRoot\uff0c\u65e7\u590d\u5236\u63a7\u5236\u6750\u6599\u4e0d\u80fd\u66ff\u4ee3\u539f\u6743\u5a01\uff1bMaintenance\u4ecd\u6309\u81ea\u5df1\u7684CONTROL/TARGET\u62d3\u6251\u89e3\u6790\u3002\n\n\u8bfb\u53d6\u5f53\u524dproject\u3001Controller\u3001\u6709\u6548\u7ea0\u6b63\u3001policy\u53ca\u5fc5\u8981\u91c7\u7528\u5b8c\u6210\u4e8b\u5b9e\uff0c\u4ece\u9879\u76eepin\u548c\u539fdistribution binding\u5b9a\u4f4d\u552f\u4e00\u56fa\u5b9a\u8fd0\u884c\u6765\u6e90\uff0c\u6838\u5bf9TOOLCHAIN\u3002\u5f00\u53d1HEAD\u3001\u7f51\u7edc\u3001\u5176\u4ed6\u9879\u76ee\u6216\u4efb\u610f\u65b0\u5305\u4e0d\u4f5cfallback\u3002\u9996\u6b21/\u65b0\u6765\u6e90\u987b\u5b8c\u6574\u8d44\u683c\u9a8c\u8bc1\uff1b\u666e\u901a\u5df2\u91c7\u7528\u6765\u6e90\u6838\u771f\u5b9e\u5f53\u524d\u5b8c\u6210\u94fe\u3001\u72ec\u7acb\u56fa\u5b9a\u7ed1\u5b9a\u3001manifest\u539f\u59cb\u8eab\u4efd\u4e0e\u58f0\u660e\uff0c\u4ee5\u53ca\u5b9e\u9645\u6d88\u8d39\u7684\u5b9e\u73b0/catalog/\u89c4\u5219\u548c\u5fc5\u8981\u4f9d\u8d56\uff0c\u4e0d\u9012\u5f52\u626b\u63cf\u672a\u6d88\u8d39\u6d4b\u8bd5\u3001\u5386\u53f2\u6216\u5176\u4ed6\u5305\u6210\u5458\uff0c\u4e5f\u4e0d\u4ee5\u8f7b\u91cf\u4e8b\u5b9e\u58f0\u79f0\u5168\u5305\u5065\u5eb7\u3002\u5b8c\u6574\u91c7\u7528\u3001\u8d44\u683c\u548c\u5206\u53d1\u9a8c\u8bc1\u4ecd\u5b8c\u6574\u6838\u5305\uff0c\u4e0d\u628a\u58f0\u660e\u5408\u6210\u4e3a\u5b8c\u6574Facts\u6216\u65b0Proof\uff1b\u4e0d\u52a0\u8de8\u8bf7\u6c42\u7f13\u5b58\u3002\u5f31\u7ed1\u5b9a\u3001\u4ec5\u6807\u8bb0true\u6216\u5b9e\u9645\u6f02\u79fb\u5747\u4e0d\u8db3\uff0c\u672a\u5b8c\u6210\u91c7\u7528\u5148\u6062\u590d\u539f\u4e8b\u52a1\u3002\n\n\u5df2\u77e5taskId\u76f4\u63a5\u8bfb\u8be5\u5361\u53ca\u5fc5\u8981\u9879\u76ee\u4e8b\u5b9e\uff0c\u672a\u77e5\u624d\u8bfb\u7d22\u5f15\u5b9a\u4f4d\uff1bSTATUS\u6309\u5168\u5c40\u4e8b\u5b9e\u5b9e\u9645\u9700\u8981\u8bfb\u53d6\u3002\u7ed1\u5b9a\u5f53\u524d\u8bf7\u6c42\u3001Owner\u3001\u771f\u5b9eactor/role/phase\u3001profile\u3001\u52a8\u4f5c/\u7ed3\u679c\u3001\u7cbe\u786e\u8303\u56f4/\u4fdd\u62a4\u3001\u80fd\u529b\u548c\u9002\u7528Review\u8981\u6c42\uff1b\u65e0\u9002\u7528\u4efb\u52a1\u7684\u53ea\u8bfb\u95ee\u9898\u7528PROJECT_READ_ONLY\uff1b\u9879\u76ee\u5df2\u660e\u786e\u9884\u6388\u6743\u7684\u666e\u901a\u5916\u90e8\u5de5\u5177\u8bf7\u6c42\u7528PROJECT_EXTERNAL\u52a0\u8f7d\u771f\u5b9eEXTERNAL\u610f\u56fe\uff0c\u4e0d\u6539\u79f0NONE\u6216\u7f16\u9020\u4efb\u52a1\u3002\u4e24\u8005\u90fd\u53ea\u53d6\u5f97\u89c4\u5219\uff0c\u4e0d\u6267\u884c\u5de5\u5177\u6216\u4ea7\u751f\u52a8\u4f5c\u51c6\u5165\u3002DISCOVER\u524d\u7531\u5f53\u524d\u6a21\u578b\u6309TOOL_CONTRACT\u552f\u4e00IntentEnvelope\u6bb5\u5f62\u6210\u771f\u5b9e\u610f\u56fe\uff0c\u518d\u6309PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES\u52a0\u8f7d\u6b63\u6587\u3002\n\n\u65b0\u4e8b\u5b9e\u53ea\u91cd\u5efa\u53d7\u5f71\u54cd\u6765\u6e90\u3001\u51b3\u5b9a\u6216\u6b63\u6587\uff1b\u538b\u7f29/\u6362\u4e3b\u4f53/\u6b63\u6587\u4e0d\u786e\u5b9a\u987b\u5b8c\u6574\u6062\u590d\u5f53\u524d\u5fc5\u9700\u6b63\u6587\uff0c\u5065\u5eb7\u8c03\u7528\u4e0d\u9010\u6b65FULL_COLD\u3002LOAD_PLAN_RESOLVE\u53ea\u670d\u52a1\u652f\u6301\u6750\u6599\u3001Framework\u7ef4\u62a4\u8bf4\u660e\u3001\u539f\u517c\u5bb9\u6216\u65e0\u6cd5\u8bc1\u660e\u6620\u5c04\u65f6\u7684\u6709\u754c\u6a21\u5757\u56de\u9000\uff0c\u4e0d\u7b5bcatalog\u6216\u7ed5\u4fdd\u62a4\u3002\u5b9e\u9645Git\u518d\u6838\u5bf9\u5e94\u4ed3\u5e93\u3002\u666e\u901a\u89c2\u5bdf\u4e0d\u53d6\u9879\u76ee/source\u534f\u8c03\u9501\uff0c\u4e0d\u81ea\u52a8\u91cd\u653epublication journal\uff1b\u771f\u5b9e\u4e8b\u52a1\u5199\u8005\u7ade\u4e89\u7684BUSY\u4fdd\u6301holder=UNKNOWN\uff0c\u6536\u8d77\u672c\u6b21\u5c1d\u8bd5\u3002\u663e\u5f0f\u76f8\u5173journal\u7684IN_PROGRESS\u6cbf\u539f\u6062\u590d\u5165\u53e3\uff1b\u4e0d\u5220\u540c\u6b65\u5bf9\u8c61\u3001\u6539pin\u6216\u8865\u8f7d\u5f00\u53d1\u6a21\u5757\u3002\u62a5\u544a\u771f\u5b9e\u4e0b\u4e00\u52a8\u4f5c\u53ca\u8bc1\u636e\u4e0a\u9650\u3002","orderedDependencies":[]}],"declarationIdentity":"675|220528D6970EBACB0E18FC3E31B0AB9696AD3EF48B35D51C5EB2F4EE3A257550"},{"requirementId":"framework:PR_TASK_CHANGED_OUTPUT_DISPOSITION","source":"FRAMEWORK","ownerModule":"TASK_AND_SCOPE.md","semanticApplicability":"DETERMINISTIC","fullText":"\u62e5\u6709\u7684\u4ed3\u5e93\u5b57\u8282\u53d8\u5316\u5230\u5019\u9009\u3001\u63a5\u53d7\u6216\u4ea4\u4ed8\u8fb9\u754c\u65f6\uff0cOwner\u5728\u539f\u4efb\u52a1\u8bf4\u660e\u4ea7\u7269\u4e0eGit\u53bb\u5411\uff1aREADY\u542b\u5019\u9009/\u8def\u5f84\u3001\u8bc1\u636e\u548c\u5b9e\u9645closer\uff1bDEFERRED\u542b\u7406\u7531\u3001\u89e6\u53d1\u548c\u8d23\u4efb\uff1bEXCLUDED\u542b\u7406\u7531\u3002\u672a\u95ed\u5408\u8d23\u4efb\u5728\u540e\u7eedNONE\u7b54\u590d\u4ecd\u6709\u6548\uff0c\u5168\u7a0b\u53ea\u8bfb\u8c41\u514d\u3002Review/\u63a5\u53d7\u4e0d\u8bc1\u660eGit\u5c31\u7eea\uff0c\u4e0d\u666e\u904d\u65b0\u5efaGit\u4efb\u52a1\uff1b\u4ec5\u5b9e\u9645\u63a5\u6536\u8005\u6709\u4e0b\u4e00\u52a8\u4f5c\u624d\u53d1\u9001\u7ed3\u679c\u3002\n\n\u5148FINALIZE\u6587\u6863/\u4ea7\u7269\u52a8\u4f5c\uff0c\u518d\u4ee5\u5f53\u524d\u5361\u5355\u5bf9\u8c61CONTROL_WRITE\u66f4\u65b0\u4efb\u52a1\u3002\u666e\u901a\u5f53\u524d\u5361\u4e0e\u5176\u4ed6\u5bf9\u8c61\u6df7\u5408\u5199\u96c6\u4ecd\u62d2\u7edd\uff1b\u5f53\u524d\u5361\u5173\u95ed\u5e76\u7269\u7406\u5f52\u6863\u4ec5\u5141\u8bb8\u666e\u901a\u7eafCONTROL_WRITE\u7684\u7cbe\u786eactive+\u540cbasename archive\u4e24\u5bf9\u8c61\uff1aactive\u5b58\u5728\u65f6\u6838\u539f\u5305\u53ca\u524d\u50cf\u5e76\u51c6\u5165\uff0c\u5148\u5b8c\u6574\u4fdd\u5b58\u3001\u8bfb\u56de\u548c\u5b9e\u9645\u9a8c\u8bc1\u95ed\u5408archive\uff0c\u518d\u590d\u6838\u539factive\u540e\u5220\u9664\uff0c\u539fFINALIZE\u6d88\u8d39\u5df2\u9a8c\u8bc1\u7684\u5b9e\u9645archive\u8def\u5f84\uff0c\u6b63\u6587ID\u53ca\u539f\u903b\u8f91\u51c6\u5165\u4fdd\u6301\u3002\u5df2\u6709\u76f8\u540carchive\u53ef\u590d\u7528\uff0c\u4e0d\u540c\u5386\u53f2\u4ec5\u6309\u660e\u786e\u539f\u50cf\u5904\u7406\uff1b\u4e2d\u65ad\u7559\u4e24\u5f20\u6709\u6548\u5361\u6216\u5b8c\u6574archive\u53ef\u6cbf\u539f\u52a8\u4f5c\u8865\u5b8c\uff0c\u4e0d\u9020\u5f52\u6863\u4e8b\u52a1/\u5168\u5c40locator\u3002\u5176\u4ed6\u5408\u6cd5\u6587\u6863\u6279\u6b21\u3001schema1\u771f\u5b9e\u8d23\u4efb\u8f6c\u6362\u53ca\u4e13\u7528\u6839\u91c7\u7528\u6309\u81ea\u8eab\u5408\u540c\uff1b\u4e0d\u6cdb\u5316\u6df7\u5408\u5199\u3001missing\u6216\u7b2c\u4e09\u65b9\u8c41\u514d\u3002\n\nCLOSED\u5199\u660eSUCCESS\u3001CANCELLED\u6216SUPERSEDED\u3001\u5173\u95ed\u4f9d\u636e\u3001\u4ea7\u7269/Git\u53bb\u5411\u548c\u672a\u89e3\u4e49\u52a1\u627f\u63a5\uff0c\u5e76\u91ca\u653ewriter/reviewer/\u52a8\u4f5c\u6388\u6743\u3002SUCCESS\u6ee1\u8db3\u9002\u7528\u9a8c\u6536\uff1b\u53d6\u6d88/\u66ff\u4ee3\u4fdd\u7559\u5b9e\u9645\u672a\u5b8c\u6210\u9879\u4e0e\u51b3\u5b9a\uff0c\u7b49\u5f85/\u963b\u585e\u4fdd\u6301active\u3002\u5f53\u524dACTIVE\u7ef4\u62a4\u4efb\u52a1\u79fb\u52a8\u53e6\u4e00\u5f20\u539f\u5df2CLOSED\u5361\u65f6\uff0c\u7cbe\u786eactive\u524d\u50cf\u5fc5\u987b\u7b49\u4e8e\u540cbasename archive\u5b9e\u9645\u540e\u50cf\uff0c\u539f\u6b63\u6587ID\u3001\u95ed\u5408/\u91ca\u653e\u3001\u5f53\u524d\u7eafCONTROL\u79fb\u52a8\u6743\u9650\u53ca\u4fdd\u62a4\u6210\u7acb\uff1b\u53ea\u8bc1\u660e\u539f\u5b57\u8282\u79fb\u5b58\uff0c\u4e0d\u91cd\u65b0\u9a8c\u6536\u540e\u6765\u6f14\u8fdb\u7684\u4ea7\u54c1\u3002\u5361\u6539\u5b57\u3001\u539f\u975eCLOSED\u3001\u672a\u91ca\u653e\u3001\u76ee\u6807\u51b2\u7a81\u6216\u539f\u4ef6\u4e0d\u8db3\u4ecd\u62d2\u7edd\u8be5\u5206\u652f\uff1b\u5f53\u524d\u4efb\u52a1\u65b0SUCCESS\u7ee7\u7eed\u5b8c\u6574\u9a8c\u6536\u3002\u65e7closure decision/acceptance plan\u8fdb\u5165\u539fretention\uff0c\u79fb\u5b58\u4e0d\u8ffd\u8ba4\u771f\u8bc1\u660e\u6709\u6548\u6216\u4ee4\u6750\u6599\u5230\u671f\u3002\u65e7\u5361\u6309\u5176\u539f\u517c\u5bb9\u68c0\u67e5\uff0c\u4e0d\u6279\u91cf\u4f2a\u8865\u6210\u529f\u3002\u4efb\u52a1\u5361\u5173\u95ed/\u7269\u7406\u5f52\u6863\u3001\u8d23\u4efb\u91ca\u653e\u548c\u5bbf\u4e3b\u4f1a\u8bdd\u5f52\u6863\u5206\u522b\u6838\u5bf9\u3002\u6709\u9650\u6210\u679c\u5df2\u4ea4\u4ed8\u3001\u539f\u7ed3\u679c\u5df2\u88ab\u5b9e\u9645\u6d88\u8d39\u4e14\u4f1a\u8bdd\u65e0\u540e\u7eed\u804c\u8d23\u65f6\uff0c\u7531\u5b9e\u9645\u6536\u5c3e\u8d23\u4efb\u4eba\u5728\u5df2\u6709\u6743\u9650\u5185\u8c03\u7528\u5bbf\u4e3b\u5f52\u6863\u8be5\u4f1a\u8bdd\uff0c\u5e76\u6838\u5bf9\u771f\u5b9e\u8fd4\u56de\uff1b\u53ea\u5199CLOSED\u3001\u91ca\u653e\u6388\u6743\u6216\u6539\u6807\u9898\u4e0d\u7b97\u4f1a\u8bdd\u5df2\u5f52\u6863\u3002\u5f85\u9a8c\u6536\u3001\u4ecd\u6709\u540c\u9879\u8fd4\u4fee\u6216\u771f\u5b9e\u957f\u671f\u804c\u8d23\u65f6\u4fdd\u7559\u3002\u6743\u9650\u7f3a\u5931\u3001\u5931\u8d25\u6216UNKNOWN\u5982\u5b9e\u4fdd\u7559\u5e76\u4ea4\u5b9e\u9645\u8d23\u4efb\u8005\uff0c\u4e0d\u5ba3\u79f0\u5df2\u5b8c\u6210\uff0c\u4e0d\u6279\u91cf\u626b\u63cf\u6216\u64cd\u4f5c\u5386\u53f2\u4f1a\u8bdd\u3002\n\n\u539f\u4efb\u52a1\u81ea\u7136\u6536\u5c3e\u4e00\u6b21\u5904\u7406\u6b63\u5f0f\u6750\u6599\u6301\u4e45\u5f52\u5c5e\u3001\u6709\u6548\u5f15\u7528\u3001\u5df2\u77e5\u4e34\u65f6\u96c6\u5408\u548c\u672a\u89e3\u4f9d\u8d56\uff0c\u751f\u547d\u5468\u671f\u53d6TOOL_CONTRACT\uff1b\u4e0d\u6309\u76ee\u5f55\u5927\u5c0f/\u5e74\u9f84/\u5173\u95ed\u72b6\u6001\u63a8\u5b9a\u53ef\u5220\uff0c\u4e0d\u53e6\u5f00\u6e05\u7406\u6216\u7edf\u8ba1\u56de\u5408\u3002\u5df2\u6709\u8bf7\u6c42\u3001\u5de5\u5177\u3001\u52a0\u8f7d\u3001\u534f\u8c03\u3001\u8fd4\u5de5\u548c\u7528\u6237\u4ecb\u5165\u6570\u636e\u53ef\u7531\u6700\u540e\u6d88\u8d39\u8005\u540c\u6279\u63d0\u53d6\uff0c\u7f3a\u6570\u636e\u4fdd\u7559\u9650\u5236\uff0c\u4e0d\u8bbe\u8d39\u7528\u8bc1\u660e\u95e8\u3002","preparationRequirements":[],"resultRequirements":["CHANGED_OUTPUT_DISPOSITION_STATED"],"selectorIdentity":"543|9BE27722EBC38366375D87D109CE2804A3FF626A620ED9A5B70FF706D2F19590","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","sourceIdentity":"21004|FAD841FC29B546A9D43267E3EB5C3238318E458BB0391E988197552EF4729875","fullText":"\u62e5\u6709\u7684\u4ed3\u5e93\u5b57\u8282\u53d8\u5316\u5230\u5019\u9009\u3001\u63a5\u53d7\u6216\u4ea4\u4ed8\u8fb9\u754c\u65f6\uff0cOwner\u5728\u539f\u4efb\u52a1\u8bf4\u660e\u4ea7\u7269\u4e0eGit\u53bb\u5411\uff1aREADY\u542b\u5019\u9009/\u8def\u5f84\u3001\u8bc1\u636e\u548c\u5b9e\u9645closer\uff1bDEFERRED\u542b\u7406\u7531\u3001\u89e6\u53d1\u548c\u8d23\u4efb\uff1bEXCLUDED\u542b\u7406\u7531\u3002\u672a\u95ed\u5408\u8d23\u4efb\u5728\u540e\u7eedNONE\u7b54\u590d\u4ecd\u6709\u6548\uff0c\u5168\u7a0b\u53ea\u8bfb\u8c41\u514d\u3002Review/\u63a5\u53d7\u4e0d\u8bc1\u660eGit\u5c31\u7eea\uff0c\u4e0d\u666e\u904d\u65b0\u5efaGit\u4efb\u52a1\uff1b\u4ec5\u5b9e\u9645\u63a5\u6536\u8005\u6709\u4e0b\u4e00\u52a8\u4f5c\u624d\u53d1\u9001\u7ed3\u679c\u3002\n\n\u5148FINALIZE\u6587\u6863/\u4ea7\u7269\u52a8\u4f5c\uff0c\u518d\u4ee5\u5f53\u524d\u5361\u5355\u5bf9\u8c61CONTROL_WRITE\u66f4\u65b0\u4efb\u52a1\u3002\u666e\u901a\u5f53\u524d\u5361\u4e0e\u5176\u4ed6\u5bf9\u8c61\u6df7\u5408\u5199\u96c6\u4ecd\u62d2\u7edd\uff1b\u5f53\u524d\u5361\u5173\u95ed\u5e76\u7269\u7406\u5f52\u6863\u4ec5\u5141\u8bb8\u666e\u901a\u7eafCONTROL_WRITE\u7684\u7cbe\u786eactive+\u540cbasename archive\u4e24\u5bf9\u8c61\uff1aactive\u5b58\u5728\u65f6\u6838\u539f\u5305\u53ca\u524d\u50cf\u5e76\u51c6\u5165\uff0c\u5148\u5b8c\u6574\u4fdd\u5b58\u3001\u8bfb\u56de\u548c\u5b9e\u9645\u9a8c\u8bc1\u95ed\u5408archive\uff0c\u518d\u590d\u6838\u539factive\u540e\u5220\u9664\uff0c\u539fFINALIZE\u6d88\u8d39\u5df2\u9a8c\u8bc1\u7684\u5b9e\u9645archive\u8def\u5f84\uff0c\u6b63\u6587ID\u53ca\u539f\u903b\u8f91\u51c6\u5165\u4fdd\u6301\u3002\u5df2\u6709\u76f8\u540carchive\u53ef\u590d\u7528\uff0c\u4e0d\u540c\u5386\u53f2\u4ec5\u6309\u660e\u786e\u539f\u50cf\u5904\u7406\uff1b\u4e2d\u65ad\u7559\u4e24\u5f20\u6709\u6548\u5361\u6216\u5b8c\u6574archive\u53ef\u6cbf\u539f\u52a8\u4f5c\u8865\u5b8c\uff0c\u4e0d\u9020\u5f52\u6863\u4e8b\u52a1/\u5168\u5c40locator\u3002\u5176\u4ed6\u5408\u6cd5\u6587\u6863\u6279\u6b21\u3001schema1\u771f\u5b9e\u8d23\u4efb\u8f6c\u6362\u53ca\u4e13\u7528\u6839\u91c7\u7528\u6309\u81ea\u8eab\u5408\u540c\uff1b\u4e0d\u6cdb\u5316\u6df7\u5408\u5199\u3001missing\u6216\u7b2c\u4e09\u65b9\u8c41\u514d\u3002\n\nCLOSED\u5199\u660eSUCCESS\u3001CANCELLED\u6216SUPERSEDED\u3001\u5173\u95ed\u4f9d\u636e\u3001\u4ea7\u7269/Git\u53bb\u5411\u548c\u672a\u89e3\u4e49\u52a1\u627f\u63a5\uff0c\u5e76\u91ca\u653ewriter/reviewer/\u52a8\u4f5c\u6388\u6743\u3002SUCCESS\u6ee1\u8db3\u9002\u7528\u9a8c\u6536\uff1b\u53d6\u6d88/\u66ff\u4ee3\u4fdd\u7559\u5b9e\u9645\u672a\u5b8c\u6210\u9879\u4e0e\u51b3\u5b9a\uff0c\u7b49\u5f85/\u963b\u585e\u4fdd\u6301active\u3002\u5f53\u524dACTIVE\u7ef4\u62a4\u4efb\u52a1\u79fb\u52a8\u53e6\u4e00\u5f20\u539f\u5df2CLOSED\u5361\u65f6\uff0c\u7cbe\u786eactive\u524d\u50cf\u5fc5\u987b\u7b49\u4e8e\u540cbasename archive\u5b9e\u9645\u540e\u50cf\uff0c\u539f\u6b63\u6587ID\u3001\u95ed\u5408/\u91ca\u653e\u3001\u5f53\u524d\u7eafCONTROL\u79fb\u52a8\u6743\u9650\u53ca\u4fdd\u62a4\u6210\u7acb\uff1b\u53ea\u8bc1\u660e\u539f\u5b57\u8282\u79fb\u5b58\uff0c\u4e0d\u91cd\u65b0\u9a8c\u6536\u540e\u6765\u6f14\u8fdb\u7684\u4ea7\u54c1\u3002\u5361\u6539\u5b57\u3001\u539f\u975eCLOSED\u3001\u672a\u91ca\u653e\u3001\u76ee\u6807\u51b2\u7a81\u6216\u539f\u4ef6\u4e0d\u8db3\u4ecd\u62d2\u7edd\u8be5\u5206\u652f\uff1b\u5f53\u524d\u4efb\u52a1\u65b0SUCCESS\u7ee7\u7eed\u5b8c\u6574\u9a8c\u6536\u3002\u65e7closure decision/acceptance plan\u8fdb\u5165\u539fretention\uff0c\u79fb\u5b58\u4e0d\u8ffd\u8ba4\u771f\u8bc1\u660e\u6709\u6548\u6216\u4ee4\u6750\u6599\u5230\u671f\u3002\u65e7\u5361\u6309\u5176\u539f\u517c\u5bb9\u68c0\u67e5\uff0c\u4e0d\u6279\u91cf\u4f2a\u8865\u6210\u529f\u3002\u4efb\u52a1\u5361\u5173\u95ed/\u7269\u7406\u5f52\u6863\u3001\u8d23\u4efb\u91ca\u653e\u548c\u5bbf\u4e3b\u4f1a\u8bdd\u5f52\u6863\u5206\u522b\u6838\u5bf9\u3002\u6709\u9650\u6210\u679c\u5df2\u4ea4\u4ed8\u3001\u539f\u7ed3\u679c\u5df2\u88ab\u5b9e\u9645\u6d88\u8d39\u4e14\u4f1a\u8bdd\u65e0\u540e\u7eed\u804c\u8d23\u65f6\uff0c\u7531\u5b9e\u9645\u6536\u5c3e\u8d23\u4efb\u4eba\u5728\u5df2\u6709\u6743\u9650\u5185\u8c03\u7528\u5bbf\u4e3b\u5f52\u6863\u8be5\u4f1a\u8bdd\uff0c\u5e76\u6838\u5bf9\u771f\u5b9e\u8fd4\u56de\uff1b\u53ea\u5199CLOSED\u3001\u91ca\u653e\u6388\u6743\u6216\u6539\u6807\u9898\u4e0d\u7b97\u4f1a\u8bdd\u5df2\u5f52\u6863\u3002\u5f85\u9a8c\u6536\u3001\u4ecd\u6709\u540c\u9879\u8fd4\u4fee\u6216\u771f\u5b9e\u957f\u671f\u804c\u8d23\u65f6\u4fdd\u7559\u3002\u6743\u9650\u7f3a\u5931\u3001\u5931\u8d25\u6216UNKNOWN\u5982\u5b9e\u4fdd\u7559\u5e76\u4ea4\u5b9e\u9645\u8d23\u4efb\u8005\uff0c\u4e0d\u5ba3\u79f0\u5df2\u5b8c\u6210\uff0c\u4e0d\u6279\u91cf\u626b\u63cf\u6216\u64cd\u4f5c\u5386\u53f2\u4f1a\u8bdd\u3002\n\n\u539f\u4efb\u52a1\u81ea\u7136\u6536\u5c3e\u4e00\u6b21\u5904\u7406\u6b63\u5f0f\u6750\u6599\u6301\u4e45\u5f52\u5c5e\u3001\u6709\u6548\u5f15\u7528\u3001\u5df2\u77e5\u4e34\u65f6\u96c6\u5408\u548c\u672a\u89e3\u4f9d\u8d56\uff0c\u751f\u547d\u5468\u671f\u53d6TOOL_CONTRACT\uff1b\u4e0d\u6309\u76ee\u5f55\u5927\u5c0f/\u5e74\u9f84/\u5173\u95ed\u72b6\u6001\u63a8\u5b9a\u53ef\u5220\uff0c\u4e0d\u53e6\u5f00\u6e05\u7406\u6216\u7edf\u8ba1\u56de\u5408\u3002\u5df2\u6709\u8bf7\u6c42\u3001\u5de5\u5177\u3001\u52a0\u8f7d\u3001\u534f\u8c03\u3001\u8fd4\u5de5\u548c\u7528\u6237\u4ecb\u5165\u6570\u636e\u53ef\u7531\u6700\u540e\u6d88\u8d39\u8005\u540c\u6279\u63d0\u53d6\uff0c\u7f3a\u6570\u636e\u4fdd\u7559\u9650\u5236\uff0c\u4e0d\u8bbe\u8d39\u7528\u8bc1\u660e\u95e8\u3002","orderedDependencies":[]}],"declarationIdentity":"998|92DA71DBF52C71A5BFC43B882698500F2023D56460E0332FACAE7B9FAD7465EB"},{"requirementId":"framework:PR_TASK_COLLABORATION_BOUNDARY","source":"FRAMEWORK","ownerModule":"TASK_AND_SCOPE.md","semanticApplicability":"DETERMINISTIC","fullText":"\u534f\u4f5c\u671f\u95f4\u4e0d\u4ee5wait_threads\u3001wait_agent\u6216\u53cd\u590d\u8bfb\u53d6\u804a\u5929\u3001\u72b6\u6001\u3001\u65e5\u5fd7\u7b49\u5f85\u5176\u4ed6\u4f1a\u8bdd\u3002\u6709\u5b89\u5168\u5de5\u4f5c\u5c31\u7ee7\u7eed\uff0c\u6ca1\u6709\u5c31\u7ed3\u675f\u5f53\u524d\u8f6e\uff0c\u771f\u5b9e\u7ed3\u679c\u9001\u8fbe\u540e\u7eed\u4f5c\u3002\u5bbf\u4e3b\u8981\u6c42\u65b0\u5efa\u540e\u9996\u6b21\u53d6\u5f97\u8fdb\u5ea6\u65f6\uff0c\u6309HOST\u7684\u4e00\u6b21\u6709\u754c\u89c2\u5bdf\u6267\u884c\uff0c\u672a\u5c31\u7eea\u4e0d\u8f6c\u4e3a\u6301\u7eed\u7b49\u5f85\u3002\u5df2\u542f\u52a8\u7684\u5f53\u524d\u547d\u4ee4/\u6d4b\u8bd5\u53ef\u7b49\u5f85\u81ea\u8eab\u5fc5\u8981\u7ed3\u679c\uff1b\u7528\u6237\u4e3b\u52a8\u67e5\u8be2\u53ef\u5355\u6b21\u8bfb\u53d6\u73b0\u72b6\u3002\n\n\u751f\u4ea7/\u81ea\u6d4b\u8f6c\u5165\u65b0\u7684\u4ea4\u5ba1\u5206\u6d3e\u662f\u7ec4\u7ec7\u4e8b\u5b9e\u53d8\u5316\uff0c\u6309PR_REVIEW_ROUTE_PREPARATION\u5904\u7406\u771f\u5b9e\u65b0\u610f\u56fe\u3001\u9009\u62e9\u53ca\u51c6\u5165\u3002\u76f8\u540c\u76ee\u6807\u7684\u5065\u5eb7\u6b63\u6587\u548c\u8bc1\u636e\u53ef\u590d\u7528\uff1b\u6ca1\u6709\u65b0\u5206\u6d3e\u4e0d\u91cd\u590d\u7ec4\u7ec7\u9009\u62e9\uff0c\u4e0d\u91cd\u505a\u5b8c\u6574\u6062\u590d\u6216\u5236\u9020\u7eaf\u8bb0\u8d26\u56de\u5408\u3002","preparationRequirements":[],"resultRequirements":[],"selectorIdentity":"154|18F2D6E677509B377730AC3A6CD950C41C4CEB8C3168DAAD3DD2503C342CA200","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","sourceIdentity":"21004|FAD841FC29B546A9D43267E3EB5C3238318E458BB0391E988197552EF4729875","fullText":"\u534f\u4f5c\u671f\u95f4\u4e0d\u4ee5wait_threads\u3001wait_agent\u6216\u53cd\u590d\u8bfb\u53d6\u804a\u5929\u3001\u72b6\u6001\u3001\u65e5\u5fd7\u7b49\u5f85\u5176\u4ed6\u4f1a\u8bdd\u3002\u6709\u5b89\u5168\u5de5\u4f5c\u5c31\u7ee7\u7eed\uff0c\u6ca1\u6709\u5c31\u7ed3\u675f\u5f53\u524d\u8f6e\uff0c\u771f\u5b9e\u7ed3\u679c\u9001\u8fbe\u540e\u7eed\u4f5c\u3002\u5bbf\u4e3b\u8981\u6c42\u65b0\u5efa\u540e\u9996\u6b21\u53d6\u5f97\u8fdb\u5ea6\u65f6\uff0c\u6309HOST\u7684\u4e00\u6b21\u6709\u754c\u89c2\u5bdf\u6267\u884c\uff0c\u672a\u5c31\u7eea\u4e0d\u8f6c\u4e3a\u6301\u7eed\u7b49\u5f85\u3002\u5df2\u542f\u52a8\u7684\u5f53\u524d\u547d\u4ee4/\u6d4b\u8bd5\u53ef\u7b49\u5f85\u81ea\u8eab\u5fc5\u8981\u7ed3\u679c\uff1b\u7528\u6237\u4e3b\u52a8\u67e5\u8be2\u53ef\u5355\u6b21\u8bfb\u53d6\u73b0\u72b6\u3002\n\n\u751f\u4ea7/\u81ea\u6d4b\u8f6c\u5165\u65b0\u7684\u4ea4\u5ba1\u5206\u6d3e\u662f\u7ec4\u7ec7\u4e8b\u5b9e\u53d8\u5316\uff0c\u6309PR_REVIEW_ROUTE_PREPARATION\u5904\u7406\u771f\u5b9e\u65b0\u610f\u56fe\u3001\u9009\u62e9\u53ca\u51c6\u5165\u3002\u76f8\u540c\u76ee\u6807\u7684\u5065\u5eb7\u6b63\u6587\u548c\u8bc1\u636e\u53ef\u590d\u7528\uff1b\u6ca1\u6709\u65b0\u5206\u6d3e\u4e0d\u91cd\u590d\u7ec4\u7ec7\u9009\u62e9\uff0c\u4e0d\u91cd\u505a\u5b8c\u6574\u6062\u590d\u6216\u5236\u9020\u7eaf\u8bb0\u8d26\u56de\u5408\u3002","orderedDependencies":[]}],"declarationIdentity":"530|0FD6D7446BB02DD62AAEB3D0044145BA13D988CF2B0D312BEBC89C74DF886529"},{"requirementId":"framework:PR_TASK_IMPLEMENTATION_JUDGMENT","source":"FRAMEWORK","ownerModule":"TASK_AND_SCOPE.md","semanticApplicability":"DETERMINISTIC","fullText":"\u5728\u5df2\u63a5\u53d7\u76ee\u6807\u3001\u7cbe\u786e\u6388\u6743\u4e0e\u4fdd\u62a4\u8303\u56f4\u5185\uff0c\u5148\u7406\u89e3\u771f\u5b9e\u673a\u5236\u3001\u76f4\u63a5\u6d88\u8d39\u8005\u53ca\u5931\u8d25\u6062\u590d\uff1b\u6709\u591a\u6761\u5b9e\u8d28\u53ef\u884c\u8def\u7ebf\u65f6\u6bd4\u8f83\u73b0\u6709\u5b9e\u73b0\u3001\u6807\u51c6\u5e93/\u5e73\u53f0\u3001\u5df2\u6388\u6743\u4f9d\u8d56\u548c\u5fc5\u8981\u65b0\u4ee3\u7801\u7684\u6b63\u786e\u6027\u53ca\u603b\u6210\u672c\uff0c\u9009\u62e9\u6700\u5c0f\u5145\u5206\u65b9\u6848\u3002\u590d\u7528\u4e0d\u5b89\u5168\u6216\u9002\u914d\u4ee3\u4ef7\u66f4\u9ad8\u65f6\u53ef\u6709\u636e\u6362\u7528\uff0c\u4e0d\u4e3a\u5047\u8bbe\u672a\u6765\u65b0\u589e\u673a\u5668\u3002\u6210\u679c\u7c7b\u522b\u53ca\u9a8c\u6536\u4ee5\u7528\u6237\u76ee\u6807\u4e3a\u51c6\uff0c\u5206\u6790\u3001\u6d4b\u8bd5\u6216\u539f\u578b\u4e0d\u66ff\u4ee3\u8bf7\u6c42\u7684\u6b63\u5f0f\u4ea7\u7269\u3002\u666e\u901a\u4f4e\u5f71\u54cd\u4fee\u590d\u4e0d\u65b0\u589e\u5199\u524d\u5ba1\u67e5\u6216\u8868\u5355\uff1b\u91cd\u5927\u5951\u7ea6/\u98ce\u9669/\u8303\u56f4\u51b2\u7a81\u53ea\u505c\u6b62\u53d7\u5f71\u54cd\u94fe\u3002\u5065\u5eb7\u5df2\u5ba1\u7ed3\u8bba\u590d\u7528\uff0c\u5b9e\u9645\u65b0\u589e\u8bc1\u636e\u624d\u91cd\u5f00\u3002MICRO\u540c\u6837\u9075\u5b88\u8fd9\u4e9b\u539f\u5219\uff0c\u4e0d\u56e0\u6b64\u52a0\u8f7d\u5b8c\u6574\u4efb\u52a1\u7ef4\u62a4\u7a0b\u5e8f\u3002\n\n\u901a\u7528\u89c4\u5219\u5f52\u7248\u672c\u3001\u9879\u76ee\u6807\u51c6\u5f52\u9879\u76ee\u3001\u65b9\u6848\u5f52\u4efb\u52a1\u3001\u79c1\u6709\u7b97\u6cd5\u5f52\u5b9e\u73b0\u3002\u53ea\u6709\u771f\u5b9e\u5916\u90e8\u6d88\u8d39\u8005\u3001\u517c\u5bb9\u3001\u5b89\u5168\u3001\u786e\u5b9a\u6027\u6216\u5916\u90e8\u6027\u80fd\u627f\u8bfa\u9700\u8981\uff0c\u624d\u628a\u5b9e\u73b0\u673a\u5236\u63d0\u5347\u4e3a\u516c\u5171\u5408\u540c\uff1b\u6d4b\u8bd5\u65b9\u4fbf\u4e0d\u662f\u7406\u7531\uff0c\u5f15\u7528\u4e0d\u5f62\u6210\u7b2c\u4e8c\u6743\u5a01\u3002\u58f0\u79f0\u5b9e\u73b0\u5df2\u63a5\u53d7\u5951\u7ea6\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u7ed1\u5b9a\u5f53\u524d\u6743\u5a01\u3001\u8d1f\u8d23\u63a5\u70b9\u3001\u76f4\u63a5\u6d88\u8d39\u8005/\u6d4b\u8bd5\u4e0e\u8bc1\u636e\uff1b\u6765\u6e90\u5b9e\u8d28\u53d8\u5316\u5148\u91cd\u7ed1\u3002\u5141\u8bb8\u8f7b\u91cf @design-contract <locator> \u5b9a\u4f4d\u539f\u8bbe\u8ba1\u5e76\u4fdd\u7559\u9879\u76ee\u5df2\u6709\u5408\u7406\u6807\u8bb0\uff1b\u4e0d\u590d\u5236\u8bed\u4e49\u3001\u54c8\u5e0c\u6216\u901a\u8fc7\u72b6\u6001\uff0c\u4e0d\u58f0\u79f0\u6807\u8bb0\u8bc1\u660e\u5b9e\u73b0\u4e00\u81f4\uff0c\u4e0d\u8981\u6c42\u5168\u4ed3\u8865\u6807\u3001\u53f0\u8d26\u6216\u626b\u63cf\u3002\u6280\u672f\u4e8b\u5b9e\u5148\u6709\u754c\u67e5\u8bc1\uff0c\u53ea\u628a\u5b9e\u8d28\u76ee\u6807\u3001\u8303\u56f4\u3001\u6743\u9650\u6216\u98ce\u9669\u53d6\u820d\u4ea4\u7528\u6237\uff1b\u4e2d\u95f4\u56de\u7b54\u4e0d\u662f\u6574\u6848\u6388\u6743\uff0c\u4ecd\u6709\u6548\u51b3\u5b9a\u4e0d\u91cd\u590d\u786e\u8ba4\u3002\u91cd\u5927\u51b2\u7a81\u4e0e\u5fc5\u8981\u7528\u6237\u53d6\u820d\u5df2\u89e3\u51b3\u3001\u5269\u4f59\u5047\u8bbe\u6709\u754c\u4e14\u53ef\u9a8c\u8bc1\u548c\u6062\u590d\u65f6\uff0c\u65b9\u6848\u8db3\u591f\u5c31\u7eea\uff0c\u6cbf\u73b0\u6709\u6388\u6743\u63a8\u8fdb\uff1b\u672a\u5904\u7406\u91cd\u5927\u51b2\u7a81\u53ea\u505c\u53d7\u5f71\u54cd\u94fe\u3002\u6309\u5b9e\u9645 Review profile \u4fdd\u7559\u5fc5\u8981\u5ba1\u6838\uff0c\u666e\u901a\u4f4e\u5f71\u54cd\u4fee\u590d\u4e0d\u65b0\u589e\u5199\u524d\u5ba1\u6838\u9636\u6bb5\u3002\n\n\u53d8\u66f4\u5b9e\u9645\u5f71\u54cd\u73b0\u884c\u5951\u7ea6\u6216\u8bf4\u660e\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u5b9a\u4f4d\u53d7\u5f71\u54cd\u5b8c\u6574\u6b63\u6587\u3001\u7ef4\u62a4\u8005\u3001\u57fa\u7ebf\u548c\u76f4\u63a5\u4f9d\u8d56\uff0c\u4fdd\u7559\u6761\u4ef6\u3001\u4f8b\u5916\u53ca\u5e76\u53d1\u6709\u6548\u53d8\u66f4\uff0c\u5f62\u6210\u5408\u5e76\u540e\u5019\u9009\uff1b\u589e\u91cf\u4e0d\u4ee3\u66ff\u539f\u6587\uff0c\u89c4\u683c\u9884\u671f\u4e0d\u4ee3\u66ff\u5b9e\u73b0\u8bc1\u636e\u3002\u5fc5\u8981\u89c4\u8303\u5019\u9009\u968f\u6210\u679c\u5728\u9002\u7528\u5ba1\u6838\u548c\u63a5\u53d7\u524d\u51c6\u5907\uff0cOwner\u6309\u539f\u5408\u540c\u63a5\u53d7\u7cbe\u786e\u5019\u9009\uff1b\u540e\u7eed\u5fc5\u8981\u5199\u5165\u3001\u751f\u6548\u3001\u53d1\u884c\u6216\u91c7\u7528\u4ecd\u9700\u5bf9\u5e94\u6388\u6743\u3002\u843d\u5730\u524d\u590d\u6838\u57fa\u7ebf\uff0c\u65b0\u589e\u8bed\u4e49\u6216\u51b2\u7a81\u987b\u91cd\u7ed1\u5019\u9009\u5e76\u590d\u6838\u53d7\u5f71\u54cd\u90e8\u5206\uff0c\u4e0d\u4ee5\u201c\u540c\u6b65\u201d\u53d1\u5e03\u672a\u5ba1\u53d8\u5316\u3002\u672a\u5b8c\u6210\u672c\u6279\u627f\u8bfa\u7684\u89c4\u8303\u7ef4\u62a4\u4e0d\u5ba3\u79f0\u8be5\u9879\u5b8c\u6210\uff1b\u5408\u6cd5\u540e\u7f6e\u4e8b\u9879\u4fdd\u7559\u771f\u5b9e\u524d\u7f6e\u548c\u539f\u8d23\u4efb\u3002\u6309\u5b9e\u9645\u5f71\u54cd\u89e6\u53d1\uff0c\u4e0d\u5f3a\u5236\u65b0\u5efa\u89c4\u683c\u3001\u52a0\u8f7d\u65b9\u6cd5\u6216\u5168\u5e93\u626b\u63cf\uff1b\u5019\u9009\u5df2\u5728\u6700\u7ec8\u76ee\u5f55\u65f6\u4e0d\u8981\u6c42\u63a5\u53d7\u540e\u518d\u590d\u5236\u3002\u53ef\u9009\u8f6f\u4ef6\u8868\u8fbe\u89c1[\u8f6f\u4ef6\u884c\u4e3a\u89c4\u683c\u4e0e\u53d8\u66f4](knowledge/software/BEHAVIOR_SPEC_CHANGE.md)\u3002\n\n\u9047\u771f\u5b9e\u5931\u8d25\u3001\u4e13\u4e1a\u4e0d\u786e\u5b9a\u6027\u6216\u77e5\u8bc6\u7f3a\u53e3\u65f6\uff0c\u539f\u53c2\u4e0e\u8005\u5728\u539f\u4efb\u52a1\u5148\u533a\u5206\u5df2\u77e5\u7f3a\u9677\u3001\u4f7f\u7528\u504f\u5dee\u3001\u8d44\u6599/\u80fd\u529b\u4e0d\u8db3\u548c\u89c4\u5219\u51b2\u7a81\uff1b\u5df2\u6709\u77e5\u8bc6\u5145\u5206\u5219\u76f4\u63a5\u5e94\u7528\uff0c\u57fa\u7840\u4e0d\u8db3\u53ef\u6309\u76ee\u6807\u7cfb\u7edf\u8865\u5b66\u3002\u6309\u6b20\u7f3a\u7684\u5224\u65ad\u9009\u62e9\u5185\u5bb9\u4e0e\u6765\u6e90\uff0c\u5206\u6e05\u5b9e\u9645\u9605\u8bfb\u3001\u4e13\u4e1a\u89e3\u91ca\u3001\u5f85\u9a8c\u5efa\u8bae\u548c\u771f\u5b9e\u6548\u679c\uff1b\u5173\u952e\u51b2\u7a81\u6216\u80fd\u529b\u7f3a\u53e3\u53ea\u9650\u5236\u53d7\u5f71\u54cd\u51b3\u5b9a\u3002\u5c06\u4f9d\u636e\u843d\u5b9e\u4e3a\u5177\u4f53\u5224\u65ad/\u52a8\u4f5c\u3001\u4e8b\u524d\u9884\u671f\u53ca\u5bf9\u5e94\u9a8c\u8bc1\uff0c\u7531Owner\u6d88\u8d39\u7ed3\u679c\uff0c\u6309\u9700\u5b89\u6392\u6709\u754c\u4e13\u5bb6\u53ca\u5177\u5907\u4e13\u4e1a/\u5de5\u5177\u80fd\u529b\u7684\u9a8c\u8bc1\u8005\uff0c\u72ec\u7acb\u5ba1\u6838\u4ecd\u6ee1\u8db3\u539f\u72ec\u7acb\u6027\u3002\u5df2\u6709\u89c4\u5219\u5145\u5206\u5219\u7559\u6709\u4ef7\u503c\u6848\u4f8b\uff0c\u786e\u6709\u4e49\u52a1\u7f3a\u53e3\u624d\u6cbf\u539f\u89c4\u5219\u53d8\u66f4\u95e8\u4fee\u8ba2\uff1b\u6c89\u6dc0\u4fdd\u7559\u6761\u4ef6\u3001\u5931\u8d25\u3001\u672a\u77e5\u3001\u7ef4\u62a4\u8d23\u4efb\u548c\u4e0b\u6b21\u5165\u53e3\u3002\u4e0a\u8ff0\u4efb\u52a1\u8d23\u4efb\u4e0d\u4f9d\u8d56\u542f\u7528KNOWLEDGE_REFERENCE\u6216\u52a0\u8f7dMETHOD\uff1b\u4e0d\u589e\u52a0\u666e\u904d\u7814\u7a76\u8868\u5355\u3001\u5e38\u9a7b\u961f\u4f0d\u3001\u6bcf\u9898\u8054\u7f51\u6216\u989d\u5916\u6a21\u578b\u8bf7\u6c42\u3002\u5b8c\u6574\u53ef\u9009\u65b9\u6cd5\u89c1[\u95ee\u9898\u9a71\u52a8\u6539\u8fdb](knowledge/cross-domain/PROBLEM_DRIVEN_IMPROVEMENT.md)\uff0c\u4ec5\u5728\u5b9e\u9645\u9700\u8981\u65f6\u8bfb\u53d6\u3002\n\n\u5177\u4f53\u8f6f\u4ef6\u8bbe\u8ba1\u3001\u5b9e\u73b0\u548c\u6d4b\u8bd5\u65b9\u6cd5\u7531\u9879\u76ee\u9009\u62e9\u7684\u5b8c\u6574\u6807\u51c6\u63d0\u4f9b\uff1bFramework\u968f\u5305\u53ef\u9009\u6b63\u6587\u89c1standards/README.md\uff0c\u672a\u91c7\u7528\u4e0d\u81ea\u52a8\u8fdb\u5165\u89c4\u5219\u96c6\u5408\u3002\u751f\u4ea7\u548c\u5ba1\u6838\u5bf9\u540c\u4e00\u6210\u679c\u6d88\u8d39\u540c\u4e00\u9002\u7528\u4e13\u4e1a\u8981\u6c42\uff0c\u804c\u8d23\u7a0b\u5e8f\u4ecd\u6309\u5404\u81ea\u89d2\u8272\u9009\u62e9\u3002","preparationRequirements":["TASK_SCOPE_CURRENT"],"resultRequirements":["SCOPE_READBACK_COMPLETE"],"selectorIdentity":"154|18F2D6E677509B377730AC3A6CD950C41C4CEB8C3168DAAD3DD2503C342CA200","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","sourceIdentity":"21004|FAD841FC29B546A9D43267E3EB5C3238318E458BB0391E988197552EF4729875","fullText":"\u5728\u5df2\u63a5\u53d7\u76ee\u6807\u3001\u7cbe\u786e\u6388\u6743\u4e0e\u4fdd\u62a4\u8303\u56f4\u5185\uff0c\u5148\u7406\u89e3\u771f\u5b9e\u673a\u5236\u3001\u76f4\u63a5\u6d88\u8d39\u8005\u53ca\u5931\u8d25\u6062\u590d\uff1b\u6709\u591a\u6761\u5b9e\u8d28\u53ef\u884c\u8def\u7ebf\u65f6\u6bd4\u8f83\u73b0\u6709\u5b9e\u73b0\u3001\u6807\u51c6\u5e93/\u5e73\u53f0\u3001\u5df2\u6388\u6743\u4f9d\u8d56\u548c\u5fc5\u8981\u65b0\u4ee3\u7801\u7684\u6b63\u786e\u6027\u53ca\u603b\u6210\u672c\uff0c\u9009\u62e9\u6700\u5c0f\u5145\u5206\u65b9\u6848\u3002\u590d\u7528\u4e0d\u5b89\u5168\u6216\u9002\u914d\u4ee3\u4ef7\u66f4\u9ad8\u65f6\u53ef\u6709\u636e\u6362\u7528\uff0c\u4e0d\u4e3a\u5047\u8bbe\u672a\u6765\u65b0\u589e\u673a\u5668\u3002\u6210\u679c\u7c7b\u522b\u53ca\u9a8c\u6536\u4ee5\u7528\u6237\u76ee\u6807\u4e3a\u51c6\uff0c\u5206\u6790\u3001\u6d4b\u8bd5\u6216\u539f\u578b\u4e0d\u66ff\u4ee3\u8bf7\u6c42\u7684\u6b63\u5f0f\u4ea7\u7269\u3002\u666e\u901a\u4f4e\u5f71\u54cd\u4fee\u590d\u4e0d\u65b0\u589e\u5199\u524d\u5ba1\u67e5\u6216\u8868\u5355\uff1b\u91cd\u5927\u5951\u7ea6/\u98ce\u9669/\u8303\u56f4\u51b2\u7a81\u53ea\u505c\u6b62\u53d7\u5f71\u54cd\u94fe\u3002\u5065\u5eb7\u5df2\u5ba1\u7ed3\u8bba\u590d\u7528\uff0c\u5b9e\u9645\u65b0\u589e\u8bc1\u636e\u624d\u91cd\u5f00\u3002MICRO\u540c\u6837\u9075\u5b88\u8fd9\u4e9b\u539f\u5219\uff0c\u4e0d\u56e0\u6b64\u52a0\u8f7d\u5b8c\u6574\u4efb\u52a1\u7ef4\u62a4\u7a0b\u5e8f\u3002\n\n\u901a\u7528\u89c4\u5219\u5f52\u7248\u672c\u3001\u9879\u76ee\u6807\u51c6\u5f52\u9879\u76ee\u3001\u65b9\u6848\u5f52\u4efb\u52a1\u3001\u79c1\u6709\u7b97\u6cd5\u5f52\u5b9e\u73b0\u3002\u53ea\u6709\u771f\u5b9e\u5916\u90e8\u6d88\u8d39\u8005\u3001\u517c\u5bb9\u3001\u5b89\u5168\u3001\u786e\u5b9a\u6027\u6216\u5916\u90e8\u6027\u80fd\u627f\u8bfa\u9700\u8981\uff0c\u624d\u628a\u5b9e\u73b0\u673a\u5236\u63d0\u5347\u4e3a\u516c\u5171\u5408\u540c\uff1b\u6d4b\u8bd5\u65b9\u4fbf\u4e0d\u662f\u7406\u7531\uff0c\u5f15\u7528\u4e0d\u5f62\u6210\u7b2c\u4e8c\u6743\u5a01\u3002\u58f0\u79f0\u5b9e\u73b0\u5df2\u63a5\u53d7\u5951\u7ea6\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u7ed1\u5b9a\u5f53\u524d\u6743\u5a01\u3001\u8d1f\u8d23\u63a5\u70b9\u3001\u76f4\u63a5\u6d88\u8d39\u8005/\u6d4b\u8bd5\u4e0e\u8bc1\u636e\uff1b\u6765\u6e90\u5b9e\u8d28\u53d8\u5316\u5148\u91cd\u7ed1\u3002\u5141\u8bb8\u8f7b\u91cf @design-contract <locator> \u5b9a\u4f4d\u539f\u8bbe\u8ba1\u5e76\u4fdd\u7559\u9879\u76ee\u5df2\u6709\u5408\u7406\u6807\u8bb0\uff1b\u4e0d\u590d\u5236\u8bed\u4e49\u3001\u54c8\u5e0c\u6216\u901a\u8fc7\u72b6\u6001\uff0c\u4e0d\u58f0\u79f0\u6807\u8bb0\u8bc1\u660e\u5b9e\u73b0\u4e00\u81f4\uff0c\u4e0d\u8981\u6c42\u5168\u4ed3\u8865\u6807\u3001\u53f0\u8d26\u6216\u626b\u63cf\u3002\u6280\u672f\u4e8b\u5b9e\u5148\u6709\u754c\u67e5\u8bc1\uff0c\u53ea\u628a\u5b9e\u8d28\u76ee\u6807\u3001\u8303\u56f4\u3001\u6743\u9650\u6216\u98ce\u9669\u53d6\u820d\u4ea4\u7528\u6237\uff1b\u4e2d\u95f4\u56de\u7b54\u4e0d\u662f\u6574\u6848\u6388\u6743\uff0c\u4ecd\u6709\u6548\u51b3\u5b9a\u4e0d\u91cd\u590d\u786e\u8ba4\u3002\u91cd\u5927\u51b2\u7a81\u4e0e\u5fc5\u8981\u7528\u6237\u53d6\u820d\u5df2\u89e3\u51b3\u3001\u5269\u4f59\u5047\u8bbe\u6709\u754c\u4e14\u53ef\u9a8c\u8bc1\u548c\u6062\u590d\u65f6\uff0c\u65b9\u6848\u8db3\u591f\u5c31\u7eea\uff0c\u6cbf\u73b0\u6709\u6388\u6743\u63a8\u8fdb\uff1b\u672a\u5904\u7406\u91cd\u5927\u51b2\u7a81\u53ea\u505c\u53d7\u5f71\u54cd\u94fe\u3002\u6309\u5b9e\u9645 Review profile \u4fdd\u7559\u5fc5\u8981\u5ba1\u6838\uff0c\u666e\u901a\u4f4e\u5f71\u54cd\u4fee\u590d\u4e0d\u65b0\u589e\u5199\u524d\u5ba1\u6838\u9636\u6bb5\u3002\n\n\u53d8\u66f4\u5b9e\u9645\u5f71\u54cd\u73b0\u884c\u5951\u7ea6\u6216\u8bf4\u660e\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u5b9a\u4f4d\u53d7\u5f71\u54cd\u5b8c\u6574\u6b63\u6587\u3001\u7ef4\u62a4\u8005\u3001\u57fa\u7ebf\u548c\u76f4\u63a5\u4f9d\u8d56\uff0c\u4fdd\u7559\u6761\u4ef6\u3001\u4f8b\u5916\u53ca\u5e76\u53d1\u6709\u6548\u53d8\u66f4\uff0c\u5f62\u6210\u5408\u5e76\u540e\u5019\u9009\uff1b\u589e\u91cf\u4e0d\u4ee3\u66ff\u539f\u6587\uff0c\u89c4\u683c\u9884\u671f\u4e0d\u4ee3\u66ff\u5b9e\u73b0\u8bc1\u636e\u3002\u5fc5\u8981\u89c4\u8303\u5019\u9009\u968f\u6210\u679c\u5728\u9002\u7528\u5ba1\u6838\u548c\u63a5\u53d7\u524d\u51c6\u5907\uff0cOwner\u6309\u539f\u5408\u540c\u63a5\u53d7\u7cbe\u786e\u5019\u9009\uff1b\u540e\u7eed\u5fc5\u8981\u5199\u5165\u3001\u751f\u6548\u3001\u53d1\u884c\u6216\u91c7\u7528\u4ecd\u9700\u5bf9\u5e94\u6388\u6743\u3002\u843d\u5730\u524d\u590d\u6838\u57fa\u7ebf\uff0c\u65b0\u589e\u8bed\u4e49\u6216\u51b2\u7a81\u987b\u91cd\u7ed1\u5019\u9009\u5e76\u590d\u6838\u53d7\u5f71\u54cd\u90e8\u5206\uff0c\u4e0d\u4ee5\u201c\u540c\u6b65\u201d\u53d1\u5e03\u672a\u5ba1\u53d8\u5316\u3002\u672a\u5b8c\u6210\u672c\u6279\u627f\u8bfa\u7684\u89c4\u8303\u7ef4\u62a4\u4e0d\u5ba3\u79f0\u8be5\u9879\u5b8c\u6210\uff1b\u5408\u6cd5\u540e\u7f6e\u4e8b\u9879\u4fdd\u7559\u771f\u5b9e\u524d\u7f6e\u548c\u539f\u8d23\u4efb\u3002\u6309\u5b9e\u9645\u5f71\u54cd\u89e6\u53d1\uff0c\u4e0d\u5f3a\u5236\u65b0\u5efa\u89c4\u683c\u3001\u52a0\u8f7d\u65b9\u6cd5\u6216\u5168\u5e93\u626b\u63cf\uff1b\u5019\u9009\u5df2\u5728\u6700\u7ec8\u76ee\u5f55\u65f6\u4e0d\u8981\u6c42\u63a5\u53d7\u540e\u518d\u590d\u5236\u3002\u53ef\u9009\u8f6f\u4ef6\u8868\u8fbe\u89c1[\u8f6f\u4ef6\u884c\u4e3a\u89c4\u683c\u4e0e\u53d8\u66f4](knowledge/software/BEHAVIOR_SPEC_CHANGE.md)\u3002\n\n\u9047\u771f\u5b9e\u5931\u8d25\u3001\u4e13\u4e1a\u4e0d\u786e\u5b9a\u6027\u6216\u77e5\u8bc6\u7f3a\u53e3\u65f6\uff0c\u539f\u53c2\u4e0e\u8005\u5728\u539f\u4efb\u52a1\u5148\u533a\u5206\u5df2\u77e5\u7f3a\u9677\u3001\u4f7f\u7528\u504f\u5dee\u3001\u8d44\u6599/\u80fd\u529b\u4e0d\u8db3\u548c\u89c4\u5219\u51b2\u7a81\uff1b\u5df2\u6709\u77e5\u8bc6\u5145\u5206\u5219\u76f4\u63a5\u5e94\u7528\uff0c\u57fa\u7840\u4e0d\u8db3\u53ef\u6309\u76ee\u6807\u7cfb\u7edf\u8865\u5b66\u3002\u6309\u6b20\u7f3a\u7684\u5224\u65ad\u9009\u62e9\u5185\u5bb9\u4e0e\u6765\u6e90\uff0c\u5206\u6e05\u5b9e\u9645\u9605\u8bfb\u3001\u4e13\u4e1a\u89e3\u91ca\u3001\u5f85\u9a8c\u5efa\u8bae\u548c\u771f\u5b9e\u6548\u679c\uff1b\u5173\u952e\u51b2\u7a81\u6216\u80fd\u529b\u7f3a\u53e3\u53ea\u9650\u5236\u53d7\u5f71\u54cd\u51b3\u5b9a\u3002\u5c06\u4f9d\u636e\u843d\u5b9e\u4e3a\u5177\u4f53\u5224\u65ad/\u52a8\u4f5c\u3001\u4e8b\u524d\u9884\u671f\u53ca\u5bf9\u5e94\u9a8c\u8bc1\uff0c\u7531Owner\u6d88\u8d39\u7ed3\u679c\uff0c\u6309\u9700\u5b89\u6392\u6709\u754c\u4e13\u5bb6\u53ca\u5177\u5907\u4e13\u4e1a/\u5de5\u5177\u80fd\u529b\u7684\u9a8c\u8bc1\u8005\uff0c\u72ec\u7acb\u5ba1\u6838\u4ecd\u6ee1\u8db3\u539f\u72ec\u7acb\u6027\u3002\u5df2\u6709\u89c4\u5219\u5145\u5206\u5219\u7559\u6709\u4ef7\u503c\u6848\u4f8b\uff0c\u786e\u6709\u4e49\u52a1\u7f3a\u53e3\u624d\u6cbf\u539f\u89c4\u5219\u53d8\u66f4\u95e8\u4fee\u8ba2\uff1b\u6c89\u6dc0\u4fdd\u7559\u6761\u4ef6\u3001\u5931\u8d25\u3001\u672a\u77e5\u3001\u7ef4\u62a4\u8d23\u4efb\u548c\u4e0b\u6b21\u5165\u53e3\u3002\u4e0a\u8ff0\u4efb\u52a1\u8d23\u4efb\u4e0d\u4f9d\u8d56\u542f\u7528KNOWLEDGE_REFERENCE\u6216\u52a0\u8f7dMETHOD\uff1b\u4e0d\u589e\u52a0\u666e\u904d\u7814\u7a76\u8868\u5355\u3001\u5e38\u9a7b\u961f\u4f0d\u3001\u6bcf\u9898\u8054\u7f51\u6216\u989d\u5916\u6a21\u578b\u8bf7\u6c42\u3002\u5b8c\u6574\u53ef\u9009\u65b9\u6cd5\u89c1[\u95ee\u9898\u9a71\u52a8\u6539\u8fdb](knowledge/cross-domain/PROBLEM_DRIVEN_IMPROVEMENT.md)\uff0c\u4ec5\u5728\u5b9e\u9645\u9700\u8981\u65f6\u8bfb\u53d6\u3002\n\n\u5177\u4f53\u8f6f\u4ef6\u8bbe\u8ba1\u3001\u5b9e\u73b0\u548c\u6d4b\u8bd5\u65b9\u6cd5\u7531\u9879\u76ee\u9009\u62e9\u7684\u5b8c\u6574\u6807\u51c6\u63d0\u4f9b\uff1bFramework\u968f\u5305\u53ef\u9009\u6b63\u6587\u89c1standards/README.md\uff0c\u672a\u91c7\u7528\u4e0d\u81ea\u52a8\u8fdb\u5165\u89c4\u5219\u96c6\u5408\u3002\u751f\u4ea7\u548c\u5ba1\u6838\u5bf9\u540c\u4e00\u6210\u679c\u6d88\u8d39\u540c\u4e00\u9002\u7528\u4e13\u4e1a\u8981\u6c42\uff0c\u804c\u8d23\u7a0b\u5e8f\u4ecd\u6309\u5404\u81ea\u89d2\u8272\u9009\u62e9\u3002","orderedDependencies":[]}],"declarationIdentity":"671|41B536C4E085286BFA56FC9C35EEB0129211F0F43560222B03E1E7FF4C37CD05"},{"requirementId":"framework:PR_TASK_OWNER_DIRECT_DOMAIN_EXTERNAL","source":"FRAMEWORK","ownerModule":"GIT_AND_EXTERNAL.md","semanticApplicability":"DETERMINISTIC","fullText":"\u9879\u76eeexternalAuthorization\u7f3a\u7701PER_ACTION\u3002\u663e\u5f0fPROJECT_PREAUTHORIZED\u5f15\u7528\u65e2\u6709\u9879\u76ee\u8bb8\u53ef\u89c4\u5219\uff0c\u53ea\u6709\u672c\u6d3b\u52a8\u5b9e\u9645\u9002\u7528\u4e14\u5f53\u524d\u4ecd\u8986\u76d6\u8be5\u8c03\u7528\u65f6\uff0c\u6267\u884c\u8005\u76f4\u63a5\u8c03\u7528\u539f\u5de5\u5177\uff1b\u65e0\u9700\u9010\u6b21\u65b0\u5361\u3001\u52a8\u4f5c\u5305\u6216\u6a21\u578bD/A/F\u3002\u5de5\u5177/provider\u3001\u64cd\u4f5c\u3001\u8d26\u53f7/\u6570\u636e\u3001\u8d39\u7528/\u5171\u4eab\u8d44\u6e90\u3001\u53ef\u6267\u884c\u548c\u59d4\u6d3e\u8005\u3001\u91cd\u8bd5/\u505c\u6b62/\u6062\u590d\u7531\u9879\u76ee\u6b63\u6587\u51b3\u5b9a\uff0c\u4e0d\u53e6\u5efa\u6846\u67b6\u8bb8\u53ef\u5f15\u64ce\u3002\u539f\u5de5\u5177/\u5bbf\u4e3b\u8fd4\u56de\u4fdd\u5b9e\u9645\u8bf7\u6c42\u3001\u6b21\u6570\u3001\u8d44\u6e90\u3001\u8f93\u51fa\u4e0eSUCCESS/FAILURE/UNKNOWN\uff1b\u5f53\u524d\u6210\u679c\u7684\u4e13\u4e1a\u9a8c\u6536\u53e6\u6309\u9879\u76ee\u8981\u6c42\u5b8c\u6210\u3002\u672a\u77e5\u6d88\u8d39\u4e0d\u76f2\u91cd\u53d1\uff0c\u4e0d\u80fd\u628a\u540e\u7eed\u653f\u7b56\u53d8\u5316\u5f53\u4f5c\u62b9\u53bb\u5df2\u53d1\u751f\u4e8b\u5b9e\u6216\u5141\u8bb8\u518d\u6b21\u8c03\u7528\u7684\u4f9d\u636e\u3002\n\n\u4ee5\u4e0bbinding1/2\u53ca\u6279\u6b21\u5b57\u6bb5\u7528\u4e8ePER_ACTION\u6216\u660e\u786e\u9009\u62e9\u539f\u6309\u6b21\u5165\u53e3\u7684\u52a8\u4f5c\u3002TASK_OWNER\u53ef\u5728\u5f53\u524d\u9886\u57df\u8d23\u4efb\u548c\u771f\u5b9e\u65e2\u6709\u7528\u6237/\u9879\u76ee\u8d44\u6e90\u8bb8\u53ef\u5185\uff0c\u4e3a\u6709\u9650\u3001\u6709\u5e8f\u4e14\u53ef\u9a8c\u6536\u7684EXTERNAL\u6279\u6b21\u7b7e\u7eaf\u52a8\u4f5c\u5305\u3002\u65e7FREE/0\u5206\u652f\u4fdd\u6301\uff1bexternalBinding2\u53ef\u5f15\u7528\u5df2\u6279\u51c6\u4ed8\u8d39\u6216\u5171\u4eab\u8d44\u6e90\u7684grantRefs\uff0c\u524d\u63d0\u662f\u672c\u6b21\u7528\u9014\u3001provider\u3001\u64cd\u4f5c\u3001payload\u53ca\u539f\u8bb8\u53ef\u5b9e\u9645\u7ea6\u675f\u5b8c\u6574\u53ef\u6838\u5bf9\u3002\u672a\u89c4\u5b9a\u91d1\u989d\u3001\u5e01\u79cd\u6216\u5230\u671f\u65e5\u4e0d\u81ea\u52a8\u7b97UNKNOWN\uff0c\u4e5f\u4e0d\u63a8\u5bfc\u65e0\u9650\u989d\u5ea6\uff1b\u53ea\u6821\u9a8c\u539f\u8bb8\u53ef\u5b9e\u9645\u89c4\u5b9a\u4e14\u672c\u6b21\u4f9d\u8d56\u7684\u6761\u4ef6\u3002\n\n\u540c\u4e00\u6210\u679c\u7684\u65e2\u6709\u8d44\u6e90\u8bb8\u53ef\u4ecd\u6709\u6548\u4e14\u660e\u786e\u5141\u8bb8Owner\u59d4\u6d3e\u65f6\uff0cOwner\u53ef\u76f4\u63a5\u7b7e\u7ed9\u5177\u540d\u539f\u4e13\u4e1a\u6267\u884c\u8005\uff0c\u590d\u7528grantee\u53ca\u539fgrantRefs\uff1bexternalBinding2\u7684grantAssessment\u987b\u660e\u786edelegationPermitted=true\u3002\u7701\u7565\u6216false\u4e0d\u6388\u59d4\u6d3e\uff0c\u65e7binding1\u4ecd\u4ec5Owner\u81ea\u7528\u3002binding2\u4e0bOwner\u4e3b\u8def\u7ebf\u4ecd\u987bactor=Owner\u3001role=TASK_OWNER\uff0c\u4f46\u53ef\u4fdd\u6709\u5f53\u524d\u5408\u6cd5\u4e3bphase\uff1bOwner\u4eb2\u81ea\u6267\u884c\u7684\u6709\u6548\u9636\u6bb5\u4e3aEXTERNAL\uff0c\u5177\u540d\u6267\u884c\u8005\u6309\u4e34\u65f6EXECUTOR/EXTERNAL\u6d88\u8d39\u3002\u5b8c\u6574\u6388\u6743\u5148\u6838\u5bf9\uff0c\u4e24\u8005\u5747\u4e0d\u6539\u53d8Owner\u3001Work route\u6216\u7236\u4efb\u52a1\uff1bbinding1\u4fdd\u7559Owner\u4e3b\u9636\u6bb5EXTERNAL\u53caFREE/0\u65e7\u7ea6\u675f\u3002Owner\u53ca\u63a5\u6536\u8005\u987b\u6838\u539f\u8bb8\u53ef\u7684\u59d4\u6d3e\u8303\u56f4\u3001\u5b9e\u9645\u8d26\u53f7\u3001\u8d39\u7528\u3001\u5171\u4eab\u6761\u4ef6\u4e0e\u5f53\u524d\u64a4\u56de/\u51b2\u7a81\u4e8b\u5b9e\uff1b\u8be5\u58f0\u660e\u4ec5\u4e3aINSTRUCTION_BOUND\u5224\u65ad\uff0c\u4e0d\u662f\u673a\u68b0\u8bed\u4e49\u8bc1\u660e\u3001\u7528\u6237\u8ba4\u8bc1\u6216\u65b0\u8bb8\u53ef\u3002\u8bb8\u53ef\u7981\u8f6c\u6388\u3001\u672a\u77e5\u6216\u9879\u76ee\u4fdd\u7559\u51b3\u5b9a\u4ea4\u5b9e\u9645\u6709\u6743\u8005\uff0c\u4e0d\u9760\u4e3b\u63a7\u7eaf\u8f6c\u7b7e\u6216\u63d0\u5347\u6267\u884c\u8005\u4e3aOwner\u7ed5\u8fc7\u3002\n\n\u6279\u6b21\u7ed1\u5b9a\u7cbe\u786epayload/\u8f93\u51fa\u7528\u9014\u3001\u5fc5\u8981\u6570\u91cf\u4e0e\u91cd\u8bd5\u4e0a\u9650\u3001\u505c\u6b62\u53ca\u6062\u590d\u6761\u4ef6\uff1b\u6ca1\u6709\u9879\u76ee\u6570\u636e\u7684\u64cd\u4f5c\u4ec5\u6309TOOL_CONTRACT\u5c01\u95edZERO_PROJECT_DATA\u7c7b\u522b\u5904\u7406\u3002\u6279\u51c6\u8d44\u6599\u8bfb\u53d6\u4e0d\u81ea\u52a8\u6279\u51c6\u4e0a\u4f20\u6216\u6b63\u5f0f\u8d44\u4ea7\u6fc0\u6d3b\u3002ONE_LOGICAL_ATOMIC_EXECUTION\u53ea\u8868\u793a\u6709\u9650\u6709\u5e8f\u6cbb\u7406\u6279\u6b21\uff0c\u4e0d\u627f\u8bfa\u4f9b\u5e94\u5546\u7269\u7406\u4e8b\u52a1\uff1breissuable=false\u4e0d\u62b9\u53bb\u539f\u8bb8\u53ef\u660e\u786e\u7684\u6bcf\u64cd\u4f5c\u6709\u9650\u91cd\u8bd5\uff0c\u4f46\u7981\u6b62\u6574\u4e2a\u672a\u77e5\u6279\u6b21\u76f2\u91cd\u53d1\u3002UNKNOWN\u53ea\u6cbf\u539f\u8bb8\u53ef\u4e14\u4f9b\u5e94\u5546\u53ef\u8bc1\u5b89\u5168\u7684\u6062\u590d/\u67e5\u8be2\uff0c\u4e0d\u91cd\u5f00\u6279\u6b21\u6e05\u96f6\u6b21\u6570\u3002\n\n\u5df2\u6709grant\u5b8c\u6574\u8986\u76d6\u7684\u4ed8\u8d39/\u5171\u4eab\u4f7f\u7528\u4e0d\u56e0\u7c7b\u522b\u518d\u6b21\u7d22\u6279\u6216\u5f3a\u5236Controller\u4e2d\u8f6c\u3002\u5404escalationFlags\u4ecd\u6309\u771f\u5b9e\u884c\u4e3a\u9010\u9879\u660e\u786e\u586b\u5199\uff0c\u4e0d\u7531\u4e00\u822cgrant\u6216payload\u8eab\u4efd\u63a8\u65adfalse\uff1bbinding2\u4ec5sharedQuotaOrResource\u53ef\u7531\u539fgrant\u8986\u76d6\u3002\u65b0\u8d2d\u4e70/\u8ba2\u9605\u3001\u5546\u4e1a\u8bb8\u53ef\u6539\u53d8\u3001\u8d26\u6237/\u51ed\u636e\u53d8\u5316\u3001\u516c\u5f00\u53d1\u5e03\u3001\u5b89\u88c5\u3001\u53d7\u4fdd\u62a4/\u79d8\u5bc6\u4e0a\u4f20\u3001\u8de8\u57df/\u9636\u6bb5\u53d8\u5316\u3001\u6b63\u5f0f\u8d44\u4ea7\u6fc0\u6d3b\u53ca\u5176\u4ed6true\u7c7b\u522b\u4e0d\u7531\u6b64\u901a\u9053\u653e\u884c\uff0c\u4ecd\u8d70\u76f8\u5e94\u8d23\u4efb\u4e0e\u72ec\u7acb\u95e8\uff1b\u771f\u5b9e\u64a4\u56de\u3001\u8d8ascope\u6216\u5fc5\u8981\u4e8b\u5b9e\u672a\u77e5\u53ea\u505c\u53d7\u5f71\u54cd\u52a8\u4f5c\u3002\u6539\u53d8result kind\u4e0d\u7ed5\u68c0\u67e5\uff0cGit/PUSH\u53e6\u8d70\u4e13\u95e8\u5408\u540c\u3002Framework\u4e0d\u7ba1\u7406\u9879\u76ee\u9884\u7b97\u6216\u8ba1\u8d39\u8d26\u672c\uff0cchecker\u3001\u8fc7\u7a0b\u4e0e\u771f\u5b9ehost\u80fd\u529b\u5206\u522b\u6210\u7acb\u3002","preparationRequirements":["DOMAIN_EXTERNAL_PACKAGE_VALID","EXTERNAL_PAYLOAD_IDENTITIES_BOUND","USER_EXTERNAL_DECISION_BOUND"],"resultRequirements":["DOMAIN_EXTERNAL_BATCH_RESULT_OBSERVED"],"selectorIdentity":"206|EDC56629D85EBCC4649567C904C9B9D817B5A02F11EC3B47A1A5E6AB72006921","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\GIT_AND_EXTERNAL.md","sourceIdentity":"6537|70C5D799142FB942EB289B44421D73D08BB8AB232581EAA43C4D49C03E9E2B46","fullText":"\u9879\u76eeexternalAuthorization\u7f3a\u7701PER_ACTION\u3002\u663e\u5f0fPROJECT_PREAUTHORIZED\u5f15\u7528\u65e2\u6709\u9879\u76ee\u8bb8\u53ef\u89c4\u5219\uff0c\u53ea\u6709\u672c\u6d3b\u52a8\u5b9e\u9645\u9002\u7528\u4e14\u5f53\u524d\u4ecd\u8986\u76d6\u8be5\u8c03\u7528\u65f6\uff0c\u6267\u884c\u8005\u76f4\u63a5\u8c03\u7528\u539f\u5de5\u5177\uff1b\u65e0\u9700\u9010\u6b21\u65b0\u5361\u3001\u52a8\u4f5c\u5305\u6216\u6a21\u578bD/A/F\u3002\u5de5\u5177/provider\u3001\u64cd\u4f5c\u3001\u8d26\u53f7/\u6570\u636e\u3001\u8d39\u7528/\u5171\u4eab\u8d44\u6e90\u3001\u53ef\u6267\u884c\u548c\u59d4\u6d3e\u8005\u3001\u91cd\u8bd5/\u505c\u6b62/\u6062\u590d\u7531\u9879\u76ee\u6b63\u6587\u51b3\u5b9a\uff0c\u4e0d\u53e6\u5efa\u6846\u67b6\u8bb8\u53ef\u5f15\u64ce\u3002\u539f\u5de5\u5177/\u5bbf\u4e3b\u8fd4\u56de\u4fdd\u5b9e\u9645\u8bf7\u6c42\u3001\u6b21\u6570\u3001\u8d44\u6e90\u3001\u8f93\u51fa\u4e0eSUCCESS/FAILURE/UNKNOWN\uff1b\u5f53\u524d\u6210\u679c\u7684\u4e13\u4e1a\u9a8c\u6536\u53e6\u6309\u9879\u76ee\u8981\u6c42\u5b8c\u6210\u3002\u672a\u77e5\u6d88\u8d39\u4e0d\u76f2\u91cd\u53d1\uff0c\u4e0d\u80fd\u628a\u540e\u7eed\u653f\u7b56\u53d8\u5316\u5f53\u4f5c\u62b9\u53bb\u5df2\u53d1\u751f\u4e8b\u5b9e\u6216\u5141\u8bb8\u518d\u6b21\u8c03\u7528\u7684\u4f9d\u636e\u3002\n\n\u4ee5\u4e0bbinding1/2\u53ca\u6279\u6b21\u5b57\u6bb5\u7528\u4e8ePER_ACTION\u6216\u660e\u786e\u9009\u62e9\u539f\u6309\u6b21\u5165\u53e3\u7684\u52a8\u4f5c\u3002TASK_OWNER\u53ef\u5728\u5f53\u524d\u9886\u57df\u8d23\u4efb\u548c\u771f\u5b9e\u65e2\u6709\u7528\u6237/\u9879\u76ee\u8d44\u6e90\u8bb8\u53ef\u5185\uff0c\u4e3a\u6709\u9650\u3001\u6709\u5e8f\u4e14\u53ef\u9a8c\u6536\u7684EXTERNAL\u6279\u6b21\u7b7e\u7eaf\u52a8\u4f5c\u5305\u3002\u65e7FREE/0\u5206\u652f\u4fdd\u6301\uff1bexternalBinding2\u53ef\u5f15\u7528\u5df2\u6279\u51c6\u4ed8\u8d39\u6216\u5171\u4eab\u8d44\u6e90\u7684grantRefs\uff0c\u524d\u63d0\u662f\u672c\u6b21\u7528\u9014\u3001provider\u3001\u64cd\u4f5c\u3001payload\u53ca\u539f\u8bb8\u53ef\u5b9e\u9645\u7ea6\u675f\u5b8c\u6574\u53ef\u6838\u5bf9\u3002\u672a\u89c4\u5b9a\u91d1\u989d\u3001\u5e01\u79cd\u6216\u5230\u671f\u65e5\u4e0d\u81ea\u52a8\u7b97UNKNOWN\uff0c\u4e5f\u4e0d\u63a8\u5bfc\u65e0\u9650\u989d\u5ea6\uff1b\u53ea\u6821\u9a8c\u539f\u8bb8\u53ef\u5b9e\u9645\u89c4\u5b9a\u4e14\u672c\u6b21\u4f9d\u8d56\u7684\u6761\u4ef6\u3002\n\n\u540c\u4e00\u6210\u679c\u7684\u65e2\u6709\u8d44\u6e90\u8bb8\u53ef\u4ecd\u6709\u6548\u4e14\u660e\u786e\u5141\u8bb8Owner\u59d4\u6d3e\u65f6\uff0cOwner\u53ef\u76f4\u63a5\u7b7e\u7ed9\u5177\u540d\u539f\u4e13\u4e1a\u6267\u884c\u8005\uff0c\u590d\u7528grantee\u53ca\u539fgrantRefs\uff1bexternalBinding2\u7684grantAssessment\u987b\u660e\u786edelegationPermitted=true\u3002\u7701\u7565\u6216false\u4e0d\u6388\u59d4\u6d3e\uff0c\u65e7binding1\u4ecd\u4ec5Owner\u81ea\u7528\u3002binding2\u4e0bOwner\u4e3b\u8def\u7ebf\u4ecd\u987bactor=Owner\u3001role=TASK_OWNER\uff0c\u4f46\u53ef\u4fdd\u6709\u5f53\u524d\u5408\u6cd5\u4e3bphase\uff1bOwner\u4eb2\u81ea\u6267\u884c\u7684\u6709\u6548\u9636\u6bb5\u4e3aEXTERNAL\uff0c\u5177\u540d\u6267\u884c\u8005\u6309\u4e34\u65f6EXECUTOR/EXTERNAL\u6d88\u8d39\u3002\u5b8c\u6574\u6388\u6743\u5148\u6838\u5bf9\uff0c\u4e24\u8005\u5747\u4e0d\u6539\u53d8Owner\u3001Work route\u6216\u7236\u4efb\u52a1\uff1bbinding1\u4fdd\u7559Owner\u4e3b\u9636\u6bb5EXTERNAL\u53caFREE/0\u65e7\u7ea6\u675f\u3002Owner\u53ca\u63a5\u6536\u8005\u987b\u6838\u539f\u8bb8\u53ef\u7684\u59d4\u6d3e\u8303\u56f4\u3001\u5b9e\u9645\u8d26\u53f7\u3001\u8d39\u7528\u3001\u5171\u4eab\u6761\u4ef6\u4e0e\u5f53\u524d\u64a4\u56de/\u51b2\u7a81\u4e8b\u5b9e\uff1b\u8be5\u58f0\u660e\u4ec5\u4e3aINSTRUCTION_BOUND\u5224\u65ad\uff0c\u4e0d\u662f\u673a\u68b0\u8bed\u4e49\u8bc1\u660e\u3001\u7528\u6237\u8ba4\u8bc1\u6216\u65b0\u8bb8\u53ef\u3002\u8bb8\u53ef\u7981\u8f6c\u6388\u3001\u672a\u77e5\u6216\u9879\u76ee\u4fdd\u7559\u51b3\u5b9a\u4ea4\u5b9e\u9645\u6709\u6743\u8005\uff0c\u4e0d\u9760\u4e3b\u63a7\u7eaf\u8f6c\u7b7e\u6216\u63d0\u5347\u6267\u884c\u8005\u4e3aOwner\u7ed5\u8fc7\u3002\n\n\u6279\u6b21\u7ed1\u5b9a\u7cbe\u786epayload/\u8f93\u51fa\u7528\u9014\u3001\u5fc5\u8981\u6570\u91cf\u4e0e\u91cd\u8bd5\u4e0a\u9650\u3001\u505c\u6b62\u53ca\u6062\u590d\u6761\u4ef6\uff1b\u6ca1\u6709\u9879\u76ee\u6570\u636e\u7684\u64cd\u4f5c\u4ec5\u6309TOOL_CONTRACT\u5c01\u95edZERO_PROJECT_DATA\u7c7b\u522b\u5904\u7406\u3002\u6279\u51c6\u8d44\u6599\u8bfb\u53d6\u4e0d\u81ea\u52a8\u6279\u51c6\u4e0a\u4f20\u6216\u6b63\u5f0f\u8d44\u4ea7\u6fc0\u6d3b\u3002ONE_LOGICAL_ATOMIC_EXECUTION\u53ea\u8868\u793a\u6709\u9650\u6709\u5e8f\u6cbb\u7406\u6279\u6b21\uff0c\u4e0d\u627f\u8bfa\u4f9b\u5e94\u5546\u7269\u7406\u4e8b\u52a1\uff1breissuable=false\u4e0d\u62b9\u53bb\u539f\u8bb8\u53ef\u660e\u786e\u7684\u6bcf\u64cd\u4f5c\u6709\u9650\u91cd\u8bd5\uff0c\u4f46\u7981\u6b62\u6574\u4e2a\u672a\u77e5\u6279\u6b21\u76f2\u91cd\u53d1\u3002UNKNOWN\u53ea\u6cbf\u539f\u8bb8\u53ef\u4e14\u4f9b\u5e94\u5546\u53ef\u8bc1\u5b89\u5168\u7684\u6062\u590d/\u67e5\u8be2\uff0c\u4e0d\u91cd\u5f00\u6279\u6b21\u6e05\u96f6\u6b21\u6570\u3002\n\n\u5df2\u6709grant\u5b8c\u6574\u8986\u76d6\u7684\u4ed8\u8d39/\u5171\u4eab\u4f7f\u7528\u4e0d\u56e0\u7c7b\u522b\u518d\u6b21\u7d22\u6279\u6216\u5f3a\u5236Controller\u4e2d\u8f6c\u3002\u5404escalationFlags\u4ecd\u6309\u771f\u5b9e\u884c\u4e3a\u9010\u9879\u660e\u786e\u586b\u5199\uff0c\u4e0d\u7531\u4e00\u822cgrant\u6216payload\u8eab\u4efd\u63a8\u65adfalse\uff1bbinding2\u4ec5sharedQuotaOrResource\u53ef\u7531\u539fgrant\u8986\u76d6\u3002\u65b0\u8d2d\u4e70/\u8ba2\u9605\u3001\u5546\u4e1a\u8bb8\u53ef\u6539\u53d8\u3001\u8d26\u6237/\u51ed\u636e\u53d8\u5316\u3001\u516c\u5f00\u53d1\u5e03\u3001\u5b89\u88c5\u3001\u53d7\u4fdd\u62a4/\u79d8\u5bc6\u4e0a\u4f20\u3001\u8de8\u57df/\u9636\u6bb5\u53d8\u5316\u3001\u6b63\u5f0f\u8d44\u4ea7\u6fc0\u6d3b\u53ca\u5176\u4ed6true\u7c7b\u522b\u4e0d\u7531\u6b64\u901a\u9053\u653e\u884c\uff0c\u4ecd\u8d70\u76f8\u5e94\u8d23\u4efb\u4e0e\u72ec\u7acb\u95e8\uff1b\u771f\u5b9e\u64a4\u56de\u3001\u8d8ascope\u6216\u5fc5\u8981\u4e8b\u5b9e\u672a\u77e5\u53ea\u505c\u53d7\u5f71\u54cd\u52a8\u4f5c\u3002\u6539\u53d8result kind\u4e0d\u7ed5\u68c0\u67e5\uff0cGit/PUSH\u53e6\u8d70\u4e13\u95e8\u5408\u540c\u3002Framework\u4e0d\u7ba1\u7406\u9879\u76ee\u9884\u7b97\u6216\u8ba1\u8d39\u8d26\u672c\uff0cchecker\u3001\u8fc7\u7a0b\u4e0e\u771f\u5b9ehost\u80fd\u529b\u5206\u522b\u6210\u7acb\u3002","orderedDependencies":[]}],"declarationIdentity":"827|4FAB35193708716D44850B85A7B514012288E9F5AD68E423D0E9C5BA78FCAA0C"},{"requirementId":"framework:PR_TASK_SCOPE_AND_FORBIDDEN","source":"FRAMEWORK","ownerModule":"TASK_AND_SCOPE.md","semanticApplicability":"DETERMINISTIC","fullText":"TASK_OWNER\u662f\u5f53\u524d\u6709\u9650\u6210\u679c\u552f\u4e00\u8d1f\u8d23\u4eba\uff0c\u8d1f\u8d23\u76ee\u6807\u660e\u786e\u3001\u5b9e\u65bd\u7ec4\u7ec7\u3001\u9a8c\u8bc1\u3001\u63a5\u53d7\u548c\u4ea7\u7269\u5904\u7f6e\uff1b\u6210\u679c\u95ed\u5408\u91ca\u653e\u6d3b\u8dc3\u8d23\u4efb\uff0c\u5386\u53f2\u7b7e\u8ba4\u53ca\u660e\u786e\u79fb\u4ea4\u7684\u672a\u89e3\u4e49\u52a1\u4fdd\u7559\u3002\u7236\u4efb\u52a1\u53ea\u5728\u786e\u6709\u6301\u7eed\u6210\u679c\u53ca\u534f\u8c03\u8d23\u4efb\u65f6\u4fdd\u5b58\u8303\u56f4\u3001\u4e0b\u7ea7\u5165\u53e3\u3001\u8d44\u6e90\u754c\u9650\u548c\u5347\u7ea7\u6761\u4ef6\uff1b\u7236\u5b50\u5173\u7cfb\u53ea\u5bfc\u822a\uff0c\u4e0d\u6388\u8de8Owner\u7b7e\u53d1\u6743\u3002\u771f\u5b9e\u8de8\u4efb\u52a1\u4f9d\u8d56\u7531\u8d23\u4efb\u4eba\u76f4\u63a5\u534f\u8c03\uff0c\u9879\u76ee\u7ea7\u51b3\u5b9a\u624d\u8def\u7531Controller\u3002\u89d2\u8272\u6574\u7406\u987b\u628a\u672a\u89e3\u5de5\u4f5c\u4ea4\u7ed9\u5b9e\u9645\u6210\u679c\u3001\u89c4\u8303\u3001\u77e5\u8bc6\u6216\u534f\u8c03\u8d23\u4efb\uff0c\u4e0d\u80fd\u4e22\u56de\u4e3b\u63a7\u3002\n\n\u9879\u76ee\u9884\u6388\u6743\u76f4\u63a5\u6a21\u5f0f\u4e0b\uff0c\u666e\u901a\u5de5\u5177\u8c03\u7528\u672c\u8eab\u4e0d\u5355\u72ec\u521b\u5efa\u4efb\u52a1\u5361\uff1b\u5df2\u6709\u6709\u9650\u6210\u679c\u65f6\u5f52\u5165\u539f\u4efb\u52a1\uff0c\u65e0\u9002\u7528\u4efb\u52a1\u7684\u6709\u754c\u7528\u6237\u5de5\u5177\u8bf7\u6c42\u53ef\u7528TOOL_CONTRACT\u7684PROJECT_EXTERNAL\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u89c4\u5219\u540e\u76f4\u63a5\u8c03\u7528\u3002\u8be5\u52a0\u8f7d\u4e0a\u4e0b\u6587\u4e0d\u5efa\u7acbOwner\u3001writer\u6216\u9010\u6b21\u6267\u884c\u8bb8\u53ef\uff0c\u4e0d\u4e3a\u7701\u5361\u5192\u7528\u5df2\u5173\u95ed\u4efb\u52a1\u3002\u771f\u6b63\u7684\u6e90\u7801\u3001\u63a7\u5236\u9762\u3001\u5ba1\u6838\u3001\u63a5\u53d7\u3001\u53d1\u5e03\u6216\u5176\u4ed6\u6709\u9650\u6210\u679c\u8d23\u4efb\u4ecd\u6309\u5404\u81ea\u4efb\u52a1\u5408\u540c\u5904\u7406\u3002\n\n\u5f53\u524d\u4efb\u52a1\u4fdd\u5b58\u76ee\u6807\u4e0e\u5b9e\u9645\u589e\u91cf\u3001\u9a8c\u6536\u573a\u666f\u3001Owner/actor\u3001\u7cbe\u786e\u8303\u56f4/\u6392\u9664\u3001\u5019\u9009\u4e0e\u8bc1\u636e\u3001\u6743\u9650\u3001\u5f53\u524d\u7ed3\u679c/\u963b\u585e\u548c\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\u3002\u65b9\u6848\u6838\u5bf9\u6839\u56e0\u3001\u5f53\u524d\u673a\u5236\u3001\u76f4\u63a5\u6d88\u8d39\u8005\u3001\u80fd\u63a8\u7ffb\u9519\u8bef\u65b9\u6848\u7684\u9a8c\u8bc1\u3001\u91cd\u8981\u5931\u8d25\u6062\u590d\u53ca\u91cd\u5927\u5047\u8bbe\uff1b\u5df2\u6709\u5145\u5206\u7ed3\u8bba\u76f4\u63a5\u5f15\u7528\u3002\u5b9e\u73b0\u53d6\u820d\u53d6PR_TASK_IMPLEMENTATION_JUDGMENT\uff0c\u4e13\u4e1a\u6750\u6599\u6309\u5b9e\u9645\u8981\u6c42\u8bfb\u53d6\uff0c\u4e0d\u5168\u91cf\u52a0\u8f7d\u76ee\u5f55\u6216\u51d1\u53cd\u4f8b\u3002\n\nOwner\u8d1f\u8d23\u6210\u679c\uff0cWork route actor\u8d1f\u8d23\u5f53\u524d\u751f\u4ea7\u8def\u7ebf\uff0caction grantee\u53ea\u627f\u62c5\u6709\u754c\u52a8\u4f5c\uff1b\u7eafReview\u4e0d\u6539\u53d8Owner/Work route\u3002\u5361\u7247\u7684\u552f\u4e00route\u8bed\u6cd5\u3001\u539f\u5b50\u4fee\u6539\u53ca\u65e7\u683c\u5f0f\u8fc1\u79fb\u53d6TOOL_CONTRACT\u3001\u4efb\u52a1\u6a21\u677f\u4e0eMIGRATION_MATRIX\uff0c\u4e0d\u80fd\u4eceOwner\u3001\u5305\u6216\u6807\u9898\u731cactor\u3002\u666e\u901a\u4efb\u52a1\u9ed8\u8ba4SAME_ROOT\uff1b\u786e\u9700\u5df2\u6388\u6743\u9694\u79bb\u65f6\uff0c\u4ee5\u539f\u4efb\u52a1\u7ed1\u5b9a\u7684\u4e0d\u53ef\u53d8descriptor\u9009\u62e9GIT_WORKTREE\u3002\u552f\u4e00controlRoot\u4fdd\u6709\u4efb\u52a1\u3001pin\u3001\u91c7\u7528\u53ca\u6062\u590d\uff0cexecutionRoot\u627f\u8f7d\u6307\u5b9a\u5019\u9009\uff1b\u590d\u5236\u7684\u65e7\u63a7\u5236\u76ee\u5f55\u4e0d\u6210\u4e3a\u65b0\u6743\u5a01\u3002\u76ee\u6807\u7f3a\u5931\u3001\u6839\u5173\u7cfb/HEAD/\u4fdd\u62a4\u6f02\u79fb\u53ea\u505c\u6b62\u53d7\u5f71\u54cd\u52a8\u4f5c\uff0c\u91cd\u65b0\u7ed1\u5b9a\u987b\u5148\u5b8c\u6210\u539f\u52a8\u4f5c\u5e76\u53d6\u5f97\u5f53\u524d\u660e\u786e\u8303\u56f4\uff1b\u4e0d\u81ea\u52a8\u79fb\u9664worktree\u3002\n\n\u540c\u4e00\u76ee\u6807\u3001\u8303\u56f4\u3001\u8d28\u91cf\u53ca\u8d44\u6e90\u8fb9\u754c\u5185\u7684\u53ef\u9884\u6d4b\u6b65\u9aa4\u7ec4\u6210\u53ef\u9a8c\u6536\u6709\u754c\u6279\u6b21\u3002Executor\u81ea\u4e3b\u9009\u62e9\u65b9\u6cd5\u3001\u5de5\u5177\u548c\u987a\u5e8f\uff1b\u5fc5\u9700\u8bca\u65ad\u3001\u4f9d\u8d56\u548c\u5c40\u90e8\u4fee\u590d\u4e0d\u62c6\u6210\u65b0\u51b3\u5b9a\u3002Owner\u6309\u5b8c\u6574\u6210\u679c\u53ca\u5b9e\u9645\u4e0d\u786e\u5b9a\u6027\u9884\u6388\u8db3\u591f\u7684\u6709\u9650\u5199\u6d4b\u7eed\u4f5c\uff1b\u6b21\u6570\u7528\u4e8e\u9632\u5931\u63a7\uff0c\u4e0d\u4ee5\u56fa\u5b9a\u5c0f\u8f6e\u6570\u4ee3\u66ff\u4efb\u52a1\u5224\u65ad\uff0c\u523b\u610f\u53ea\u6388\u7ebf\u6027\u8ba1\u5212\u65f6\u4fdd\u7559\u5176\u5b9e\u9645\u7406\u7531\u3002Executor\u4f9d\u636e\u539f\u59cb\u5931\u8d25\u3001\u5b9e\u9645\u540e\u50cf\u548c\u6700\u77ed\u9a8c\u8bc1\u5224\u65ad\u8fdb\u5c55\uff1a\u8303\u56f4\u5185\u3001\u8bb8\u53ef\u6709\u6548\u4e14\u4e0b\u4e00\u4fee\u6b63\u6709\u53ef\u68c0\u9a8c\u4f9d\u636e\u65f6\u76f4\u63a5\u7eed\u4f5c\uff1b\u91cd\u590d\u540c\u6839\u56e0\u800c\u65e0\u65b0\u8bc1\u636e\u65f6\u5148\u8bca\u65ad\u6216\u505c\u6b62\uff0c\u65b9\u6848/\u80fd\u529b/\u8d44\u6e90\u53ca\u6743\u9650\u8fb9\u754c\u6539\u53d8\u65f6\u4ea4\u5b9e\u9645\u8d23\u4efb\u8005\u3002\u8fdb\u5c55\u5224\u65ad\u4e0d\u6269\u6743\uff0c\u4e0d\u4e3a\u6bcf\u8f6e\u65b0\u589e\u5ba1\u6838\u6216\u6a21\u578b\u8bf7\u6c42\u3002\u505c\u6b62\u540e\u7531Owner\u6d88\u8d39\u5df2\u6709\u5931\u8d25\u3001\u5019\u9009\u548c\u672a\u5b8c\u6210\u9879\uff0c\u53ea\u91cd\u7ed1\u5931\u6548\u6216\u65b0\u6388\u90e8\u5206\uff0c\u4e0d\u91cd\u5efa\u5065\u5eb7\u4efb\u52a1\u6216\u6e05\u96f6\u5386\u53f2\u3002\u5177\u4f53\u5206\u652f\u3001\u8ba1\u6570\u548c\u6536\u636e\u53ea\u53d6TOOL_CONTRACT\u3002\u5206\u6790\u3001\u539f\u578b\u3001\u81ea\u6d4b\u6216\u5c40\u90e8\u6210\u529f\u4e0d\u80fd\u66ff\u4ee3\u7528\u6237\u8bf7\u6c42\u6210\u679c\u3002\u660e\u786e\u6269\u5c55\u66f4\u65b0\u5b9e\u9645\u8303\u56f4\u548c\u6388\u6743\uff0c\u53ef\u72ec\u7acb\u4ea4\u4ed8\u7684\u65b0\u6210\u679c\u53d6\u5f97\u81ea\u5df1\u7684\u76ee\u6807\u3001\u9a8c\u6536\u548c\u5173\u95ed\u8d23\u4efb\uff1b\u7d27\u5bc6\u76f8\u5173\u4e14\u53ef\u5171\u540c\u9a8c\u6536\u7684\u5de5\u4f5c\u53ef\u5408\u6279\uff0c\u4e0d\u8981\u6c42\u4e00\u529f\u80fd\u4e00\u5361\u3002\u540c\u4e00\u672a\u5b8c\u6210\u6210\u679c\u7684\u5065\u5eb7\u804a\u5929\u53ef\u7eed\u4f5c\uff1b\u65b0\u6709\u9650\u6210\u679c\u53ca\u65b0\u72ec\u5ba1\u9ed8\u8ba4\u65b0\u4f1a\u8bdd\uff0c\u4e0d\u80fd\u9760\u590d\u7528\u804a\u5929\u6269\u5927\u65e7\u76ee\u6807\u548c\u6743\u9650\u3002\u539f\u4e8b\u5fc5\u8981\u8865\u6b63\u3001\u540c\u5ba1\u6709\u754c\u4fee\u590d\u590d\u5ba1\u53ca\u771f\u5b9e\u6301\u7eed\u804c\u8d23\u6309PR_TASK_LAUNCH_AND_ROUTE\u5904\u7406\u3002\u5e76\u884c/\u9694\u79bb\u6309\u771f\u5b9e\u6536\u76ca\u9009\u62e9\uff0c\u5171\u4eab\u51b2\u7a81\u53ea\u9650\u5236\u51b2\u7a81\u5199\u96c6\u3002\n\nController\u548cOwner\u53ef\u56e0\u8d28\u91cf\u3001\u80fd\u529b\u7f3a\u53e3\u6216\u6709\u636e\u603b\u6210\u672c\u6536\u76ca\u5b89\u6392\u6709\u754c\u4e13\u5bb6\uff0c\u4e0d\u4ee5\u4efb\u52a1\u7c7b\u522b\u3001profile\u3001\u8017\u65f6\u6216\u5148\u5931\u8d25\u4f5c\u95e8\u69db\u3002\u8bbe\u8ba1\u7ed9\u7ed3\u8bba\u3001\u4f9d\u636e\u3001\u53d6\u820d\u3001\u9002\u7528\u6761\u4ef6\u53ca\u5b9e\u65bd/\u9a8c\u6536\uff1b\u8c03\u67e5\u7ed9\u6839\u56e0\u3001\u8bc1\u636e\u3001\u4fee\u6b63\u548c\u9a8c\u8bc1\uff1b\u56f0\u96be\u5b9e\u73b0\u53ef\u7531\u8db3\u591f\u80fd\u529b\u8005\u76f4\u63a5\u5b8c\u6210\u3002Owner\u5fc5\u987b\u7406\u89e3\u5e76\u6d88\u8d39\u7ed3\u8bba\uff0c\u6309\u9700\u7ec4\u7ec7\u6267\u884c\u3001\u5408\u683c\u4e13\u4e1a\u5ba1\u6838\u6216\u660e\u786e\u53d7\u6258\u63a5\u53d7\u3002\u8bbe\u8ba1/\u5b9e\u73b0\u8d21\u732e\u8005\u4e0d\u80fd\u5145\u4efb\u540c\u6210\u679c\u72ec\u7acbReviewer\uff1b\u666e\u901a\u7b80\u5355\u4efb\u52a1\u4e0d\u5f3a\u5236\u4e13\u5bb6\u3002\u4ec5\u5b9e\u8d28\u65b0\u4e8b\u5b9e\u91cd\u65b0\u54a8\u8be2\u3002\n\nOwner\u5728\u6b63\u5e38\u7ed3\u679c\u6d88\u8d39\u65f6\u66ff\u6362\u552f\u4e00\u4efb\u52a1\u5361\u7684\u8fc7\u65f6\u5f53\u524d\u4e8b\u5b9e\uff0c\u5019\u9009\u4e0d\u6295\u4e3a\u5df2\u63a5\u53d7\uff0c\u8be6\u7ec6\u5386\u53f2/\u5931\u8d25\u5f15\u7528\u539f\u4ef6\u3002writer/reviewer/\u6388\u6743\u53d8\u5316\u7559\u5361\uff1bSTATUS\u4ec5\u968f\u7a33\u5b9a\u9636\u6bb5\u3001\u957f\u671f\u8d23\u4efb\u3001\u4fdd\u62a4\u6216\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\u53d8\u5316\uff0cindex\u4ec5\u968flifecycle/routing\u53d8\u5316\u3002\u65e0\u65b0\u7ed3\u679c\u4e0d\u5199\u5361\uff0c\u4e0d\u4e3a\u53ef\u53d8\u5361\u5efa\u5b57\u6bb5manifest\uff1b\u5e76\u53d1\u6cbf\u539flease/package\u7ea6\u675f\uff0c\u4fdd\u62a4/\u4e0d\u53ef\u53d8\u5bf9\u8c61\u4ecd\u6574\u4f53\u9a8c\u8bc1\u3002\u6d89\u53ca\u8eab\u4efd\u7ec4\u5408\u8f6c\u6362\u5148\u6309RECOVERY\u6062\u590d\u539f\u4e8b\u52a1\uff1b\u6536\u5c3e\u53d6PR_TASK_CHANGED_OUTPUT_DISPOSITION\u3002\n\u9879\u76ee\u663e\u5f0fqualityAssurance1\u6309\u5b8c\u6574\u7a33\u5b9a\u6210\u679csubject\u5e76\u96c6\u9009\u62e9SELF_CHECK/RESULT_REVIEW/RESULT_ACCEPT\uff0c\u89c4\u5219/\u683c\u5f0f\u548c\u51c6\u5907\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\u7f3a\u7701LEGACY\uff0c\u542f\u7528\u7f3aplan2\u4e0d\u5f97\u964d\u4e3a\u65e0\u95e8\uff1b\u771f\u96f6\u4e0d\u4f2a\u9020\u8bc1\u636e\uff0c\u7528\u6237/\u4e13\u4e1a\u9636\u6bb5\u548c\u771f\u5b9e\u5931\u8d25\u4fdd\u7559\u3002qualityBinding\u662f\u5f53\u524d\u9009\u62e9\u6295\u5f71\uff0c\u4e0d\u6388\u52a8\u4f5c\u3001\u8de8\u4ed3\u3001\u4e13\u95e8\u95e8\u6216\u63a5\u53d7\u6743\u3002\n\n\u5df2\u91c7\u7528\u652f\u6301C\u7684\u6765\u6e90\u540e\uff0cOwner\u901a\u8fc7\u53ea\u8bfbQUALITY_PLAN_PREPARE\u6838\u7a33\u5b9asubject\u4e0e\u5df2\u6709\u6301\u4e45\u8981\u6c42\uff0c\u5728\u539f\u5355\u5361CONTROL\u7ed1\u5b9aplan2\u5e76\u4fdd\u989d\u5916\u7528\u6237/\u4e13\u4e1a\u9636\u6bb5\uff1b\u771f\u5b9e\u51bb\u7ed3\u548c\u7ed3\u679c\u6d88\u8d39\u8865\u5b9e\u9645\u5019\u9009/\u8bc1\u636e\u3002\u6309\u5f53\u524dpolicy\u53d8\u5316\u53ea\u91cd\u7ed1\u4e0b\u4e00\u5b9e\u9645\u52a8\u4f5c\uff0c\u4e0d\u6279\u91cf\u8fc1\u5173\u95ed\u5361\uff1bSUCCESS\u6d88\u8d39\u540c\u4e00\u8ba1\u5212\u5168\u90e8\u771f\u5b9e\u9636\u6bb5\uff0c\u53d6\u6d88/\u66ff\u4ee3\u4fdd\u5b9e\u9645\u672a\u5b8c\u6210\uff0c\u539f\u5f52\u6863\u5199\u5e8f\u53ca\u8d23\u4efb\u91ca\u653e\u4fdd\u6301\u3002\n","preparationRequirements":[],"resultRequirements":[],"selectorIdentity":"205|4312886A3A4B3179EB9F9CA3E57A40F6E8C7240921FBC0071BB545B45D0A34E0","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b9335c38\\aiw-int-p-f263f077d4a2414c888830a59ce39138\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","sourceIdentity":"21004|FAD841FC29B546A9D43267E3EB5C3238318E458BB0391E988197552EF4729875","fullText":"TASK_OWNER\u662f\u5f53\u524d\u6709\u9650\u6210\u679c\u552f\u4e00\u8d1f\u8d23\u4eba\uff0c\u8d1f\u8d23\u76ee\u6807\u660e\u786e\u3001\u5b9e\u65bd\u7ec4\u7ec7\u3001\u9a8c\u8bc1\u3001\u63a5\u53d7\u548c\u4ea7\u7269\u5904\u7f6e\uff1b\u6210\u679c\u95ed\u5408\u91ca\u653e\u6d3b\u8dc3\u8d23\u4efb\uff0c\u5386\u53f2\u7b7e\u8ba4\u53ca\u660e\u786e\u79fb\u4ea4\u7684\u672a\u89e3\u4e49\u52a1\u4fdd\u7559\u3002\u7236\u4efb\u52a1\u53ea\u5728\u786e\u6709\u6301\u7eed\u6210\u679c\u53ca\u534f\u8c03\u8d23\u4efb\u65f6\u4fdd\u5b58\u8303\u56f4\u3001\u4e0b\u7ea7\u5165\u53e3\u3001\u8d44\u6e90\u754c\u9650\u548c\u5347\u7ea7\u6761\u4ef6\uff1b\u7236\u5b50\u5173\u7cfb\u53ea\u5bfc\u822a\uff0c\u4e0d\u6388\u8de8Owner\u7b7e\u53d1\u6743\u3002\u771f\u5b9e\u8de8\u4efb\u52a1\u4f9d\u8d56\u7531\u8d23\u4efb\u4eba\u76f4\u63a5\u534f\u8c03\uff0c\u9879\u76ee\u7ea7\u51b3\u5b9a\u624d\u8def\u7531Controller\u3002\u89d2\u8272\u6574\u7406\u987b\u628a\u672a\u89e3\u5de5\u4f5c\u4ea4\u7ed9\u5b9e\u9645\u6210\u679c\u3001\u89c4\u8303\u3001\u77e5\u8bc6\u6216\u534f\u8c03\u8d23\u4efb\uff0c\u4e0d\u80fd\u4e22\u56de\u4e3b\u63a7\u3002\n\n\u9879\u76ee\u9884\u6388\u6743\u76f4\u63a5\u6a21\u5f0f\u4e0b\uff0c\u666e\u901a\u5de5\u5177\u8c03\u7528\u672c\u8eab\u4e0d\u5355\u72ec\u521b\u5efa\u4efb\u52a1\u5361\uff1b\u5df2\u6709\u6709\u9650\u6210\u679c\u65f6\u5f52\u5165\u539f\u4efb\u52a1\uff0c\u65e0\u9002\u7528\u4efb\u52a1\u7684\u6709\u754c\u7528\u6237\u5de5\u5177\u8bf7\u6c42\u53ef\u7528TOOL_CONTRACT\u7684PROJECT_EXTERNAL\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u89c4\u5219\u540e\u76f4\u63a5\u8c03\u7528\u3002\u8be5\u52a0\u8f7d\u4e0a\u4e0b\u6587\u4e0d\u5efa\u7acbOwner\u3001writer\u6216\u9010\u6b21\u6267\u884c\u8bb8\u53ef\uff0c\u4e0d\u4e3a\u7701\u5361\u5192\u7528\u5df2\u5173\u95ed\u4efb\u52a1\u3002\u771f\u6b63\u7684\u6e90\u7801\u3001\u63a7\u5236\u9762\u3001\u5ba1\u6838\u3001\u63a5\u53d7\u3001\u53d1\u5e03\u6216\u5176\u4ed6\u6709\u9650\u6210\u679c\u8d23\u4efb\u4ecd\u6309\u5404\u81ea\u4efb\u52a1\u5408\u540c\u5904\u7406\u3002\n\n\u5f53\u524d\u4efb\u52a1\u4fdd\u5b58\u76ee\u6807\u4e0e\u5b9e\u9645\u589e\u91cf\u3001\u9a8c\u6536\u573a\u666f\u3001Owner/actor\u3001\u7cbe\u786e\u8303\u56f4/\u6392\u9664\u3001\u5019\u9009\u4e0e\u8bc1\u636e\u3001\u6743\u9650\u3001\u5f53\u524d\u7ed3\u679c/\u963b\u585e\u548c\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\u3002\u65b9\u6848\u6838\u5bf9\u6839\u56e0\u3001\u5f53\u524d\u673a\u5236\u3001\u76f4\u63a5\u6d88\u8d39\u8005\u3001\u80fd\u63a8\u7ffb\u9519\u8bef\u65b9\u6848\u7684\u9a8c\u8bc1\u3001\u91cd\u8981\u5931\u8d25\u6062\u590d\u53ca\u91cd\u5927\u5047\u8bbe\uff1b\u5df2\u6709\u5145\u5206\u7ed3\u8bba\u76f4\u63a5\u5f15\u7528\u3002\u5b9e\u73b0\u53d6\u820d\u53d6PR_TASK_IMPLEMENTATION_JUDGMENT\uff0c\u4e13\u4e1a\u6750\u6599\u6309\u5b9e\u9645\u8981\u6c42\u8bfb\u53d6\uff0c\u4e0d\u5168\u91cf\u52a0\u8f7d\u76ee\u5f55\u6216\u51d1\u53cd\u4f8b\u3002\n\nOwner\u8d1f\u8d23\u6210\u679c\uff0cWork route actor\u8d1f\u8d23\u5f53\u524d\u751f\u4ea7\u8def\u7ebf\uff0caction grantee\u53ea\u627f\u62c5\u6709\u754c\u52a8\u4f5c\uff1b\u7eafReview\u4e0d\u6539\u53d8Owner/Work route\u3002\u5361\u7247\u7684\u552f\u4e00route\u8bed\u6cd5\u3001\u539f\u5b50\u4fee\u6539\u53ca\u65e7\u683c\u5f0f\u8fc1\u79fb\u53d6TOOL_CONTRACT\u3001\u4efb\u52a1\u6a21\u677f\u4e0eMIGRATION_MATRIX\uff0c\u4e0d\u80fd\u4eceOwner\u3001\u5305\u6216\u6807\u9898\u731cactor\u3002\u666e\u901a\u4efb\u52a1\u9ed8\u8ba4SAME_ROOT\uff1b\u786e\u9700\u5df2\u6388\u6743\u9694\u79bb\u65f6\uff0c\u4ee5\u539f\u4efb\u52a1\u7ed1\u5b9a\u7684\u4e0d\u53ef\u53d8descriptor\u9009\u62e9GIT_WORKTREE\u3002\u552f\u4e00controlRoot\u4fdd\u6709\u4efb\u52a1\u3001pin\u3001\u91c7\u7528\u53ca\u6062\u590d\uff0cexecutionRoot\u627f\u8f7d\u6307\u5b9a\u5019\u9009\uff1b\u590d\u5236\u7684\u65e7\u63a7\u5236\u76ee\u5f55\u4e0d\u6210\u4e3a\u65b0\u6743\u5a01\u3002\u76ee\u6807\u7f3a\u5931\u3001\u6839\u5173\u7cfb/HEAD/\u4fdd\u62a4\u6f02\u79fb\u53ea\u505c\u6b62\u53d7\u5f71\u54cd\u52a8\u4f5c\uff0c\u91cd\u65b0\u7ed1\u5b9a\u987b\u5148\u5b8c\u6210\u539f\u52a8\u4f5c\u5e76\u53d6\u5f97\u5f53\u524d\u660e\u786e\u8303\u56f4\uff1b\u4e0d\u81ea\u52a8\u79fb\u9664worktree\u3002\n\n\u540c\u4e00\u76ee\u6807\u3001\u8303\u56f4\u3001\u8d28\u91cf\u53ca\u8d44\u6e90\u8fb9\u754c\u5185\u7684\u53ef\u9884\u6d4b\u6b65\u9aa4\u7ec4\u6210\u53ef\u9a8c\u6536\u6709\u754c\u6279\u6b21\u3002Executor\u81ea\u4e3b\u9009\u62e9\u65b9\u6cd5\u3001\u5de5\u5177\u548c\u987a\u5e8f\uff1b\u5fc5\u9700\u8bca\u65ad\u3001\u4f9d\u8d56\u548c\u5c40\u90e8\u4fee\u590d\u4e0d\u62c6\u6210\u65b0\u51b3\u5b9a\u3002Owner\u6309\u5b8c\u6574\u6210\u679c\u53ca\u5b9e\u9645\u4e0d\u786e\u5b9a\u6027\u9884\u6388\u8db3\u591f\u7684\u6709\u9650\u5199\u6d4b\u7eed\u4f5c\uff1b\u6b21\u6570\u7528\u4e8e\u9632\u5931\u63a7\uff0c\u4e0d\u4ee5\u56fa\u5b9a\u5c0f\u8f6e\u6570\u4ee3\u66ff\u4efb\u52a1\u5224\u65ad\uff0c\u523b\u610f\u53ea\u6388\u7ebf\u6027\u8ba1\u5212\u65f6\u4fdd\u7559\u5176\u5b9e\u9645\u7406\u7531\u3002Executor\u4f9d\u636e\u539f\u59cb\u5931\u8d25\u3001\u5b9e\u9645\u540e\u50cf\u548c\u6700\u77ed\u9a8c\u8bc1\u5224\u65ad\u8fdb\u5c55\uff1a\u8303\u56f4\u5185\u3001\u8bb8\u53ef\u6709\u6548\u4e14\u4e0b\u4e00\u4fee\u6b63\u6709\u53ef\u68c0\u9a8c\u4f9d\u636e\u65f6\u76f4\u63a5\u7eed\u4f5c\uff1b\u91cd\u590d\u540c\u6839\u56e0\u800c\u65e0\u65b0\u8bc1\u636e\u65f6\u5148\u8bca\u65ad\u6216\u505c\u6b62\uff0c\u65b9\u6848/\u80fd\u529b/\u8d44\u6e90\u53ca\u6743\u9650\u8fb9\u754c\u6539\u53d8\u65f6\u4ea4\u5b9e\u9645\u8d23\u4efb\u8005\u3002\u8fdb\u5c55\u5224\u65ad\u4e0d\u6269\u6743\uff0c\u4e0d\u4e3a\u6bcf\u8f6e\u65b0\u589e\u5ba1\u6838\u6216\u6a21\u578b\u8bf7\u6c42\u3002\u505c\u6b62\u540e\u7531Owner\u6d88\u8d39\u5df2\u6709\u5931\u8d25\u3001\u5019\u9009\u548c\u672a\u5b8c\u6210\u9879\uff0c\u53ea\u91cd\u7ed1\u5931\u6548\u6216\u65b0\u6388\u90e8\u5206\uff0c\u4e0d\u91cd\u5efa\u5065\u5eb7\u4efb\u52a1\u6216\u6e05\u96f6\u5386\u53f2\u3002\u5177\u4f53\u5206\u652f\u3001\u8ba1\u6570\u548c\u6536\u636e\u53ea\u53d6TOOL_CONTRACT\u3002\u5206\u6790\u3001\u539f\u578b\u3001\u81ea\u6d4b\u6216\u5c40\u90e8\u6210\u529f\u4e0d\u80fd\u66ff\u4ee3\u7528\u6237\u8bf7\u6c42\u6210\u679c\u3002\u660e\u786e\u6269\u5c55\u66f4\u65b0\u5b9e\u9645\u8303\u56f4\u548c\u6388\u6743\uff0c\u53ef\u72ec\u7acb\u4ea4\u4ed8\u7684\u65b0\u6210\u679c\u53d6\u5f97\u81ea\u5df1\u7684\u76ee\u6807\u3001\u9a8c\u6536\u548c\u5173\u95ed\u8d23\u4efb\uff1b\u7d27\u5bc6\u76f8\u5173\u4e14\u53ef\u5171\u540c\u9a8c\u6536\u7684\u5de5\u4f5c\u53ef\u5408\u6279\uff0c\u4e0d\u8981\u6c42\u4e00\u529f\u80fd\u4e00\u5361\u3002\u540c\u4e00\u672a\u5b8c\u6210\u6210\u679c\u7684\u5065\u5eb7\u804a\u5929\u53ef\u7eed\u4f5c\uff1b\u65b0\u6709\u9650\u6210\u679c\u53ca\u65b0\u72ec\u5ba1\u9ed8\u8ba4\u65b0\u4f1a\u8bdd\uff0c\u4e0d\u80fd\u9760\u590d\u7528\u804a\u5929\u6269\u5927\u65e7\u76ee\u6807\u548c\u6743\u9650\u3002\u539f\u4e8b\u5fc5\u8981\u8865\u6b63\u3001\u540c\u5ba1\u6709\u754c\u4fee\u590d\u590d\u5ba1\u53ca\u771f\u5b9e\u6301\u7eed\u804c\u8d23\u6309PR_TASK_LAUNCH_AND_ROUTE\u5904\u7406\u3002\u5e76\u884c/\u9694\u79bb\u6309\u771f\u5b9e\u6536\u76ca\u9009\u62e9\uff0c\u5171\u4eab\u51b2\u7a81\u53ea\u9650\u5236\u51b2\u7a81\u5199\u96c6\u3002\n\nController\u548cOwner\u53ef\u56e0\u8d28\u91cf\u3001\u80fd\u529b\u7f3a\u53e3\u6216\u6709\u636e\u603b\u6210\u672c\u6536\u76ca\u5b89\u6392\u6709\u754c\u4e13\u5bb6\uff0c\u4e0d\u4ee5\u4efb\u52a1\u7c7b\u522b\u3001profile\u3001\u8017\u65f6\u6216\u5148\u5931\u8d25\u4f5c\u95e8\u69db\u3002\u8bbe\u8ba1\u7ed9\u7ed3\u8bba\u3001\u4f9d\u636e\u3001\u53d6\u820d\u3001\u9002\u7528\u6761\u4ef6\u53ca\u5b9e\u65bd/\u9a8c\u6536\uff1b\u8c03\u67e5\u7ed9\u6839\u56e0\u3001\u8bc1\u636e\u3001\u4fee\u6b63\u548c\u9a8c\u8bc1\uff1b\u56f0\u96be\u5b9e\u73b0\u53ef\u7531\u8db3\u591f\u80fd\u529b\u8005\u76f4\u63a5\u5b8c\u6210\u3002Owner\u5fc5\u987b\u7406\u89e3\u5e76\u6d88\u8d39\u7ed3\u8bba\uff0c\u6309\u9700\u7ec4\u7ec7\u6267\u884c\u3001\u5408\u683c\u4e13\u4e1a\u5ba1\u6838\u6216\u660e\u786e\u53d7\u6258\u63a5\u53d7\u3002\u8bbe\u8ba1/\u5b9e\u73b0\u8d21\u732e\u8005\u4e0d\u80fd\u5145\u4efb\u540c\u6210\u679c\u72ec\u7acbReviewer\uff1b\u666e\u901a\u7b80\u5355\u4efb\u52a1\u4e0d\u5f3a\u5236\u4e13\u5bb6\u3002\u4ec5\u5b9e\u8d28\u65b0\u4e8b\u5b9e\u91cd\u65b0\u54a8\u8be2\u3002\n\nOwner\u5728\u6b63\u5e38\u7ed3\u679c\u6d88\u8d39\u65f6\u66ff\u6362\u552f\u4e00\u4efb\u52a1\u5361\u7684\u8fc7\u65f6\u5f53\u524d\u4e8b\u5b9e\uff0c\u5019\u9009\u4e0d\u6295\u4e3a\u5df2\u63a5\u53d7\uff0c\u8be6\u7ec6\u5386\u53f2/\u5931\u8d25\u5f15\u7528\u539f\u4ef6\u3002writer/reviewer/\u6388\u6743\u53d8\u5316\u7559\u5361\uff1bSTATUS\u4ec5\u968f\u7a33\u5b9a\u9636\u6bb5\u3001\u957f\u671f\u8d23\u4efb\u3001\u4fdd\u62a4\u6216\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\u53d8\u5316\uff0cindex\u4ec5\u968flifecycle/routing\u5