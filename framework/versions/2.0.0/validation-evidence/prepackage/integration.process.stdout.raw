1\u6709\u64a4\u56de\u3001\u51b2\u7a81\u6216\u672a\u77e5\u65f6\uff0c\u7531\u5b9e\u9645\u6267\u884c\u8005\u76f4\u63a5\u8c03\u7528\u539f\u5de5\u5177\u3002\u8c03\u7528\u672c\u8eab\u4e0d\u8981\u6c42\u9010\u6b21\u4efb\u52a1\u5361\u3001EXTERNAL\u5305\u3001DISCOVER/ADMIT/FINALIZE\uff1b\u539f\u5de5\u5177\u8fd4\u56de\u4e0e\u5bbf\u4e3b\u89c2\u5bdf\u4fdd\u7559\u771f\u5b9e\u6210\u529f\u3001\u5931\u8d25\u6216UNKNOWN\uff0c\u968f\u5f53\u524d\u6210\u679c\u81ea\u7136\u4ea4\u4ed8\u3002\u5b83\u4e0d\u514d\u9664\u9996\u6b21/\u6d3b\u52a8\u53d8\u5316/\u6062\u590d\u65f6\u7684\u5b8c\u6574\u89c4\u5219\u8bfb\u53d6\uff0c\u4e5f\u4e0d\u4ea7\u751f\u53ef\u4f9b\u5176\u4ed6\u52a8\u4f5c\u7eed\u6743\u7684\u6210\u529f\u6536\u636e\u3002\u5f53\u524d\u9879\u76ee\u8bbe\u7f6e\u548c\u5b8c\u6574\u8bb8\u53ef\u7684\u8bfb\u53d6\u63a5\u53e3\u53d6TOOL_CONTRACT\uff0c\u8bed\u4e49\u8986\u76d6\u4ecd\u4e3aINSTRUCTION_BOUND\u3002\n\n\u76f4\u63a5\u6a21\u5f0f\u4e0d\u6388\u4e88Git\u3001\u8bbe\u5907\u3001\u6d4f\u89c8\u5668\u6216\u6e90\u7801/\u63a7\u5236\u9762\u5199\u5165\uff0c\u4e0d\u7ed5\u8fc7\u5bbf\u4e3b\u6743\u9650\u548c\u7528\u6237\u4eb2\u81ea\u4fdd\u7559\u4e8b\u9879\u3002\u672a\u8bbe\u91d1\u989d\u6216\u6b21\u6570\u4e0d\u586bFREE/0\u3001\u4e0d\u81ea\u52a8\u7d22\u53d6\u9010\u6b21\u6279\u51c6\uff1b\u64a4\u56de\u3001\u8d8a\u754c\u6216\u5fc5\u8981\u4e8b\u5b9e\u672a\u77e5\u505c\u6b62\u672c\u6b21\u8c03\u7528\u3002\u516c\u5f00\u53d1\u5e03\u3001\u79d8\u5bc6\u4e0a\u4f20\u3001\u8d26\u6237/\u51ed\u636e\u53d8\u66f4\u7b49\u72ec\u7acb\u8fb9\u754c\u6309\u5f53\u524d\u5b9e\u9645\u6743\u9650\u5904\u7406\uff0c\u4e0d\u80fd\u4ece\u4e00\u822c\u8bb8\u53ef\u6216hash\u63a8\u65ad\u83b7\u51c6\u3002\u660e\u786e\u4f7f\u7528\u6309\u6b21\u5305\u65f6\u4ecd\u8d70\u539fchecker\u53ca\u8fc7\u7a0b\u95e8\uff0c\u76f4\u63a5\u6a21\u5f0f\u4e0d\u80fd\u628a\u7f3a\u5305\u6216\u574f\u5305\u53d8\u6210\u6309\u6b21\u51c6\u5165PASS\u3002\n\n\u7528\u6237\u660e\u786e\u91c7\u7528Framework\u5f00\u5c55\u9879\u76ee\u5de5\u4f5c\u65f6\uff0c\u6cbf\u5df2\u6279\u51c6\u63a5\u5165\u6a21\u677f\u5efa\u7acb\u9879\u76ee\u5de5\u4f5c\u51b3\u5b9a\u7ea6\u5b9a\uff0c\u65e0\u987b\u9010\u6b65\u9aa4\u518d\u6b21\u786e\u8ba4\u540c\u4e00\u5df2\u6279\u51c6\u5de5\u4f5c\uff1b\u4ec5\u67e5\u770b\u6587\u4ef6\u6216\u672a\u91c7\u7eb3\u5efa\u8bae\u4e0d\u6784\u6210\u91c7\u7528\u3002\u7ea6\u5b9a\u6765\u6e90\u662f\u4eba\u7c7b\u660e\u786e\u91c7\u7528/\u786e\u8ba4\u7684\u9879\u76ee\u6b63\u6587\u6216\u76f4\u63a5\u51b3\u5b9a\uff1aAI\u6839\u636e\u5f53\u524d\u91c7\u7528Framework\u3001\u6709\u6548\u7ea0\u6b63\u53ca\u6c38\u4e45\u89c4\u5219\u4f5c\u51fa\u7684\u5177\u4f53\u51b3\u5b9a\uff0c\u5728\u8be5\u7ea6\u5b9a\u8303\u56f4\u5185\u6267\u884c\u3002\u5f53\u524d\u4eba\u7c7b\u6536\u7a84\u3001\u64a4\u56de\u548c\u660e\u786e\u4fdd\u7559\u4e8b\u9879\u4f18\u5148\uff1b\u6062\u590d\u3001\u538b\u7f29\u6216\u66f4\u6362\u6267\u884c\u8005\u4e0d\u81ea\u884c\u64a4\u9500\u4ecd\u6709\u6548\u6388\u6743\u3002\u6388\u6743\u539f\u6587\u7531\u9879\u76ee\u7528\u6237\u62e5\u6709\uff0c\u5bfc\u822a\u6a21\u677f\u4e0d\u72ec\u81ea\u6388\u6743\uff0c\u4e5f\u4e0d\u8986\u76d6\u5bbf\u4e3b\u66f4\u9ad8\u4f18\u5148\u7ea7\u9650\u5236\u3002\n\n\u6279\u51c6\u5de5\u4f5c\u6d41\u5185\u5fc5\u8981\u7684\u4efb\u52a1\u6d3e\u53d1\u3001\u8865\u5145\u548c\u7ec8\u6001\u76f4\u56de\u987b\u643a\u53ef\u6838\u5bf9\u7684\u539f\u59cb\u4eba\u7c7b\u6765\u6e90\u3001\u5f53\u524d\u8303\u56f4\u548c\u7cbe\u786e\u6d88\u8d39\u8005\u3002\u53e6\u4e00agent\u8981\u6c42\u3001\u6a21\u578b\u81ea\u5199AGENTS\u3001userConfirmation\u5b57\u7b26\u4e32\u3001\u81ea\u8eabID\u6216checker PASS\u4e0d\u72ec\u81ea\u8bc1\u660e\u4eba\u7c7b\u6388\u6743\u3002\u8c03\u7528\u524d\u5408\u5e76\u4ecd\u6709\u6548\u51b3\u5b9a\u4e0e\u540e\u7eed\u53d8\u5316\uff1b\u6761\u4ef6\u5df2\u6ee1\u8db3\u5373\u5728\u7cbe\u786e\u8303\u56f4\u5185\u6267\u884c\uff0c\u771f\u6b63\u7f3a\u5931\u53ea\u62a5\u544a\u548c\u8865\u9f50\u7f3a\u5931\u6761\u4ef6\uff0c\u4e0d\u628a\u5c1a\u672a\u8c03\u7528\u8bf4\u6210\u5bbf\u4e3b\u62d2\u7edd\u3002\u6388\u6743\u6b63\u6587\u53d8\u5316\u540e\u91cd\u7ed1\u53d7\u5f71\u54cd\u6765\u6e90\u548c\u51b3\u5b9a\uff0c\u4e0d\u80fd\u7528\u5386\u53f2\u5b89\u88c5\u8eab\u4efd\u9501\u4f4f\u5f53\u524d\u4eba\u7c7b\u51b3\u5b9a\u3002"},{"unitKey":"384|7FB85995BC076E2E2C09DCC5B8F82E83E3C034A021D2E4937B90979B05589D15","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"357|342A3D0D5E8E92EA186E701C31FF422426C1C530316C3567849D4F8088A867C2","textIdentity":"579|22A8B30C026B42B3406A915E58E96835FD873531D66E9F5414F392284716F201","orderedDependencies":[],"fullText":"authority context \u53ea\u80fd\u6765\u81ea\u5f53\u524d\u673a\u68b0\u89c2\u5bdf\u5230\u7684 project\u3001Controller\u3001task\u3001package\u3001scope\u3001identity\u3001capability\u3001recovery \u4e0e host facts\u3002requested objective/action/result\u3001\u540c\u4e00\u5f53\u524dIntentEnvelope3\uff08\u65e7IntentEnvelope2\u6cbf\u517c\u5bb9\u5206\u652f\uff09\u7684facets \u548c semantic hints \u8868\u8fbe\u5f53\u524d\u610f\u56fe\uff0c\u4e0d\u751f\u6210\u6388\u6743\u3002authority facts \u59cb\u7ec8\u4f18\u5148\uff1bUNKNOWN\u3001\u672a\u6388\u6743 action \u6216 hint/fact mismatch \u4f1a\u963b\u6b62\u53d7\u6cbb\u7406 action\uff0c\u6216\u5728\u5176\u4f59\u5df2\u77e5\u8fb9\u754c\u5185\u4fdd\u5b88\u9009\u62e9\u53d7\u5f71\u54cd\u7684\u5b8c\u6574\u89c4\u5219\u5757\u3002\u672a\u6765\u52a8\u4f5c\u3001\u5426\u5b9a\u548c\u793a\u4f8b\u4e2d\u7684\u6267\u884c\u8bcd\u4e0d\u6539\u53d8\u6b64\u523b\u7684\u52a8\u4f5c\u4e8b\u5b9e\u3002"},{"unitKey":"385|FEBA5D285FE90DAF49D523B81E0BE0272B9FED5B6EF76EB06A900A0CBAFA7369","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"339|AEAC28E6838B05A8D1252A3047107BAE61DB0277131939193A75DE73D8679F31","textIdentity":"2905|9FB24B71A291FDA2050AD4D9D9263CC4701D099D6490008F6CEFEF7F2866F47F","orderedDependencies":[],"fullText":"\u5305\u7ed1\u5b9a\u5f53\u524dTASK\u6216\u539fPROJECT_WORK\u8bf7\u6c42\u3001\u8d23\u4efb\u4e3b\u4f53\u3001\u52a8\u4f5c\u3001\u7cbe\u786e\u8def\u5f84/\u5bf9\u8c61\u3001\u51b3\u5b9a\u3001\u914d\u7f6e\u53ca\u9002\u7528\u4ed3\u5e93/\u6267\u884c\u76ee\u6807\uff1b\u5b9e\u9645\u6f02\u79fb\u3001\u672a\u77e5\u5fc5\u8981\u4e8b\u5b9e\u6216\u4e0d\u5408\u683c\u5f0f\u5747\u62d2\u7edd\u53d7\u5f71\u54cd\u52a8\u4f5c\u3002\u666e\u901a\u53ef\u9009\u6267\u884c\u76ee\u6807\u4e0d\u6539\u53d8\u552f\u4e00\u63a7\u5236\u6839\u548c\u539f\u4efb\u52a1\u6743\u5a01\uff1bMaintenance\u7684CONTROL/TARGET\u7ee7\u7eed\u5206\u5305\u3001\u5206\u4ed3\u9a8c\u8bc1\u3002\u7cbe\u786e\u5b57\u6bb5\u53ca\u5f53\u524d\u683c\u5f0f\u53d6TOOL_CONTRACT\u548c\u5bf9\u5e94schema\u3002\n\n\u53ef\u9884\u6388\u4e88\u540c\u4e00\u6709\u754c\u6210\u679c\u7684\u672c\u5730\u5199\u6d4b\u3001\u6709\u9650\u81ea\u68c0\u8fd4\u5de5\u53ca\u6700\u540e\u4e00\u6b21REVIEW_ROUTE\u3002\u53ea\u6709\u771f\u5b9e\u539fFINALIZE\u540e\u50cf\u548c\u5f53\u524d\u51c6\u5165\u53ef\u627f\u63a5\u4e0b\u4e00\u6b65\uff0c\u672a\u786e\u5b9a\u7ed3\u679c\u3001\u65e0\u8bb8\u53ef\u3001\u8017\u5c3d\u6216\u505c\u6b62\u4e0d\u751f\u6210\u7eed\u6743\u3002\u5ba1\u6838\u8986\u76d6A\u53ef\u5305\u542b\u6709\u9650\u751f\u4ea7\u96c6M\uff0c\u4f46\u4e0d\u6269\u5927M\u5199\u6743\uff1b\u6210\u529f\u81ea\u67e5\u4e0e\u5b8c\u6574\u5019\u9009\u51c6\u5907\u5206\u522b\u53d6\u8bc1\u3002\u9996\u6b21\u4ea4\u5ba1/\u4fee\u590d\u590d\u5ba1\u7684\u7ec4\u7ec7\u804c\u8d23\u53d6REVIEW_AND_EVIDENCE\uff0c\u8fde\u7eed\u5305\u3001receipt\u3001repairReviewPlan\u53caM/A\u5b57\u6bb5\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\u72ec\u7acbReview\u3001\u63a5\u53d7\u3001Git\u3001\u8bbe\u5907\u3001\u5916\u90e8\u3001\u53d1\u884c\u548c\u91c7\u7528\u4e0d\u7531\u8fde\u7eed\u5199\u6d4b\u81ea\u52a8\u53d6\u5f97\u3002\n\n\u4efb\u52a1/Controller\u771f\u5b9e\u8eab\u4efd\u8f6c\u6362\u53ca\u9879\u76ee\u5347\u7ea7\u6cbfTOOL_CONTRACT\u548c\u6839PROJECT_ADOPTION\u7684\u539f\u8d23\u4efb/\u91c7\u7528\u4e8b\u52a1\uff1b\u666e\u901a\u6765\u6e90\u91c7\u7528\u3001\u65e0effect\u7ea0\u6b63\u53ca\u540c\u9879\u76ee\u4e13\u4e1a\u6b63\u6587\u53cc\u52a8\u4f5c\u66f4\u65b0\u6309\u5404\u81ea\u5b9e\u9645\u5199\u96c6\u548c\u6709\u5e8f\u6279\u6b21\uff0c\u4e0d\u6cdb\u5316\u5f3a\u5236\u4e8b\u52a1\uff0c\u4e0d\u4ee5fresh\u51c6\u5165\u8ffd\u8ba4\u65e7\u5199\u5165\u3002\u4e13\u4e1a\u6b63\u6587SOURCE/CONTROL\u4e24\u7c7b\u5f53\u524d\u6743\u9650\u548c\u5404\u81ea\u539f/\u65b0\u4e49\u52a1\u4e92\u4e0d\u66ff\u4ee3\uff1b\u53ef\u6cbf\u53d7\u9650\u8054\u5408\u5165\u53e3\u4e00\u6b21\u63d0\u4ea4\u4e24\u4efd\u539f\u51c6\u5165\u8f93\u5165\uff0c\u5171\u4eab\u540c\u6b21\u5b8c\u6574\u76ee\u6807\u6784\u9020\uff0c\u5404\u81ea\u4ecd\u4ea7\u751f\u771f\u5b9e\u51b3\u5b9a\u3002\u5b8c\u6574\u51c6\u5165\u540e\u6cbf\u539f\u5019\u9009\u6709\u5e8f\u6267\u884c\uff0c\u53ea\u6709\u4e24\u6210\u5458\u771f\u5b9e\u6536\u53e3\u90fd\u6210\u529f\u624d\u79f0\u6574\u6279\u5b8c\u6210\uff1bMaintenance CONTROL\u4e13\u4e1a\u6b63\u6587\u4f8b\u5916\u4ecd\u987b\u5f53\u524dController\u7cbe\u786e\u6388\u6743\u3001\u539f\u51b3\u5b9a\u53ca\u5b8c\u6574\u4fdd\u62a4\uff0c\u666e\u901aSOURCE/TEST_WRITE/BROWSER_RUN/DEVICE_RUN\u7981\u4ee4\u4fdd\u6301\u3002\u672a\u77e5\u7b2c\u4e09\u65b9\u5b57\u8282\u505c\u6b62\u53d7\u5f71\u54cd\u6062\u590d\u3002\n\n\u81ea\u68c0\u5931\u8d25\u6536\u53e3\u4e0d\u7b49\u4e8e\u6d4b\u8bd5\u6210\u529f\uff0c\u4e0d\u5236\u9020\u72ec\u7acbReview finding\uff1b\u5386\u53f2\u5931\u8d25\u4e0e\u672a\u5b8c\u6210\u6210\u679c\u8d23\u4efb\u4fdd\u7559\u3002\u4e34\u65f6\u8fc7\u7a0b\u6750\u6599\u662fINSTRUCTION_BOUND\u5173\u8054\u8bc1\u636e\uff0c\u4e0d\u662f\u7b7e\u540d\u3001\u5bbf\u4e3b\u5f3a\u5236\u6216\u6d88\u8d39\u53f0\u8d26\uff0c\u6309TOOL_CONTRACT\u4fdd\u7559\u81f3\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u3002\n\u666e\u901arepo-local schema1\u53caMaintenance CONTROL/TARGET schema2\u7684\u539f\u5b8c\u6574checker\u5df2\u5728ADMIT\u6309\u540c\u4e00\u56fa\u5b9a\u6765\u6e90/\u9002\u914d\u5668\u3001\u5b8c\u6574\u52a8\u4f5c/\u5bf9\u8c61/\u7eed\u94fe\u53c2\u6570\u548c\u5f53\u524d\u89c2\u5bdf\u6267\u884c\u65f6\uff0c\u7531\u8be5\u5b9e\u9645\u8c03\u7528\u6ee1\u8db3\u6388\u6743\u68c0\u67e5\uff1b\u8c03\u7528\u8005\u7701\u7565\u989d\u5916\u76f8\u540cchecker\u547d\u4ee4\u3002checker\u516c\u5171\u5165\u53e3\u4fdd\u7559\uff1bDISCOVER\u3001ADMIT\u4e0e\u6536\u53e3\u5404\u81ea\u771f\u5b9e\u89c2\u5bdf\u4e0d\u5408\u5e76\u6210\u5168\u5c40\u4e00\u6b21\u6216\u7f13\u5b58\u3002schema4\u53ca\u672a\u8bc1\u660e\u7b49\u4ef7\u7684\u4e13\u95e8\u8def\u5f84\u4ecd\u5206\u522b\u8c03\u7528\uff1b\u9519\u4e3b\u4f53\u3001\u8d8a\u754c\u3001\u524d\u50cf\u6f02\u79fb\u3001\u64a4\u56de\u548c\u574f\u7eed\u94fe\u7167\u539f\u62d2\u7edd\u3002\n\n\u6309\u540c\u4e00\u7a33\u5b9a\u6210\u679csubject\u5c65\u884c\u5f53\u524d\u5361/\u8d28\u91cf\u9009\u62e9\u53ca\u4ecd\u6709\u6548\u7684\u7528\u6237\u3001\u4e13\u4e1a\u548c\u4e13\u95e8\u95e8\uff1b\u7f3a\u7701LEGACY\u53caQA1\u65e7\u5206\u652f\u4fdd\u6301\uff0cQA2\u51bb\u7ed3\u53d1\u8d77workType\u3002\u8d28\u91cf\u9009\u62e9\u4e0d\u6388\u52a8\u4f5c\u3001\u8de8\u4ed3\u6216\u4e13\u95e8\u63a5\u53d7\u6743\uff0c\u7701\u5361\u4e0d\u53d6\u6d88\u6210\u679c\u8d23\u4efb\uff1b\u5c65\u884c\u5b9e\u9645\u9636\u6bb5\uff0c\u771f\u96f6\u4e0d\u9020\u8bc1\u636e\uff0c\u5df2\u53d1\u751f\u5931\u8d25\u5982\u5b9e\u4fdd\u7559\u3002\u9009\u62e9\u4e0e\u683c\u5f0f\u552f\u4e00\u53d6TOOL_CONTRACT\u3002"},{"unitKey":"375|087B4524884420FDD371403C1C372707AD90C4B7149B628AA8D296B04630CA41","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","normativeIdentity":"334|AFBA3D80CC2B690C4A44C6051463AF3135DAC24CB3307CA6CC8A6714BE985DC8","textIdentity":"933|71CC796CDB0ABCFD3DF75C31FB71E4FCE995AA3C66DA4854000AE8683EDDD951","orderedDependencies":[],"fullText":"\u672c\u76ee\u6807\u4f7f\u7528navigationContractVersion=3\u7684PROJECT_BOOTSTRAP\u5165\u53e3\u3002\u9879\u76eeAGENTS\u53ea\u5bfc\u822a\u660e\u786e\u9879\u76ee\u7684.ai-workspace/BOOTSTRAP.md\uff1bBootstrap\u6309\u9879\u76eepin\u53ca\u539f\u91c7\u7528\u8bb0\u5f55\u7ed1\u5b9a\u56fa\u5b9a\u6765\u6e90\u548cTOOLCHAIN\uff0c\u4e0d\u8981\u6c42\u65b0Skill\u3001\u5b89\u88c5\u53d1\u73b0\u6216\u517c\u5bb9\u8f6c\u53d1\u3002\u5bbf\u4e3bAGENTS\u53ef\u89c1\u3001\u6587\u4ef6\u53ef\u8bfb\u548c\u5b9e\u9645\u6b63\u6587\u5df2\u8bfb\u5206\u522b\u6838\u5bf9\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u6216\u6362\u4e3b\u4f53\u6309RECOVERY\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\uff1b\u5065\u5eb7\u4e0a\u4e0b\u6587\u6309RECOVERY\u590d\u7528\uff0c\u540c\u6d3b\u52a8\u666e\u901a\u8303\u56f4\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u9a8c\u5f53\u524d\u51c6\u5165\u4e0e\u9002\u7528\u8981\u6c42\uff0c\u4e0d\u4e3a\u6bcf\u6b21action/final\u91cd\u8f7d\u3002\u65e0\u5173\u4f1a\u8bdd\u4e0d\u542f\u52a8\u9879\u76ee\u6062\u590d\u3002\n\n\u65e7nav1/nav2\u9879\u76ee\u53ca\u5728\u9014\u91c7\u7528\u7ee7\u7eed\u4f7f\u7528\u5404\u81ea\u539f\u56fa\u5b9a\u5165\u53e3\uff0c\u539fFINALIZE\u5b8c\u6210\u540e\u624d\u8bfb\u65b0AGENTS/Bootstrap\uff1b\u90e8\u5206\u6587\u4ef6\u53d8\u5316\u4e0d\u4ee3\u8868\u5207\u6362\u5b8c\u6210\u3002\u65e7Skill\u4ec5\u5728\u771f\u5b9e\u4f9d\u8d56\u7ed3\u675f\u4e14\u6709\u5bbf\u4e3b\u6743\u9650\u65f6\u9000\u5f79\uff0c\u4e0d\u5efa\u6d88\u8d39\u8005\u767b\u8bb0\u6216\u6bcf\u9879\u76ee\u526f\u672c\u3002\u8f93\u5165/\u8bc1\u636e\u4ecd\u53d6\u5f53\u524dTOOL_CONTRACT\uff0c\u5bfc\u822a\u672c\u8eab\u4e0d\u6388\u6743\u3002"},{"unitKey":"375|B8E317E252780BD0E4F97CFD6210BB20EA38D665A4BF01D6CA49B39D12CD6184","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","normativeIdentity":"340|1A6E1EC3F30088B37F9F677965A709D531F0103D1CD1DF4E01D9798D4BDA94E0","textIdentity":"392|C9E6E6DB9F6224EA1D25EE3845C7C7717DB4156B859A655517D8E832F1DBD53A","orderedDependencies":[],"fullText":"\u6309RECOVERY\u7684\u5df2\u7ed1\u5b9abackend/TOOLCHAIN\u53d6\u5f97\u7cbe\u786eoperation\u5165\u53e3\uff0c\u5065\u5eb7\u8c03\u7528\u590d\u7528\u3002\u5df2\u77e5\u72ec\u7acb\u8bfb\u67e5\u540c\u6279\u6267\u884c\uff1b\u6709\u4f9d\u8d56\u4e14\u65e0\u9700\u65b0\u8bed\u4e49\u5224\u65ad\u7684\u673a\u68b0\u6b65\u9aa4\u8fde\u7eed\u7f16\u6392\uff0c\u9010\u95e8\u68c0\u67e5\u5b9e\u9645\u7ed3\u679c\uff0c\u5931\u8d25\u505c\u4f9d\u8d56\u94fe\u3002\u65b0\u4e8b\u5b9e\u3001\u8bed\u4e49\u53d6\u820d\u6216\u771f\u5b9e\u5931\u8d25\u624d\u8fd4\u56de\u6a21\u578b\uff0c\u4e0d\u81ea\u52a8\u586b\u6388\u6743\u3001Review\u6216\u63a5\u53d7PASS\uff1b\u8bb0\u5f55\u3001\u4ea4\u4ed8\u4e0e\u5fc5\u8981\u5f52\u6863\u5728\u539f\u81ea\u7136\u6536\u5c3e\u5b8c\u6210\u3002"},{"unitKey":"376|FEB546FF813DF1D83098AD4E4E70E32DAC78BED9726002363E33F24A621F2B52","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","normativeIdentity":"340|3D3AFF10486F4BA882B820AF4C7051BB3AC55EFF8007B8491803A47DA2FFA9FF","textIdentity":"1145|636F19849A1F4395C5BCE69BC5C82B2E2A0E9A9EDDDE6E8E92AD38408DDE5129","orderedDependencies":[],"fullText":"\u901a\u7528\u7ec8\u6001\u3001\u6d88\u8d39\u8005\u3001Controller\u4f8b\u5916\u548c\u7b49\u5f85\u53d6TASK\uff1b\u672c\u5757\u53ea\u6620\u5c04Codex\u771f\u5b9e\u6295\u9012\u3002\u4f18\u5148turn boundary\uff0c\u5b89\u5168\u4f8b\u5916\u53ef\u7acb\u5373steer\uff1b\u7f3a\u771f\u5b9e\u6027/\u9001\u8fbe\u4fe1\u53f7\u5982\u5b9e\u9650\u5236\u4e3acapability ceiling\u6216REPORT_CHANNEL_UNAVAILABLE\uff0c\u4e0d\u5efaheartbeat\u6216\u6295\u9012\u53f0\u8d26\u3002\n\n\u53d1\u9001\u524d\u6838\u5bf9\u539f\u59cb\u4eba\u7c7b\u5de5\u4f5c\u6d41\u6765\u6e90\u3001\u7cbe\u786e\u6d88\u8d39\u8005\u53ca\u540e\u7eed\u6536\u7a84/\u64a4\u56de\uff1b\u53e6\u4e00\u4efb\u52a1\u8981\u6c42\u672c\u8eab\u4e0d\u63d0\u4f9b\u6d88\u606f\u6388\u6743\u3002\u539f\u751ffinal\u4ec5\u5bf9\u7ed1\u5b9aUSER\u6d88\u8d39\u8005\u4f7f\u7528PREPARE\uff0c\u8de8\u4efb\u52a1PREPARE\u53ea\u662fREADY_TO_SEND\uff0c\u4e0d\u80fd\u7528USER\u66ff\u4ee3\u771f\u5b9e\u63a5\u6536\u8005\u6216\u5ba3\u79f0\u5df2\u9001\u8fbe\u3002\n\n\u5b9e\u9645\u53d1\u9001\u540e\u5728\u540c\u4e00\u5de5\u5177\u7f16\u6392\u4fdd\u5b58\u5b8c\u6574\u539f\u59cb\u8fd4\u56de\u5e76OBSERVE\uff1a\u975e\u9519\u8befMCP text JSON\u4e2d\u552f\u4e00\u5339\u914dthreadId\u8868\u793a\u5bbf\u4e3b\u53d7\u7406\uff1b\u660e\u786e\u62d2\u7edd\u4e3aFAILURE\uff0c\u65e0\u53ef\u786e\u5b9a\u7ed3\u679c\u4e3aUNKNOWN\u3002\u6309TOOL_CONTRACT\u540c\u65f6\u6838\u5bf9\u5f53\u524d\u6d88\u8d39\u8005\u4e0e\u8fd4\u56de\u539f\u5b57\u8282\uff1b\u672a\u77e5/\u5931\u8d25\u505c\u6b62\u4f9d\u8d56\u53d1\u9001\uff0c\u4e0d\u5236\u9020\u672a\u6765\u56de\u6267\u3001ACK\u6216\u989d\u5916\u767b\u8bb0\u56de\u5408\uff0c\u91cd\u8bd5\u8d44\u683c\u53ea\u53d6\u771f\u5b9e\u5bbf\u4e3b\u660e\u786e\u6709\u754c\u4fe1\u53f7\u3002\u53d1\u9001\u53d7\u7406\u4e0d\u7b49\u4e8e\u5bf9\u65b9\u6267\u884c\u3001\u5ba1\u6838\u6216\u63a5\u53d7\u3002\n\u666e\u901aUSER\u7b54\u590d\u80fd\u5426\u7701\u673a\u68b0\u6536\u53e3\uff0c\u53d6\u5f53\u524d\u540c\u65f6\u5fc5\u9009\u7684RECOVERY_CORE / PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES\u5b8c\u6574\u6761\u4ef6\u3002\n"},{"unitKey":"385|421282975C7E07963FD393C7E35769631600C40EB6814F0C876A21A534487235","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"347|06242430771B9014F6E119FBCCB10E9BC8E833E871517344A9A5513E3F44C40E","textIdentity":"1457|3059D6AEEC1DBEE32EFA7CE4D2D37A18F2DBB8814CE58EE98579F7CCFA6BE056","orderedDependencies":[],"fullText":"controller.json\u552f\u4e00\u786e\u5b9a\u5f53\u524dController ID/epoch\uff1bPROJECT_CONTROLLER\u7b7e\u53d1\u8005\u987b\u5339\u914d\uff0cTASK_OWNER\u4e0d\u5f97\u5192\u5145\u3002\u540c\u4e00actor\u53ef\u517c\u4efb\uff0c\u4f46\u7b7e\u53d1\u3001\u63a5\u53d7\u548c\u72ec\u7acb\u5ba1\u6838\u5173\u7cfb\u5206\u522b\u6210\u7acb\u3002Controller\u627f\u62c5\u9879\u76ee\u6301\u7eed\u8d23\u4efb\uff0c\u5bf9\u81ea\u8eab\u7ec4\u7ec7\u3001\u516c\u5171/\u8de8\u57df\u53ca\u8d44\u6e90\u51b3\u5b9a\u7684\u4f9d\u636e\u4e0e\u7ed3\u679c\u8d1f\u8d23\uff1b\u59d4\u6d3e\u6216\u4e13\u5bb6\u7ed3\u8bba\u4e0d\u8f6c\u79fb\u8fd9\u9879\u8d23\u4efb\u3002Owner\u627f\u62c5TASK_AND_SCOPE\u5b9a\u4e49\u7684\u5f53\u524d\u6709\u9650\u6210\u679c\u4e0e\u6574\u5408\u8d23\u4efb\uff0c\u4e34\u65f6\u4e3b\u4f53\u4f9d\u539f\u53d7\u6258\u8303\u56f4\u5c65\u804c\u3002\n\nTASK_OWNER\u5728\u672a\u53d8domain\u6210\u679c\u5185\u76f4\u63a5\u6267\u884c\uff0c\u6216\u9009\u62e9temporary actor/Reviewer\u3001\u7b7e\u7cbe\u786e\u5305\u5e76\u6d88\u8d39\u7ed3\u679c\u3002grantee\u53ea\u6709\u672c\u52a8\u4f5c\u6216\u660e\u786e\u8fde\u7eed\u6279\u6b21\u7684\u4e34\u65f6\u6267\u884c\u8d44\u683c\uff0c\u4e0d\u53d6\u5f97Owner\u6743\u529b\uff0c\u4e0d\u6539Work route\u3002\u672a\u77e5\u63a5\u6536\u8005\u4f7f\u7528TOOL_CONTRACT\u7684\u4e0d\u53ef\u6267\u884c\u5f85\u7ed1\u5b9a\u539f\u4ef6\u53caHOST\u7684\u771f\u5b9e\u81ea\u8eab\u8eab\u4efd\u6838\u5bf9\uff1b\u5df2\u77e5ID\u76f4\u63a5\u7ed1\u5b9a\uff0c\u5065\u5eb7\u7eed\u4f5c\u4e0d\u91cd\u590d\u81ea\u7ed1\u5b9a\u3002\n\nidentity/model\u7684\u5408\u6cd5\u7ed1\u5b9a\u53d8\u5316\u4e0eeffort\u8c03\u6574\u5206\u5f00\uff1beffort\u672c\u8eab\u4e0d\u8f6c\u79fb\u8d23\u4efb\u3001\u4e0d\u6388\u4e88\u6743\u9650\uff0c\u4e0d\u81ea\u52a8\u8981\u6c42handoff\u3001\u65b0\u4efb\u52a1\u6216FULL_COLD\u3002\u8d44\u6e90\u5224\u65ad\u53d6PR_TASK_RESOURCE_SELECTION\uff0c\u5bbf\u4e3b\u5b9e\u9645\u914d\u7f6e\u53d6HOST_CODEX\u3002\n\n\u53ea\u6709Controller\u62e5\u6709\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\uff0c\u6216\u5f53\u524dOwner/\u516c\u5171\u51b3\u5b9a\u3001\u8de8\u57df\u5408\u540c\u3001\u4fdd\u62a4\u3001\u9879\u76ee\u9636\u6bb5\u3001Git/device/external\u6743\u9650\u3001\u8d44\u6e90\u51b2\u7a81\u786e\u9700\u5176\u51b3\u5b9a\u65f6\u624d\u5347\u7ea7\u8def\u7531\uff1b\u5df2\u83b7\u6388\u7684\u9886\u57dfGit\u53ca\u5916\u90e8\u52a8\u4f5c\u6309GIT_AND_EXTERNAL\u76f4\u63a5\u6267\u884c\uff0c\u4e0d\u56e0\u52a8\u4f5c\u540d\u79f0\u5f3a\u5236\u4e2d\u8f6c\u3002Reviewer\u8d44\u683c\u3001finding/APPROVED\u53bb\u5411\u4e0e\u53d7\u6258\u63a5\u53d7\u552f\u4e00\u53d6REVIEW_AND_EVIDENCE\u3002"},{"unitKey":"384|B1FE65D0CB82C9545720FD88512ED8FB9379647E1BA4D6306708C97CA681763B","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\REVIEW_AND_EVIDENCE.md","normativeIdentity":"345|DAB6873E5F29BA15C75B13E96DECBDBCCDD0D823DF11E67D2BFBD300973EE86D","textIdentity":"705|9C72DDB971C85A17E53E43DC69A75D63E7AE7E35CA235208B2E397E315CB1A8E","orderedDependencies":[],"fullText":"\u8bc1\u636e\u53ea\u652f\u6301\u5b9e\u9645\u89c2\u5bdf\u5230\u7684\u5bf9\u8c61\u3001\u73af\u5883\u3001\u673a\u5236\u548c\u8303\u56f4\u3002\u5939\u5177\u53ef\u8bc1\u660e\u901a\u7528\u534f\u8bae\u3001\u5931\u8d25\u5206\u652f\u3001\u89c4\u8303\u8eab\u4efd\u548c\u533f\u540d\u9879\u76ee\u4fdd\u6301\uff1b\u81ea\u7136\u9879\u76ee\u89c2\u5bdf\u53e6\u8bc1\u660e\u5176\u771f\u5b9e\u8c03\u7528\u3001\u8bef\u963b\u65ad/\u6cc4\u6f0f\u53ca\u6709\u8986\u76d6\u7684\u6210\u672c\uff0c\u4e8c\u8005\u4e0d\u4e92\u76f8\u5192\u5145\u3002\u53ef\u9009\u53d1\u884c\u540e\u81ea\u7136\u89c2\u5bdf\u4e0d\u81ea\u52a8\u6210\u4e3a\u65b0\u7684\u53d1\u884c\u95e8\u3002\n\n\u7ed3\u6784PASS\u3001hash\u3001\u8c03\u7528\u8fd4\u56de\u6216\u6a21\u62df\u5bbf\u4e3b\u5747\u4e0d\u8bc1\u660e\u8bed\u4e49\u6b63\u786e\u3001\u6a21\u578battention\u3001\u771f\u5b9e\u6d4f\u89c8\u5668/\u8bbe\u5907\u72b6\u6001\u3001\u8fdc\u7aef\u53d1\u5e03\u6216\u5916\u90e8\u52a8\u4f5c\u5b8c\u6210\u3002\u5931\u8d25\u3001\u4e2d\u65ad\u3001\u672a\u77e5\u3001\u8df3\u8fc7\u548c\u672a\u8fd0\u884c\u660e\u786e\u4fdd\u7559\uff1b\u5e73\u53f0\u652f\u6301\u53ea\u6309\u5bf9\u5e94\u5b9e\u9645conformance\u58f0\u660e\u3002\u65f6\u95f4\u3001\u5b57\u6bb5\u548c\u89c4\u8303\u7ed3\u679c\u7684\u5b9e\u73b0\u8981\u6c42\u53d6TOOL_CONTRACT\u53caTOOLCHAIN\uff0c\u4e0d\u628a\u672a\u9a8c\u8bc1\u5e73\u53f0\u5199\u4e3a\u5df2\u652f\u6301\u3002"},{"unitKey":"381|A9ED385E135784FFDBDE155175E50FE06C1FDB031E0EE19629663F5F980867BE","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\GIT_AND_EXTERNAL.md","normativeIdentity":"347|AE5100E9077726701D50F675066EA8FAACFD2952003BA0E1A7B4A0E7D579ED57","textIdentity":"400|EF5BD2515336BF24040DDE6DA963BFCBA485F5305C3BED1BCD71090A7D06C55D","orderedDependencies":[],"fullText":"browser\u3001device \u4e0e\u5176\u4ed6 external side effect \u5fc5\u987b\u5404\u81ea\u7ed1\u5b9a\u771f\u5b9e\u64cd\u4f5c\u3001\u76ee\u6807\u3001credential/publication boundary\u3001\u7528\u6237\u51b3\u5b9a\u4e0e\u8bc1\u636e\u4e0a\u9650\u3002\u666e\u901aEXTERNAL\u53ef\u7531\u9879\u76ee\u663e\u5f0f\u9009\u62e9\u9884\u6388\u6743\u76f4\u63a5\u8c03\u7528\uff0c\u6309\u6b21\u6a21\u5f0f\u4ecd\u7ed1\u5b9a\u5f53\u524d\u52a8\u4f5c\u5305\uff1b\u6d4f\u89c8\u5668\u3001\u8bbe\u5907\u53ca\u5176\u4ed6\u72ec\u7acb\u95e8\u4e0d\u7531\u8be5\u8bbe\u7f6e\u653e\u5f00\u3002process resolution\u4e0d\u662fhost enforcement\uff0c\u4e0d\u80fd\u4ea7\u751f\u5bbf\u4e3b\u6ca1\u6709\u6388\u4e88\u7684\u80fd\u529b\u3002"},{"unitKey":"379|057F48BCE222E3316D8A084CAA0BE91C4A8481CE70BEAB0E813429362B5744E3","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"340|CCBDECF5FB799067DC05833984237D63E384EDCE6F6A030AE46CFE43950B216F","textIdentity":"805|7C94485EF5CA7FE88445867DED7AA2DDE4F9A884EC09CC010E8DEAEC23624105","orderedDependencies":[],"fullText":"\u4ea4\u4ed8\u672c\u6b21\u8bf7\u6c42\u7684\u5b9e\u9645\u6210\u679c\u3001\u5f53\u524d\u7ed3\u8bba\u53ca\u5fc5\u8981\u8bc1\u636e\u4e0e\u9650\u5236\uff1b\u6709finding\u65f6\u8bf4\u660e\u672a\u6ee1\u8db3\u7684\u6709\u6548\u8981\u6c42\u3001\u539f\u56e0\u3001\u5f71\u54cd\u53ca\u8be5\u8981\u6c42\u89c4\u5b9a\u7684\u53ef\u89c2\u5bdf\u8fbe\u6807\u7ed3\u679c\uff1b\u6709\u672a\u5b8c\u9879\u65f6\u8bf4\u660e\u963b\u585e\u4e0e\u5b9e\u9645\u4e0b\u4e00\u8d23\u4efb\u52a8\u4f5c\u3002\u666e\u901a\u6b63\u6587\u4ec5\u62ab\u9732\u6d88\u8d39\u8005\u5224\u65ad\u6216\u884c\u52a8\u5fc5\u9700\u7684\u4e8b\u5b9e\uff0c\u4e0d\u590d\u5236\u5e38\u89c4\u6210\u529f\u63a7\u5236\u8bc1\u660e\u6216\u65e0\u5173\u654f\u611f\u8d44\u6599\u3002\n\n\u6210\u529f\u63a7\u5236\u8bc1\u660e\u4fdd\u7559\u5728\u5bf9\u5e94\u8bc1\u636e\uff1b\u5931\u8d25\u3001\u672a\u77e5\u3001\u8df3\u8fc7\u548c\u4e2d\u65ad\u4ecd\u660e\u786e\u62a5\u544a\uff0c\u4e0d\u56e0\u7cbe\u7b80\u800c\u541e\u6389\u3002\u81ea\u68c0\u5931\u8d25\u6309\u539f\u6709\u9650\u8bb8\u53ef\u4e0e\u5f53\u524d\u5019\u9009\u7eed\u4f5c\uff0c\u5177\u4f53\u5206\u652f\u4e0e\u8bc1\u636e\u5408\u540c\u53d6 TOOL_CONTRACT\uff1b\u65e0\u8bb8\u53ef\u3001\u8017\u5c3d\u3001\u4e0d\u5b8c\u6574\u6216\u505c\u6b62\u53ea\u7ed3\u675f\u8be5\u52a8\u4f5c\uff0cOwner \u4fdd\u7559\u672a\u5b8c\u6210\u6210\u679c\u8d23\u4efb\u3002\u5b89\u5168\u539f\u52a8\u4f5c\u91cd\u8dd1\u4e0d\u5236\u9020\u7a7a\u5199\u5165\u3001\u865a\u5047\u6210\u529f\u6216\u5ba1\u6838 finding\uff1b\u5386\u53f2\u5931\u8d25\u4fdd\u7559\uff0c\u6210\u529f\u81ea\u67e5\u4e0d\u66ff\u4ee3\u72ec\u7acb\u5ba1\u6838\u3002"},{"unitKey":"378|124C30CFA202641A059A2FE11438EFAB7E5E4BD67749882A20896CCE43810C43","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","normativeIdentity":"339|A8F326ABF1DF9A7EBED76DEEC7EE7B3DE4A172549621AB5FE6F5539982CA1749","textIdentity":"733|F21457FF41D15A5AABE223D679BADEEAD0D55CC6E5FAF050A3C768D3EED3F68B","orderedDependencies":[],"fullText":"backend\u662f\u9879\u76eeFramework\u4f7f\u7528\u914d\u7f6e\uff0c\u4e0d\u662f\u4efb\u52a1\u6216\u52a8\u4f5c\u6388\u6743\u3002\u9996\u6b21\u8c03\u7528\u6216\u76f8\u5173\u6765\u6e90\u53d8\u5316\u65f6\uff0c\u4ee5project\u914d\u7f6e\u7cbe\u786e\u5339\u914dTOOLCHAIN\u7684\u8bed\u8a00\u65e0\u5173operation\u53casealed entrypoint\uff0c\u6ee1\u8db3\u58f0\u660eruntime/platform\uff1b\u5065\u5eb7\u7ed1\u5b9a\u53ef\u590d\u7528\u3002\u5f53\u524d\u53ea\u63d0\u4f9bpowershell7\uff0c\u53ea\u6709\u5b9e\u9645\u53d1\u884c\u63d0\u4f9b\u7b2c\u4e8c\u4e2aofficial backend\u624d\u53ef\u6cbf\u9879\u76ee\u91c7\u7528\u5207\u6362\u3002\n\nbackend\u53d8\u66f4\u4f7f\u53d7\u5f71\u54cd\u914d\u7f6e/\u5305\u7ed1\u5b9a\u5931\u6548\uff0c\u987b\u5b89\u5168\u91c7\u7528\u8fb9\u754c\u53cafresh recovery\u3002\u672a\u77e5backend\u3001\u7f3a\u5165\u53e3\u3001\u4e0d\u652f\u6301\u5e73\u53f0\u6216runtime\u4e0d\u53ef\u7528\u5747\u505c\u6b62\u53d7\u5f71\u54cd\u8c03\u7528\uff0c\u4e0d\u4eceshell\u731c\u6d4b\uff0c\u4e0d\u81ea\u52a8fallback\u3001\u5b89\u88c5\u3001\u751f\u6210adapter\u3001\u53e6\u9020launcher\u6216\u8ba9\u7528\u6237\u9010\u4efb\u52a1\u9009\u540e\u7aef\u3002\u64cd\u4f5c\u683c\u5f0f\u552f\u4e00\u53d6TOOL_CONTRACT\uff0c\u771f\u5b9e\u5165\u53e3/\u652f\u6301\u4e8b\u5b9e\u552f\u4e00\u53d6TOOLCHAIN\u3002"},{"unitKey":"380|02F90580CE6F7E72993DECEC8059ACF4DF38C1CC07E5367833911D2C7CA44237","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\PROJECT_CONTROL.md","normativeIdentity":"345|A11D7DC0232CB39852794228F5F9F6D4C2D8ED2EC0D2F8470542D89FAC6C95D0","textIdentity":"541|84D79FD18593E05C2BF457C6CA0BA50737F6DC4AB19F3542C04E0C35DBDA99A4","orderedDependencies":[],"fullText":"\u9879\u76ee\u91c7\u7528\u52a0\u8f7d\u76ee\u6807starter\u548c\u4efb\u52a1\u5408\u540c\uff0c\u4e0d\u6279\u91cf\u91cd\u5199\u5df2\u6709\u4efb\u52a1\u6216\u4f1a\u8bdd\u3002\u5f53\u524d\u6210\u679c\u7684Owner\u3001\u6267\u884c\u8def\u7ebf\u53ca\u4e34\u65f6\u4e3b\u4f53\u6309TASK_AND_SCOPE\u7ed1\u5b9a\uff1b\u7b7e\u53d1\u4e0e\u771f\u6b63Controller\u4f8b\u5916\u53ea\u53d6AUTHORIZATION_MODEL\uff0c\u4e0d\u56e0\u65b0\u5305\u6216\u4e34\u65f6\u8d44\u6e90\u53d8\u5316\u5f3a\u5236\u4e3b\u63a7\u4e2d\u8f6c\u3002\n\n\u9879\u76ee\u7ed3\u679c\u6d88\u8d39\u7531\u5f53\u524d\u6709\u9650\u6210\u679c\u8d23\u4efb\u4eba\u76f4\u63a5\u5b8c\u6210\uff0c\u9879\u76ee\u6301\u7eed\u4e8b\u5b9e\u7531Controller\u7ef4\u62a4\u3002\u53d1\u73b0\u4efb\u52a1\u6216Controller\u7684\u5728\u9014\u8f6c\u6362\u6807\u8bb0\u65f6\uff0c\u5148\u6cbfRECOVERY_CORE\u548cTOOL_CONTRACT\u6062\u590d\u539f\u4e8b\u52a1\uff0c\u4e0d\u80fd\u7528\u65b0\u7684\u5361\u7247\u6216\u6388\u6743\u8ffd\u8ba4\u672a\u95ed\u5408\u5199\u5165\u3002"},{"unitKey":"379|13B8676DB3AD0D623232B45B8D8F0AD04F9F3B4B85CDC820FBDE1F8FC770C0F8","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","normativeIdentity":"356|7C35999A9A09890C0980EB32709E6D7E6C66A5EE9CC0296A696A094D4537AEEF","textIdentity":"2974|09AD9458D59E18CFD6925AEE7F537BEB90F4BDD88B71D009A01D94FE4D31360E","orderedDependencies":[],"fullText":"DISCOVER\u6838\u5bf9\u5b8c\u6574\u6709\u6548\u58f0\u660e\u3001\u5f53\u524d\u6743\u5a01\u53ca\u771f\u5b9e\u610f\u56fe\uff0c\u9009\u62e9\u5e76\u8bfb\u53d6\u547d\u4e2d\u89c4\u5219\u7684\u5b8c\u6574\u6761\u4ef6\u3001\u6709\u5e8f\u4f9d\u8d56\u548c\u6b63\u6587\uff0c\u8fd4\u56de\u5f53\u524d\u4e49\u52a1\u3002\u91c7\u7528/\u53d8\u66f4\u4ecd\u6838\u5b8c\u6574\u76ee\u6807\u96c6\u5408\uff1b\u672a\u547d\u4e2d\u6b63\u6587\u4e0d\u4f5c\u5065\u5eb7\u8bc1\u660e\u3002\u6bcf\u4e2a\u53d7\u6cbb\u7406\u52a8\u4f5c\u5206\u522b\u6ee1\u8db3\u5f53\u524dchecker/ADMIT\uff0c\u6b63\u5f0f\u7ed3\u679c\u6309\u771f\u5b9e\u6d88\u8d39\u8005FINALIZE\uff1b\u5df2\u8bc1\u660e\u7b49\u4ef7\u7684checker\u7531ADMIT\u5185\u5b8c\u6574\u8c03\u7528\u6ee1\u8db3\u3002\u9879\u76ee\u9884\u6388\u6743\u8303\u56f4\u5185\u7684\u666e\u901a\u5de5\u5177\u76f4\u63a5\u8c03\u7528\u5e76\u4fdd\u539f\u8fd4\u56de\uff0c\u4e0d\u9010\u5de5\u5177\u91cd\u5efa\u8fc7\u7a0b\u94fe\u3002\u5408\u6cd5\u53ea\u8bfb\u67e5\u8bc1\u53ef\u4f5c\u6709\u754cNONE\u6279\u6b21\uff0c\u4e0d\u7f16\u9020\u4efb\u52a1\u6216\u9010\u6587\u4ef6\u51c6\u5165\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u3001\u6362\u4e3b\u4f53\u3001\u6b63\u6587\u4e0d\u786e\u5b9a\u3001\u771f\u5b9e\u6d3b\u52a8\u5207\u6362\u6216\u9002\u7528\u6765\u6e90/\u8981\u6c42\u53d8\u5316\u65f6\uff0c\u6309\u5f53\u524d\u610f\u56feFULL\u53d6\u5f97\u5168\u90e8\u5fc5\u8981\u6b63\u6587\u3002\u5b9e\u73b0\u4e2d\u7684\u8bfb\u53d6\u3001\u4ee3\u7801\u53ca\u914d\u5957\u8bb0\u5f55\u53ef\u5c5e\u540c\u4e00\u6d3b\u52a8\uff1b\u5b9e\u9645TEST_RUN\u3001\u81ea\u67e5\u3001\u5ba1\u6838\u6216\u9a8c\u8bc1\u8f6c\u8fd4\u4fee\u6309\u771f\u5b9e\u65b0\u6d3b\u52a8\u5b8c\u6574\u52a0\u8f7d\u3002\u4fdd\u7559\u5931\u8d25\u3001\u64a4\u6743\u3001\u4fdd\u62a4\u548c\u672a\u5b8c\u91c7\u7528\u7684\u62d2\u7edd\uff1bFULL\u4e0d\u4f7f\u8fd9\u4e9b\u6761\u4ef6\u901a\u8fc7\u3002\n\n\u540c\u4e00\u5065\u5eb7\u6d3b\u52a8\u4e2d\uff0c\u666e\u901a\u6587\u4ef6\u3001\u5305\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u6838\u5f53\u524d\u6743\u9650\u3001\u8303\u56f4\u3001\u771f\u5b9e\u8def\u7ebf\u53ca\u9002\u7528\u8981\u6c42\u3002\u65b0\u5f53\u524d\u64cd\u4f5c\u7531\u539f\u9009\u62e9\u5668\u91cd\u7b97\u5b8c\u6574O\uff1b\u6240\u9700\u6b63\u6587B\u4ecd\u5168\u90e8\u5728\u5b9e\u9645\u5df2\u8bfb\u5b8c\u6574\u96c6\u5408\u4e2d\uff0c\u4e14\u6765\u6e90\u3001\u6d3b\u52a8\u548c\u8def\u7ebf\u672a\u53d8\u65f6\uff0c\u7528\u539fruleReadRef\u91cd\u7ed1\u64cd\u4f5c\uff0c\u4e0d\u8c03\u7528\u6b63\u6587assembler\u6216renderer\u3002\u65b0\u589e\u5fc5\u8981\u6b63\u6587\u3001\u6765\u6e90/\u6d3b\u52a8/\u8def\u7ebf\u53d8\u5316\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8fd4\u56deRULE_LOAD_REQUIRED\u5e76FULL\u3002O\u4e2d\u9000\u51fa\u7684\u4e49\u52a1\u4e0d\u5220\u9664\u5df2\u8bfb\u6b63\u6587\uff1b\u89c4\u5219\u518d\u6b21\u9002\u7528\u4e0d\u7b49\u4e8e\u65b0\u589e\u6b63\u6587\u3002\u4fdd\u5b58\u5f53\u524d\u5b8c\u6574\u4e49\u52a1\u4f9b\u539fFINALIZE\u6d88\u8d39\uff0c\u5386\u53f2\u52a8\u4f5c\u6cbf\u539f\u51bb\u7ed3\u4e49\u52a1\uff0c\u4e0d\u7528\u4eca\u65e5policy\u91cd\u7b97\u65e7\u6210\u529f\u3002\u683c\u5f0f\u4e0e\u65e7actionRebind\u5206\u652f\u53d6TOOL_CONTRACT\u3002\n\n\u6a21\u578b\u53ea\u8bfb\u53d6\u4e00\u4efd\u5b98\u65b9text\uff1a\u6a21\u5f0f\u3001\u771f\u5b9e\u9650\u5236\u3001\u77ed\u6765\u6e90\u3001\u6709\u5e8f\u5f15\u7528\u3001\u5f53\u524d\u4e49\u52a1\u53ca\u540c\u6b21\u53bb\u91cd\u540e\u7684\u5168\u90e8\u5fc5\u8981\u6b63\u6587\u3002\u8c03\u7528\u524d\u5206\u522b\u7ed9\u5916\u5c42\u7f16\u6392\u548c\u5185\u5c42\u547d\u4ee4\u7559\u8db3\u5b8c\u6574\u8f93\u51fa\u9884\u7b97\u3002\u5b9e\u9645\u5bbf\u4e3b\u622a\u65ad\u65f6\u4ece\u540c\u6b21\u7ed3\u679c\u8865\u8bfb\u771f\u5b9e\u7f3a\u5931\u7684\u5b8c\u6574\u5355\u5143\u53ca\u4e49\u52a1\uff1b\u4e0d\u91cd\u65b0\u9009\u62e9\u3001\u4e0d\u4e3b\u52a8\u5206\u9875\u3001\u4e0d\u7528\u6458\u8981\u3001hash\u6216\u65e7\u6536\u636e\u66ff\u4ee3\u672a\u8bfb\u6b63\u6587\u3002\u4e0d\u5f97\u9884\u8f7d\u672a\u6765\u6d3b\u52a8\u3001\u6309\u4e0a\u4e0b\u6587\u5dee\u96c6\u88c1\u6b63\u6587\u6216\u58f0\u79f0\u673a\u5668PASS\u8bc1\u660e\u6a21\u578b\u8bb0\u5fc6/attention\u3002\u65e7REUSE\u4ec5\u6309FULL\u517c\u5bb9\uff0c\u4e0d\u8bfb\u53d6previousCoverageRef\u3002\n\n\u5bbf\u4e3b\u7f16\u7801/\u8f93\u51fa\u9700\u8981\u65f6\uff0c\u540c\u6b21DISCOVER\u7528DisplayPath\u4fdd\u7559\u5b98\u65b9UTF-8 text\uff1bAsJson\u673a\u5668\u8f7d\u4f53\u7531\u7a0b\u5e8f\u6355\u83b7\uff0c\u7ecf\u539f\u5b98\u65b9renderer\u53d6text\uff0c\u4e0d\u76f4\u63a5\u6253\u5370\u673a\u5668JSON\u3002\u8865\u6587\u53ea\u8bfb\u540c\u4e00\u7ed3\u679c\uff1b\u526f\u672c\u548c\u8fc7\u7a0b\u6750\u6599\u7559\u81f3\u5404\u81ea\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u540e\u6cbfTOOL_CONTRACT\u91ca\u653e\u3002\u56fa\u5b9a\u8fd0\u884c\u5305\u4fdd\u6301\u539f\u5b57\u8282\uff0c\u5f53\u524d\u5f00\u53d1\u6765\u6e90\u4e0d\u80fd\u66ff\u4ee3\u5b83\u3002\n\n\u4ec5\u5b9e\u9645NONE\u3001\u65e0\u5305\u65e0\u526f\u4f5c\u7528\u3001\u5411\u5f53\u524dUSER\u4f5c\u666e\u901aPLAN/USER_RESPONSE\uff0c\u4e14\u65e0\u6b63\u5f0fReview/\u63a5\u53d7\u3001TASK_MESSAGE\u3001\u5173\u95ed/\u8d23\u4efb\u8f6c\u6362\u6216continuation\u6d88\u8d39\u8005\u65f6\uff0c\u53ef\u7701\u72ec\u7acb\u673a\u68b0FINALIZE\uff1b\u5b8c\u6574\u89c4\u5219\u8bfb\u53d6\u3001\u4e8b\u5b9e/\u9650\u5236\u548c\u672a\u5b8c\u8d23\u4efb\u4ecd\u5c65\u884c\uff0c\u4e0d\u751f\u6210\u540e\u7ee7\u6267\u884c\u8bb8\u53ef\u3002\u771f\u5b9e\u8de8\u4efb\u52a1\u4ea4\u4ed8\u3001\u8d28\u91cf\u52a8\u4f5c\u548c\u8d23\u4efb\u8f6c\u6362\u6309\u5404\u81ea\u539f\u95e8\uff1b\u9879\u76ee\u9884\u6388\u6743\u76f4\u63a5\u5de5\u5177\u4fdd\u771f\u5b9e\u8fd4\u56de\u5e76\u81ea\u7136\u4ea4\u4ed8\u3002"},{"unitKey":"384|604F6B211764FFE14AA6225A7FB3AEE16A559787A6DA078909AC604A834FD1F0","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"344|4B39A1F0C8A07E3200581F961092E685AF3164A0929A3EBB8A7399FBABA28FA5","textIdentity":"228|24D7CF7CF517B288855FA679D1264EE66BEAB932F5F21CDD75D6517CF0852323","orderedDependencies":[],"fullText":"protected \u6216 excluded \u7684 read/hash/diff/index/write \u8fb9\u754c\u5fc5\u987b\u7cbe\u786e\u4e14 fail closed\u3002scope \u4e3a UNKNOWN \u6216 bounded helper \u4e0d\u53ef\u7528\u65f6\uff0c\u53ea\u8fd4\u56de\u6700\u7a84 blocker\uff1b\u4e0d\u5f97\u6269\u5927\u641c\u7d22\u3001\u4f7f\u7528\u7ed5\u884c\u8bfb\u53d6\u6216\u653e\u5bbd path set\u3002"},{"unitKey":"379|9BC6D3D0EBC1828B3F9942342B0E11F87B9293E0D75CEAF8C9B391CC7D78C9B9","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","normativeIdentity":"339|D2E333342456161615A60FDD108C6BE2C9BFC45B3A8736B5609C78AE78B0B29C","textIdentity":"2734|52E7FF8EF2724AED67FFC6EEE28E3C1ACA22DF19C3E88C49A72944607B09EF54","orderedDependencies":[],"fullText":"\u6062\u590d\u53ea\u8bc1\u660e\u5f53\u524d\u6743\u5a01\u53ca\u4e8b\u5b9e\uff0c\u4e0d\u6388\u4e88\u5199\u3001\u6d4b\u8bd5\u3001Review\u3001Git\u3001\u6d4f\u89c8\u5668/\u8bbe\u5907\u6216\u5916\u90e8\u6743\u9650\u3002\u5148\u4ece\u660e\u786e\u9879\u76ee\u6839\u53ca\u5176AGENTS\u8fdb\u5165\u56fa\u5b9aBOOTSTRAP\uff0c\u6821\u9a8c\u771f\u5b9e\u8def\u5f84\u548c\u62d3\u6251\uff1b\u666e\u901a\u975eGit\u9879\u76ee\u4e0d\u4ee5Git\u51b3\u5b9a\u9879\u76ee\u6839\u3002\u53ef\u9009GIT_WORKTREE\u6cbf\u539f\u4efb\u52a1descriptor\u9a8c\u8bc1\u552f\u4e00controlRoot\u4e0eexecutionRoot\uff0c\u65e7\u590d\u5236\u63a7\u5236\u6750\u6599\u4e0d\u80fd\u66ff\u4ee3\u539f\u6743\u5a01\uff1bMaintenance\u4ecd\u6309\u81ea\u5df1\u7684CONTROL/TARGET\u62d3\u6251\u89e3\u6790\u3002\n\n\u8bfb\u53d6\u5f53\u524dproject\u3001Controller\u3001\u6709\u6548\u7ea0\u6b63\u3001policy\u53ca\u5fc5\u8981\u91c7\u7528\u5b8c\u6210\u4e8b\u5b9e\uff0c\u4ece\u9879\u76eepin\u53ca.ai-workspace/upgrade-recovery/<version>/state.json\u7684distributionBinding\u5b9a\u4f4d\u552f\u4e00\u56fa\u5b9a\u8fd0\u884c\u6765\u6e90\uff0c\u6309\u5b9e\u9645REGISTER/UPGRADE/REFRESH\u5b8c\u6210\u94fe\u6838\u5bf9\u5e76\u8bfb\u53d6TOOLCHAIN\u3002\u5f00\u53d1HEAD\u3001\u7f51\u7edc\u3001\u5176\u4ed6\u9879\u76ee\u6216\u4efb\u610f\u65b0\u5305\u4e0d\u4f5cfallback\u3002\u9996\u6b21/\u65b0\u6765\u6e90\u987b\u5b8c\u6574\u8d44\u683c\u9a8c\u8bc1\uff1b\u666e\u901a\u5df2\u91c7\u7528\u6765\u6e90\u6838\u771f\u5b9e\u5f53\u524d\u5b8c\u6210\u94fe\u3001\u72ec\u7acb\u56fa\u5b9a\u7ed1\u5b9a\u3001manifest\u539f\u59cb\u8eab\u4efd\u4e0e\u58f0\u660e\uff0c\u4ee5\u53ca\u5b9e\u9645\u6d88\u8d39\u7684\u5b9e\u73b0/catalog/\u89c4\u5219\u548c\u5fc5\u8981\u4f9d\u8d56\uff0c\u4e0d\u9012\u5f52\u626b\u63cf\u672a\u6d88\u8d39\u6d4b\u8bd5\u3001\u5386\u53f2\u6216\u5176\u4ed6\u5305\u6210\u5458\uff0c\u4e5f\u4e0d\u4ee5\u8f7b\u91cf\u4e8b\u5b9e\u58f0\u79f0\u5168\u5305\u5065\u5eb7\u3002\u5b8c\u6574\u91c7\u7528\u3001\u8d44\u683c\u548c\u5206\u53d1\u9a8c\u8bc1\u4ecd\u5b8c\u6574\u6838\u5305\uff0c\u4e0d\u628a\u58f0\u660e\u5408\u6210\u4e3a\u5b8c\u6574Facts\u6216\u65b0Proof\uff1b\u4e0d\u52a0\u8de8\u8bf7\u6c42\u7f13\u5b58\u3002\u5f31\u7ed1\u5b9a\u3001\u4ec5\u6807\u8bb0true\u6216\u5b9e\u9645\u6f02\u79fb\u5747\u4e0d\u8db3\uff0c\u672a\u5b8c\u6210\u91c7\u7528\u5148\u6062\u590d\u539f\u4e8b\u52a1\u3002\n\n\u5df2\u6709taskId\u76f4\u63a5\u8bfb\u53d6\u539f\u5361\u53ca\u5fc5\u8981\u9879\u76ee\u4e8b\u5b9e\uff0c\u672a\u77e5\u4efb\u52a1\u624d\u7528\u7d22\u5f15\u5b9a\u4f4d\uff1bSTATUS\u6309\u5168\u5c40\u4e8b\u5b9e\u9700\u8981\u8bfb\u53d6\u3002\u65b0\u8bf7\u6c42\u5148\u6309\u7a33\u5b9a\u6210\u679csubject\u3001\u9879\u76ee\u5361/\u8d28\u91cf\u7b56\u7565\u53ca\u5f53\u524d\u4eba\u7c7b\u51b3\u5b9a\u9009\u62e9\u771f\u5b9e\u4e0a\u4e0b\u6587\uff1a\u9700\u5361\u7528TASK\uff0c\u5141\u8bb8\u7701\u5361\u4f46\u6709\u6210\u679c\u95e8\u6216\u6709\u9650\u5199\u5165/\u591a\u6b65\u6210\u679c\u7528PROJECT_WORK\uff0c\u65e0\u9002\u7528\u4efb\u52a1\u7684\u53ea\u8bfb\u7528PROJECT_READ_ONLY\uff0c\u53ea\u6709\u65e0\u9700\u5361\u6216\u6210\u679c\u95e8\u4e14\u8bb8\u53ef\u8986\u76d6\u7684\u666e\u901a\u5de5\u5177\u7528PROJECT_EXTERNAL\u3002\u7ed1\u5b9a\u539f\u8bf7\u6c42\u3001\u6210\u679cOwner\u3001\u5b9e\u9645actor/role/phase\u3001profile\u3001\u52a8\u4f5c/\u7ed3\u679c\u3001\u7cbe\u786e\u8303\u56f4/\u4fdd\u62a4\u548c\u9002\u7528\u8d28\u91cf\uff0c\u4e0d\u628a\u5f53\u524d\u64cd\u4f5cworkType\u66ff\u4ee3\u53d1\u8d77\u6210\u679cworkType\u3002DISCOVER\u524d\u4f9dTOOL_CONTRACT\u5f62\u6210\u771f\u5b9eIntentEnvelope\uff0c\u53d6\u5f97\u5f53\u524d\u5b8c\u6574\u5fc5\u8981\u6b63\u6587\uff1b\u52a0\u8f7d\u4e0d\u6267\u884c\u52a8\u4f5c\u6216\u4ea7\u751f\u8bb8\u53ef\u3002\u7f3a\u7701LEGACY\u548c\u65e7\u8f93\u5165\u6cbf\u539f\u517c\u5bb9\u6761\u4ef6\uff0c\u672a\u77e5\u4e0d\u964d\u95e8\u3002\n\n\u65b0\u4e8b\u5b9e\u53ea\u91cd\u5efa\u53d7\u5f71\u54cd\u6765\u6e90\u3001\u51b3\u5b9a\u6216\u6b63\u6587\uff1b\u538b\u7f29/\u6362\u4e3b\u4f53/\u6b63\u6587\u4e0d\u786e\u5b9a\u987b\u5b8c\u6574\u6062\u590d\u5f53\u524d\u5fc5\u9700\u6b63\u6587\uff0c\u5065\u5eb7\u8c03\u7528\u4e0d\u9010\u6b65FULL_COLD\u3002LOAD_PLAN_RESOLVE\u53ea\u670d\u52a1\u652f\u6301\u6750\u6599\u3001Framework\u7ef4\u62a4\u8bf4\u660e\u3001\u539f\u517c\u5bb9\u6216\u65e0\u6cd5\u8bc1\u660e\u6620\u5c04\u65f6\u7684\u6709\u754c\u6a21\u5757\u56de\u9000\uff0c\u4e0d\u7b5bcatalog\u6216\u7ed5\u4fdd\u62a4\u3002\u5b9e\u9645Git\u518d\u6838\u5bf9\u5e94\u4ed3\u5e93\u3002\u666e\u901a\u89c2\u5bdf\u4e0d\u53d6\u9879\u76ee/source\u534f\u8c03\u9501\uff0c\u4e0d\u81ea\u52a8\u91cd\u653epublication journal\uff1b\u771f\u5b9e\u4e8b\u52a1\u5199\u8005\u7ade\u4e89\u7684BUSY\u4fdd\u6301holder=UNKNOWN\uff0c\u6536\u8d77\u672c\u6b21\u5c1d\u8bd5\u3002\u663e\u5f0f\u76f8\u5173journal\u7684IN_PROGRESS\u6cbf\u539f\u6062\u590d\u5165\u53e3\uff1b\u4e0d\u5220\u540c\u6b65\u5bf9\u8c61\u3001\u6539pin\u6216\u8865\u8f7d\u5f00\u53d1\u6a21\u5757\u3002\u62a5\u544a\u771f\u5b9e\u4e0b\u4e00\u52a8\u4f5c\u53ca\u8bc1\u636e\u4e0a\u9650\u3002"},{"unitKey":"380|651658BD192B4B5163A255E27C71C80B48A18F9408BB748806C4DE05DF977AD8","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"345|87F3D4FBDEED8AFFD9461F65B92FEFDA6DF0B7066E23535BC1EDD225282B3161","textIdentity":"1005|0EFD729F3D66E462EBEDCE5729703A2EC651E4EE32CE3DA4F3A0EFC6BC0F5B2F","orderedDependencies":[],"fullText":"\u62e5\u6709\u7684\u4ed3\u5e93\u5b57\u8282\u53d8\u5316\u5230\u5019\u9009\u3001\u63a5\u53d7\u6216\u4ea4\u4ed8\u8fb9\u754c\u65f6\uff0cOwner\u5728\u539f\u4efb\u52a1\u8bf4\u660e\u4ea7\u7269\u4e0eGit\u53bb\u5411\uff1aREADY\u542b\u5019\u9009/\u8def\u5f84\u3001\u8bc1\u636e\u548c\u5b9e\u9645closer\uff1bDEFERRED\u542b\u7406\u7531\u3001\u89e6\u53d1\u548c\u8d23\u4efb\uff1bEXCLUDED\u542b\u7406\u7531\u3002\u672a\u95ed\u5408\u8d23\u4efb\u5728\u540e\u7eedNONE\u7b54\u590d\u4ecd\u6709\u6548\uff0c\u5168\u7a0b\u53ea\u8bfb\u8c41\u514d\u3002Review/\u63a5\u53d7\u4e0d\u8bc1\u660eGit\u5c31\u7eea\uff0c\u4e0d\u666e\u904d\u65b0\u5efaGit\u4efb\u52a1\uff1b\u4ec5\u5b9e\u9645\u63a5\u6536\u8005\u6709\u4e0b\u4e00\u52a8\u4f5c\u624d\u53d1\u9001\u7ed3\u679c\u3002\n\n\u5148FINALIZE\u6587\u6863/\u4ea7\u7269\u52a8\u4f5c\uff0c\u518d\u4ee5\u5f53\u524d\u5361\u5355\u5bf9\u8c61CONTROL_WRITE\u66f4\u65b0\u4efb\u52a1\uff1b\u666e\u901a\u5f53\u524d\u5361\u4e0e\u5176\u4ed6\u5bf9\u8c61\u6df7\u5408\u5199\u96c6\u4ecd\u62d2\u7edd\u3002\u771f\u5b9e\u5173\u95ed/\u7269\u7406\u5f52\u6863\u65f6\u53d6\u5f97\u672c\u6a21\u5757PR_TASK_CLOSURE_AND_ARCHIVAL\u5b8c\u6574\u6761\u4ef6\u3002\n\n\u539f\u4efb\u52a1\u81ea\u7136\u6536\u5c3e\u4e00\u6b21\u5904\u7406\u6b63\u5f0f\u6750\u6599\u6301\u4e45\u5f52\u5c5e\u3001\u6709\u6548\u5f15\u7528\u3001\u5df2\u77e5\u4e34\u65f6\u96c6\u5408\u548c\u672a\u89e3\u4f9d\u8d56\uff0c\u751f\u547d\u5468\u671f\u53d6TOOL_CONTRACT\uff1b\u4e0d\u6309\u76ee\u5f55\u5927\u5c0f/\u5e74\u9f84/\u5173\u95ed\u72b6\u6001\u63a8\u5b9a\u53ef\u5220\uff0c\u4e0d\u53e6\u5f00\u6e05\u7406\u6216\u7edf\u8ba1\u56de\u5408\u3002\u5df2\u6709\u8bf7\u6c42\u3001\u5de5\u5177\u3001\u52a0\u8f7d\u3001\u534f\u8c03\u3001\u8fd4\u5de5\u548c\u7528\u6237\u4ecb\u5165\u6570\u636e\u53ef\u7531\u6700\u540e\u6d88\u8d39\u8005\u540c\u6279\u63d0\u53d6\uff0c\u7f3a\u6570\u636e\u4fdd\u7559\u9650\u5236\uff0c\u4e0d\u8bbe\u8d39\u7528\u8bc1\u660e\u95e8\u3002"},{"unitKey":"379|299359FD44BBC7D7B3A042ED10FD4FA4273318FCEE9ACC0DE6B50B0FDE66638A","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"340|8A6AC34F19AC1914088B47A8BE941EC56DB2A77910C7AC78D36249DC4C24BF5B","textIdentity":"675|2A5CD709B28BF4D18462C5F7E773EE3691DF7E1B64917E449C2004CD6D5F13BC","orderedDependencies":[],"fullText":"\u534f\u4f5c\u671f\u95f4\u4e0d\u4ee5wait_threads\u3001wait_agent\u6216\u53cd\u590d\u8bfb\u53d6\u804a\u5929\u3001\u72b6\u6001\u3001\u65e5\u5fd7\u7b49\u5f85\u5176\u4ed6\u4f1a\u8bdd\u3002\u6709\u5b89\u5168\u5de5\u4f5c\u5c31\u7ee7\u7eed\uff0c\u6ca1\u6709\u5c31\u7ed3\u675f\u5f53\u524d\u8f6e\uff0c\u771f\u5b9e\u7ed3\u679c\u9001\u8fbe\u540e\u7eed\u4f5c\u3002\u5bbf\u4e3b\u8981\u6c42\u65b0\u5efa\u540e\u9996\u6b21\u53d6\u5f97\u8fdb\u5ea6\u65f6\uff0c\u6309HOST\u7684\u4e00\u6b21\u6709\u754c\u89c2\u5bdf\u6267\u884c\uff0c\u672a\u5c31\u7eea\u4e0d\u8f6c\u4e3a\u6301\u7eed\u7b49\u5f85\u3002\u5df2\u542f\u52a8\u7684\u5f53\u524d\u547d\u4ee4/\u6d4b\u8bd5\u53ef\u7b49\u5f85\u81ea\u8eab\u5fc5\u8981\u7ed3\u679c\uff1b\u7528\u6237\u4e3b\u52a8\u67e5\u8be2\u53ef\u5355\u6b21\u8bfb\u53d6\u73b0\u72b6\u3002\n\n\u751f\u4ea7/\u81ea\u6d4b\u8f6c\u5165\u65b0\u7684\u4ea4\u5ba1\u5206\u6d3e\u662f\u7ec4\u7ec7\u4e8b\u5b9e\u53d8\u5316\uff0c\u6309PR_REVIEW_ROUTE_PREPARATION\u5904\u7406\u771f\u5b9e\u65b0\u610f\u56fe\u3001\u9009\u62e9\u53ca\u51c6\u5165\u3002\u76f8\u540c\u76ee\u6807\u7684\u5065\u5eb7\u6b63\u6587\u548c\u8bc1\u636e\u53ef\u590d\u7528\uff1b\u6ca1\u6709\u65b0\u5206\u6d3e\u4e0d\u91cd\u590d\u7ec4\u7ec7\u9009\u62e9\uff0c\u4e0d\u91cd\u505a\u5b8c\u6574\u6062\u590d\u6216\u5236\u9020\u7eaf\u8bb0\u8d26\u56de\u5408\u3002"},{"unitKey":"380|90D49D7F144B7ECA3100E7BCCB40D9EC6A31E614A00B98FAD2809130732925CE","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"343|4F710366BA60D3DAEAC0B05F1DB4776A00A495C44E4CD794492672F30FF4B5D2","textIdentity":"1951|545A2FE3BF52CF152337BBA82FBB2D2D8F9B8E7856EA375CD0459446FB0EE654","orderedDependencies":[],"fullText":"\u901a\u7528\u89c4\u5219\u5f52\u7248\u672c\u3001\u9879\u76ee\u6807\u51c6\u5f52\u9879\u76ee\u3001\u65b9\u6848\u5f52\u4efb\u52a1\u3001\u79c1\u6709\u7b97\u6cd5\u5f52\u5b9e\u73b0\u3002\u53ea\u6709\u771f\u5b9e\u5916\u90e8\u6d88\u8d39\u8005\u3001\u517c\u5bb9\u3001\u5b89\u5168\u3001\u786e\u5b9a\u6027\u6216\u5916\u90e8\u6027\u80fd\u627f\u8bfa\u9700\u8981\uff0c\u624d\u628a\u5b9e\u73b0\u673a\u5236\u63d0\u5347\u4e3a\u516c\u5171\u5408\u540c\uff1b\u6d4b\u8bd5\u65b9\u4fbf\u4e0d\u662f\u7406\u7531\uff0c\u5f15\u7528\u4e0d\u5f62\u6210\u7b2c\u4e8c\u6743\u5a01\u3002\u58f0\u79f0\u5b9e\u73b0\u5df2\u63a5\u53d7\u5951\u7ea6\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u7ed1\u5b9a\u5f53\u524d\u6743\u5a01\u3001\u8d1f\u8d23\u63a5\u70b9\u3001\u76f4\u63a5\u6d88\u8d39\u8005/\u6d4b\u8bd5\u4e0e\u8bc1\u636e\uff1b\u6765\u6e90\u5b9e\u8d28\u53d8\u5316\u5148\u91cd\u7ed1\u3002\u5141\u8bb8\u8f7b\u91cf @design-contract <locator> \u5b9a\u4f4d\u539f\u8bbe\u8ba1\u5e76\u4fdd\u7559\u9879\u76ee\u5df2\u6709\u5408\u7406\u6807\u8bb0\uff1b\u4e0d\u590d\u5236\u8bed\u4e49\u3001\u54c8\u5e0c\u6216\u901a\u8fc7\u72b6\u6001\uff0c\u4e0d\u58f0\u79f0\u6807\u8bb0\u8bc1\u660e\u5b9e\u73b0\u4e00\u81f4\uff0c\u4e0d\u8981\u6c42\u5168\u4ed3\u8865\u6807\u3001\u53f0\u8d26\u6216\u626b\u63cf\u3002\u6280\u672f\u4e8b\u5b9e\u5148\u6709\u754c\u67e5\u8bc1\uff0c\u53ea\u628a\u5b9e\u8d28\u76ee\u6807\u3001\u8303\u56f4\u3001\u6743\u9650\u6216\u98ce\u9669\u53d6\u820d\u4ea4\u7528\u6237\uff1b\u4e2d\u95f4\u56de\u7b54\u4e0d\u662f\u6574\u6848\u6388\u6743\uff0c\u4ecd\u6709\u6548\u51b3\u5b9a\u4e0d\u91cd\u590d\u786e\u8ba4\u3002\u91cd\u5927\u51b2\u7a81\u4e0e\u5fc5\u8981\u7528\u6237\u53d6\u820d\u5df2\u89e3\u51b3\u3001\u5269\u4f59\u5047\u8bbe\u6709\u754c\u4e14\u53ef\u9a8c\u8bc1\u548c\u6062\u590d\u65f6\uff0c\u65b9\u6848\u8db3\u591f\u5c31\u7eea\uff0c\u6cbf\u73b0\u6709\u6388\u6743\u63a8\u8fdb\uff1b\u672a\u5904\u7406\u91cd\u5927\u51b2\u7a81\u53ea\u505c\u53d7\u5f71\u54cd\u94fe\u3002\u6309\u5f53\u524d\u5b9e\u9645\u8d28\u91cf\u9009\u62e9\u53ca\u4ecd\u6709\u6548\u7684\u7528\u6237\u3001\u4e13\u4e1a\u6216\u4e13\u95e8\u8981\u6c42\u4fdd\u7559\u5fc5\u8981\u5ba1\u6838\u3002\n\n\u53d8\u66f4\u5b9e\u9645\u5f71\u54cd\u73b0\u884c\u5951\u7ea6\u6216\u8bf4\u660e\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u5b9a\u4f4d\u53d7\u5f71\u54cd\u5b8c\u6574\u6b63\u6587\u3001\u7ef4\u62a4\u8005\u3001\u57fa\u7ebf\u548c\u76f4\u63a5\u4f9d\u8d56\uff0c\u4fdd\u7559\u6761\u4ef6\u3001\u4f8b\u5916\u53ca\u5e76\u53d1\u6709\u6548\u53d8\u66f4\uff0c\u5f62\u6210\u5408\u5e76\u540e\u5019\u9009\uff1b\u589e\u91cf\u4e0d\u4ee3\u66ff\u539f\u6587\uff0c\u89c4\u683c\u9884\u671f\u4e0d\u4ee3\u66ff\u5b9e\u73b0\u8bc1\u636e\u3002\u5fc5\u8981\u89c4\u8303\u5019\u9009\u968f\u6210\u679c\u5728\u9002\u7528\u5ba1\u6838\u548c\u63a5\u53d7\u524d\u51c6\u5907\uff0cOwner\u6309\u539f\u5408\u540c\u63a5\u53d7\u7cbe\u786e\u5019\u9009\uff1b\u540e\u7eed\u5fc5\u8981\u5199\u5165\u3001\u751f\u6548\u3001\u53d1\u884c\u6216\u91c7\u7528\u4ecd\u9700\u5bf9\u5e94\u6388\u6743\u3002\u843d\u5730\u524d\u590d\u6838\u57fa\u7ebf\uff0c\u65b0\u589e\u8bed\u4e49\u6216\u51b2\u7a81\u987b\u91cd\u7ed1\u5019\u9009\u5e76\u590d\u6838\u53d7\u5f71\u54cd\u90e8\u5206\uff0c\u4e0d\u4ee5\u201c\u540c\u6b65\u201d\u53d1\u5e03\u672a\u5ba1\u53d8\u5316\u3002\u672a\u5b8c\u6210\u672c\u6279\u627f\u8bfa\u7684\u89c4\u8303\u7ef4\u62a4\u4e0d\u5ba3\u79f0\u8be5\u9879\u5b8c\u6210\uff1b\u5408\u6cd5\u540e\u7f6e\u4e8b\u9879\u4fdd\u7559\u771f\u5b9e\u524d\u7f6e\u548c\u539f\u8d23\u4efb\u3002\u6309\u5b9e\u9645\u5f71\u54cd\u89e6\u53d1\uff0c\u4e0d\u5f3a\u5236\u65b0\u5efa\u89c4\u683c\u3001\u52a0\u8f7d\u65b9\u6cd5\u6216\u5168\u5e93\u626b\u63cf\uff1b\u5019\u9009\u5df2\u5728\u6700\u7ec8\u76ee\u5f55\u65f6\u4e0d\u8981\u6c42\u63a5\u53d7\u540e\u518d\u590d\u5236\u3002\u53ef\u9009\u8f6f\u4ef6\u8868\u8fbe\u89c1[\u8f6f\u4ef6\u884c\u4e3a\u89c4\u683c\u4e0e\u53d8\u66f4](knowledge/software/BEHAVIOR_SPEC_CHANGE.md)\u3002"},{"unitKey":"380|6CDC0CFBC9AAD03E3907A8BE506FF38DF6FC6B70520CF6C6DF9F0A882C0752FE","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"342|B924ABF64B899AF100006C273223E22F88B6685594C1695172651C5F216C9561","textIdentity":"1176|529A230CFCD58746BCC2A3F4ACAD6B5DCA28849116430315BE71CD7DD929B3A5","orderedDependencies":[],"fullText":"\u5728\u5df2\u63a5\u53d7\u76ee\u6807\u3001\u7cbe\u786e\u6388\u6743\u4e0e\u4fdd\u62a4\u8303\u56f4\u5185\uff0c\u5148\u7406\u89e3\u53d7\u6258\u6210\u679c\u3001\u6709\u6548\u8981\u6c42\u3001\u771f\u5b9e\u673a\u5236\u3001\u76f4\u63a5\u6d88\u8d39\u8005\u53ca\u5931\u8d25\u6062\u590d\uff0c\u6838\u5bf9\u81ea\u8eab\u5224\u65ad\u4e0e\u5b9e\u9645\u7ed3\u679c\u3001\u7ea0\u6b63\u5df2\u77e5\u9519\u8bef\u5e76\u53d6\u5f97\u5fc5\u8981\u5e2e\u52a9\uff1b\u6709\u591a\u6761\u5b9e\u8d28\u53ef\u884c\u8def\u7ebf\u65f6\u6bd4\u8f83\u73b0\u6709\u5b9e\u73b0\u3001\u6807\u51c6\u5e93/\u5e73\u53f0\u3001\u5df2\u6388\u6743\u4f9d\u8d56\u548c\u5fc5\u8981\u65b0\u4ee3\u7801\u7684\u6b63\u786e\u6027\u53ca\u603b\u6210\u672c\uff0c\u9009\u62e9\u6700\u5c0f\u5145\u5206\u65b9\u6848\u3002\u590d\u7528\u4e0d\u5b89\u5168\u6216\u9002\u914d\u4ee3\u4ef7\u66f4\u9ad8\u65f6\u53ef\u6709\u636e\u6362\u7528\uff0c\u4e0d\u4e3a\u5047\u8bbe\u672a\u6765\u65b0\u589e\u673a\u5668\u3002\u6210\u679c\u7c7b\u522b\u53ca\u9a8c\u6536\u4ee5\u7528\u6237\u76ee\u6807\u4e3a\u51c6\uff0c\u5206\u6790\u3001\u6d4b\u8bd5\u6216\u539f\u578b\u4e0d\u66ff\u4ee3\u8bf7\u6c42\u7684\u6b63\u5f0f\u4ea7\u7269\u3002\u672c\u804c\u6838\u5bf9\u548c\u7ea0\u6b63\u4e0d\u9010\u64cd\u4f5c\u589e\u8bbe\u6b63\u5f0fSELF_CHECK\u9636\u6bb5\uff1b\u9002\u7528\u8d28\u91cf\u9636\u6bb5\u4fdd\u7559\uff0c\u666e\u901a\u4f4e\u5f71\u54cd\u4fee\u590d\u4e0d\u65b0\u589e\u5199\u524d\u5ba1\u67e5\u6216\u8868\u5355\uff1b\u91cd\u5927\u5951\u7ea6/\u98ce\u9669/\u8303\u56f4\u51b2\u7a81\u53ea\u505c\u6b62\u53d7\u5f71\u54cd\u94fe\u3002\u5065\u5eb7\u5df2\u5ba1\u7ed3\u8bba\u590d\u7528\uff0c\u5b9e\u9645\u65b0\u589e\u8bc1\u636e\u624d\u91cd\u5f00\u3002MICRO\u540c\u6837\u9075\u5b88\u8fd9\u4e9b\u539f\u5219\uff0c\u4e0d\u56e0\u6b64\u52a0\u8f7d\u5b8c\u6574\u4efb\u52a1\u7ef4\u62a4\u7a0b\u5e8f\u3002\n\n\u5177\u4f53\u8f6f\u4ef6\u8bbe\u8ba1\u3001\u5b9e\u73b0\u548c\u6d4b\u8bd5\u65b9\u6cd5\u7531\u9879\u76ee\u9009\u62e9\u7684\u5b8c\u6574\u6807\u51c6\u63d0\u4f9b\uff1bFramework\u968f\u5305\u53ef\u9009\u6b63\u6587\u89c1standards/README.md\uff0c\u672a\u91c7\u7528\u4e0d\u81ea\u52a8\u8fdb\u5165\u89c4\u5219\u96c6\u5408\u3002\u751f\u4ea7\u548c\u5ba1\u6838\u5bf9\u540c\u4e00\u6210\u679c\u6d88\u8d39\u540c\u4e00\u9002\u7528\u4e13\u4e1a\u8981\u6c42\uff0c\u804c\u8d23\u7a0b\u5e8f\u4ecd\u6309\u5404\u81ea\u89d2\u8272\u9009\u62e9\u3002"},{"unitKey":"382|5669A40454661548F2A456421782673423CCF8681DD078899E0D077B283ED6B7","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\GIT_AND_EXTERNAL.md","normativeIdentity":"349|F32174EEE80AC99F3A4FF81A0F04AC6D0E66590BD3CE3C7B7F58A2077728B031","textIdentity":"3433|EF086205B5EE332D4F346AA9E34B1B5D8C5F0713A54ED767B74B02C8D437BDD8","orderedDependencies":[],"fullText":"\u9879\u76eeexternalAuthorization\u7f3a\u7701PER_ACTION\u3002\u663e\u5f0fPROJECT_PREAUTHORIZED\u5f15\u7528\u65e2\u6709\u9879\u76ee\u8bb8\u53ef\u89c4\u5219\uff0c\u53ea\u6709\u672c\u6d3b\u52a8\u5b9e\u9645\u9002\u7528\u4e14\u5f53\u524d\u4ecd\u8986\u76d6\u8be5\u8c03\u7528\u65f6\uff0c\u6267\u884c\u8005\u76f4\u63a5\u8c03\u7528\u539f\u5de5\u5177\uff1b\u65e0\u9700\u9010\u6b21\u65b0\u5361\u3001\u52a8\u4f5c\u5305\u6216\u6a21\u578bD/A/F\u3002\u5de5\u5177/provider\u3001\u64cd\u4f5c\u3001\u8d26\u53f7/\u6570\u636e\u3001\u8d39\u7528/\u5171\u4eab\u8d44\u6e90\u3001\u53ef\u6267\u884c\u548c\u59d4\u6d3e\u8005\u3001\u91cd\u8bd5/\u505c\u6b62/\u6062\u590d\u7531\u9879\u76ee\u6b63\u6587\u51b3\u5b9a\uff0c\u4e0d\u53e6\u5efa\u6846\u67b6\u8bb8\u53ef\u5f15\u64ce\u3002\u539f\u5de5\u5177/\u5bbf\u4e3b\u8fd4\u56de\u4fdd\u5b9e\u9645\u8bf7\u6c42\u3001\u6b21\u6570\u3001\u8d44\u6e90\u3001\u8f93\u51fa\u4e0eSUCCESS/FAILURE/UNKNOWN\uff1b\u5f53\u524d\u6210\u679c\u7684\u4e13\u4e1a\u9a8c\u6536\u53e6\u6309\u9879\u76ee\u8981\u6c42\u5b8c\u6210\u3002\u672a\u77e5\u6d88\u8d39\u4e0d\u76f2\u91cd\u53d1\uff0c\u4e0d\u80fd\u628a\u540e\u7eed\u653f\u7b56\u53d8\u5316\u5f53\u4f5c\u62b9\u53bb\u5df2\u53d1\u751f\u4e8b\u5b9e\u6216\u5141\u8bb8\u518d\u6b21\u8c03\u7528\u7684\u4f9d\u636e\u3002\n\n\u4ee5\u4e0bbinding1/2\u53ca\u6279\u6b21\u5b57\u6bb5\u7528\u4e8ePER_ACTION\u6216\u660e\u786e\u9009\u62e9\u539f\u6309\u6b21\u5165\u53e3\u7684\u52a8\u4f5c\u3002TASK_OWNER\u53ef\u5728\u5f53\u524d\u9886\u57df\u8d23\u4efb\u548c\u771f\u5b9e\u65e2\u6709\u7528\u6237/\u9879\u76ee\u8d44\u6e90\u8bb8\u53ef\u5185\uff0c\u4e3a\u6709\u9650\u3001\u6709\u5e8f\u4e14\u53ef\u9a8c\u6536\u7684EXTERNAL\u6279\u6b21\u7b7e\u7eaf\u52a8\u4f5c\u5305\u3002\u65e7FREE/0\u5206\u652f\u4fdd\u6301\uff1bexternalBinding2\u53ef\u5f15\u7528\u5df2\u6279\u51c6\u4ed8\u8d39\u6216\u5171\u4eab\u8d44\u6e90\u7684grantRefs\uff0c\u524d\u63d0\u662f\u672c\u6b21\u7528\u9014\u3001provider\u3001\u64cd\u4f5c\u3001payload\u53ca\u539f\u8bb8\u53ef\u5b9e\u9645\u7ea6\u675f\u5b8c\u6574\u53ef\u6838\u5bf9\u3002\u672a\u89c4\u5b9a\u91d1\u989d\u3001\u5e01\u79cd\u6216\u5230\u671f\u65e5\u4e0d\u81ea\u52a8\u7b97UNKNOWN\uff0c\u4e5f\u4e0d\u63a8\u5bfc\u65e0\u9650\u989d\u5ea6\uff1b\u53ea\u6821\u9a8c\u539f\u8bb8\u53ef\u5b9e\u9645\u89c4\u5b9a\u4e14\u672c\u6b21\u4f9d\u8d56\u7684\u6761\u4ef6\u3002\n\n\u540c\u4e00\u6210\u679c\u7684\u65e2\u6709\u8d44\u6e90\u8bb8\u53ef\u4ecd\u6709\u6548\u4e14\u660e\u786e\u5141\u8bb8Owner\u59d4\u6d3e\u65f6\uff0cOwner\u53ef\u76f4\u63a5\u7b7e\u7ed9\u5177\u540d\u539f\u4e13\u4e1a\u6267\u884c\u8005\uff0c\u590d\u7528grantee\u53ca\u539fgrantRefs\uff1bexternalBinding2\u7684grantAssessment\u987b\u660e\u786edelegationPermitted=true\u3002\u7701\u7565\u6216false\u4e0d\u6388\u59d4\u6d3e\uff0c\u65e7binding1\u4ecd\u4ec5Owner\u81ea\u7528\u3002binding2\u4e0bOwner\u4e3b\u8def\u7ebf\u4ecd\u987bactor=Owner\u3001role=TASK_OWNER\uff0c\u4f46\u53ef\u4fdd\u6709\u5f53\u524d\u5408\u6cd5\u4e3bphase\uff1bOwner\u4eb2\u81ea\u6267\u884c\u7684\u6709\u6548\u9636\u6bb5\u4e3aEXTERNAL\uff0c\u5177\u540d\u6267\u884c\u8005\u6309\u4e34\u65f6EXECUTOR/EXTERNAL\u6d88\u8d39\u3002\u5b8c\u6574\u6388\u6743\u5148\u6838\u5bf9\uff0c\u4e24\u8005\u5747\u4e0d\u6539\u53d8Owner\u3001Work route\u6216\u7236\u4efb\u52a1\uff1bbinding1\u4fdd\u7559Owner\u4e3b\u9636\u6bb5EXTERNAL\u53caFREE/0\u65e7\u7ea6\u675f\u3002Owner\u53ca\u63a5\u6536\u8005\u987b\u6838\u539f\u8bb8\u53ef\u7684\u59d4\u6d3e\u8303\u56f4\u3001\u5b9e\u9645\u8d26\u53f7\u3001\u8d39\u7528\u3001\u5171\u4eab\u6761\u4ef6\u4e0e\u5f53\u524d\u64a4\u56de/\u51b2\u7a81\u4e8b\u5b9e\uff1b\u8be5\u58f0\u660e\u4ec5\u4e3aINSTRUCTION_BOUND\u5224\u65ad\uff0c\u4e0d\u662f\u673a\u68b0\u8bed\u4e49\u8bc1\u660e\u3001\u7528\u6237\u8ba4\u8bc1\u6216\u65b0\u8bb8\u53ef\u3002\u8bb8\u53ef\u7981\u8f6c\u6388\u3001\u672a\u77e5\u6216\u9879\u76ee\u4fdd\u7559\u51b3\u5b9a\u4ea4\u5b9e\u9645\u6709\u6743\u8005\uff0c\u4e0d\u9760\u4e3b\u63a7\u7eaf\u8f6c\u7b7e\u6216\u63d0\u5347\u6267\u884c\u8005\u4e3aOwner\u7ed5\u8fc7\u3002\n\n\u6279\u6b21\u7ed1\u5b9a\u7cbe\u786epayload/\u8f93\u51fa\u7528\u9014\u3001\u5fc5\u8981\u6570\u91cf\u4e0e\u91cd\u8bd5\u4e0a\u9650\u3001\u505c\u6b62\u53ca\u6062\u590d\u6761\u4ef6\uff1b\u6ca1\u6709\u9879\u76ee\u6570\u636e\u7684\u64cd\u4f5c\u4ec5\u6309TOOL_CONTRACT\u5c01\u95edZERO_PROJECT_DATA\u7c7b\u522b\u5904\u7406\u3002\u6279\u51c6\u8d44\u6599\u8bfb\u53d6\u4e0d\u81ea\u52a8\u6279\u51c6\u4e0a\u4f20\u6216\u6b63\u5f0f\u8d44\u4ea7\u6fc0\u6d3b\u3002ONE_LOGICAL_ATOMIC_EXECUTION\u53ea\u8868\u793a\u6709\u9650\u6709\u5e8f\u6cbb\u7406\u6279\u6b21\uff0c\u4e0d\u627f\u8bfa\u4f9b\u5e94\u5546\u7269\u7406\u4e8b\u52a1\uff1breissuable=false\u4e0d\u62b9\u53bb\u539f\u8bb8\u53ef\u660e\u786e\u7684\u6bcf\u64cd\u4f5c\u6709\u9650\u91cd\u8bd5\uff0c\u4f46\u7981\u6b62\u6574\u4e2a\u672a\u77e5\u6279\u6b21\u76f2\u91cd\u53d1\u3002UNKNOWN\u53ea\u6cbf\u539f\u8bb8\u53ef\u4e14\u4f9b\u5e94\u5546\u53ef\u8bc1\u5b89\u5168\u7684\u6062\u590d/\u67e5\u8be2\uff0c\u4e0d\u91cd\u5f00\u6279\u6b21\u6e05\u96f6\u6b21\u6570\u3002\n\n\u5df2\u6709grant\u5b8c\u6574\u8986\u76d6\u7684\u4ed8\u8d39/\u5171\u4eab\u4f7f\u7528\u4e0d\u56e0\u7c7b\u522b\u518d\u6b21\u7d22\u6279\u6216\u5f3a\u5236Controller\u4e2d\u8f6c\u3002\u5404escalationFlags\u4ecd\u6309\u771f\u5b9e\u884c\u4e3a\u9010\u9879\u660e\u786e\u586b\u5199\uff0c\u4e0d\u7531\u4e00\u822cgrant\u6216payload\u8eab\u4efd\u63a8\u65adfalse\uff1bbinding2\u4ec5sharedQuotaOrResource\u53ef\u7531\u539fgrant\u8986\u76d6\u3002\u65b0\u8d2d\u4e70/\u8ba2\u9605\u3001\u5546\u4e1a\u8bb8\u53ef\u6539\u53d8\u3001\u8d26\u6237/\u51ed\u636e\u53d8\u5316\u3001\u516c\u5f00\u53d1\u5e03\u3001\u5b89\u88c5\u3001\u53d7\u4fdd\u62a4/\u79d8\u5bc6\u4e0a\u4f20\u3001\u8de8\u57df/\u9636\u6bb5\u53d8\u5316\u3001\u6b63\u5f0f\u8d44\u4ea7\u6fc0\u6d3b\u53ca\u5176\u4ed6true\u7c7b\u522b\u4e0d\u7531\u6b64\u901a\u9053\u653e\u884c\uff0c\u4ecd\u8d70\u76f8\u5e94\u8d23\u4efb\u4e0e\u72ec\u7acb\u95e8\uff1b\u771f\u5b9e\u64a4\u56de\u3001\u8d8ascope\u6216\u5fc5\u8981\u4e8b\u5b9e\u672a\u77e5\u53ea\u505c\u53d7\u5f71\u54cd\u52a8\u4f5c\u3002\u6539\u53d8result kind\u4e0d\u7ed5\u68c0\u67e5\uff0cGit/PUSH\u53e6\u8d70\u4e13\u95e8\u5408\u540c\u3002Framework\u4e0d\u7ba1\u7406\u9879\u76ee\u9884\u7b97\u6216\u8ba1\u8d39\u8d26\u672c\uff0cchecker\u3001\u8fc7\u7a0b\u4e0e\u771f\u5b9ehost\u80fd\u529b\u5206\u522b\u6210\u7acb\u3002"},{"unitKey":"380|1C521534ED698486DD601D202F991BB9142760E13EC9695BC9310D1E8D045F86","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"338|175B33AD8D7B4ED200555128C08FC534A8EBA0B3EB3BACAE36130313B7664BA4","textIdentity":"6315|C2C1444099641EC61FA58BA1A7CFBD697ECEDE6B3608A30850EC3CFC939D490D","orderedDependencies":[],"fullText":"TASK_OWNER\u662f\u5f53\u524d\u6709\u9650\u6210\u679c\u552f\u4e00\u8d1f\u8d23\u4eba\uff1aTASK\u7531\u5361\u7ed1\u5b9a\uff0cPROJECT_WORK\u7531\u539f\u8bf7\u6c42\u548c\u5f53\u524d\u9879\u76ee\u6388\u6743\u7ed1\u5b9a\u3002Owner\u8d1f\u8d23\u76ee\u6807\u660e\u786e\u3001\u5b9e\u65bd\u7ec4\u7ec7\u3001\u9a8c\u8bc1\u3001\u63a5\u53d7\u548c\u4ea7\u7269\u5904\u7f6e\uff1b\u6210\u679c\u95ed\u5408\u91ca\u653e\u6d3b\u8dc3\u8d23\u4efb\uff0c\u5386\u53f2\u7b7e\u8ba4\u53ca\u660e\u786e\u79fb\u4ea4\u7684\u672a\u89e3\u4e49\u52a1\u4fdd\u7559\u3002\u7236\u4efb\u52a1\u53ea\u5728\u786e\u6709\u6301\u7eed\u6210\u679c\u53ca\u534f\u8c03\u8d23\u4efb\u65f6\u4fdd\u5b58\u8303\u56f4\u3001\u4e0b\u7ea7\u5165\u53e3\u3001\u8d44\u6e90\u754c\u9650\u548c\u5347\u7ea7\u6761\u4ef6\uff1b\u7236\u5b50\u5173\u7cfb\u53ea\u5bfc\u822a\uff0c\u4e0d\u6388\u8de8Owner\u7b7e\u53d1\u6743\u3002\u771f\u5b9e\u8de8\u4efb\u52a1\u4f9d\u8d56\u7531\u8d23\u4efb\u4eba\u76f4\u63a5\u534f\u8c03\uff0c\u9879\u76ee\u7ea7\u51b3\u5b9a\u624d\u8def\u7531Controller\u3002\u539f\u6210\u679c\u8d23\u4efb\u4eba\u4fdd\u7559\u672a\u5b8c\u9879\uff0c\u53d6\u5f97\u7f3a\u5c11\u7684\u8f93\u5165\u3001\u6743\u9650\u6216\u4e13\u4e1a\u5e2e\u52a9\uff1b\u786e\u9700\u79fb\u4ea4\u65f6\u6309\u5f53\u524d\u6388\u6743\u660e\u786e\u627f\u63a5\u8005\uff0c\u5c5e\u4e8eController\u7684\u516c\u5171\u51b3\u5b9a\u6309AUTHORIZATION_MODEL\u5347\u7ea7\u3002\n\n\u5df2\u6709TASK\u6cbf\u539f\u5361\u7ee7\u7eed\u81f3\u6210\u679c\u5b8c\u6210\u3002\u65b0\u8bf7\u6c42\u6309\u7a33\u5b9a\u6210\u679csubject\u3001\u9879\u76eetaskCards\u7b56\u7565\u548c\u4ecd\u6709\u6548\u4eba\u7c7b\u51b3\u5b9a\u9009\u62e9\u5361\u53ca\u8d28\u91cf\uff1aREQUIRED\u7528TASK\uff1bOMIT\u4e14\u6709\u6210\u679c\u8d28\u91cf/\u7528\u6237/\u4e13\u4e1a\u95e8\uff0c\u6216\u5c5e\u4e8e\u6709\u9650\u5199\u5165\u3001\u591a\u6b65\u6210\u679c\u65f6\u7528PROJECT_WORK\uff1b\u65e0\u526f\u4f5c\u7528\u53ea\u8bfb\u4e14\u65e0\u9002\u7528\u4efb\u52a1\u7528PROJECT_READ_ONLY\uff1b\u53ea\u6709\u65e0\u9700\u5361\u6216\u6210\u679c\u95e8\u3001\u8bb8\u53ef\u5b8c\u6574\u8986\u76d6\u7684\u666e\u901a\u5de5\u5177\u624d\u7528PROJECT_EXTERNAL\u3002\u7f3a\u7701\u8bbe\u7f6e\u6cbfLEGACY\uff0c\u672a\u77e5\u4e0d\u63a8\u6210OMIT\u6216\u96f6\u95e8\u3002\u7701\u5361\u4fdd\u7559\u6210\u679cOwner\u3001\u6743\u9650\u3001\u9002\u7528\u8d28\u91cf\u3001\u771f\u5b9e\u4ea4\u4ed8\u53ca\u672a\u5b8c\u8d23\u4efb\uff0c\u4e0d\u501f\u5df2\u5173\u95ed\u4efb\u52a1\u3002\u8fdb\u5165TASK\u6216PROJECT_WORK\u540e\uff0c\u5df2\u8986\u76d6\u7684\u9879\u76ee\u9884\u6388\u6743\u5de5\u5177\u4ecd\u76f4\u63a5\u8c03\u7528\uff0c\u4e0d\u9010\u5de5\u5177\u589e\u52a0EXTERNAL\u5305\u6216\u8fc7\u7a0b\u8c03\u7528\u3002\u7cbe\u786e\u8f93\u5165\u548c\u65e7\u683c\u5f0f\u5206\u652f\u53d6TOOL_CONTRACT\u3002\n\n\u5f53\u524d\u4efb\u52a1\u4fdd\u5b58\u76ee\u6807\u4e0e\u5b9e\u9645\u589e\u91cf\u3001\u9a8c\u6536\u573a\u666f\u3001Owner/actor\u3001\u7cbe\u786e\u8303\u56f4/\u6392\u9664\u3001\u5019\u9009\u4e0e\u8bc1\u636e\u3001\u6743\u9650\u3001\u5f53\u524d\u7ed3\u679c/\u963b\u585e\u548c\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\u3002\u65b9\u6848\u6838\u5bf9\u6839\u56e0\u3001\u5f53\u524d\u673a\u5236\u3001\u76f4\u63a5\u6d88\u8d39\u8005\u3001\u80fd\u63a8\u7ffb\u9519\u8bef\u65b9\u6848\u7684\u9a8c\u8bc1\u3001\u91cd\u8981\u5931\u8d25\u6062\u590d\u53ca\u91cd\u5927\u5047\u8bbe\uff1b\u5df2\u6709\u5145\u5206\u7ed3\u8bba\u76f4\u63a5\u5f15\u7528\u3002\u5b9e\u73b0\u53d6\u820d\u53d6PR_TASK_IMPLEMENTATION_JUDGMENT\uff0c\u4e13\u4e1a\u6750\u6599\u6309\u5b9e\u9645\u8981\u6c42\u8bfb\u53d6\uff0c\u4e0d\u5168\u91cf\u52a0\u8f7d\u76ee\u5f55\u6216\u51d1\u53cd\u4f8b\u3002\n\nOwner\u8d1f\u8d23\u6210\u679c\uff0cWork route actor\u8d1f\u8d23\u5f53\u524d\u751f\u4ea7\u8def\u7ebf\uff0caction grantee\u53ea\u627f\u62c5\u6709\u754c\u52a8\u4f5c\uff1b\u7eafReview\u4e0d\u6539\u53d8Owner/Work route\u3002\u5361\u7247\u7684\u552f\u4e00route\u8bed\u6cd5\u3001\u539f\u5b50\u4fee\u6539\u53ca\u65e7\u683c\u5f0f\u8fc1\u79fb\u53d6TOOL_CONTRACT\u3001\u4efb\u52a1\u6a21\u677f\u4e0eMIGRATION_MATRIX\uff0c\u4e0d\u80fd\u4eceOwner\u3001\u5305\u6216\u6807\u9898\u731cactor\u3002\u666e\u901a\u4efb\u52a1\u9ed8\u8ba4SAME_ROOT\uff1b\u786e\u9700\u5df2\u6388\u6743\u9694\u79bb\u65f6\uff0c\u4ee5\u539f\u4efb\u52a1\u7ed1\u5b9a\u7684\u4e0d\u53ef\u53d8descriptor\u9009\u62e9GIT_WORKTREE\u3002\u552f\u4e00controlRoot\u4fdd\u6709\u4efb\u52a1\u3001pin\u3001\u91c7\u7528\u53ca\u6062\u590d\uff0cexecutionRoot\u627f\u8f7d\u6307\u5b9a\u5019\u9009\uff1b\u590d\u5236\u7684\u65e7\u63a7\u5236\u76ee\u5f55\u4e0d\u6210\u4e3a\u65b0\u6743\u5a01\u3002\u76ee\u6807\u7f3a\u5931\u3001\u6839\u5173\u7cfb/HEAD/\u4fdd\u62a4\u6f02\u79fb\u53ea\u505c\u6b62\u53d7\u5f71\u54cd\u52a8\u4f5c\uff0c\u91cd\u65b0\u7ed1\u5b9a\u987b\u5148\u5b8c\u6210\u539f\u52a8\u4f5c\u5e76\u53d6\u5f97\u5f53\u524d\u660e\u786e\u8303\u56f4\uff1b\u4e0d\u81ea\u52a8\u79fb\u9664worktree\u3002\n\n\u540c\u4e00\u76ee\u6807\u3001\u8303\u56f4\u3001\u8d28\u91cf\u53ca\u8d44\u6e90\u8fb9\u754c\u5185\u7684\u53ef\u9884\u6d4b\u6b65\u9aa4\u7ec4\u6210\u53ef\u9a8c\u6536\u6709\u754c\u6279\u6b21\u3002Executor\u81ea\u4e3b\u9009\u62e9\u65b9\u6cd5\u3001\u5de5\u5177\u548c\u987a\u5e8f\uff1b\u5fc5\u9700\u8bca\u65ad\u3001\u4f9d\u8d56\u548c\u5c40\u90e8\u4fee\u590d\u4e0d\u62c6\u6210\u65b0\u51b3\u5b9a\u3002Owner\u6309\u5b8c\u6574\u6210\u679c\u53ca\u5b9e\u9645\u4e0d\u786e\u5b9a\u6027\u9884\u6388\u8db3\u591f\u7684\u6709\u9650\u5199\u6d4b\u7eed\u4f5c\uff1b\u6b21\u6570\u7528\u4e8e\u9632\u5931\u63a7\uff0c\u4e0d\u4ee5\u56fa\u5b9a\u5c0f\u8f6e\u6570\u4ee3\u66ff\u4efb\u52a1\u5224\u65ad\uff0c\u523b\u610f\u53ea\u6388\u7ebf\u6027\u8ba1\u5212\u65f6\u4fdd\u7559\u5176\u5b9e\u9645\u7406\u7531\u3002Executor\u4f9d\u636e\u539f\u59cb\u5931\u8d25\u3001\u5b9e\u9645\u540e\u50cf\u548c\u6700\u77ed\u9a8c\u8bc1\u5224\u65ad\u8fdb\u5c55\uff1a\u8303\u56f4\u5185\u3001\u8bb8\u53ef\u6709\u6548\u4e14\u4e0b\u4e00\u4fee\u6b63\u6709\u53ef\u68c0\u9a8c\u4f9d\u636e\u65f6\u76f4\u63a5\u7eed\u4f5c\uff1b\u91cd\u590d\u540c\u6839\u56e0\u800c\u65e0\u65b0\u8bc1\u636e\u65f6\u5148\u8bca\u65ad\u6216\u505c\u6b62\u3002\u65b9\u6848\u3001\u80fd\u529b\u3001\u8d44\u6e90\u6216\u6743\u9650\u8fb9\u754c\u6539\u53d8\u65f6\uff0c\u53ea\u505c\u53d7\u5f71\u54cd\u52a8\u4f5c\uff0c\u7531Owner\u6d88\u8d39\u5df2\u6709\u5931\u8d25\u3001\u5019\u9009\u548c\u672a\u5b8c\u6210\u9879\uff0c\u53d6\u5f97\u6240\u9700\u8f93\u5165\u3001\u4e13\u4e1a\u5e2e\u52a9\u6216\u6709\u6743\u8005\u51b3\u5b9a\uff0c\u5e76\u7ee7\u7eed\u72ec\u7acb\u5b89\u5168\u5de5\u4f5c\u3002\u505c\u6b62\u4e0d\u8f6c\u79fb\u672a\u5b8c\u6210\u6210\u679c\u8d23\u4efb\uff1b\u771f\u6b63\u79fb\u4ea4\u987b\u5728\u5f53\u524d\u6388\u6743\u4e0b\u660e\u786e\u627f\u63a5\u8005\u3002\u8fdb\u5c55\u5224\u65ad\u4e0d\u6269\u6743\uff0c\u4e0d\u4e3a\u6bcf\u8f6e\u65b0\u589e\u5ba1\u6838\u6216\u6a21\u578b\u8bf7\u6c42\uff1b\u53ea\u91cd\u7ed1\u5931\u6548\u6216\u65b0\u6388\u90e8\u5206\uff0c\u4e0d\u91cd\u5efa\u5065\u5eb7\u4efb\u52a1\u6216\u6e05\u96f6\u5386\u53f2\u3002\u5177\u4f53\u5206\u652f\u3001\u8ba1\u6570\u548c\u6536\u636e\u53ea\u53d6TOOL_CONTRACT\u3002\u5206\u6790\u3001\u539f\u578b\u3001\u81ea\u6d4b\u6216\u5c40\u90e8\u6210\u529f\u4e0d\u80fd\u66ff\u4ee3\u7528\u6237\u8bf7\u6c42\u6210\u679c\u3002\u660e\u786e\u6269\u5c55\u66f4\u65b0\u5b9e\u9645\u8303\u56f4\u548c\u6388\u6743\uff0c\u53ef\u72ec\u7acb\u4ea4\u4ed8\u7684\u65b0\u6210\u679c\u53d6\u5f97\u81ea\u5df1\u7684\u76ee\u6807\u3001\u9a8c\u6536\u548c\u5173\u95ed\u8d23\u4efb\uff1b\u7d27\u5bc6\u76f8\u5173\u4e14\u53ef\u5171\u540c\u9a8c\u6536\u7684\u5de5\u4f5c\u53ef\u5408\u6279\uff0c\u4e0d\u8981\u6c42\u4e00\u529f\u80fd\u4e00\u5361\u3002\u540c\u4e00\u672a\u5b8c\u6210\u6210\u679c\u7684\u5065\u5eb7\u804a\u5929\u53ef\u7eed\u4f5c\uff1b\u65b0\u6709\u9650\u6210\u679c\u53ca\u65b0\u72ec\u5ba1\u9ed8\u8ba4\u65b0\u4f1a\u8bdd\uff0c\u4e0d\u80fd\u9760\u590d\u7528\u804a\u5929\u6269\u5927\u65e7\u76ee\u6807\u548c\u6743\u9650\u3002\u539f\u4e8b\u5fc5\u8981\u8865\u6b63\u3001\u540c\u5ba1\u6709\u754c\u4fee\u590d\u590d\u5ba1\u53ca\u771f\u5b9e\u6301\u7eed\u804c\u8d23\u6309PR_TASK_LAUNCH_AND_ROUTE\u5904\u7406\u3002\u5e76\u884c/\u9694\u79bb\u6309\u771f\u5b9e\u6536\u76ca\u9009\u62e9\uff0c\u5171\u4eab\u51b2\u7a81\u53ea\u9650\u5236\u51b2\u7a81\u5199\u96c6\u3002\n\nController\u548cOwner\u53ef\u56e0\u8d28\u91cf\u3001\u80fd\u529b\u7f3a\u53e3\u6216\u6709\u636e\u603b\u6210\u672c\u6536\u76ca\u5b89\u6392\u6709\u754c\u4e13\u5bb6\uff0c\u4e0d\u4ee5\u4efb\u52a1\u7c7b\u522b\u3001profile\u3001\u8017\u65f6\u6216\u5148\u5931\u8d25\u4f5c\u95e8\u69db\u3002\u8bbe\u8ba1\u7ed9\u7ed3\u8bba\u3001\u4f9d\u636e\u3001\u53d6\u820d\u3001\u9002\u7528\u6761\u4ef6\u53ca\u5b9e\u65bd/\u9a8c\u6536\uff1b\u8c03\u67e5\u7ed9\u6839\u56e0\u3001\u8bc1\u636e\u3001\u4fee\u6b63\u548c\u9a8c\u8bc1\uff1b\u56f0\u96be\u5b9e\u73b0\u53ef\u7531\u8db3\u591f\u80fd\u529b\u8005\u76f4\u63a5\u5b8c\u6210\u3002Owner\u8d1f\u8d23\u7406\u89e3\u7ed3\u8bba\u3001\u5224\u65ad\u9002\u7528\u6027\u5e76\u6574\u5408\uff0c\u590d\u7528\u6709\u6548\u4e13\u4e1a\u6210\u679c\uff0c\u6309\u9700\u7ec4\u7ec7\u6267\u884c\u3001\u9a8c\u8bc1\u3001\u5408\u683c\u4e13\u4e1a\u5ba1\u6838\u6216\u660e\u786e\u53d7\u6258\u63a5\u53d7\u3002\u8bbe\u8ba1/\u5b9e\u73b0\u8d21\u732e\u8005\u4e0d\u80fd\u5145\u4efb\u540c\u6210\u679c\u72ec\u7acbReviewer\uff1b\u666e\u901a\u7b80\u5355\u4efb\u52a1\u4e0d\u5f3a\u5236\u4e13\u5bb6\u3002\u4ec5\u5b9e\u8d28\u65b0\u4e8b\u5b9e\u91cd\u65b0\u54a8\u8be2\u3002\n\nOwner\u5728\u6b63\u5e38\u7ed3\u679c\u6d88\u8d39\u65f6\u66ff\u6362\u552f\u4e00\u4efb\u52a1\u5361\u7684\u8fc7\u65f6\u5f53\u524d\u4e8b\u5b9e\uff0c\u5019\u9009\u4e0d\u6295\u4e3a\u5df2\u63a5\u53d7\uff0c\u8be6\u7ec6\u5386\u53f2/\u5931\u8d25\u5f15\u7528\u539f\u4ef6\u3002writer/reviewer/\u6388\u6743\u53d8\u5316\u7559\u5361\uff1bSTATUS\u4ec5\u968f\u7a33\u5b9a\u9636\u6bb5\u3001\u957f\u671f\u8d23\u4efb\u3001\u4fdd\u62a4\u6216\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\u53d8\u5316\uff0cindex\u4ec5\u968flifecycle/routing\u53d8\u5316\u3002\u65e0\u65b0\u7ed3\u679c\u4e0d\u5199\u5361\uff0c\u4e0d\u4e3a\u53ef\u53d8\u5361\u5efa\u5b57\u6bb5manifest\uff1b\u5e76\u53d1\u6cbf\u539flease/package\u7ea6\u675f\uff0c\u4fdd\u62a4/\u4e0d\u53ef\u53d8\u5bf9\u8c61\u4ecd\u6574\u4f53\u9a8c\u8bc1\u3002\u6d89\u53ca\u8eab\u4efd\u7ec4\u5408\u8f6c\u6362\u5148\u6309RECOVERY\u6062\u590d\u539f\u4e8b\u52a1\uff1b\u6536\u5c3e\u53d6PR_TASK_CHANGED_OUTPUT_DISPOSITION\u3002\n\u6309\u5b8c\u6574\u7a33\u5b9a\u6210\u679csubject\u548c\u9879\u76ee\u8d28\u91cf\u7b56\u7565\u53d6SELF_CHECK/RESULT_REVIEW/RESULT_ACCEPT\u5e76\u96c6\uff0c\u53e0\u52a0\u4ecd\u6709\u6548\u7528\u6237\u3001\u4e13\u4e1a\u53ca\u4e13\u95e8\u9636\u6bb5\u3002\u7f3a\u7701LEGACY\uff1bQA1\u6cbf\u539fsubject/binding1\uff0cQA2\u51bb\u7ed3domain\u3001\u53d1\u8d77workType\u53cadeliverableType\u5e76\u5f62\u6210binding2\uff0c\u4e0d\u4ee5\u5f53\u524dreview\u6216output-delivery\u91cd\u9009\u539f\u6210\u679c\u3002\u771f\u96f6\u4e0d\u9020\u8bc1\u636e\uff0c\u542f\u7528\u800c\u7f3a\u5fc5\u9700\u8ba1\u5212\u4e0d\u964d\u95e8\uff0c\u771f\u5b9e\u5931\u8d25\u4fdd\u7559\u3002\u8d28\u91cf\u9009\u62e9\u4e0d\u6388\u52a8\u4f5c\u3001\u8de8\u4ed3\u6216\u4e13\u95e8\u63a5\u53d7\u6743\uff0c\u7cbe\u786e\u5b57\u6bb5\u53d6TOOL_CONTRACT\u3002\n\n\u6709TASK\u65f6\uff0cOwner\u4ee5QUALITY_PLAN_PREPARE\u6838\u539f\u6301\u4e45\u8981\u6c42\u53ca\u7a33\u5b9asubject\uff0c\u5728\u539f\u5355\u5361\u7ed1\u5b9aplan2\uff1bPROJECT_WORK\u628a\u786e\u9700\u7684acceptancePlan\u653e\u539frequestContext\uff0c\u4e0d\u4e3a\u8d28\u91cf\u5efa\u5f71\u5b50\u5361\u3002\u51bb\u7ed3\u5019\u9009\u548c\u6d88\u8d39\u7ed3\u679c\u65f6\u8865\u771f\u5b9e\u5f15\u7528\uff1b\u7b56\u7565\u53d8\u5316\u53ea\u91cd\u7ed1\u4e0b\u4e00\u5b9e\u9645\u52a8\u4f5c\uff0c\u5386\u53f2\u6210\u529f\u6309\u539f\u7ed1\u5b9a\u6d88\u8d39\u3002SUCCESS\u6ee1\u8db3\u540c\u4e00\u8ba1\u5212\u5168\u90e8\u771f\u5b9e\u9636\u6bb5\uff0c\u53d6\u6d88/\u66ff\u4ee3\u4fdd\u672a\u5b8c\u9879\uff1b\u5361\u5f52\u6863\u5199\u5e8f\u548c\u8d23\u4efb\u91ca\u653e\u53d6\u539f\u5408\u540c\u3002\n"},{"unitKey":"380|BFF736475A03F063E6C2AA6C88662EE1B6B1CFE4ECAEC42336119D7D19B5580E","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"336|C1198F0F9DC7B608B74F6FE6E3E5E5963AE30C055607E01BB116CD62B6803605","textIdentity":"1725|6CB68FEBE6D0EB6046FE68B57741FD199E3D5ED3B57B5BF045DD15052396EF67","orderedDependencies":[],"fullText":"\u7ec8\u6001\u4ec5\u53d1\u4e00\u6b21 compact terminal\uff1a`READY`=\u4e0b\u4e00 authorized phase \u53ef\u5f00\u59cb\uff1b`COMPLETE`=requested outcome+required gates \u5168\u5b8c\u6210\uff1b`BLOCKED`=\u771f\u5b9e boundary \u963b\u6b62\u7ee7\u7eed\uff1b`RANGE_GATE_REQUIRED`=\u7f3a deterministic scope input\uff1bprotected-path exception=exact exception+owner route\u3002\u53d1\u9001\u524d\u7ed1\u5b9a\u5b9e\u9645\u6388\u6743\u3001\u7cbe\u786e\u6d88\u8d39\u8005\u4e0e\u5141\u8bb8\u5185\u5bb9\uff1b\u8ba4\u8bc1 identity/Controller epoch \u7559\u5b9e\u9645\u5de5\u5177\u5305\u7edc\uff0c\u666e\u901a\u6b63\u6587\u4ec5\u62ab\u9732\u6d88\u8d39\u8005\u5224\u65ad\u6216\u884c\u52a8\u5fc5\u9700\u7684\u4e8b\u5b9e\uff0c\u4e0d\u590d\u5236\u5e38\u89c4\u6210\u529f\u63a7\u5236\u8bc1\u660e\u6216\u65e0\u5173\u654f\u611f\u8d44\u6599\u3002authoritative task \u4e0d\u53ef\u8fbe=>`REPORT_CHANNEL_UNAVAILABLE`\uff0c\u4e0d\u5f97\u79f0\u5df2\u4ea4\u4ed8\u3002\u534f\u8bae\u672c\u8eab\u4e0d\u6388\u4e88\u901a\u4fe1\u6743\u3002\n\n\u65e0 ACK\u3002\u534f\u4f5c\u671f\u95f4\u7684\u7b49\u5f85\u4e0e\u7ec4\u7ec7\u5207\u6362\u53ea\u53d6\u672c\u6a21\u5757 PR_TASK_COLLABORATION_BOUNDARY\uff1b\u672c\u5757\u53ea\u5904\u7406\u7ec8\u6001\u4ea4\u4ed8\u3002\u672a\u77e5\u7ed3\u679c\u4e0d\u81ea\u884c\u8f6c\u6210\u6210\u529f\u6216\u91cd\u8bd5\u8bb8\u53ef\u3002\n\n\u4ea4\u4ed8\u4e0e\u73af\u5883/\u8d77\u70b9\u9009\u62e9\u670d\u4ece\u5f53\u524d\u7528\u6237\u51b3\u5b9a\u548c\u5bbf\u4e3b\u5b9e\u9645\u5408\u540c\u3002\u4ec5\u5bbf\u4e3b\u6210\u529f\u4fe1\u53f7\u8bc1\u660e\u9001\u8fbe\u3002\u660e\u786e\u7b56\u7565\u62d2\u7edd\u4e0d\u5f97\u7ed5\u884c\uff1b\u8d85\u65f6\u3001\u672a\u77e5\u6216\u6a21\u7cca\u7ed3\u679c\u505c\u6b62\u53d7\u5f71\u54cd\u53d1\u9001\uff0c\u4e0d\u76f2\u67e5\u91cd\u53d1\u3002\u4ec5\u5bbf\u4e3b\u660e\u786e\u53ef\u91cd\u8bd5\u4e14\u5f53\u524d\u6388\u6743/\u8eab\u4efd\u4ecd\u6709\u6548\u65f6\uff0c\u6309\u5176\u6709\u754c\u5408\u540c\u91cd\u9001\u540c\u4e00\u7ed3\u679c\uff0c\u4e0d\u91cd\u505a Review\u3001\u5efa ACK \u94fe\u6216\u6295\u9012\u53f0\u8d26\u3002\n\n`TERMINAL` \u7ed1\u5b9a proposed consumer \u4e0e\u771f\u5b9e Controller escalation\u3002\u4ec5 Controller-owned unique next action \u6216 `PR_DYNAMIC_ROLE_DIRECT_ISSUANCE` \u5168\u90e8 explicit exceptions \u53ef\u8bbe `controllerEscalationRequired=true`\uff1b\u5426\u5219 `UNNECESSARY_CONTROLLER_RELAY`\u3002fresh package\u3001temporary role/resource change \u4e0d\u662f\u5347\u7ea7\u7406\u7531\u3002\n\nrouting message \u987b\u5e26 host-authenticated task/sender identity+Controller epoch/envelope\uff0c\u62d2 stale epoch\uff1bauthenticity \u4e0d\u53ef\u8bc1\u65f6\u4ec5\u662f untrusted locator\uff0cidentity-dependent transition fail closed\u3002"},{"unitKey":"384|045789C6A6C0B728B64D0861A0C4E330C2602976BEB9A38044AC3EBB67E91242","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"337|EA738FF8699A09759B2B0ACAD916CC67C04275AB9ED46358AB1EEBBB57C59E98","textIdentity":"397|CD2A3B0DA73EEA9D4A1A4060A8BDA05849F28153DF0ECE1709078B952C328C72","orderedDependencies":[],"fullText":"## User decision\n\n\u53ea\u8981\u51bb\u7ed3\u7684 decision\u3001scope\u3001risk \u4e0e boundary \u672a\u53d8\u5316\uff0cuser confirmation \u5c31\u7ee7\u7eed\u6709\u6548\u3002material \u6216 UNKNOWN drift \u9700\u8981\u65b0 decision\uff1b\u65e0\u5173 metadata \u6216 deterministic projection \u4e0d\u9700\u8981\u3002\n\ndrift class \u4e3a `MATERIAL / UNRELATED_METADATA / PROJECTION / UNKNOWN`\u3002immutable candidate\u3001protected object \u4e0e canonical evidence \u4ecd\u6267\u884c\u4e25\u683c whole-object stop\u3002"}],"currentRules":[{"requirementId":"framework:PR_ACTION_AUTHORIZ