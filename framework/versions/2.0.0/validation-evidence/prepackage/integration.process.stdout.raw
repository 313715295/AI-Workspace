untime\u4e0d\u53ef\u7528\u5747\u505c\u6b62\u53d7\u5f71\u54cd\u8c03\u7528\uff0c\u4e0d\u4eceshell\u731c\u6d4b\uff0c\u4e0d\u81ea\u52a8fallback\u3001\u5b89\u88c5\u3001\u751f\u6210adapter\u3001\u53e6\u9020launcher\u6216\u8ba9\u7528\u6237\u9010\u4efb\u52a1\u9009\u540e\u7aef\u3002\u64cd\u4f5c\u683c\u5f0f\u552f\u4e00\u53d6TOOL_CONTRACT\uff0c\u771f\u5b9e\u5165\u53e3/\u652f\u6301\u4e8b\u5b9e\u552f\u4e00\u53d6TOOLCHAIN\u3002","orderedDependencies":[]}],"declarationIdentity":"652|5B211A21B24FF57D7338D6B52576F7D01D5477DAECC8D8C4C293C3F52ABAC426"},{"requirementId":"framework:PR_OWNER_FIRST_DIRECT_DOMAIN_ROUTE","source":"FRAMEWORK","ownerModule":"PROJECT_CONTROL.md","semanticApplicability":"DETERMINISTIC","fullText":"\u9879\u76ee\u91c7\u7528\u52a0\u8f7d\u76ee\u6807starter\u548c\u4efb\u52a1\u5408\u540c\uff0c\u4e0d\u6279\u91cf\u91cd\u5199\u5df2\u6709\u4efb\u52a1\u6216\u4f1a\u8bdd\u3002\u5f53\u524d\u6210\u679c\u7684Owner\u3001\u6267\u884c\u8def\u7ebf\u53ca\u4e34\u65f6\u4e3b\u4f53\u6309TASK_AND_SCOPE\u7ed1\u5b9a\uff1b\u7b7e\u53d1\u4e0e\u771f\u6b63Controller\u4f8b\u5916\u53ea\u53d6AUTHORIZATION_MODEL\uff0c\u4e0d\u56e0\u65b0\u5305\u6216\u4e34\u65f6\u8d44\u6e90\u53d8\u5316\u5f3a\u5236\u4e3b\u63a7\u4e2d\u8f6c\u3002\n\n\u9879\u76ee\u7ed3\u679c\u6d88\u8d39\u7531\u5f53\u524d\u6709\u9650\u6210\u679c\u8d23\u4efb\u4eba\u76f4\u63a5\u5b8c\u6210\uff0c\u9879\u76ee\u6301\u7eed\u4e8b\u5b9e\u7531Controller\u7ef4\u62a4\u3002\u53d1\u73b0\u4efb\u52a1\u6216Controller\u7684\u5728\u9014\u8f6c\u6362\u6807\u8bb0\u65f6\uff0c\u5148\u6cbfRECOVERY_CORE\u548cTOOL_CONTRACT\u6062\u590d\u539f\u4e8b\u52a1\uff0c\u4e0d\u80fd\u7528\u65b0\u7684\u5361\u7247\u6216\u6388\u6743\u8ffd\u8ba4\u672a\u95ed\u5408\u5199\u5165\u3002","preparationRequirements":[],"resultRequirements":[],"selectorIdentity":"585|0B5196B3B2191EF4C2C2FA2073E19E1840ED79703BEF3190FA64BD6363BE57E9","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\PROJECT_CONTROL.md","sourceIdentity":"10135|852EA031DB12091988B5D5C9329750723001394C3BAE14216833D5D5E2C6FB9C","fullText":"\u9879\u76ee\u91c7\u7528\u52a0\u8f7d\u76ee\u6807starter\u548c\u4efb\u52a1\u5408\u540c\uff0c\u4e0d\u6279\u91cf\u91cd\u5199\u5df2\u6709\u4efb\u52a1\u6216\u4f1a\u8bdd\u3002\u5f53\u524d\u6210\u679c\u7684Owner\u3001\u6267\u884c\u8def\u7ebf\u53ca\u4e34\u65f6\u4e3b\u4f53\u6309TASK_AND_SCOPE\u7ed1\u5b9a\uff1b\u7b7e\u53d1\u4e0e\u771f\u6b63Controller\u4f8b\u5916\u53ea\u53d6AUTHORIZATION_MODEL\uff0c\u4e0d\u56e0\u65b0\u5305\u6216\u4e34\u65f6\u8d44\u6e90\u53d8\u5316\u5f3a\u5236\u4e3b\u63a7\u4e2d\u8f6c\u3002\n\n\u9879\u76ee\u7ed3\u679c\u6d88\u8d39\u7531\u5f53\u524d\u6709\u9650\u6210\u679c\u8d23\u4efb\u4eba\u76f4\u63a5\u5b8c\u6210\uff0c\u9879\u76ee\u6301\u7eed\u4e8b\u5b9e\u7531Controller\u7ef4\u62a4\u3002\u53d1\u73b0\u4efb\u52a1\u6216Controller\u7684\u5728\u9014\u8f6c\u6362\u6807\u8bb0\u65f6\uff0c\u5148\u6cbfRECOVERY_CORE\u548cTOOL_CONTRACT\u6062\u590d\u539f\u4e8b\u52a1\uff0c\u4e0d\u80fd\u7528\u65b0\u7684\u5361\u7247\u6216\u6388\u6743\u8ffd\u8ba4\u672a\u95ed\u5408\u5199\u5165\u3002","orderedDependencies":[]}],"declarationIdentity":"1136|92EB7A75829C7F6F3C7BFF66F260093E2BB316EB9B6D4B48F8B3638B3413E002"},{"requirementId":"framework:PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES","source":"FRAMEWORK","ownerModule":"RECOVERY_CORE.md","semanticApplicability":"DETERMINISTIC","fullText":"DISCOVER\u6838\u5bf9\u5b8c\u6574\u6709\u6548\u58f0\u660e\u3001\u5f53\u524d\u6743\u5a01\u53ca\u771f\u5b9e\u610f\u56fe\uff0c\u9009\u62e9\u5e76\u8bfb\u53d6\u547d\u4e2d\u89c4\u5219\u7684\u5b8c\u6574\u6761\u4ef6\u3001\u6709\u5e8f\u4f9d\u8d56\u548c\u6b63\u6587\uff0c\u8fd4\u56de\u5f53\u524d\u4e49\u52a1\u3002\u91c7\u7528/\u53d8\u66f4\u4ecd\u6838\u5b8c\u6574\u76ee\u6807\u96c6\u5408\uff1b\u672a\u547d\u4e2d\u6b63\u6587\u4e0d\u4f5c\u5065\u5eb7\u8bc1\u660e\u3002\u6bcf\u4e2a\u53d7\u6cbb\u7406\u52a8\u4f5c\u5206\u522b\u6ee1\u8db3\u5f53\u524dchecker/ADMIT\uff0c\u6b63\u5f0f\u7ed3\u679c\u6309\u771f\u5b9e\u6d88\u8d39\u8005FINALIZE\uff1b\u5df2\u8bc1\u660e\u7b49\u4ef7\u7684checker\u7531ADMIT\u5185\u5b8c\u6574\u8c03\u7528\u6ee1\u8db3\u3002\u9879\u76ee\u9884\u6388\u6743\u8303\u56f4\u5185\u7684\u666e\u901a\u5de5\u5177\u76f4\u63a5\u8c03\u7528\u5e76\u4fdd\u539f\u8fd4\u56de\uff0c\u4e0d\u9010\u5de5\u5177\u91cd\u5efa\u8fc7\u7a0b\u94fe\u3002\u5408\u6cd5\u53ea\u8bfb\u67e5\u8bc1\u53ef\u4f5c\u6709\u754cNONE\u6279\u6b21\uff0c\u4e0d\u7f16\u9020\u4efb\u52a1\u6216\u9010\u6587\u4ef6\u51c6\u5165\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u3001\u6362\u4e3b\u4f53\u3001\u6b63\u6587\u4e0d\u786e\u5b9a\u3001\u771f\u5b9e\u6d3b\u52a8\u5207\u6362\u6216\u9002\u7528\u6765\u6e90/\u8981\u6c42\u53d8\u5316\u65f6\uff0c\u6309\u5f53\u524d\u610f\u56feFULL\u53d6\u5f97\u5168\u90e8\u5fc5\u8981\u6b63\u6587\u3002\u5b9e\u73b0\u4e2d\u7684\u8bfb\u53d6\u3001\u4ee3\u7801\u53ca\u914d\u5957\u8bb0\u5f55\u53ef\u5c5e\u540c\u4e00\u6d3b\u52a8\uff1b\u5b9e\u9645TEST_RUN\u3001\u81ea\u67e5\u3001\u5ba1\u6838\u6216\u9a8c\u8bc1\u8f6c\u8fd4\u4fee\u6309\u771f\u5b9e\u65b0\u6d3b\u52a8\u5b8c\u6574\u52a0\u8f7d\u3002\u4fdd\u7559\u5931\u8d25\u3001\u64a4\u6743\u3001\u4fdd\u62a4\u548c\u672a\u5b8c\u91c7\u7528\u7684\u62d2\u7edd\uff1bFULL\u4e0d\u4f7f\u8fd9\u4e9b\u6761\u4ef6\u901a\u8fc7\u3002\n\n\u540c\u4e00\u5065\u5eb7\u6d3b\u52a8\u4e2d\uff0c\u666e\u901a\u6587\u4ef6\u3001\u5305\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u6838\u5f53\u524d\u6743\u9650\u3001\u8303\u56f4\u3001\u771f\u5b9e\u8def\u7ebf\u53ca\u9002\u7528\u8981\u6c42\u3002\u65b0\u5f53\u524d\u64cd\u4f5c\u7531\u539f\u9009\u62e9\u5668\u91cd\u7b97\u5b8c\u6574O\uff1b\u6240\u9700\u6b63\u6587B\u4ecd\u5168\u90e8\u5728\u5b9e\u9645\u5df2\u8bfb\u5b8c\u6574\u96c6\u5408\u4e2d\uff0c\u4e14\u6765\u6e90\u3001\u6d3b\u52a8\u548c\u8def\u7ebf\u672a\u53d8\u65f6\uff0c\u7528\u539fruleReadRef\u91cd\u7ed1\u64cd\u4f5c\uff0c\u4e0d\u8c03\u7528\u6b63\u6587assembler\u6216renderer\u3002\u65b0\u589e\u5fc5\u8981\u6b63\u6587\u3001\u6765\u6e90/\u6d3b\u52a8/\u8def\u7ebf\u53d8\u5316\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8fd4\u56deRULE_LOAD_REQUIRED\u5e76FULL\u3002O\u4e2d\u9000\u51fa\u7684\u4e49\u52a1\u4e0d\u5220\u9664\u5df2\u8bfb\u6b63\u6587\uff1b\u89c4\u5219\u518d\u6b21\u9002\u7528\u4e0d\u7b49\u4e8e\u65b0\u589e\u6b63\u6587\u3002\u4fdd\u5b58\u5f53\u524d\u5b8c\u6574\u4e49\u52a1\u4f9b\u539fFINALIZE\u6d88\u8d39\uff0c\u5386\u53f2\u52a8\u4f5c\u6cbf\u539f\u51bb\u7ed3\u4e49\u52a1\uff0c\u4e0d\u7528\u4eca\u65e5policy\u91cd\u7b97\u65e7\u6210\u529f\u3002\u683c\u5f0f\u4e0e\u65e7actionRebind\u5206\u652f\u53d6TOOL_CONTRACT\u3002\n\n\u6a21\u578b\u53ea\u8bfb\u53d6\u4e00\u4efd\u5b98\u65b9text\uff1a\u6a21\u5f0f\u3001\u771f\u5b9e\u9650\u5236\u3001\u77ed\u6765\u6e90\u3001\u6709\u5e8f\u5f15\u7528\u3001\u5f53\u524d\u4e49\u52a1\u53ca\u540c\u6b21\u53bb\u91cd\u540e\u7684\u5168\u90e8\u5fc5\u8981\u6b63\u6587\u3002\u8c03\u7528\u524d\u5206\u522b\u7ed9\u5916\u5c42\u7f16\u6392\u548c\u5185\u5c42\u547d\u4ee4\u7559\u8db3\u5b8c\u6574\u8f93\u51fa\u9884\u7b97\u3002\u5b9e\u9645\u5bbf\u4e3b\u622a\u65ad\u65f6\u4ece\u540c\u6b21\u7ed3\u679c\u8865\u8bfb\u771f\u5b9e\u7f3a\u5931\u7684\u5b8c\u6574\u5355\u5143\u53ca\u4e49\u52a1\uff1b\u4e0d\u91cd\u65b0\u9009\u62e9\u3001\u4e0d\u4e3b\u52a8\u5206\u9875\u3001\u4e0d\u7528\u6458\u8981\u3001hash\u6216\u65e7\u6536\u636e\u66ff\u4ee3\u672a\u8bfb\u6b63\u6587\u3002\u4e0d\u5f97\u9884\u8f7d\u672a\u6765\u6d3b\u52a8\u3001\u6309\u4e0a\u4e0b\u6587\u5dee\u96c6\u88c1\u6b63\u6587\u6216\u58f0\u79f0\u673a\u5668PASS\u8bc1\u660e\u6a21\u578b\u8bb0\u5fc6/attention\u3002\u65e7REUSE\u4ec5\u6309FULL\u517c\u5bb9\uff0c\u4e0d\u8bfb\u53d6previousCoverageRef\u3002\n\n\u5bbf\u4e3b\u7f16\u7801/\u8f93\u51fa\u9700\u8981\u65f6\uff0c\u540c\u6b21DISCOVER\u7528DisplayPath\u4fdd\u7559\u5b98\u65b9UTF-8 text\uff1bAsJson\u673a\u5668\u8f7d\u4f53\u7531\u7a0b\u5e8f\u6355\u83b7\uff0c\u7ecf\u539f\u5b98\u65b9renderer\u53d6text\uff0c\u4e0d\u76f4\u63a5\u6253\u5370\u673a\u5668JSON\u3002\u8865\u6587\u53ea\u8bfb\u540c\u4e00\u7ed3\u679c\uff1b\u526f\u672c\u548c\u8fc7\u7a0b\u6750\u6599\u7559\u81f3\u5404\u81ea\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u540e\u6cbfTOOL_CONTRACT\u91ca\u653e\u3002\u56fa\u5b9a\u8fd0\u884c\u5305\u4fdd\u6301\u539f\u5b57\u8282\uff0c\u5f53\u524d\u5f00\u53d1\u6765\u6e90\u4e0d\u80fd\u66ff\u4ee3\u5b83\u3002\n\n\u4ec5\u5b9e\u9645NONE\u3001\u65e0\u5305\u65e0\u526f\u4f5c\u7528\u3001\u5411\u5f53\u524dUSER\u4f5c\u666e\u901aPLAN/USER_RESPONSE\uff0c\u4e14\u65e0\u6b63\u5f0fReview/\u63a5\u53d7\u3001TASK_MESSAGE\u3001\u5173\u95ed/\u8d23\u4efb\u8f6c\u6362\u6216continuation\u6d88\u8d39\u8005\u65f6\uff0c\u53ef\u7701\u72ec\u7acb\u673a\u68b0FINALIZE\uff1b\u5b8c\u6574\u89c4\u5219\u8bfb\u53d6\u3001\u4e8b\u5b9e/\u9650\u5236\u548c\u672a\u5b8c\u8d23\u4efb\u4ecd\u5c65\u884c\uff0c\u4e0d\u751f\u6210\u540e\u7ee7\u6267\u884c\u8bb8\u53ef\u3002\u771f\u5b9e\u8de8\u4efb\u52a1\u4ea4\u4ed8\u3001\u8d28\u91cf\u52a8\u4f5c\u548c\u8d23\u4efb\u8f6c\u6362\u6309\u5404\u81ea\u539f\u95e8\uff1b\u9879\u76ee\u9884\u6388\u6743\u76f4\u63a5\u5de5\u5177\u4fdd\u771f\u5b9e\u8fd4\u56de\u5e76\u81ea\u7136\u4ea4\u4ed8\u3002","preparationRequirements":["DISCOVER_RECEIPT_BOUND","SELECTED_RULE_BLOCKS_LOADED"],"resultRequirements":["BOUNDARY_RECEIPT_REUSED"],"selectorIdentity":"225|00AFDA43FF5054E997C982EA1FA60FD16FB9840B89561F1EF6C88ED8980BAF33","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","sourceIdentity":"7885|CA6AE9C5E588F13F7FC6328B0F4454FD70D6553F25982908FD128D85292825E5","fullText":"DISCOVER\u6838\u5bf9\u5b8c\u6574\u6709\u6548\u58f0\u660e\u3001\u5f53\u524d\u6743\u5a01\u53ca\u771f\u5b9e\u610f\u56fe\uff0c\u9009\u62e9\u5e76\u8bfb\u53d6\u547d\u4e2d\u89c4\u5219\u7684\u5b8c\u6574\u6761\u4ef6\u3001\u6709\u5e8f\u4f9d\u8d56\u548c\u6b63\u6587\uff0c\u8fd4\u56de\u5f53\u524d\u4e49\u52a1\u3002\u91c7\u7528/\u53d8\u66f4\u4ecd\u6838\u5b8c\u6574\u76ee\u6807\u96c6\u5408\uff1b\u672a\u547d\u4e2d\u6b63\u6587\u4e0d\u4f5c\u5065\u5eb7\u8bc1\u660e\u3002\u6bcf\u4e2a\u53d7\u6cbb\u7406\u52a8\u4f5c\u5206\u522b\u6ee1\u8db3\u5f53\u524dchecker/ADMIT\uff0c\u6b63\u5f0f\u7ed3\u679c\u6309\u771f\u5b9e\u6d88\u8d39\u8005FINALIZE\uff1b\u5df2\u8bc1\u660e\u7b49\u4ef7\u7684checker\u7531ADMIT\u5185\u5b8c\u6574\u8c03\u7528\u6ee1\u8db3\u3002\u9879\u76ee\u9884\u6388\u6743\u8303\u56f4\u5185\u7684\u666e\u901a\u5de5\u5177\u76f4\u63a5\u8c03\u7528\u5e76\u4fdd\u539f\u8fd4\u56de\uff0c\u4e0d\u9010\u5de5\u5177\u91cd\u5efa\u8fc7\u7a0b\u94fe\u3002\u5408\u6cd5\u53ea\u8bfb\u67e5\u8bc1\u53ef\u4f5c\u6709\u754cNONE\u6279\u6b21\uff0c\u4e0d\u7f16\u9020\u4efb\u52a1\u6216\u9010\u6587\u4ef6\u51c6\u5165\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u3001\u6362\u4e3b\u4f53\u3001\u6b63\u6587\u4e0d\u786e\u5b9a\u3001\u771f\u5b9e\u6d3b\u52a8\u5207\u6362\u6216\u9002\u7528\u6765\u6e90/\u8981\u6c42\u53d8\u5316\u65f6\uff0c\u6309\u5f53\u524d\u610f\u56feFULL\u53d6\u5f97\u5168\u90e8\u5fc5\u8981\u6b63\u6587\u3002\u5b9e\u73b0\u4e2d\u7684\u8bfb\u53d6\u3001\u4ee3\u7801\u53ca\u914d\u5957\u8bb0\u5f55\u53ef\u5c5e\u540c\u4e00\u6d3b\u52a8\uff1b\u5b9e\u9645TEST_RUN\u3001\u81ea\u67e5\u3001\u5ba1\u6838\u6216\u9a8c\u8bc1\u8f6c\u8fd4\u4fee\u6309\u771f\u5b9e\u65b0\u6d3b\u52a8\u5b8c\u6574\u52a0\u8f7d\u3002\u4fdd\u7559\u5931\u8d25\u3001\u64a4\u6743\u3001\u4fdd\u62a4\u548c\u672a\u5b8c\u91c7\u7528\u7684\u62d2\u7edd\uff1bFULL\u4e0d\u4f7f\u8fd9\u4e9b\u6761\u4ef6\u901a\u8fc7\u3002\n\n\u540c\u4e00\u5065\u5eb7\u6d3b\u52a8\u4e2d\uff0c\u666e\u901a\u6587\u4ef6\u3001\u5305\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u6838\u5f53\u524d\u6743\u9650\u3001\u8303\u56f4\u3001\u771f\u5b9e\u8def\u7ebf\u53ca\u9002\u7528\u8981\u6c42\u3002\u65b0\u5f53\u524d\u64cd\u4f5c\u7531\u539f\u9009\u62e9\u5668\u91cd\u7b97\u5b8c\u6574O\uff1b\u6240\u9700\u6b63\u6587B\u4ecd\u5168\u90e8\u5728\u5b9e\u9645\u5df2\u8bfb\u5b8c\u6574\u96c6\u5408\u4e2d\uff0c\u4e14\u6765\u6e90\u3001\u6d3b\u52a8\u548c\u8def\u7ebf\u672a\u53d8\u65f6\uff0c\u7528\u539fruleReadRef\u91cd\u7ed1\u64cd\u4f5c\uff0c\u4e0d\u8c03\u7528\u6b63\u6587assembler\u6216renderer\u3002\u65b0\u589e\u5fc5\u8981\u6b63\u6587\u3001\u6765\u6e90/\u6d3b\u52a8/\u8def\u7ebf\u53d8\u5316\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8fd4\u56deRULE_LOAD_REQUIRED\u5e76FULL\u3002O\u4e2d\u9000\u51fa\u7684\u4e49\u52a1\u4e0d\u5220\u9664\u5df2\u8bfb\u6b63\u6587\uff1b\u89c4\u5219\u518d\u6b21\u9002\u7528\u4e0d\u7b49\u4e8e\u65b0\u589e\u6b63\u6587\u3002\u4fdd\u5b58\u5f53\u524d\u5b8c\u6574\u4e49\u52a1\u4f9b\u539fFINALIZE\u6d88\u8d39\uff0c\u5386\u53f2\u52a8\u4f5c\u6cbf\u539f\u51bb\u7ed3\u4e49\u52a1\uff0c\u4e0d\u7528\u4eca\u65e5policy\u91cd\u7b97\u65e7\u6210\u529f\u3002\u683c\u5f0f\u4e0e\u65e7actionRebind\u5206\u652f\u53d6TOOL_CONTRACT\u3002\n\n\u6a21\u578b\u53ea\u8bfb\u53d6\u4e00\u4efd\u5b98\u65b9text\uff1a\u6a21\u5f0f\u3001\u771f\u5b9e\u9650\u5236\u3001\u77ed\u6765\u6e90\u3001\u6709\u5e8f\u5f15\u7528\u3001\u5f53\u524d\u4e49\u52a1\u53ca\u540c\u6b21\u53bb\u91cd\u540e\u7684\u5168\u90e8\u5fc5\u8981\u6b63\u6587\u3002\u8c03\u7528\u524d\u5206\u522b\u7ed9\u5916\u5c42\u7f16\u6392\u548c\u5185\u5c42\u547d\u4ee4\u7559\u8db3\u5b8c\u6574\u8f93\u51fa\u9884\u7b97\u3002\u5b9e\u9645\u5bbf\u4e3b\u622a\u65ad\u65f6\u4ece\u540c\u6b21\u7ed3\u679c\u8865\u8bfb\u771f\u5b9e\u7f3a\u5931\u7684\u5b8c\u6574\u5355\u5143\u53ca\u4e49\u52a1\uff1b\u4e0d\u91cd\u65b0\u9009\u62e9\u3001\u4e0d\u4e3b\u52a8\u5206\u9875\u3001\u4e0d\u7528\u6458\u8981\u3001hash\u6216\u65e7\u6536\u636e\u66ff\u4ee3\u672a\u8bfb\u6b63\u6587\u3002\u4e0d\u5f97\u9884\u8f7d\u672a\u6765\u6d3b\u52a8\u3001\u6309\u4e0a\u4e0b\u6587\u5dee\u96c6\u88c1\u6b63\u6587\u6216\u58f0\u79f0\u673a\u5668PASS\u8bc1\u660e\u6a21\u578b\u8bb0\u5fc6/attention\u3002\u65e7REUSE\u4ec5\u6309FULL\u517c\u5bb9\uff0c\u4e0d\u8bfb\u53d6previousCoverageRef\u3002\n\n\u5bbf\u4e3b\u7f16\u7801/\u8f93\u51fa\u9700\u8981\u65f6\uff0c\u540c\u6b21DISCOVER\u7528DisplayPath\u4fdd\u7559\u5b98\u65b9UTF-8 text\uff1bAsJson\u673a\u5668\u8f7d\u4f53\u7531\u7a0b\u5e8f\u6355\u83b7\uff0c\u7ecf\u539f\u5b98\u65b9renderer\u53d6text\uff