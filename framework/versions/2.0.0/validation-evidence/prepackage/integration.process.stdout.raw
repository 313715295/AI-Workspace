u3001\u64cd\u4f5c\u3001\u6267\u884c/\u59d4\u6d3e\u4e3b\u4f53\u3001\u8d26\u53f7/\u6570\u636e\u3001\u8d39\u7528\u53ca\u6062\u590d\u6761\u4ef6\uff0c\u4e14\u6ca1\u6709\u64a4\u56de\u3001\u51b2\u7a81\u6216\u672a\u77e5\u65f6\uff0c\u7531\u5b9e\u9645\u6267\u884c\u8005\u76f4\u63a5\u8c03\u7528\u539f\u5de5\u5177\u3002\u8c03\u7528\u672c\u8eab\u4e0d\u8981\u6c42\u9010\u6b21\u4efb\u52a1\u5361\u3001EXTERNAL\u5305\u3001DISCOVER/ADMIT/FINALIZE\uff1b\u539f\u5de5\u5177\u8fd4\u56de\u4e0e\u5bbf\u4e3b\u89c2\u5bdf\u4fdd\u7559\u771f\u5b9e\u6210\u529f\u3001\u5931\u8d25\u6216UNKNOWN\uff0c\u968f\u5f53\u524d\u6210\u679c\u81ea\u7136\u4ea4\u4ed8\u3002\u5b83\u4e0d\u514d\u9664\u9996\u6b21/\u6d3b\u52a8\u53d8\u5316/\u6062\u590d\u65f6\u7684\u5b8c\u6574\u89c4\u5219\u8bfb\u53d6\uff0c\u4e5f\u4e0d\u4ea7\u751f\u53ef\u4f9b\u5176\u4ed6\u52a8\u4f5c\u7eed\u6743\u7684\u6210\u529f\u6536\u636e\u3002\u5f53\u524d\u9879\u76ee\u8bbe\u7f6e\u548c\u5b8c\u6574\u8bb8\u53ef\u7684\u8bfb\u53d6\u63a5\u53e3\u53d6TOOL_CONTRACT\uff0c\u8bed\u4e49\u8986\u76d6\u4ecd\u4e3aINSTRUCTION_BOUND\u3002\n\n\u76f4\u63a5\u6a21\u5f0f\u4e0d\u6388\u4e88Git\u3001\u8bbe\u5907\u3001\u6d4f\u89c8\u5668\u6216\u6e90\u7801/\u63a7\u5236\u9762\u5199\u5165\uff0c\u4e0d\u7ed5\u8fc7\u5bbf\u4e3b\u6743\u9650\u548c\u7528\u6237\u4eb2\u81ea\u4fdd\u7559\u4e8b\u9879\u3002\u672a\u8bbe\u91d1\u989d\u6216\u6b21\u6570\u4e0d\u586bFREE/0\u3001\u4e0d\u81ea\u52a8\u7d22\u53d6\u9010\u6b21\u6279\u51c6\uff1b\u64a4\u56de\u3001\u8d8a\u754c\u6216\u5fc5\u8981\u4e8b\u5b9e\u672a\u77e5\u505c\u6b62\u672c\u6b21\u8c03\u7528\u3002\u516c\u5f00\u53d1\u5e03\u3001\u79d8\u5bc6\u4e0a\u4f20\u3001\u8d26\u6237/\u51ed\u636e\u53d8\u66f4\u7b49\u72ec\u7acb\u8fb9\u754c\u6309\u5f53\u524d\u5b9e\u9645\u6743\u9650\u5904\u7406\uff0c\u4e0d\u80fd\u4ece\u4e00\u822c\u8bb8\u53ef\u6216hash\u63a8\u65ad\u83b7\u51c6\u3002\u660e\u786e\u4f7f\u7528\u6309\u6b21\u5305\u65f6\u4ecd\u8d70\u539fchecker\u53ca\u8fc7\u7a0b\u95e8\uff0c\u76f4\u63a5\u6a21\u5f0f\u4e0d\u80fd\u628a\u7f3a\u5305\u6216\u574f\u5305\u53d8\u6210\u6309\u6b21\u51c6\u5165PASS\u3002\n\n\u7528\u6237\u660e\u786e\u91c7\u7528Framework\u5f00\u5c55\u9879\u76ee\u5de5\u4f5c\u65f6\uff0c\u6cbf\u5df2\u6279\u51c6\u63a5\u5165\u6a21\u677f\u5efa\u7acb\u9879\u76ee\u5de5\u4f5c\u51b3\u5b9a\u7ea6\u5b9a\uff0c\u65e0\u987b\u9010\u6b65\u9aa4\u518d\u6b21\u786e\u8ba4\u540c\u4e00\u5df2\u6279\u51c6\u5de5\u4f5c\uff1b\u4ec5\u67e5\u770b\u6587\u4ef6\u6216\u672a\u91c7\u7eb3\u5efa\u8bae\u4e0d\u6784\u6210\u91c7\u7528\u3002\u7ea6\u5b9a\u6765\u6e90\u662f\u4eba\u7c7b\u660e\u786e\u91c7\u7528/\u786e\u8ba4\u7684\u9879\u76ee\u6b63\u6587\u6216\u76f4\u63a5\u51b3\u5b9a\uff1aAI\u6839\u636e\u5f53\u524d\u91c7\u7528Framework\u3001\u6709\u6548\u7ea0\u6b63\u53ca\u6c38\u4e45\u89c4\u5219\u4f5c\u51fa\u7684\u5177\u4f53\u51b3\u5b9a\uff0c\u5728\u8be5\u7ea6\u5b9a\u8303\u56f4\u5185\u6267\u884c\u3002\u5f53\u524d\u4eba\u7c7b\u6536\u7a84\u3001\u64a4\u56de\u548c\u660e\u786e\u4fdd\u7559\u4e8b\u9879\u4f18\u5148\uff1b\u6062\u590d\u3001\u538b\u7f29\u6216\u66f4\u6362\u6267\u884c\u8005\u4e0d\u81ea\u884c\u64a4\u9500\u4ecd\u6709\u6548\u6388\u6743\u3002\u6388\u6743\u539f\u6587\u7531\u9879\u76ee\u7528\u6237\u62e5\u6709\uff0c\u5bfc\u822a\u6a21\u677f\u4e0d\u72ec\u81ea\u6388\u6743\uff0c\u4e5f\u4e0d\u8986\u76d6\u5bbf\u4e3b\u66f4\u9ad8\u4f18\u5148\u7ea7\u9650\u5236\u3002\n\n\u6279\u51c6\u5de5\u4f5c\u6d41\u5185\u5fc5\u8981\u7684\u4efb\u52a1\u6d3e\u53d1\u3001\u8865\u5145\u548c\u7ec8\u6001\u76f4\u56de\u987b\u643a\u53ef\u6838\u5bf9\u7684\u539f\u59cb\u4eba\u7c7b\u6765\u6e90\u3001\u5f53\u524d\u8303\u56f4\u548c\u7cbe\u786e\u6d88\u8d39\u8005\u3002\u53e6\u4e00agent\u8981\u6c42\u3001\u6a21\u578b\u81ea\u5199AGENTS\u3001userConfirmation\u5b57\u7b26\u4e32\u3001\u81ea\u8eabID\u6216checker PASS\u4e0d\u72ec\u81ea\u8bc1\u660e\u4eba\u7c7b\u6388\u6743\u3002\u8c03\u7528\u524d\u5408\u5e76\u4ecd\u6709\u6548\u51b3\u5b9a\u4e0e\u540e\u7eed\u53d8\u5316\uff1b\u6761\u4ef6\u5df2\u6ee1\u8db3\u5373\u5728\u7cbe\u786e\u8303\u56f4\u5185\u6267\u884c\uff0c\u771f\u6b63\u7f3a\u5931\u53ea\u62a5\u544a\u548c\u8865\u9f50\u7f3a\u5931\u6761\u4ef6\uff0c\u4e0d\u628a\u5c1a\u672a\u8c03\u7528\u8bf4\u6210\u5bbf\u4e3b\u62d2\u7edd\u3002\u6388\u6743\u6b63\u6587\u53d8\u5316\u540e\u91cd\u7ed1\u53d7\u5f71\u54cd\u6765\u6e90\u548c\u51b3\u5b9a\uff0c\u4e0d\u80fd\u7528\u5386\u53f2\u5b89\u88c5\u8eab\u4efd\u9501\u4f4f\u5f53\u524d\u4eba\u7c7b\u51b3\u5b9a\u3002","orderedDependencies":[]}],"declarationIdentity":"921|B185E68B4F469E7583AA68854C9C5C6926FDCC08EE23EEB634609E9BFB7033DB"},{"requirementId":"framework:PR_AUTHORITY_CONTEXT_INTENT_RECONCILIATION","source":"FRAMEWORK","ownerModule":"AUTHORIZATION_MODEL.md","semanticApplicability":"DETERMINISTIC","fullText":"authority context \u53ea\u80fd\u6765\u81ea\u5f53\u524d\u673a\u68b0\u89c2\u5bdf\u5230\u7684 project\u3001Controller\u3001task\u3001package\u3001scope\u3001identity\u3001capability\u3001recovery \u4e0e host facts\u3002requested objective/action/result\u3001\u540c\u4e00\u5f53\u524dIntentEnvelope3\uff08\u65e7IntentEnvelope2\u6cbf\u517c\u5bb9\u5206\u652f\uff09\u7684facets \u548c semantic hints \u8868\u8fbe\u5f53\u524d\u610f\u56fe\uff0c\u4e0d\u751f\u6210\u6388\u6743\u3002authority facts \u59cb\u7ec8\u4f18\u5148\uff1bUNKNOWN\u3001\u672a\u6388\u6743 action \u6216 hint/fact mismatch \u4f1a\u963b\u6b62\u53d7\u6cbb\u7406 action\uff0c\u6216\u5728\u5176\u4f59\u5df2\u77e5\u8fb9\u754c\u5185\u4fdd\u5b88\u9009\u62e9\u53d7\u5f71\u54cd\u7684\u5b8c\u6574\u89c4\u5219\u5757\u3002\u672a\u6765\u52a8\u4f5c\u3001\u5426\u5b9a\u548c\u793a\u4f8b\u4e2d\u7684\u6267\u884c\u8bcd\u4e0d\u6539\u53d8\u6b64\u523b\u7684\u52a8\u4f5c\u4e8b\u5b9e\u3002","preparationRequirements":["AUTHORITY_CONTEXT_BOUND","INTENT_ENVELOPE_BOUND"],"resultRequirements":["INTENT_AUTHORITY_RECONCILED"],"selectorIdentity":"225|00AFDA43FF5054E997C982EA1FA60FD16FB9840B89561F1EF6C88ED8980BAF33","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","sourceIdentity":"9397|7579ED2278FA273F2C6A1B0F07329C7B2F09123343577F5B2D70BF562B8891C0","fullText":"authority context \u53ea\u80fd\u6765\u81ea\u5f53\u524d\u673a\u68b0\u89c2\u5bdf\u5230\u7684 project\u3001Controller\u3001task\u3001package\u3001scope\u3001identity\u3001capability\u3001recovery \u4e0e host facts\u3002requested objective/action/result\u3001\u540c\u4e00\u5f53\u524dIntentEnvelope3\uff08\u65e7IntentEnvelope2\u6cbf\u517c\u5bb9\u5206\u652f\uff09\u7684facets \u548c semantic hints \u8868\u8fbe\u5f53\u524d\u610f\u56fe\uff0c\u4e0d\u751f\u6210\u6388\u6743\u3002authority facts \u59cb\u7ec8\u4f18\u5148\uff1bUNKNOWN\u3001\u672a\u6388\u6743 action \u6216 hint/fact mismatch \u4f1a\u963b\u6b62\u53d7\u6cbb\u7406 action\uff0c\u6216\u5728\u5176\u4f59\u5df2\u77e5\u8fb9\u754c\u5185\u4fdd\u5b88\u9009\u62e9\u53d7\u5f71\u54cd\u7684\u5b8c\u6574\u89c4\u5219\u5757\u3002\u672a\u6765\u52a8\u4f5c\u3001\u5426\u5b9a\u548c\u793a\u4f8b\u4e2d\u7684\u6267\u884c\u8bcd\u4e0d\u6539\u53d8\u6b64\u523b\u7684\u52a8\u4f5c\u4e8b\u5b9e\u3002","orderedDependencies":[]}],"declarationIdentity":"731|7F887EBECBF5B4D216930AF6D39457D076B206DD6BECFDC7CFBD969EA2BA984A"},{"requirementId":"framework:PR_BOUNDED_TASK_ACTIONS","source":"FRAMEWORK","ownerModule":"AUTHORIZATION_MODEL.md","semanticApplicability":"DETERMINISTIC","fullText":"\u5305\u7ed1\u5b9a\u5f53\u524dTASK\u6216\u539fPROJECT_WORK\u8bf7\u6c42\u3001\u8d23\u4efb\u4e3b\u4f53\u3001\u52a8\u4f5c\u3001\u7cbe\u786e\u8def\u5f84/\u5bf9\u8c61\u3001\u51b3\u5b9a\u3001\u914d\u7f6e\u53ca\u9002\u7528\u4ed3\u5e93/\u6267\u884c\u76ee\u6807\uff1b\u5b9e\u9645\u6f02\u79fb\u3001\u672a\u77e5\u5fc5\u8981\u4e8b\u5b9e\u6216\u4e0d\u5408\u683c\u5f0f\u5747\u62d2\u7edd\u53d7\u5f71\u54cd\u52a8\u4f5c\u3002\u666e\u901a\u53ef\u9009\u6267\u884c\u76ee\u6807\u4e0d\u6539\u53d8\u552f\u4e00\u63a7\u5236\u6839\u548c\u539f\u4efb\u52a1\u6743\u5a01\uff1bMaintenance\u7684CONTROL/TARGET\u7ee7\u7eed\u5206\u5305\u3001\u5206\u4ed3\u9a8c\u8bc1\u3002\u7cbe\u786e\u5b57\u6bb5\u53ca\u5f53\u524d\u683c\u5f0f\u53d6TOOL_CONTRACT\u548c\u5bf9\u5e94schema\u3002\n\n\u53ef\u9884\u6388\u4e88\u540c\u4e00\u6709\u754c\u6210\u679c\u7684\u672c\u5730\u5199\u6d4b\u3001\u6709\u9650\u81ea\u68c0\u8fd4\u5de5\u53ca\u6700\u540e\u4e00\u6b21REVIEW_ROUTE\u3002\u53ea\u6709\u771f\u5b9e\u539fFINALIZE\u540e\u50cf\u548c\u5f53\u524d\u51c6\u5165\u53ef\u627f\u63a5\u4e0b\u4e00\u6b65\uff0c\u672a\u786e\u5b9a\u7ed3\u679c\u3001\u65e0\u8bb8\u53ef\u3001\u8017\u5c3d\u6216\u505c\u6b62\u4e0d\u751f\u6210\u7eed\u6743\u3002\u5ba1\u6838\u8986\u76d6A\u53ef\u5305\u542b\u6709\u9650\u751f\u4ea7\u96c6M\uff0c\u4f46\u4e0d\u6269\u5927M\u5199\u6743\uff1b\u6210\u529f\u81ea\u67e5\u4e0e\u5b8c\u6574\u5019\u9009\u51c6\u5907\u5206\u522b\u53d6\u8bc1\u3002\u9996\u6b21\u4ea4\u5ba1/\u4fee\u590d\u590d\u5ba1\u7684\u7ec4\u7ec7\u804c\u8d23\u53d6REVIEW_AND_EVIDENCE\uff0c\u8fde\u7eed\u5305\u3001receipt\u3001repairReviewPlan\u53caM/A\u5b57\u6bb5\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\u72ec\u7acbReview\u3001\u63a5\u53d7\u3001Git\u3001\u8bbe\u5907\u3001\u5916\u90e8\u3001\u53d1\u884c\u548c\u91c7\u7528\u4e0d\u7531\u8fde\u7eed\u5199\u6d4b\u81ea\u52a8\u53d6\u5f97\u3002\n\n\u4efb\u52a1/Controller\u771f\u5b9e\u8eab\u4efd\u8f6c\u6362\u53ca\u9879\u76ee\u5347\u7ea7\u6cbfTOOL_CONTRACT\u548c\u6839PROJECT_ADOPTION\u7684\u539f\u8d23\u4efb/\u91c7\u7528\u4e8b\u52a1\uff1b\u666e\u901a\u6765\u6e90\u91c7\u7528\u3001\u65e0effect\u7ea0\u6b63\u53ca\u540c\u9879\u76ee\u4e13\u4e1a\u6b63\u6587\u53cc\u52a8\u4f5c\u66f4\u65b0\u6309\u5404\u81ea\u5b9e\u9645\u5199\u96c6\u548c\u6709\u5e8f\u6279\u6b21\uff0c\u4e0d\u6cdb\u5316\u5f3a\u5236\u4e8b\u52a1\uff0c\u4e0d\u4ee5fresh\u51c6\u5165\u8ffd\u8ba4\u65e7\u5199\u5165\u3002\u4e13\u4e1a\u6b63\u6587SOURCE/CONTROL\u4e24\u7c7b\u5f53\u524d\u6743\u9650\u548c\u5404\u81ea\u539f/\u65b0\u4e49\u52a1\u4e92\u4e0d\u66ff\u4ee3\uff1b\u53ef\u6cbf\u53d7\u9650\u8054\u5408\u5165\u53e3\u4e00\u6b21\u63d0\u4ea4\u4e24\u4efd\u539f\u51c6\u5165\u8f93\u5165\uff0c\u5171\u4eab\u540c\u6b21\u5b8c\u6574\u76ee\u6807\u6784\u9020\uff0c\u5404\u81ea\u4ecd\u4ea7\u751f\u771f\u5b9e\u51b3\u5b9a\u3002\u5b8c\u6574\u51c6\u5165\u540e\u6cbf\u539f\u5019\u9009\u6709\u5e8f\u6267\u884c\uff0c\u53ea\u6709\u4e24\u6210\u5458\u771f\u5b9e\u6536\u53e3\u90fd\u6210\u529f\u624d\u79f0\u6574\u6279\u5b8c\u6210\uff1bMaintenance CONTROL\u4e13\u4e1a\u6b63\u6587\u4f8b\u5916\u4ecd\u987b\u5f53\u524dController\u7cbe\u786e\u6388\u6743\u3001\u539f\u51b3\u5b9a\u53ca\u5b8c\u6574\u4fdd\u62a4\uff0c\u666e\u901aSOURCE/TEST_WRITE/BROWSER_RUN/DEVICE_RUN\u7981\u4ee4\u4fdd\u6301\u3002\u672a\u77e5\u7b2c\u4e09\u65b9\u5b57\u8282\u505c\u6b62\u53d7\u5f71\u54cd\u6062\u590d\u3002\n\n\u81ea\u68c0\u5931\u8d25\u6536\u53e3\u4e0d\u7b49\u4e8e\u6d4b\u8bd5\u6210\u529f\uff0c\u4e0d\u5236\u9020\u72ec\u7acbReview finding\uff1b\u5386\u53f2\u5931\u8d25\u4e0e\u672a\u5b8c\u6210\u6210\u679c\u8d23\u4efb\u4fdd\u7559\u3002\u4e34\u65f6\u8fc7\u7a0b\u6750\u6599\u662fINSTRUCTION_BOUND\u5173\u8054\u8bc1\u636e\uff0c\u4e0d\u662f\u7b7e\u540d\u3001\u5bbf\u4e3b\u5f3a\u5236\u6216\u6d88\u8d39\u53f0\u8d26\uff0c\u6309TOOL_CONTRACT\u4fdd\u7559\u81f3\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u3002\n\u666e\u901arepo-local schema1\u53caMaintenance CONTROL/TARGET schema2\u7684\u539f\u5b8c\u6574checker\u5df2\u5728ADMIT\u6309\u540c\u4e00\u56fa\u5b9a\u6765\u6e90/\u9002\u914d\u5668\u3001\u5b8c\u6574\u52a8\u4f5c/\u5bf9\u8c61/\u7eed\u94fe\u53c2\u6570\u548c\u5f53\u524d\u89c2\u5bdf\u6267\u884c\u65f6\uff0c\u7531\u8be5\u5b9e\u9645\u8c03\u7528\u6ee1\u8db3\u6388\u6743\u68c0\u67e5\uff1b\u8c03\u7528\u8005\u7701\u7565\u989d\u5916\u76f8\u540cchecker\u547d\u4ee4\u3002checker\u516c\u5171\u5165\u53e3\u4fdd\u7559\uff1bDISCOVER\u3001ADMIT\u4e0e\u6536\u53e3\u5404\u81ea\u771f\u5b9e\u89c2\u5bdf\u4e0d\u5408\u5e76\u6210\u5168\u5c40\u4e00\u6b21\u6216\u7f13\u5b58\u3002schema4\u53ca\u672a\u8bc1\u660e\u7b49\u4ef7\u7684\u4e13\u95e8\u8def\u5f84\u4ecd\u5206\u522b\u8c03\u7528\uff1b\u9519\u4e3b\u4f53\u3001\u8d8a\u754c\u3001\u524d\u50cf\u6f02\u79fb\u3001\u64a4\u56de\u548c\u574f\u7eed\u94fe\u7167\u539f\u62d2\u7edd\u3002\n\n\u6309\u540c\u4e00\u7a33\u5b9a\u6210\u679csubject\u5c65\u884c\u5f53\u524d\u5361/\u8d28\u91cf\u9009\u62e9\u53ca\u4ecd\u6709\u6548\u7684\u7528\u6237\u3001\u4e13\u4e1a\u548c\u4e13\u95e8\u95e8\uff1b\u7f3a\u7701LEGACY\u53caQA1\u65e7\u5206\u652f\u4fdd\u6301\uff0cQA2\u51bb\u7ed3\u53d1\u8d77workType\u3002\u8d28\u91cf\u9009\u62e9\u4e0d\u6388\u52a8\u4f5c\u3001\u8de8\u4ed3\u6216\u4e13\u95e8\u63a5\u53d7\u6743\uff0c\u7701\u5361\u4e0d\u53d6\u6d88\u6210\u679c\u8d23\u4efb\uff1b\u5c65\u884c\u5b9e\u9645\u9636\u6bb5\uff0c\u771f\u96f6\u4e0d\u9020\u8bc1\u636e\uff0c\u5df2\u53d1\u751f\u5931\u8d25\u5982\u5b9e\u4fdd\u7559\u3002\u9009\u62e9\u4e0e\u683c\u5f0f\u552f\u4e00\u53d6TOOL_CONTRACT\u3002","preparationRequirements":[],"resultRequirements":[],"selectorIdentity":"362|B1B89B93AB46D1C326521AF866439C9F93776780CD81418D93921841FC632FDB","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","sourceIdentity":"9397|7579ED2278FA273F2C6A1B0F07329C7B2F09123343577F5B2D70BF562B8891C0","fullText":"\u5305\u7ed1\u5b9a\u5f53\u524dTASK\u6216\u539fPROJECT_WORK\u8bf7\u6c42\u3001\u8d23\u4efb\u4e3b\u4f53\u3001\u52a8\u4f5c\u3001\u7cbe\u786e\u8def\u5f84/\u5bf9\u8c61\u3001\u51b3\u5b9a\u3001\u914d\u7f6e\u53ca\u9002\u7528\u4ed3\u5e93/\u6267\u884c\u76ee\u6807\uff1b\u5b9e\u9645\u6f02\u79fb\u3001\u672a\u77e5\u5fc5\u8981\u4e8b\u5b9e\u6216\u4e0d\u5408\u683c\u5f0f\u5747\u62d2\u7edd\u53d7\u5f71\u54cd\u52a8\u4f5c\u3002\u666e\u901a\u53ef\u9009\u6267\u884c\u76ee\u6807\u4e0d\u6539\u53d8\u552f\u4e00\u63a7\u5236\u6839\u548c\u539f\u4efb\u52a1\u6743\u5a01\uff1bMaintenance\u7684CONTROL/TARGET\u7ee7\u7eed\u5206\u5305\u3001\u5206\u4ed3\u9a8c\u8bc1\u3002\u7cbe\u786e\u5b57\u6bb5\u53ca\u5f53\u524d\u683c\u5f0f\u53d6TOOL_CONTRACT\u548c\u5bf9\u5e94schema\u3002\n\n\u53ef\u9884\u6388\u4e88\u540c\u4e00\u6709\u754c\u6210\u679c\u7684\u672c\u5730\u5199\u6d4b\u3001\u6709\u9650\u81ea\u68c0\u8fd4\u5de5\u53ca\u6700\u540e\u4e00\u6b21REVIEW_ROUTE\u3002\u53ea\u6709\u771f\u5b9e\u539fFINALIZE\u540e\u50cf\u548c\u5f53\u524d\u51c6\u5165\u53ef\u627f\u63a5\u4e0b\u4e00\u6b65\uff0c\u672a\u786e\u5b9a\u7ed3\u679c\u3001\u65e0\u8bb8\u53ef\u3001\u8017\u5c3d\u6216\u505c\u6b62\u4e0d\u751f\u6210\u7eed\u6743\u3002\u5ba1\u6838\u8986\u76d6A\u53ef\u5305\u542b\u6709\u9650\u751f\u4ea7\u96c6M\uff0c\u4f46\u4e0d\u6269\u5927M\u5199\u6743\uff1b\u6210\u529f\u81ea\u67e5\u4e0e\u5b8c\u6574\u5019\u9009\u51c6\u5907\u5206\u522b\u53d6\u8bc1\u3002\u9996\u6b21\u4ea4\u5ba1/\u4fee\u590d\u590d\u5ba1\u7684\u7ec4\u7ec7\u804c\u8d23\u53d6REVIEW_AND_EVIDENCE\uff0c\u8fde\u7eed\u5305\u3001receipt\u3001repairReviewPlan\u53caM/A\u5b57\u6bb5\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\u72ec\u7acbReview\u3001\u63a5\u53d7\u3001Git\u3001\u8bbe\u5907\u3001\u5916\u90e8\u3001\u53d1\u884c\u548c\u91c7\u7528\u4e0d\u7531\u8fde\u7eed\u5199\u6d4b\u81ea\u52a8\u53d6\u5f97\u3002\n\n\u4efb\u52a1/Controller\u771f\u5b9e\u8eab\u4efd\u8f6c\u6362\u53ca\u9879\u76ee\u5347\u7ea7\u6cbfTOOL_CONTRACT\u548c\u6839PROJECT_ADOPTION\u7684\u539f\u8d23\u4efb/\u91c7\u7528\u4e8b\u52a1\uff1b\u666e\u901a\u6765\u6e90\u91c7\u7528\u3001\u65e0effect\u7ea0\u6b63\u53ca\u540c\u9879\u76ee\u4e13\u4e1a\u6b63\u6587\u53cc\u52a8\u4f5c\u66f4\u65b0\u6309\u5404\u81ea\u5b9e\u9645\u5199\u96c6\u548c\u6709\u5e8f\u6279\u6b21\uff0c\u4e0d\u6cdb\u5316\u5f3a\u5236\u4e8b\u52a1\uff0c\u4e0d\u4ee5fresh\u51c6\u5165\u8ffd\u8ba4\u65e7\u5199\u5165\u3002\u4e13\u4e1a\u6b63\u6587SOURCE/CONTROL\u4e24\u7c7b\u5f53\u524d\u6743\u9650\u548c\u5404\u81ea\u539f/\u65b0\u4e49\u52a1\u4e92\u4e0d\u66ff\u4ee3\uff1b\u53ef\u6cbf\u53d7\u9650\u8054\u5408\u5165\u53e3\u4e00\u6b21\u63d0\u4ea4\u4e24\u4efd\u539f\u51c6\u5165\u8f93\u5165\uff0c\u5171\u4eab\u540c\u6b21\u5b8c\u6574\u76ee\u6807\u6784\u9020\uff0c\u5404\u81ea\u4ecd\u4ea7\u751f\u771f\u5b9e\u51b3\u5b9a\u3002\u5b8c\u6574\u51c6\u5165\u540e\u6cbf\u539f\u5019\u9009\u6709\u5e8f\u6267\u884c\uff0c\u53ea\u6709\u4e24\u6210\u5458\u771f\u5b9e\u6536\u53e3\u90fd\u6210\u529f\u624d\u79f0\u6574\u6279\u5b8c\u6210\uff1bMaintenance CONTROL\u4e13\u4e1a\u6b63\u6587\u4f8b\u5916\u4ecd\u987b\u5f53\u524dController\u7cbe\u786e\u6388\u6743\u3001\u539f\u51b3\u5b9a\u53ca\u5b8c\u6574\u4fdd\u62a4\uff0c\u666e\u901aSOURCE/TEST_WRITE/BROWSER_RUN/DEVICE_RUN\u7981\u4ee4\u4fdd\u6301\u3002\u672a\u77e5\u7b2c\u4e09\u65b9\u5b57\u8282\u505c\u6b62\u53d7\u5f71\u54cd\u6062\u590d\u3002\n\n\u81ea\u68c0\u5931\u8d25\u6536\u53e3\u4e0d\u7b49\u4e8e\u6d4b\u8bd5\u6210\u529f\uff0c\u4e0d\u5236\u9020\u72ec\u7acbReview finding\uff1b\u5386\u53f2\u5931\u8d25\u4e0e\u672a\u5b8c\u6210\u6210\u679c\u8d23\u4efb\u4fdd\u7559\u3002\u4e34\u65f6\u8fc7\u7a0b\u6750\u6599\u662fINSTRUCTION_BOUND\u5173\u8054\u8bc1\u636e\uff0c\u4e0d\u662f\u7b7e\u540d\u3001\u5bbf\u4e3b\u5f3a\u5236\u6216\u6d88\u8d39\u53f0\u8d26\uff0c\u6309TOOL_CONTRACT\u4fdd\u7559\u81f3\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u3002\n\u666e\u901arepo-local schema1\u53caMaintenance CONTROL/TARGET schema2\u7684\u539f\u5b8c\u6574checker\u5df2\u5728ADMIT\u6309\u540c\u4e00\u56fa\u5b9a\u6765\u6e90/\u9002\u914d\u5668\u3001\u5b8c\u6574\u52a8\u4f5c/\u5bf9\u8c61/\u7eed\u94fe\u53c2\u6570\u548c\u5f53\u524d\u89c2\u5bdf\u6267\u884c\u65f6\uff0c\u7531\u8be5\u5b9e\u9645\u8c03\u7528\u6ee1\u8db3\u6388\u6743\u68c0\u67e5\uff1b\u8c03\u7528\u8005\u7701\u7565\u989d\u5916\u76f8\u540cchecker\u547d\u4ee4\u3002checker\u516c\u5171\u5165\u53e3\u4fdd\u7559\uff1bDISCOVER\u3001ADMIT\u4e0e\u6536\u53e3\u5404\u81ea\u771f\u5b9e\u89c2\u5bdf\u4e0d\u5408\u5e76\u6210\u5168\u5c40\u4e00\u6b21\u6216\u7f13\u5b58\u3002schema4\u53ca\u672a\u8bc1\u660e\u7b49\u4ef7\u7684\u4e13\u95e8\u8def\u5f84\u4ecd\u5206\u522b\u8c03\u7528\uff1b\u9519\u4e3b\u4f53\u3001\u8d8a\u754c\u3001\u524d\u50cf\u6f02\u79fb\u3001\u64a4\u56de\u548c\u574f\u7eed\u94fe\u7167\u539f\u62d2\u7edd\u3002\n\n\u6309\u540c\u4e00\u7a33\u5b9a\u6210\u679csubject\u5c65\u884c\u5f53\u524d\u5361/\u8d28\u91cf\u9009\u62e9\u53ca\u4ecd\u6709\u6548\u7684\u7528\u6237\u3001\u4e13\u4e1a\u548c\u4e13\u95e8\u95e8\uff1b\u7f3a\u7701LEGACY\u53caQA1\u65e7\u5206\u652f\u4fdd\u6301\uff0cQA2\u51bb\u7ed3\u53d1\u8d77workType\u3002\u8d28\u91cf\u9009\u62e9\u4e0d\u6388\u52a8\u4f5c\u3001\u8de8\u4ed3\u6216\u4e13\u95e8\u63a5\u53d7\u6743\uff0c\u7701\u5361\u4e0d\u53d6\u6d88\u6210\u679c\u8d23\u4efb\uff1b\u5c65\u884c\u5b9e\u9645\u9636\u6bb5\uff0c\u771f\u96f6\u4e0d\u9020\u8bc1\u636e\uff0c\u5df2\u53d1\u751f\u5931\u8d25\u5982\u5b9e\u4fdd\u7559\u3002\u9009\u62e9\u4e0e\u683c\u5f0f\u552f\u4e00\u53d6TOOL_CONTRACT\u3002","orderedDependencies":[]}],"declarationIdentity":"784|C1A265778D39A270BF59E03DA1EE0E8527711E8A1E9A4223D27525BB0CA119B9"},{"requirementId":"framework:PR_CODEX_ROUTER_REACTIVATION","source":"FRAMEWORK","ownerModule":"HOST_CODEX.md","semanticApplicability":"DETERMINISTIC","fullText":"\u672c\u76ee\u6807\u4f7f\u7528navigationContractVersion=3\u7684PROJECT_BOOTSTRAP\u5165\u53e3\u3002\u9879\u76eeAGENTS\u53ea\u5bfc\u822a\u660e\u786e\u9879\u76ee\u7684.ai-workspace/BOOTSTRAP.md\uff1bBootstrap\u6309\u9879\u76eepin\u53ca\u539f\u91c7\u7528\u8bb0\u5f55\u7ed1\u5b9a\u56fa\u5b9a\u6765\u6e90\u548cTOOLCHAIN\uff0c\u4e0d\u8981\u6c42\u65b0Skill\u3001\u5b89\u88c5\u53d1\u73b0\u6216\u517c\u5bb9\u8f6c\u53d1\u3002\u5bbf\u4e3bAGENTS\u53ef\u89c1\u3001\u6587\u4ef6\u53ef\u8bfb\u548c\u5b9e\u9645\u6b63\u6587\u5df2\u8bfb\u5206\u522b\u6838\u5bf9\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u6216\u6362\u4e3b\u4f53\u6309RECOVERY\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\uff1b\u5065\u5eb7\u4e0a\u4e0b\u6587\u6309RECOVERY\u590d\u7528\uff0c\u540c\u6d3b\u52a8\u666e\u901a\u8303\u56f4\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u9a8c\u5f53\u524d\u51c6\u5165\u4e0e\u9002\u7528\u8981\u6c42\uff0c\u4e0d\u4e3a\u6bcf\u6b21action/final\u91cd\u8f7d\u3002\u65e0\u5173\u4f1a\u8bdd\u4e0d\u542f\u52a8\u9879\u76ee\u6062\u590d\u3002\n\n\u65e7nav1/nav2\u9879\u76ee\u53ca\u5728\u9014\u91c7\u7528\u7ee7\u7eed\u4f7f\u7528\u5404\u81ea\u539f\u56fa\u5b9a\u5165\u53e3\uff0c\u539fFINALIZE\u5b8c\u6210\u540e\u624d\u8bfb\u65b0AGENTS/Bootstrap\uff1b\u90e8\u5206\u6587\u4ef6\u53d8\u5316\u4e0d\u4ee3\u8868\u5207\u6362\u5b8c\u6210\u3002\u65e7Skill\u4ec5\u5728\u771f\u5b9e\u4f9d\u8d56\u7ed3\u675f\u4e14\u6709\u5bbf\u4e3b\u6743\u9650\u65f6\u9000\u5f79\uff0c\u4e0d\u5efa\u6d88\u8d39\u8005\u767b\u8bb0\u6216\u6bcf\u9879\u76ee\u526f\u672c\u3002\u8f93\u5165/\u8bc1\u636e\u4ecd\u53d6\u5f53\u524dTOOL_CONTRACT\uff0c\u5bfc\u822a\u672c\u8eab\u4e0d\u6388\u6743\u3002","preparationRequirements":["PROJECT_ENTRY_CONTEXT_BOUND"],"resultRequirements":["PROJECT_ENTRY_FINAL_READBACK"],"selectorIdentity":"471|2577D7A2AC74DDF06C5538EB79EA806DBB5433C7B8A690636D0BDE0F03CD98A7","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","sourceIdentity":"7845|DEDF5E5A1B3196F187F9E5560C102390DB44B79CF3F01810FA986977AF547978","fullText":"\u672c\u76ee\u6807\u4f7f\u7528navigationContractVersion=3\u7684PROJECT_BOOTSTRAP\u5165\u53e3\u3002\u9879\u76eeAGENTS\u53ea\u5bfc\u822a\u660e\u786e\u9879\u76ee\u7684.ai-workspace/BOOTSTRAP.md\uff1bBootstrap\u6309\u9879\u76eepin\u53ca\u539f\u91c7\u7528\u8bb0\u5f55\u7ed1\u5b9a\u56fa\u5b9a\u6765\u6e90\u548cTOOLCHAIN\uff0c\u4e0d\u8981\u6c42\u65b0Skill\u3001\u5b89\u88c5\u53d1\u73b0\u6216\u517c\u5bb9\u8f6c\u53d1\u3002\u5bbf\u4e3bAGENTS\u53ef\u89c1\u3001\u6587\u4ef6\u53ef\u8bfb\u548c\u5b9e\u9645\u6b63\u6587\u5df2\u8bfb\u5206\u522b\u6838\u5bf9\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u6216\u6362\u4e3b\u4f53\u6309RECOVERY\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\uff1b\u5065\u5eb7\u4e0a\u4e0b\u6587\u6309RECOVERY\u590d\u7528\uff0c\u540c\u6d3b\u52a8\u666e\u901a\u8303\u56f4\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u9a8c\u5f53\u524d\u51c6\u5165\u4e0e\u9002\u7528\u8981\u6c42\uff0c\u4e0d\u4e3a\u6bcf\u6b21action/final\u91cd\u8f7d\u3002\u65e0\u5173\u4f1a\u8bdd\u4e0d\u542f\u52a8\u9879\u76ee\u6062\u590d\u3002\n\n\u65e7nav1/nav2\u9879\u76ee\u53ca\u5728\u9014\u91c7\u7528\u7ee7\u7eed\u4f7f\u7528\u5404\u81ea\u539f\u56fa\u5b9a\u5165\u53e3\uff0c\u539fFINALIZE\u5b8c\u6210\u540e\u624d\u8bfb\u65b0AGENTS/Bootstrap\uff1b\u90e8\u5206\u6587\u4ef6\u53d8\u5316\u4e0d\u4ee3\u8868\u5207\u6362\u5b8c\u6210\u3002\u65e7Skill\u4ec5\u5728\u771f\u5b9e\u4f9d\u8d56\u7ed3\u675f\u4e14\u6709\u5bbf\u4e3b\u6743\u9650\u65f6\u9000\u5f79\uff0c\u4e0d\u5efa\u6d88\u8d39\u8005\u767b\u8bb0\u6216\u6bcf\u9879\u76ee\u526f\u672c\u3002\u8f93\u5165/\u8bc1\u636e\u4ecd\u53d6\u5f53\u524dTOOL_CONTRACT\uff0c\u5bfc\u822a\u672c\u8eab\u4e0d\u6388\u6743\u3002","orderedDependencies":[]}],"declarationIdentity":"937|BB539B17256DAD819641DB11C62EB09115C32FA348B7BAFF992CA5A968EC78B6"},{"requirementId":"framework:PR_CODEX_TOOL_OPERATION_RESOLUTION","source":"FRAMEWORK","ownerModule":"HOST_CODEX.md","semanticApplicability":"DETERMINISTIC","fullText":"\u6309RECOVERY\u7684\u5df2\u7ed1\u5b9abackend/TOOLCHAIN\u53d6\u5f97\u7cbe\u786eoperation\u5165\u53e3\uff0c\u5065\u5eb7\u8c03\u7528\u590d\u7528\u3002\u5df2\u77e5\u72ec\u7acb\u8bfb\u67e5\u540c\u6279\u6267\u884c\uff1b\u6709\u4f9d\u8d56\u4e14\u65e0\u9700\u65b0\u8bed\u4e49\u5224\u65ad\u7684\u673a\u68b0\u6b65\u9aa4\u8fde\u7eed\u7f16\u6392\uff0c\u9010\u95e8\u68c0\u67e5\u5b9e\u9645\u7ed3\u679c\uff0c\u5931\u8d25\u505c\u4f9d\u8d56\u94fe\u3002\u65b0\u4e8b\u5b9e\u3001\u8bed\u4e49\u53d6\u820d\u6216\u771f\u5b9e\u5931\u8d25\u624d\u8fd4\u56de\u6a21\u578b\uff0c\u4e0d\u81ea\u52a8\u586b\u6388\u6743\u3001Review\u6216\u63a5\u53d7PASS\uff1b\u8bb0\u5f55\u3001\u4ea4\u4ed8\u4e0e\u5fc5\u8981\u5f52\u6863\u5728\u539f\u81ea\u7136\u6536\u5c3e\u5b8c\u6210\u3002","preparationRequirements":["TOOLCHAIN_IDENTITY_BOUND"],"resultRequirements":["SEALED_ENTRYPOINT_INVOKED"],"selectorIdentity":"653|3DE8F0AE2CEEB69FDFB22709B65ACCD511878EB6398FDC73CAEA3B4D0FB40582","displayParts":[{"sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-b264a47a\\aiw-int-p-7e970be96e8d4c8b95abe6d3b51fd1fc\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","sourceIdentity":"7845|DE