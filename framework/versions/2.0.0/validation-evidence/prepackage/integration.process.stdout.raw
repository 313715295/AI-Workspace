-policy.externalAuthorization\u4e2d\u9009\u62e9PER_ACTION\uff08\u7f3a\u7701\uff09\u6216PROJECT_PREAUTHORIZED\u3002\u540e\u8005\u4ec5\u5728\u5f53\u524d\u9879\u76ee\u8bb8\u53ef\u5b8c\u6574\u8986\u76d6\u5b9e\u9645\u5de5\u5177/provider\u3001\u64cd\u4f5c\u3001\u6267\u884c/\u59d4\u6d3e\u4e3b\u4f53\u3001\u8d26\u53f7/\u6570\u636e\u3001\u8d39\u7528\u53ca\u6062\u590d\u6761\u4ef6\uff0c\u4e14\u6ca1\u6709\u64a4\u56de\u3001\u51b2\u7a81\u6216\u672a\u77e5\u65f6\uff0c\u7531\u5b9e\u9645\u6267\u884c\u8005\u76f4\u63a5\u8c03\u7528\u539f\u5de5\u5177\u3002\u8c03\u7528\u672c\u8eab\u4e0d\u8981\u6c42\u9010\u6b21\u4efb\u52a1\u5361\u3001EXTERNAL\u5305\u3001DISCOVER/ADMIT/FINALIZE\uff1b\u539f\u5de5\u5177\u8fd4\u56de\u4e0e\u5bbf\u4e3b\u89c2\u5bdf\u4fdd\u7559\u771f\u5b9e\u6210\u529f\u3001\u5931\u8d25\u6216UNKNOWN\uff0c\u968f\u5f53\u524d\u6210\u679c\u81ea\u7136\u4ea4\u4ed8\u3002\u5b83\u4e0d\u514d\u9664\u9996\u6b21/\u6d3b\u52a8\u53d8\u5316/\u6062\u590d\u65f6\u7684\u5b8c\u6574\u89c4\u5219\u8bfb\u53d6\uff0c\u4e5f\u4e0d\u4ea7\u751f\u53ef\u4f9b\u5176\u4ed6\u52a8\u4f5c\u7eed\u6743\u7684\u6210\u529f\u6536\u636e\u3002\u5f53\u524d\u9879\u76ee\u8bbe\u7f6e\u548c\u5b8c\u6574\u8bb8\u53ef\u7684\u8bfb\u53d6\u63a5\u53e3\u53d6TOOL_CONTRACT\uff0c\u8bed\u4e49\u8986\u76d6\u4ecd\u4e3aINSTRUCTION_BOUND\u3002\n\n\u76f4\u63a5\u6a21\u5f0f\u4e0d\u6388\u4e88Git\u3001\u8bbe\u5907\u3001\u6d4f\u89c8\u5668\u6216\u6e90\u7801/\u63a7\u5236\u9762\u5199\u5165\uff0c\u4e0d\u7ed5\u8fc7\u5bbf\u4e3b\u6743\u9650\u548c\u7528\u6237\u4eb2\u81ea\u4fdd\u7559\u4e8b\u9879\u3002\u672a\u8bbe\u91d1\u989d\u6216\u6b21\u6570\u4e0d\u586bFREE/0\u3001\u4e0d\u81ea\u52a8\u7d22\u53d6\u9010\u6b21\u6279\u51c6\uff1b\u64a4\u56de\u3001\u8d8a\u754c\u6216\u5fc5\u8981\u4e8b\u5b9e\u672a\u77e5\u505c\u6b62\u672c\u6b21\u8c03\u7528\u3002\u516c\u5f00\u53d1\u5e03\u3001\u79d8\u5bc6\u4e0a\u4f20\u3001\u8d26\u6237/\u51ed\u636e\u53d8\u66f4\u7b49\u72ec\u7acb\u8fb9\u754c\u6309\u5f53\u524d\u5b9e\u9645\u6743\u9650\u5904\u7406\uff0c\u4e0d\u80fd\u4ece\u4e00\u822c\u8bb8\u53ef\u6216hash\u63a8\u65ad\u83b7\u51c6\u3002\u660e\u786e\u4f7f\u7528\u6309\u6b21\u5305\u65f6\u4ecd\u8d70\u539fchecker\u53ca\u8fc7\u7a0b\u95e8\uff0c\u76f4\u63a5\u6a21\u5f0f\u4e0d\u80fd\u628a\u7f3a\u5305\u6216\u574f\u5305\u53d8\u6210\u6309\u6b21\u51c6\u5165PASS\u3002\n\n\u7528\u6237\u660e\u786e\u91c7\u7528Framework\u5f00\u5c55\u9879\u76ee\u5de5\u4f5c\u65f6\uff0c\u6cbf\u5df2\u6279\u51c6\u63a5\u5165\u6a21\u677f\u5efa\u7acb\u9879\u76ee\u5de5\u4f5c\u51b3\u5b9a\u7ea6\u5b9a\uff0c\u65e0\u987b\u9010\u6b65\u9aa4\u518d\u6b21\u786e\u8ba4\u540c\u4e00\u5df2\u6279\u51c6\u5de5\u4f5c\uff1b\u4ec5\u67e5\u770b\u6587\u4ef6\u6216\u672a\u91c7\u7eb3\u5efa\u8bae\u4e0d\u6784\u6210\u91c7\u7528\u3002\u7ea6\u5b9a\u6765\u6e90\u662f\u4eba\u7c7b\u660e\u786e\u91c7\u7528/\u786e\u8ba4\u7684\u9879\u76ee\u6b63\u6587\u6216\u76f4\u63a5\u51b3\u5b9a\uff1aAI\u6839\u636e\u5f53\u524d\u91c7\u7528Framework\u3001\u6709\u6548\u7ea0\u6b63\u53ca\u6c38\u4e45\u89c4\u5219\u4f5c\u51fa\u7684\u5177\u4f53\u51b3\u5b9a\uff0c\u5728\u8be5\u7ea6\u5b9a\u8303\u56f4\u5185\u6267\u884c\u3002\u5f53\u524d\u4eba\u7c7b\u6536\u7a84\u3001\u64a4\u56de\u548c\u660e\u786e\u4fdd\u7559\u4e8b\u9879\u4f18\u5148\uff1b\u6062\u590d\u3001\u538b\u7f29\u6216\u66f4\u6362\u6267\u884c\u8005\u4e0d\u81ea\u884c\u64a4\u9500\u4ecd\u6709\u6548\u6388\u6743\u3002\u6388\u6743\u539f\u6587\u7531\u9879\u76ee\u7528\u6237\u62e5\u6709\uff0c\u5bfc\u822a\u6a21\u677f\u4e0d\u72ec\u81ea\u6388\u6743\uff0c\u4e5f\u4e0d\u8986\u76d6\u5bbf\u4e3b\u66f4\u9ad8\u4f18\u5148\u7ea7\u9650\u5236\u3002\n\n\u6279\u51c6\u5de5\u4f5c\u6d41\u5185\u5fc5\u8981\u7684\u4efb\u52a1\u6d3e\u53d1\u3001\u8865\u5145\u548c\u7ec8\u6001\u76f4\u56de\u987b\u643a\u53ef\u6838\u5bf9\u7684\u539f\u59cb\u4eba\u7c7b\u6765\u6e90\u3001\u5f53\u524d\u8303\u56f4\u548c\u7cbe\u786e\u6d88\u8d39\u8005\u3002\u53e6\u4e00agent\u8981\u6c42\u3001\u6a21\u578b\u81ea\u5199AGENTS\u3001userConfirmation\u5b57\u7b26\u4e32\u3001\u81ea\u8eabID\u6216checker PASS\u4e0d\u72ec\u81ea\u8bc1\u660e\u4eba\u7c7b\u6388\u6743\u3002\u8c03\u7528\u524d\u5408\u5e76\u4ecd\u6709\u6548\u51b3\u5b9a\u4e0e\u540e\u7eed\u53d8\u5316\uff1b\u6761\u4ef6\u5df2\u6ee1\u8db3\u5373\u5728\u7cbe\u786e\u8303\u56f4\u5185\u6267\u884c\uff0c\u771f\u6b63\u7f3a\u5931\u53ea\u62a5\u544a\u548c\u8865\u9f50\u7f3a\u5931\u6761\u4ef6\uff0c\u4e0d\u628a\u5c1a\u672a\u8c03\u7528\u8bf4\u6210\u5bbf\u4e3b\u62d2\u7edd\u3002\u6388\u6743\u6b63\u6587\u53d8\u5316\u540e\u91cd\u7ed1\u53d7\u5f71\u54cd\u6765\u6e90\u548c\u51b3\u5b9a\uff0c\u4e0d\u80fd\u7528\u5386\u53f2\u5b89\u88c5\u8eab\u4efd\u9501\u4f4f\u5f53\u524d\u4eba\u7c7b\u51b3\u5b9a\u3002\n\n\u5305\u7ed1\u5b9a\u5f53\u524d\u4efb\u52a1\u3001\u8d23\u4efb\u4e3b\u4f53\u3001\u52a8\u4f5c\u3001\u7cbe\u786e\u8def\u5f84/\u5bf9\u8c61\u3001\u51b3\u5b9a\u3001\u914d\u7f6e\u53ca\u9002\u7528\u4ed3\u5e93/\u6267\u884c\u76ee\u6807\uff1b\u5b9e\u9645\u6f02\u79fb\u3001\u672a\u77e5\u5fc5\u8981\u4e8b\u5b9e\u6216\u4e0d\u5408\u683c\u5f0f\u5747\u62d2\u7edd\u53d7\u5f71\u54cd\u52a8\u4f5c\u3002\u666e\u901a\u53ef\u9009\u6267\u884c\u76ee\u6807\u4e0d\u6539\u53d8\u552f\u4e00\u63a7\u5236\u6839\u548c\u539f\u4efb\u52a1\u6743\u5a01\uff1bMaintenance\u7684CONTROL/TARGET\u7ee7\u7eed\u5206\u5305\u3001\u5206\u4ed3\u9a8c\u8bc1\u3002\u7cbe\u786e\u5b57\u6bb5\u53ca\u5f53\u524d\u683c\u5f0f\u53d6TOOL_CONTRACT\u548c\u5bf9\u5e94schema\u3002\n\n\u53ef\u9884\u6388\u4e88\u540c\u4e00\u6709\u754c\u6210\u679c\u7684\u672c\u5730\u5199\u6d4b\u3001\u6709\u9650\u81ea\u68c0\u8fd4\u5de5\u53ca\u6700\u540e\u4e00\u6b21REVIEW_ROUTE\u3002\u53ea\u6709\u771f\u5b9e\u539fFINALIZE\u540e\u50cf\u548c\u5f53\u524d\u51c6\u5165\u53ef\u627f\u63a5\u4e0b\u4e00\u6b65\uff0c\u672a\u786e\u5b9a\u7ed3\u679c\u3001\u65e0\u8bb8\u53ef\u3001\u8017\u5c3d\u6216\u505c\u6b62\u4e0d\u751f\u6210\u7eed\u6743\u3002\u5ba1\u6838\u8986\u76d6A\u53ef\u5305\u542b\u6709\u9650\u751f\u4ea7\u96c6M\uff0c\u4f46\u4e0d\u6269\u5927M\u5199\u6743\uff1b\u6210\u529f\u81ea\u67e5\u4e0e\u5b8c\u6574\u5019\u9009\u51c6\u5907\u5206\u522b\u53d6\u8bc1\u3002\u9996\u6b21\u4ea4\u5ba1/\u4fee\u590d\u590d\u5ba1\u7684\u7ec4\u7ec7\u804c\u8d23\u53d6REVIEW_AND_EVIDENCE\uff0c\u8fde\u7eed\u5305\u3001receipt\u3001repairReviewPlan\u53caM/A\u5b57\u6bb5\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\u72ec\u7acbReview\u3001\u63a5\u53d7\u3001Git\u3001\u8bbe\u5907\u3001\u5916\u90e8\u3001\u53d1\u884c\u548c\u91c7\u7528\u4e0d\u7531\u8fde\u7eed\u5199\u6d4b\u81ea\u52a8\u53d6\u5f97\u3002\n\n\u4efb\u52a1/Controller\u771f\u5b9e\u8eab\u4efd\u8f6c\u6362\u53ca\u9879\u76ee\u5347\u7ea7\u6cbfTOOL_CONTRACT\u548c\u6839PROJECT_ADOPTION\u7684\u539f\u8d23\u4efb/\u91c7\u7528\u4e8b\u52a1\uff1b\u666e\u901a\u6765\u6e90\u91c7\u7528\u3001\u65e0effect\u7ea0\u6b63\u53ca\u540c\u9879\u76ee\u4e13\u4e1a\u6b63\u6587\u53cc\u52a8\u4f5c\u66f4\u65b0\u6309\u5404\u81ea\u5b9e\u9645\u5199\u96c6\u548c\u6709\u5e8f\u6279\u6b21\uff0c\u4e0d\u6cdb\u5316\u5f3a\u5236\u4e8b\u52a1\uff0c\u4e0d\u4ee5fresh\u51c6\u5165\u8ffd\u8ba4\u65e7\u5199\u5165\u3002\u4e13\u4e1a\u6b63\u6587SOURCE/CONTROL\u4e24\u7c7b\u5f53\u524d\u6743\u9650\u548c\u5404\u81ea\u539f/\u65b0\u4e49\u52a1\u4e92\u4e0d\u66ff\u4ee3\uff1b\u53ef\u6cbf\u53d7\u9650\u8054\u5408\u5165\u53e3\u4e00\u6b21\u63d0\u4ea4\u4e24\u4efd\u539f\u51c6\u5165\u8f93\u5165\uff0c\u5171\u4eab\u540c\u6b21\u5b8c\u6574\u76ee\u6807\u6784\u9020\uff0c\u5404\u81ea\u4ecd\u4ea7\u751f\u771f\u5b9e\u51b3\u5b9a\u3002\u5b8c\u6574\u51c6\u5165\u540e\u6cbf\u539f\u5019\u9009\u6709\u5e8f\u6267\u884c\uff0c\u53ea\u6709\u4e24\u6210\u5458\u771f\u5b9e\u6536\u53e3\u90fd\u6210\u529f\u624d\u79f0\u6574\u6279\u5b8c\u6210\uff1bMaintenance CONTROL\u4e13\u4e1a\u6b63\u6587\u4f8b\u5916\u4ecd\u987b\u5f53\u524dController\u7cbe\u786e\u6388\u6743\u3001\u539f\u51b3\u5b9a\u53ca\u5b8c\u6574\u4fdd\u62a4\uff0c\u666e\u901aSOURCE/TEST_WRITE/BROWSER_RUN/DEVICE_RUN\u7981\u4ee4\u4fdd\u6301\u3002\u672a\u77e5\u7b2c\u4e09\u65b9\u5b57\u8282\u505c\u6b62\u53d7\u5f71\u54cd\u6062\u590d\u3002\n\n\u81ea\u68c0\u5931\u8d25\u6536\u53e3\u4e0d\u7b49\u4e8e\u6d4b\u8bd5\u6210\u529f\uff0c\u4e0d\u5236\u9020\u72ec\u7acbReview finding\uff1b\u5386\u53f2\u5931\u8d25\u4e0e\u672a\u5b8c\u6210\u6210\u679c\u8d23\u4efb\u4fdd\u7559\u3002\u4e34\u65f6\u8fc7\u7a0b\u6750\u6599\u662fINSTRUCTION_BOUND\u5173\u8054\u8bc1\u636e\uff0c\u4e0d\u662f\u7b7e\u540d\u3001\u5bbf\u4e3b\u5f3a\u5236\u6216\u6d88\u8d39\u53f0\u8d26\uff0c\u6309TOOL_CONTRACT\u4fdd\u7559\u81f3\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u3002\n\u666e\u901arepo-local schema1\u53caMaintenance CONTROL/TARGET schema2\u7684\u539f\u5b8c\u6574checker\u5df2\u5728ADMIT\u6309\u540c\u4e00\u56fa\u5b9a\u6765\u6e90/\u9002\u914d\u5668\u3001\u5b8c\u6574\u52a8\u4f5c/\u5bf9\u8c61/\u7eed\u94fe\u53c2\u6570\u548c\u5f53\u524d\u89c2\u5bdf\u6267\u884c\u65f6\uff0c\u7531\u8be5\u5b9e\u9645\u8c03\u7528\u6ee1\u8db3\u6388\u6743\u68c0\u67e5\uff1b\u8c03\u7528\u8005\u7701\u7565\u989d\u5916\u76f8\u540cchecker\u547d\u4ee4\u3002checker\u516c\u5171\u5165\u53e3\u4fdd\u7559\uff1bDISCOVER\u3001ADMIT\u4e0e\u6536\u53e3\u5404\u81ea\u771f\u5b9e\u89c2\u5bdf\u4e0d\u5408\u5e76\u6210\u5168\u5c40\u4e00\u6b21\u6216\u7f13\u5b58\u3002schema4\u53ca\u672a\u8bc1\u660e\u7b49\u4ef7\u7684\u4e13\u95e8\u8def\u5f84\u4ecd\u5206\u522b\u8c03\u7528\uff1b\u9519\u4e3b\u4f53\u3001\u8d8a\u754c\u3001\u524d\u50cf\u6f02\u79fb\u3001\u64a4\u56de\u548c\u574f\u7eed\u94fe\u7167\u539f\u62d2\u7edd\u3002\n\n\u9879\u76ee\u663e\u5f0fqualityAssurance1\u6309\u5b8c\u6574\u7a33\u5b9a\u6210\u679csubject\u5e76\u96c6\u9009\u62e9SELF_CHECK/RESULT_REVIEW/RESULT_ACCEPT\uff0c\u89c4\u5219/\u683c\u5f0f\u548c\u51c6\u5907\u552f\u4e00\u53d6TOOL_CONTRACT\u3002\u7f3a\u7701LEGACY\uff0c\u542f\u7528\u7f3aplan2\u4e0d\u5f97\u964d\u4e3a\u65e0\u95e8\uff1b\u771f\u96f6\u4e0d\u4f2a\u9020\u8bc1\u636e\uff0c\u7528\u6237/\u4e13\u4e1a\u9636\u6bb5\u548c\u771f\u5b9e\u5931\u8d25\u4fdd\u7559\u3002qualityBinding\u662f\u5f53\u524d\u9009\u62e9\u6295\u5f71\uff0c\u4e0d\u6388\u52a8\u4f5c\u3001\u8de8\u4ed3\u3001\u4e13\u95e8\u95e8\u6216\u63a5\u53d7\u6743\u3002\n"},{"unitKey":"384|B61209CB7AA09495133B9023A6F27B5586B292E6F2995D688515CA79BAA51E0A","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"357|446117A57B310691C95677F2DDEF6D6C4491EC6C6FAA27DD8A539737DB652FAB","textIdentity":"537|B044A67A539260F35DD1BF477DFF8AE897112AE33DB44BF1E5258647FC1389EF","orderedDependencies":[],"fullText":"authority context \u53ea\u80fd\u6765\u81ea\u5f53\u524d\u673a\u68b0\u89c2\u5bdf\u5230\u7684 project\u3001Controller\u3001task\u3001package\u3001scope\u3001identity\u3001capability\u3001recovery \u4e0e host facts\u3002requested objective/action/result\u3001\u540c\u4e00 IntentEnvelope2 \u7684 facets \u548c semantic hints \u8868\u8fbe\u5f53\u524d\u610f\u56fe\uff0c\u4e0d\u751f\u6210\u6388\u6743\u3002authority facts \u59cb\u7ec8\u4f18\u5148\uff1bUNKNOWN\u3001\u672a\u6388\u6743 action \u6216 hint/fact mismatch \u4f1a\u963b\u6b62\u53d7\u6cbb\u7406 action\uff0c\u6216\u5728\u5176\u4f59\u5df2\u77e5\u8fb9\u754c\u5185\u4fdd\u5b88\u9009\u62e9\u53d7\u5f71\u54cd\u7684\u5b8c\u6574\u89c4\u5219\u5757\u3002\u672a\u6765\u52a8\u4f5c\u3001\u5426\u5b9a\u548c\u793a\u4f8b\u4e2d\u7684\u6267\u884c\u8bcd\u4e0d\u6539\u53d8\u6b64\u523b\u7684\u52a8\u4f5c\u4e8b\u5b9e\u3002"},{"unitKey":"375|7BE4CD376DEE8A3AC8034D80FFE6EA0E9E2CE03A41D787E1127FA66421A6D1C1","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","normativeIdentity":"334|EB203D57AB82B1B3DE9B3D02F782F300B307FF608056B017FDE38DF9D9A611D0","textIdentity":"933|71CC796CDB0ABCFD3DF75C31FB71E4FCE995AA3C66DA4854000AE8683EDDD951","orderedDependencies":[],"fullText":"\u672c\u76ee\u6807\u4f7f\u7528navigationContractVersion=3\u7684PROJECT_BOOTSTRAP\u5165\u53e3\u3002\u9879\u76eeAGENTS\u53ea\u5bfc\u822a\u660e\u786e\u9879\u76ee\u7684.ai-workspace/BOOTSTRAP.md\uff1bBootstrap\u6309\u9879\u76eepin\u53ca\u539f\u91c7\u7528\u8bb0\u5f55\u7ed1\u5b9a\u56fa\u5b9a\u6765\u6e90\u548cTOOLCHAIN\uff0c\u4e0d\u8981\u6c42\u65b0Skill\u3001\u5b89\u88c5\u53d1\u73b0\u6216\u517c\u5bb9\u8f6c\u53d1\u3002\u5bbf\u4e3bAGENTS\u53ef\u89c1\u3001\u6587\u4ef6\u53ef\u8bfb\u548c\u5b9e\u9645\u6b63\u6587\u5df2\u8bfb\u5206\u522b\u6838\u5bf9\u3002\n\n\u9996\u6b21\u9879\u76ee\u5de5\u4f5c\u3001\u538b\u7f29\u6216\u6362\u4e3b\u4f53\u6309RECOVERY\u53d6\u5f97\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\uff1b\u5065\u5eb7\u4e0a\u4e0b\u6587\u6309RECOVERY\u590d\u7528\uff0c\u540c\u6d3b\u52a8\u666e\u901a\u8303\u56f4\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\u53ea\u91cd\u9a8c\u5f53\u524d\u51c6\u5165\u4e0e\u9002\u7528\u8981\u6c42\uff0c\u4e0d\u4e3a\u6bcf\u6b21action/final\u91cd\u8f7d\u3002\u65e0\u5173\u4f1a\u8bdd\u4e0d\u542f\u52a8\u9879\u76ee\u6062\u590d\u3002\n\n\u65e7nav1/nav2\u9879\u76ee\u53ca\u5728\u9014\u91c7\u7528\u7ee7\u7eed\u4f7f\u7528\u5404\u81ea\u539f\u56fa\u5b9a\u5165\u53e3\uff0c\u539fFINALIZE\u5b8c\u6210\u540e\u624d\u8bfb\u65b0AGENTS/Bootstrap\uff1b\u90e8\u5206\u6587\u4ef6\u53d8\u5316\u4e0d\u4ee3\u8868\u5207\u6362\u5b8c\u6210\u3002\u65e7Skill\u4ec5\u5728\u771f\u5b9e\u4f9d\u8d56\u7ed3\u675f\u4e14\u6709\u5bbf\u4e3b\u6743\u9650\u65f6\u9000\u5f79\uff0c\u4e0d\u5efa\u6d88\u8d39\u8005\u767b\u8bb0\u6216\u6bcf\u9879\u76ee\u526f\u672c\u3002\u8f93\u5165/\u8bc1\u636e\u4ecd\u53d6\u5f53\u524dTOOL_CONTRACT\uff0c\u5bfc\u822a\u672c\u8eab\u4e0d\u6388\u6743\u3002"},{"unitKey":"376|F54485FF832DDC7D99045AFABBCF9F500E9A7AAC3A26886A4C6D14DC9865E898","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\HOST_CODEX.md","normativeIdentity":"341|3FF0B562B887BF245A2289AAA90BF5BBE338C81C3BFEF4E2DBCFA1CB0E1242B8","textIdentity":"2425|6BB42B3F1CDFFA3D4B7115AEDF395773BE73A3861F68AE987A69E6D94B6138F3","orderedDependencies":[],"fullText":"\u6309RECOVERY\u7684\u5df2\u7ed1\u5b9abackend/TOOLCHAIN\u53d6\u5f97\u7cbe\u786eoperation\u5165\u53e3\uff0c\u5065\u5eb7\u8c03\u7528\u590d\u7528\u3002\u5df2\u77e5\u72ec\u7acb\u8bfb\u67e5\u540c\u6279\u6267\u884c\uff1b\u6709\u4f9d\u8d56\u4e14\u65e0\u9700\u65b0\u8bed\u4e49\u5224\u65ad\u7684\u673a\u68b0\u6b65\u9aa4\u8fde\u7eed\u7f16\u6392\uff0c\u9010\u95e8\u68c0\u67e5\u5b9e\u9645\u7ed3\u679c\uff0c\u5931\u8d25\u505c\u4f9d\u8d56\u94fe\u3002\u65b0\u4e8b\u5b9e\u3001\u8bed\u4e49\u53d6\u820d\u6216\u771f\u5b9e\u5931\u8d25\u624d\u8fd4\u56de\u6a21\u578b\uff0c\u4e0d\u81ea\u52a8\u586b\u6388\u6743\u3001Review\u6216\u63a5\u53d7PASS\uff1b\u8bb0\u5f55\u3001\u4ea4\u4ed8\u4e0e\u5fc5\u8981\u5f52\u6863\u5728\u539f\u81ea\u7136\u6536\u5c3e\u5b8c\u6210\u3002\n\n\u65b0\u6709\u9650\u6210\u679c\u3001\u65b0\u72ec\u5ba1\u6309TASK\u9ed8\u8ba4\u65b0\u5efa\u53ef\u89c1\u4f1a\u8bdd\uff1b\u540c\u4e00\u539f\u6210\u679c\u6216\u540c\u5ba1\u6709\u754c\u4fee\u590d\u590d\u5ba1\u53ef\u7eed\u4ecd\u5065\u5eb7\u3001\u5408\u683c\u7684\u539f\u4f1a\u8bdd\u3002\u521b\u5efa\u65f6\u540c\u4e00\u6b21\u5b9e\u9645\u8c03\u7528\u843d\u5b9e\u9009\u5b9amodel\u3001effort\u3001\u73af\u5883\u548c\u5bbf\u4e3b\u652f\u6301\u7684\u7cbe\u786e\u8d77\u70b9\uff0c\u4f7f\u7528\u6807\u9898\u53c2\u6570\uff0c\u5e76\u6838\u5bf9\u771f\u5b9ethread ID\u3001\u914d\u7f6e\u53ca\u8bfb\u53d6\u57fa\u7ebf\u3002clientThreadId\u4e0d\u4f5c\u6b63\u5f0f\u4e3b\u4f53\u3002\u5f53\u524d\u672a\u63d0\u4ea4\u6750\u6599\u3001\u9694\u79bb\u9700\u8981\u548c\u7528\u6237\u6307\u5b9a\u5f71\u54cd\u8d77\u70b9\uff0c\u4e0d\u56e0\u201c\u72ec\u5ba1\u201d\u6216Git\u540d\u79f0\u81ea\u52a8\u5f3a\u5236worktree\uff1b\u5bbf\u4e3b\u4e0d\u652f\u6301\u4e0e\u7528\u6237\u6ca1\u6388\u6743\u5206\u522b\u62a5\u544a\uff0c\u4e0d\u9759\u9ed8\u6362\u73af\u5883\u3002\u660e\u786econtrolRoot\u53caexecutionTarget\u7684\u521d\u59cb\u6307\u4ee4\u4f18\u5148\u4e8e\u6267\u884c\u76ee\u5f55\u5185\u5386\u53f2\u590d\u5236\u5165\u53e3\uff0c\u5b9e\u9645authority/\u4fdd\u62a4\u4ecd\u7531\u5f53\u524d\u5de5\u5177\u6838\u5bf9\u3002\n\n\u5df2\u77e5\u63a5\u6536\u8005\u76f4\u63a5\u4f7f\u7528\u771f\u5b9eID\u3002\u65b0\u5efa\u672a\u77e5ID\u65f6\uff0c\u521b\u5efa\u63d0\u793a\u4e00\u6b21\u4ea4\u9f50\u5b8c\u6574\u5de5\u4f5c/\u9a8c\u6536/\u5019\u9009/\u6d88\u8d39\u8005\u3001\u53ef\u6838\u5bf9\u7684\u539f\u59cb\u4eba\u7c7b\u6765\u6e90\u548c\u5f85\u7ed1\u5b9a\u539f\u4ef6\u8def\u5f84\u3001identity\u3001delegationId\uff1b\u539f\u4ef6\u4e0d\u53ef\u6267\u884c\u3002\u63a5\u6536\u8005\u4ece\u81ea\u5df1\u7684\u771f\u5b9e\u521d\u59cb\u59d4\u6d3e\u6838\u5bf9\u539f\u4ef6\uff0cAUTHORIZATION_RECEIVER_BIND\u8bfb\u53d6\u5bbf\u4e3bCODEX_THREAD_ID\uff0c\u4ec5\u6309\u539f\u6a21\u677f\u7ed1\u5b9a\u81ea\u8eab\uff0c\u4e0d\u80fd\u6539Owner/issuer/\u8303\u56f4/\u52a8\u4f5c/\u5019\u9009\u3002\u8be5\u5173\u7cfb\u4e3aINSTRUCTION_BOUND\uff0c\u4e0d\u58f0\u79f0\u5de5\u5177\u80fd\u8ba4\u8bc1\u521d\u59cb\u63d0\u793a\uff1b\u7f3a\u5931/\u4e0d\u7b26\u53ea\u8bfb\u505c\u6b62\u3002\u5177\u4f53assignment/receiverBinding\u5b57\u6bb5\u552f\u4e00TOOL_CONTRACT\uff1b\u5065\u5eb7\u7eed\u4f5c\u590d\u7528\u6709\u6548\u7ed1\u5b9a\uff0c\u4e0d\u9ed8\u8ba4\u521b\u5efa\u540e\u8865\u5305\u3002\n\n\u5bbf\u4e3b\u660e\u786e\u8981\u6c42\u521b\u5efa\u540e\u9996\u6b21\u8fdb\u5ea6\u89c2\u5bdf\u65f6\uff0c\u5728\u53d6\u5f97\u771f\u5b9e\u53ef\u7528ID\u540e\u4ec5\u505a\u4e00\u6b21\u7acb\u5373\u5feb\u7167\uff0c\u672a\u5c31\u7eea\u7ed3\u675f\u672c\u8f6e\uff1b\u8d85\u65f6/commentary\u4e0d\u89e6\u53d1\u7ee7\u7eed\u7b49\u5f85\u3002\u5f53\u524d\u547d\u4ee4\u5fc5\u8981\u7b49\u5f85\u4e0epeer\u7b49\u5f85\u5206\u5f00\uff0c\u540e\u8005\u9075\u5faaTASK\u3002\u663e\u793a\u6807\u9898\u4ec5\u5728\u4e3b\u9898/\u804c\u8d23\u5b9e\u53d8\u65f6\u6309\u771f\u5b9eID\u66f4\u65b0\uff0c\u4e0d\u53d1\u9001\u6307\u4ee4\uff0c\u4e0d\u6539\u53d8Owner\u3001\u8303\u56f4\u3001\u6743\u9650\u6216\u8d21\u732e\u5386\u53f2\uff1b\u4e0d\u9760\u6062\u590d\u6539\u540d\u8ba9\u5df2\u5173\u95ed/\u5f52\u6863\u6709\u9650\u4f1a\u8bdd\u9ed8\u8ba4\u63a5\u65b0\u6210\u679c\u3002\u6709\u9650\u6210\u679c\u5df2\u4ea4\u4ed8\u3001\u539f\u7ed3\u679c\u5df2\u6d88\u8d39\u4e14\u65e0\u540e\u7eed\u804c\u8d23\u65f6\uff0c\u5b9e\u9645\u6536\u5c3e\u8d23\u4efb\u4eba\u5728\u5df2\u6709\u6743\u9650\u5185\u7528\u5bbf\u4e3b\u5f52\u6863\u5e76\u6838\u5bf9\u771f\u5b9e\u7ed3\u679c\uff1b\u5f85\u9a8c\u6536\u3001\u8fd4\u4fee\u53ca\u771f\u5b9e\u957f\u671f\u804c\u8d23\u4fdd\u7559\uff0c\u4efb\u52a1\u5361\u4e0e\u4f1a\u8bdd\u5f52\u6863\u5206\u522b\u786e\u8ba4\u3002\u5b9e\u9645\u4ea4\u5ba1\u4f9d\u8d56\u987a\u5e8f\u552f\u4e00\u53d6REVIEW_AND_EVIDENCE\u3002"},{"unitKey":"385|56B154BEDC3744F0B4E42CD1A445A38009A5450388D1D30B1E24D6DA47A25B09","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"347|1357F2CBAFFE3CCA961248BF967121A00206BF3E6B12A06E8216773325996D58","textIdentity":"1291|CF3A38ABC7768EC281F9B63617F400F9AA17803092DD8447EB21595DF1E87089","orderedDependencies":[],"fullText":"controller.json\u552f\u4e00\u786e\u5b9a\u5f53\u524dController ID/epoch\uff1bPROJECT_CONTROLLER\u7b7e\u53d1\u8005\u987b\u5339\u914d\uff0cTASK_OWNER\u4e0d\u5f97\u5192\u5145\u3002\u540c\u4e00actor\u53ef\u517c\u4efb\uff0c\u4f46\u7b7e\u53d1\u3001\u63a5\u53d7\u548c\u72ec\u7acb\u5ba1\u6838\u5173\u7cfb\u5206\u522b\u6210\u7acb\u3002Controller\u627f\u62c5\u9879\u76ee\u6301\u7eed\u8d23\u4efb\uff0cOwner\u627f\u62c5TASK_AND_SCOPE\u5b9a\u4e49\u7684\u5f53\u524d\u6709\u9650\u6210\u679c\u8d23\u4efb\u3002\n\nTASK_OWNER\u5728\u672a\u53d8domain\u6210\u679c\u5185\u76f4\u63a5\u6267\u884c\uff0c\u6216\u9009\u62e9temporary actor/Reviewer\u3001\u7b7e\u7cbe\u786e\u5305\u5e76\u6d88\u8d39\u7ed3\u679c\u3002grantee\u53ea\u6709\u672c\u52a8\u4f5c\u6216\u660e\u786e\u8fde\u7eed\u6279\u6b21\u7684\u4e34\u65f6\u6267\u884c\u8d44\u683c\uff0c\u4e0d\u53d6\u5f97Owner\u6743\u529b\uff0c\u4e0d\u6539Work route\u3002\u672a\u77e5\u63a5\u6536\u8005\u4f7f\u7528TOOL_CONTRACT\u7684\u4e0d\u53ef\u6267\u884c\u5f85\u7ed1\u5b9a\u539f\u4ef6\u53caHOST\u7684\u771f\u5b9e\u81ea\u8eab\u8eab\u4efd\u6838\u5bf9\uff1b\u5df2\u77e5ID\u76f4\u63a5\u7ed1\u5b9a\uff0c\u5065\u5eb7\u7eed\u4f5c\u4e0d\u91cd\u590d\u81ea\u7ed1\u5b9a\u3002\n\nidentity/model\u7684\u5408\u6cd5\u7ed1\u5b9a\u53d8\u5316\u4e0eeffort\u8c03\u6574\u5206\u5f00\uff1beffort\u672c\u8eab\u4e0d\u8f6c\u79fb\u8d23\u4efb\u3001\u4e0d\u6388\u4e88\u6743\u9650\uff0c\u4e0d\u81ea\u52a8\u8981\u6c42handoff\u3001\u65b0\u4efb\u52a1\u6216FULL_COLD\u3002\u8d44\u6e90\u5224\u65ad\u53d6PR_TASK_RESOURCE_SELECTION\uff0c\u5bbf\u4e3b\u5b9e\u9645\u914d\u7f6e\u53d6HOST_CODEX\u3002\n\n\u53ea\u6709Controller\u62e5\u6709\u552f\u4e00\u4e0b\u4e00\u52a8\u4f5c\uff0c\u6216\u5f53\u524dOwner/\u516c\u5171\u51b3\u5b9a\u3001\u8de8\u57df\u5408\u540c\u3001\u4fdd\u62a4\u3001\u9879\u76ee\u9636\u6bb5\u3001Git/device/external\u6743\u9650\u3001\u8d44\u6e90\u51b2\u7a81\u786e\u9700\u5176\u51b3\u5b9a\u65f6\u624d\u5347\u7ea7\u8def\u7531\uff1b\u5df2\u83b7\u6388\u7684\u9886\u57dfGit\u53ca\u5916\u90e8\u52a8\u4f5c\u6309GIT_AND_EXTERNAL\u76f4\u63a5\u6267\u884c\uff0c\u4e0d\u56e0\u52a8\u4f5c\u540d\u79f0\u5f3a\u5236\u4e2d\u8f6c\u3002Reviewer\u8d44\u683c\u3001finding/APPROVED\u53bb\u5411\u4e0e\u53d7\u6258\u63a5\u53d7\u552f\u4e00\u53d6REVIEW_AND_EVIDENCE\u3002"},{"unitKey":"384|33ADB74870EDEF5C1778B11EEC0B6EB4C7D2F992982C9C645C35D701C7BEF15A","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\REVIEW_AND_EVIDENCE.md","normativeIdentity":"345|5302EC03A774B8AD488387D94C9748E2A70CECCE1E90BF682440A5DE91408A4D","textIdentity":"705|9C72DDB971C85A17E53E43DC69A75D63E7AE7E35CA235208B2E397E315CB1A8E","orderedDependencies":[],"fullText":"\u8bc1\u636e\u53ea\u652f\u6301\u5b9e\u9645\u89c2\u5bdf\u5230\u7684\u5bf9\u8c61\u3001\u73af\u5883\u3001\u673a\u5236\u548c\u8303\u56f4\u3002\u5939\u5177\u53ef\u8bc1\u660e\u901a\u7528\u534f\u8bae\u3001\u5931\u8d25\u5206\u652f\u3001\u89c4\u8303\u8eab\u4efd\u548c\u533f\u540d\u9879\u76ee\u4fdd\u6301\uff1b\u81ea\u7136\u9879\u76ee\u89c2\u5bdf\u53e6\u8bc1\u660e\u5176\u771f\u5b9e\u8c03\u7528\u3001\u8bef\u963b\u65ad/\u6cc4\u6f0f\u53ca\u6709\u8986\u76d6\u7684\u6210\u672c\uff0c\u4e8c\u8005\u4e0d\u4e92\u76f8\u5192\u5145\u3002\u53ef\u9009\u53d1\u884c\u540e\u81ea\u7136\u89c2\u5bdf\u4e0d\u81ea\u52a8\u6210\u4e3a\u65b0\u7684\u53d1\u884c\u95e8\u3002\n\n\u7ed3\u6784PASS\u3001hash\u3001\u8c03\u7528\u8fd4\u56de\u6216\u6a21\u62df\u5bbf\u4e3b\u5747\u4e0d\u8bc1\u660e\u8bed\u4e49\u6b63\u786e\u3001\u6a21\u578battention\u3001\u771f\u5b9e\u6d4f\u89c8\u5668/\u8bbe\u5907\u72b6\u6001\u3001\u8fdc\u7aef\u53d1\u5e03\u6216\u5916\u90e8\u52a8\u4f5c\u5b8c\u6210\u3002\u5931\u8d25\u3001\u4e2d\u65ad\u3001\u672a\u77e5\u3001\u8df3\u8fc7\u548c\u672a\u8fd0\u884c\u660e\u786e\u4fdd\u7559\uff1b\u5e73\u53f0\u652f\u6301\u53ea\u6309\u5bf9\u5e94\u5b9e\u9645conformance\u58f0\u660e\u3002\u65f6\u95f4\u3001\u5b57\u6bb5\u548c\u89c4\u8303\u7ed3\u679c\u7684\u5b9e\u73b0\u8981\u6c42\u53d6TOOL_CONTRACT\u53caTOOLCHAIN\uff0c\u4e0d\u628a\u672a\u9a8c\u8bc1\u5e73\u53f0\u5199\u4e3a\u5df2\u652f\u6301\u3002"},{"unitKey":"381|1747F9B78BBD24FCDD1FFE95E837006F8B1C0ABD6DC152F2BFE46F19473DB1AC","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\GIT_AND_EXTERNAL.md","normativeIdentity":"347|C6D1AF4C91B1FF9E9EE176F282F768F877FB77D9EA31ED79AB4FE4181610B372","textIdentity":"400|EF5BD2515336BF24040DDE6DA963BFCBA485F5305C3BED1BCD71090A7D06C55D","orderedDependencies":[],"fullText":"browser\u3001device \u4e0e\u5176\u4ed6 external side effect \u5fc5\u987b\u5404\u81ea\u7ed1\u5b9a\u771f\u5b9e\u64cd\u4f5c\u3001\u76ee\u6807\u3001credential/publication boundary\u3001\u7528\u6237\u51b3\u5b9a\u4e0e\u8bc1\u636e\u4e0a\u9650\u3002\u666e\u901aEXTERNAL\u53ef\u7531\u9879\u76ee\u663e\u5f0f\u9009\u62e9\u9884\u6388\u6743\u76f4\u63a5\u8c03\u7528\uff0c\u6309\u6b21\u6a21\u5f0f\u4ecd\u7ed1\u5b9a\u5f53\u524d\u52a8\u4f5c\u5305\uff1b\u6d4f\u89c8\u5668\u3001\u8bbe\u5907\u53ca\u5176\u4ed6\u72ec\u7acb\u95e8\u4e0d\u7531\u8be5\u8bbe\u7f6e\u653e\u5f00\u3002process resolution\u4e0d\u662fhost enforcement\uff0c\u4e0d\u80fd\u4ea7\u751f\u5bbf\u4e3b\u6ca1\u6709\u6388\u4e88\u7684\u80fd\u529b\u3002"},{"unitKey":"378|5FBAD91BA7BAC2FDE2B30C5A93DDD23454E5C6EA7FCE3D219EDB8EBDC286CAC1","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","normativeIdentity":"339|BA083DB83A1523E766824AAFDF0AC438BB1B230B6D6571A44BC28CA1B2916260","textIdentity":"733|F21457FF41D15A5AABE223D679BADEEAD0D55CC6E5FAF050A3C768D3EED3F68B","orderedDependencies":[],"fullText":"backend\u662f\u9879\u76eeFramework\u4f7f\u7528\u914d\u7f6e\uff0c\u4e0d\u662f\u4efb\u52a1\u6216\u52a8\u4f5c\u6388\u6743\u3002\u9996\u6b21\u8c03\u7528\u6216\u76f8\u5173\u6765\u6e90\u53d8\u5316\u65f6\uff0c\u4ee5project\u914d\u7f6e\u7cbe\u786e\u5339\u914dTOOLCHAIN\u7684\u8bed\u8a00\u65e0\u5173operation\u53casealed entrypoint\uff0c\u6ee1\u8db3\u58f0\u660eruntime/platform\uff1b\u5065\u5eb7\u7ed1\u5b9a\u53ef\u590d\u7528\u3002\u5f53\u524d\u53ea\u63d0\u4f9bpowershell7\uff0c\u53ea\u6709\u5b9e\u9645\u53d1\u884c\u63d0\u4f9b\u7b2c\u4e8c\u4e2aofficial backend\u624d\u53ef\u6cbf\u9879\u76ee\u91c7\u7528\u5207\u6362\u3002\n\nbackend\u53d8\u66f4\u4f7f\u53d7\u5f71\u54cd\u914d\u7f6e/\u5305\u7ed1\u5b9a\u5931\u6548\uff0c\u987b\u5b89\u5168\u91c7\u7528\u8fb9\u754c\u53cafresh recovery\u3002\u672a\u77e5backend\u3001\u7f3a\u5165\u53e3\u3001\u4e0d\u652f\u6301\u5e73\u53f0\u6216runtime\u4e0d\u53ef\u7528\u5747\u505c\u6b62\u53d7\u5f71\u54cd\u8c03\u7528\uff0c\u4e0d\u4eceshell\u731c\u6d4b\uff0c\u4e0d\u81ea\u52a8fallback\u3001\u5b89\u88c5\u3001\u751f\u6210adapter\u3001\u53e6\u9020launcher\u6216\u8ba9\u7528\u6237\u9010\u4efb\u52a1\u9009\u540e\u7aef\u3002\u64cd\u4f5c\u683c\u5f0f\u552f\u4e00\u53d6TOOL_CONTRACT\uff0c\u771f\u5b9e\u5165\u53e3/\u652f\u6301\u4e8b\u5b9e\u552f\u4e00\u53d6TOOLCHAIN\u3002"},{"unitKey":"380|C26CB5617790B28BFDCE2AF43F17245DB939B67095B912A5E0E4F5065D622E96","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\PROJECT_CONTROL.md","normativeIdentity":"345|BC6A4466B945B3574A0E4D348040513D2E77E5A6BF0FFD38099A373969C66B6A","textIdentity":"541|84D79FD18593E05C2BF457C6CA0BA50737F6DC4AB19F3542C04E0C35DBDA99A4","orderedDependencies":[],"fullText":"\u9879\u76ee\u91c7\u7528\u52a0\u8f7d\u76ee\u6807starter\u548c\u4efb\u52a1\u5408\u540c\uff0c\u4e0d\u6279\u91cf\u91cd\u5199\u5df2\u6709\u4efb\u52a1\u6216\u4f1a\u8bdd\u3002\u5f53\u524d\u6210\u679c\u7684Owner\u3001\u6267\u884c\u8def\u7ebf\u53ca\u4e34\u65f6\u4e3b\u4f53\u6309TASK_AND_SCOPE\u7ed1\u5b9a\uff1b\u7b7e\u53d1\u4e0e\u771f\u6b63Controller\u4f8b\u5916\u53ea\u53d6AUTHORIZATION_MODEL\uff0c\u4e0d\u56e0\u65b0\u5305\u6216\u4e34\u65f6\u8d44\u6e90\u53d8\u5316\u5f3a\u5236\u4e3b\u63a7\u4e2d\u8f6c\u3002\n\n\u9879\u76ee\u7ed3\u679c\u6d88\u8d39\u7531\u5f53\u524d\u6709\u9650\u6210\u679c\u8d23\u4efb\u4eba\u76f4\u63a5\u5b8c\u6210\uff0c\u9879\u76ee\u6301\u7eed\u4e8b\u5b9e\u7531Controller\u7ef4\u62a4\u3002\u53d1\u73b0\u4efb\u52a1\u6216Controller\u7684\u5728\u9014\u8f6c\u6362\u6807\u8bb0\u65f6\uff0c\u5148\u6cbfRECOVERY_CORE\u548cTOOL_CONTRACT\u6062\u590d\u539f\u4e8b\u52a1\uff0c\u4e0d\u80fd\u7528\u65b0\u7684\u5361\u7247\u6216\u6388\u6743\u8ffd\u8ba4\u672a\u95ed\u5408\u5199\u5165\u3002"},{"unitKey":"379|0EBF614784A1DB3A6C1775401EE1A57BB947E301F40CF1FFF910DCE68711EC3A","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","normativeIdentity":"356|29989A3D629B160E32BAB45503AF2B73EF87CBB3434BC4F0DC089FF1EB7B833A","textIdentity":"5246|D0E790346400E216F2357EAEA1597863B6338610B396A894367BADBAF04E7014","orderedDependencies":[],"fullText":"DISCOVER\u9a8c\u8bc1\u5fc5\u8981\u5168\u5c40\u4e09\u6e90\u58f0\u660e\u4e0e\u5f53\u524d\u6743\u5a01\uff0c\u6309\u540c\u4e00\u771f\u5b9eIntent\u9009\u62e9\uff0c\u518d\u9a8c\u8bc1\u547d\u4e2d\u89c4\u5219\u7684\u5b8c\u6574\u516c\u5171\u6761\u4ef6\u3001\u4f9d\u8d56\u548c\u6b63\u6587\uff0c\u8fd4\u56de\u5f53\u524d\u4e49\u52a1\u53ca\u6240\u9700\u5168\u6587\uff0c\u4e0d\u6388\u6743\u3002\u672a\u547d\u4e2d\u7684\u72ec\u7acb\u5916\u90e8\u6b63\u6587\u4e0d\u8bfb\u53d6\uff0c\u4e0d\u8bc1\u660e\u5176\u5065\u5eb7\uff1b\u771f\u5b9e\u91c7\u7528/\u53d8\u66f4\u8fb9\u754c\u4ecd\u9a8c\u8bc1\u5b8c\u6574\u76ee\u6807\u96c6\u5408\u3002\u6309\u6b21\u53d7\u6cbb\u7406\u52a8\u4f5c\u5404\u81eachecker/ADMIT\uff0c\u6b63\u5f0f\u8f93\u51fa\u6309\u771f\u5b9e\u7ed3\u679c\u548c\u6d88\u8d39\u8005FINALIZE\uff1bPROJECT_PREAUTHORIZED\u8986\u76d6\u5185\u666e\u901a\u5916\u90e8\u5de5\u5177\u8c03\u7528\u6cbf\u5f53\u524d\u9879\u76ee\u8bb8\u53ef\u76f4\u63a5\u6267\u884c\u5e76\u4fdd\u539f\u5de5\u5177\u8fd4\u56de\uff0c\u4e0d\u9010\u6b21\u91cd\u5efaD/A/F\u3002\u6ca1\u6709\u9002\u7528\u4efb\u52a1\u7684\u5408\u6cd5\u53ea\u8bfb\u89e3\u91ca\u3001\u67e5\u8bc1\u548c\u65b9\u6848\u53ef\u7ec4\u6210\u4e00\u4e2a\u6709\u754cNONE\u6279\u6b21\uff0c\u4e0d\u9010\u6587\u4ef6ADMIT\u6216\u7f16\u9020\u4efb\u52a1\uff1b\u8f6c\u4e3a\u771f\u5b9e\u526f\u4f5c\u7528\u3001\u6b63\u5f0f\u5ba1\u6838\u6216\u65b0\u8fb9\u754c\u65f6\u6309\u5b9e\u9645\u6a21\u5f0f\u91cd\u65b0\u5224\u65ad\uff1b\u9879\u76ee\u9884\u6388\u6743\u76f4\u63a5\u8c03\u7528\u4e0d\u91cd\u590d\u52a8\u4f5c\u5305\u94fe\uff0c\u5176\u4ed6\u52a8\u4f5c\u4ecd\u72ec\u7acb\u51c6\u5165\u3002\n\n\u5206\u5f00\u5904\u7406\u6765\u6e90\u7ec4\u5408\u3001\u5f53\u524d\u52a8\u4f5c\u51b3\u5b9a\u53ca\u6b63\u6587\u53ef\u7528\u6027\uff1a\u6765\u6e90/\u89c4\u8303\u5355\u5143\u53ca\u6709\u5e8f\u4f9d\u8d56\u7684\u53d8\u5316\u91cd\u7ed1\u76f8\u5e94\u5185\u5bb9\uff0c\u6743\u9650\u3001\u4efb\u52a1\u8def\u7ebf\u3001\u9636\u6bb5\u3001\u51b3\u5b9a\u6216\u6267\u884c\u76ee\u6807\u53d8\u5316\u91cd\u9a8c\u5f53\u524d\u52a8\u4f5c\uff1bfresh\u5305\u3001\u5de5\u5177\u8c03\u7528\u3001\u6b63\u5e38\u8fdb\u5c55\u548c\u5df2\u6388\u6743\u540e\u50cf\u672c\u8eab\u4e0d\u8981\u6c42\u5168\u90e8\u91cd\u8bfb\u3002scoped\u6765\u6e90\u8eab\u4efd\u53ea\u8bc1\u660e\u5f53\u524d\u5b8c\u6574\u9009\u62e9\u95ed\u5305\uff1b\u6388\u6743/\u4e0d\u53ef\u53d8\u5bf9\u8c61\u53ca\u5b9e\u9645\u6d88\u8d39\u6210\u5458\u4ecd\u6309\u5404\u81ea\u5b8c\u6574\u5b57\u8282\u4e25\u683c\u6838\u5bf9\u3002\n\n\u9996\u6b21\u3001\u538b\u7f29\u3001\u6362\u4e3b\u4f53\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u8bf7\u6c42FULL\uff0c\u6309\u5f53\u524d\u610f\u56fe\u9009\u62e9\u5b8c\u6574\u6761\u4ef6\u4e0e\u4f9d\u8d56\uff0c\u540c\u6b21\u53bb\u91cd\u540e\u7ec4\u88c5\u5168\u90e8\u5f53\u524d\u5fc5\u9700\u6b63\u6587\u3002\u5de5\u4f5c\u6d3b\u52a8\u4e0e\u6743\u9650\u64cd\u4f5c\u5206\u522b\u5224\u65ad\uff1a\u5b9e\u73b0\u4e2d\u7684\u8bfb\u53d6\u3001\u6e90\u7801/\u6d4b\u8bd5\u4ee3\u7801\u4fee\u6539\u548c\u8bb0\u5f55\u53ef\u5c5e\u4e8e\u540c\u4e00\u6d3b\u52a8\uff1b\u8fdb\u5165\u5b9e\u9645TEST_RUN\u3001\u81ea\u67e5\u3001\u5ba1\u6838\u6216\u7531\u9a8c\u8bc1\u8f6c\u8fd4\u4fee\u662f\u6d3b\u52a8\u5207\u6362\uff0c\u987b\u5b8c\u6574\u52a0\u8f7d\u3002\u65b0\u589e\u9002\u7528\u8981\u6c42\u3001\u771f\u5b9e\u4efb\u52a1\u8def\u7ebf\u6216\u6765\u6e90\u5b9e\u53d8\u540c\u6837FULL\u3002\u9000\u51facoverage\u5dee\u96c6\u6267\u884c\u548c\u672a\u6765\u6b63\u6587\u9884\u8f7d\uff1b\u65e7REUSE\u4ec5\u517c\u5bb9\u4e3aFULL\uff0c\u4e0d\u6253\u5f00previousCoverageRef\uff0c\u4e0d\u8fd4\u56deREUSED\u96f6\u6b63\u6587\u6216DELTA\u5c40\u90e8\u6b63\u6587\u3002coverage\u4ec5\u4e3a\u672c\u6b21\u6765\u6e90\u7d22\u5f15\uff0c\u4e0d\u8bc1\u660e\u6a21\u578b\u8bb0\u5fc6\u6216attention\uff0c\u4e0d\u8981\u6c42\u5bbf\u4e3b\u63d0\u4f9b\u4e0d\u5b58\u5728\u7684\u201c\u5f53\u524d\u6a21\u578b\u6301\u6709\u5168\u6587\u8bc1\u660e\u201d\u3002\u771f\u5b9e\u6765\u6e90\u62d2\u7edd\u3001\u64a4\u6743\u3001\u4fdd\u62a4\u6216\u672a\u5b8c\u91c7\u7528\u4e0d\u80fd\u4ee5FULL\u53d8\u6210PASS\u3002\n\n\u540c\u4e00\u5065\u5eb7\u5de5\u4f5c\u6d3b\u52a8\u4e2d\u7684\u666e\u901a\u6587\u4ef6\u3001\u5305\u6216\u672c\u5730\u914d\u5957\u64cd\u4f5c\u53d8\u5316\uff0c\u5148\u7ecf\u539fchecker/ADMIT\u6838\u5f53\u524d\u6743\u9650\u3001\u8303\u56f4\u3001\u771f\u5b9e\u4efb\u52a1\u8def\u7ebf\u3001\u6765\u6e90\u53ca\u540c\u4e00\u9009\u62e9\u5668\u7684\u9002\u7528\u7ed3\u679c\u3002\u5f53\u524d\u89c4\u5219\u4ecd\u5728\u5df2\u5b8c\u6574\u52a0\u8f7d\u96c6\u5408\u5185\u4e14\u672a\u65b0\u589e\u8981\u6c42\u65f6\uff0c\u53ef\u53ea\u91cd\u7ed1\u5f53\u524d\u64cd\u4f5c\uff0c\u4e0d\u8c03\u7528\u6b63\u6587\u88c5\u914d\u6216\u663e\u793a\uff1b\u5df2\u9000\u51fa\u7684\u64cd\u4f5c\u4e13\u5c5e\u89c4\u5219\u4e0d\u5e26\u5165\u65b0\u64cd\u4f5c\u4e49\u52a1\uff0c\u56e0\u8303\u56f4/\u5206\u7c7b\u6539\u53d8\u800c\u9000\u51fa\u7684\u89c4\u5219\u4e0d\u80fd\u5192\u5145\u64cd\u4f5c\u9000\u573a\u3002\u4fdd\u5b58\u7684\u65b0compact\u4ee5\u5f53\u524d\u5b8c\u6574selectedObligations\u7ed1\u5b9araw\u3001view\u3001identity\u53ca\u539fFINALIZE\uff1b\u5386\u53f2\u6d88\u8d39\u8005\u8bfb\u53d6\u539f\u51bb\u7ed3\u4e49\u52a1\uff0c\u4e0d\u4ee5\u4eca\u65e5policy\u91cd\u7b97\u65e7\u6210\u529f\u3002\u4e0d\u80fd\u5148\u88c5\u914d\u5168\u6587\u518d\u4ee5\u96f6\u8f93\u51fa\u58f0\u79f0\u590d\u7528\u3002\u65b0\u589e/\u91cd\u65b0\u8fdb\u5165\u9002\u7528\u89c4\u5219\u3001\u5fc5\u8981\u6765\u6e90\u53d8\u5316\u6216\u6b63\u6587\u4e0d\u786e\u5b9a\u65f6\u8fd4\u56deRULE_LOAD_REQUIRED\uff0c\u91cd\u65b0DISCOVER\u53d6\u5f97\u5f53\u524d\u5168\u90e8\u6b63\u6587\u3002\u8be5\u8fb9\u754c\u4e0d\u6269\u65e7\u5305\u6743\u9650\u3001\u4e0d\u627f\u63a5\u672a\u6765\u52a8\u4f5c\uff0c\u4e5f\u4e0d\u65b0\u589e\u7f13\u5b58\u3001\u53f0\u8d26\u6216\u6a21\u578b\u8bb0\u5fc6\u8bc1\u660e\uff1b\u7cbe\u786e\u652f\u6301\u8303\u56f4\u53d6TOOL_CONTRACT\u3002\n\n\u6a21\u578b\u89c6\u56fe\u4ee5\u5355\u4e00text\u8f93\u51fa\u6a21\u5f0f\u3001\u771f\u5b9e\u517c\u5bb9\u8bf4\u660e\u4e0e\u9650\u5236\u3001\u77ed\u6765\u6e90\u3001\u6bcf\u89c4\u5219\u6709\u5e8f\u77ed\u5f15\u7528\u548c\u5f53\u524d\u4e49\u52a1\uff1b\u540c\u6b21\u5fc5\u8981\u5b8c\u6574\u6b63\u6587\u53ea\u663e\u793a\u4e00\u6b21\uff0c\u4e0d\u88c1\u526a\u6761\u4ef6\u3001\u4f9d\u8d56\u6216\u91cd\u53e0\u6b63\u6587\u3002\u673a\u5668\u6765\u6e90\u7d22\u5f15\u7559\u7a0b\u5e8f\u4fa7\u3002\u8c03\u7528\u524d\u4e3a\u5916\u5c42\u7f16\u6392\u548c\u5185\u5c42\u547d\u4ee4\u6309\u5b8c\u6574\u6b63\u6587\u5206\u522b\u7559\u8db3\u9884\u7b97\uff0c\u63d0\u5347\u5185\u5c42\u4e0d\u6539\u53d8\u5916\u5c42\uff1b\u53ea\u66b4\u9732\u4e00\u4efd\u5b98\u65b9text\uff0c\u4e0d\u6df7\u5165\u673a\u5668JSON\u6216\u5176\u4ed6\u957f\u8f93\u51fa\u3002\u9ed8\u8ba4\u4e00\u6b21\u5b8c\u6574\u8f93\u51fa\uff1b\u5b9e\u9645\u5bbf\u4e3b\u622a\u65ad\u65f6\u4ece\u540c\u4e00\u7ed3\u679c\u8865\u8bfb\u771f\u5b9e\u7f3a\u5931\u7684\u5b8c\u6574\u5355\u5143\u53ca\u4e49\u52a1\uff0c\u4e0d\u4e3b\u52a8\u5206\u9875\u3001\u4e0d\u5efa\u9875\u7968\u636e\u3001\u4e0d\u91cd\u8dd1\u9009\u62e9\u3002\u5931\u8d25\u548c\u672a\u77e5\u4fdd\u7559\uff0c\u4e0d\u80fd\u53d8\u6210\u7a7a\u89c4\u5219\u6210\u529f\u3002summary\u3001hash\u3001\u65e7receipt\u6216\u673a\u68b0PASS\u4e0d\u80fd\u66ff\u4ee3\u5b9e\u9645\u7f3a\u5931\u6b63\u6587\u3002\n\n\u5b9e\u9645\u5bbf\u4e3b\u8de8\u8fdb\u7a0b\u7f16\u7801/\u8f93\u51fa\u9650\u5236\u9700\u8981\u65f6\uff0c\u6309TOOL_CONTRACT\u5728\u540c\u6b21DISCOVER\u663e\u5f0f\u4fdd\u7559\u5b98\u65b9UTF-8 text\u526f\u672c\uff08DisplayPath\uff09\uff1b\u673a\u5668AsJson\u7531\u7a0b\u5e8f\u6355\u83b7\uff0c\u4e0d\u6253\u5370\u7ed9\u6a21\u578b\u3002\u8865\u6587\u53ea\u6d88\u8d39\u540c\u4e00\u7ed3\u679c/\u5b98\u65b9\u526f\u672c\uff0c\u4e0d\u91cd\u8dd1\u89e3\u6790\u6216\u91cd\u626b\u9879\u76ee\u6e90\u6587\u4ef6\uff1b\u9ed8\u8ba4\u4e0d\u4fdd\u5b58\u3001\u4e0d\u5206\u9875\uff0c\u6700\u540e\u6d88\u8d39\u8005\u5b8c\u6210\u6309\u539fruntime\u751f\u547d\u5468\u671f\u91ca\u653e\u3002\u65e7\u56fa\u5b9a\u7248\u672c\u4f7f\u7528\u540c\u6b21AsJson\u7ed3\u679c\u53ca\u539f\u5b98\u65b9renderer\uff0c\u4e0d\u70ed\u6539\u8fd0\u884c\u5305\u3002\n\n\u8f93\u5165\u3001compact\u3001continuation\u53ca\u6b63\u5f0f\u8bc1\u636e\u7684\u5b58\u653e/\u6e05\u7406\u53d6TOOL_CONTRACT\uff1b\u6700\u540e\u6d88\u8d39\u8005\u672a\u5b8c\u6210\u524d\u4fdd\u7559\u5176\u539f\u5f15\u7528\u3002\u8fd9\u91cc\u4e0d\u65b0\u589e\u7f13\u5b58\u53f0\u8d26\u3001\u610f\u56fe\u670d\u52a1\u6216\u6a21\u578b\u8bf7\u6c42\u6b65\u9aa4\u3002\u7ed3\u6784\u901a\u8fc7\u4e0d\u8bc1\u660e\u8bed\u4e49\u6b63\u786e\u6216\u5b9e\u9645\u5bbf\u4e3b\u6267\u884c\u3002\n\u4ec5\u672c\u6b21\u5b9e\u9645NONE\u3001\u65e0\u5305\u65e0\u526f\u4f5c\u7528\uff0c\u5411\u5f53\u524dUSER\u4f5c\u666e\u901aPLAN/USER_RESPONSE\uff0c\u4e14\u65e0\u6b63\u5f0fReview/\u63a5\u53d7\u3001TASK_MESSAGE\u3001\u5173\u95ed/\u8d23\u4efb\u8f6c\u6362\u6216continuation\u6d88\u8d39\u8005\u65f6\uff0c\u53ef\u7701\u72ec\u7acb\u673a\u68b0FINALIZE\u3002\u5f53\u524d\u5fc5\u8981\u5b8c\u6574\u89c4\u5219\u4ecd\u5b9e\u9645\u8bfb\u53d6\uff0c\u4e8b\u5b9e/\u6765\u6e90/\u9650\u5236/\u672a\u77e5\u4ecd\u5982\u5b9e\u8bf4\u660e\uff1b\u4e0d\u4ea7\u751f\u5047PASS\u6216\u53ef\u88ab\u540e\u7ee7\u501f\u7528\u7684\u6210\u529f\u6536\u636e\u3002\u4efb\u4e00\u6761\u4ef6\u4e0d\u7b26\u4ecd\u8d70\u539f\u6536\u53e3\uff1bPROJECT_PREAUTHORIZED\u76f4\u63a5\u5de5\u5177\u8c03\u7528\u6309AUTHORIZATION_MODEL\u4fdd\u539f\u8fd4\u56de\u5e76\u81ea\u7136\u4ea4\u4ed8\uff0c\u4e0d\u4f2a\u9020\u673a\u68b0\u6536\u636e\u3002\u771f\u5b9eTASK_MESSAGE\u3001\u6b63\u5f0fReview/\u63a5\u53d7\u6216\u8d23\u4efb\u8f6c\u6362\u4ecd\u6ee1\u8db3\u5404\u81ea\u95e8\uff1b\u663e\u5f0fFINALIZE\u516c\u5171\u5165\u53e3\u4fdd\u6301\u4e25\u683c\u3002\n\n\u8d28\u91cf\u7b56\u7565\u542f\u7528\u4e0d\u6539\u53d8\u56fa\u5b9a\u8fd0\u884c\u6765\u6e90\u6216\u6062\u590d\u6743\u5a01\uff1b\u5f53\u524d\u4e0e\u539f\u6210\u529f\u5386\u53f2\u5206\u522b\u6309TOOL_CONTRACT\u6838\u7ed1\u5b9a\uff0c\u4e0d\u80fd\u7528\u4eca\u65e5policy\u91cd\u7b97\u65e7\u63a5\u53d7\uff0c\u4e5f\u4e0d\u56e0C\u800c\u7ed9\u53ea\u8bfb\u95ee\u9898\u9020\u5361\u3002\n"},{"unitKey":"384|E97C804869750E182404674A1F346192D3FFF5A1B94A12EC1D4E636351F432D0","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\AUTHORIZATION_MODEL.md","normativeIdentity":"344|EBB3B9162A703D0DAE832512600FF4DA14778A1CCF52016B4DD39268FC05D990","textIdentity":"228|24D7CF7CF517B288855FA679D1264EE66BEAB932F5F21CDD75D6517CF0852323","orderedDependencies":[],"fullText":"protected \u6216 excluded \u7684 read/hash/diff/index/write \u8fb9\u754c\u5fc5\u987b\u7cbe\u786e\u4e14 fail closed\u3002scope \u4e3a UNKNOWN \u6216 bounded helper \u4e0d\u53ef\u7528\u65f6\uff0c\u53ea\u8fd4\u56de\u6700\u7a84 blocker\uff1b\u4e0d\u5f97\u6269\u5927\u641c\u7d22\u3001\u4f7f\u7528\u7ed5\u884c\u8bfb\u53d6\u6216\u653e\u5bbd path set\u3002"},{"unitKey":"379|A997ED8389626405B5C2444527A117395D1727995D3790A4FB674108F25A2307","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\RECOVERY_CORE.md","normativeIdentity":"339|22602531BED162592E1A2D5126DEB34BC9382ABBAFD9C179979FB02F1C5298B1","textIdentity":"2479|81060587DC59382203844355AE4C70A215D686B19E0039B0159351D981A65B80","orderedDependencies":[],"fullText":"\u6062\u590d\u53ea\u8bc1\u660e\u5f53\u524d\u6743\u5a01\u53ca\u4e8b\u5b9e\uff0c\u4e0d\u6388\u4e88\u5199\u3001\u6d4b\u8bd5\u3001Review\u3001Git\u3001\u6d4f\u89c8\u5668/\u8bbe\u5907\u6216\u5916\u90e8\u6743\u9650\u3002\u5148\u4ece\u660e\u786e\u9879\u76ee\u6839\u53ca\u5176AGENTS\u8fdb\u5165\u56fa\u5b9aBOOTSTRAP\uff0c\u6821\u9a8c\u771f\u5b9e\u8def\u5f84\u548c\u62d3\u6251\uff1b\u666e\u901a\u975eGit\u9879\u76ee\u4e0d\u4ee5Git\u51b3\u5b9a\u9879\u76ee\u6839\u3002\u53ef\u9009GIT_WORKTREE\u6cbf\u539f\u4efb\u52a1descriptor\u9a8c\u8bc1\u552f\u4e00controlRoot\u4e0eexecutionRoot\uff0c\u65e7\u590d\u5236\u63a7\u5236\u6750\u6599\u4e0d\u80fd\u66ff\u4ee3\u539f\u6743\u5a01\uff1bMaintenance\u4ecd\u6309\u81ea\u5df1\u7684CONTROL/TARGET\u62d3\u6251\u89e3\u6790\u3002\n\n\u8bfb\u53d6\u5f53\u524dproject\u3001Controller\u3001\u6709\u6548\u7ea0\u6b63\u3001policy\u53ca\u5fc5\u8981\u91c7\u7528\u5b8c\u6210\u4e8b\u5b9e\uff0c\u4ece\u9879\u76eepin\u548c\u539fdistribution binding\u5b9a\u4f4d\u552f\u4e00\u56fa\u5b9a\u8fd0\u884c\u6765\u6e90\uff0c\u6838\u5bf9TOOLCHAIN\u3002\u5f00\u53d1HEAD\u3001\u7f51\u7edc\u3001\u5176\u4ed6\u9879\u76ee\u6216\u4efb\u610f\u65b0\u5305\u4e0d\u4f5cfallback\u3002\u9996\u6b21/\u65b0\u6765\u6e90\u987b\u5b8c\u6574\u8d44\u683c\u9a8c\u8bc1\uff1b\u666e\u901a\u5df2\u91c7\u7528\u6765\u6e90\u6838\u771f\u5b9e\u5f53\u524d\u5b8c\u6210\u94fe\u3001\u72ec\u7acb\u56fa\u5b9a\u7ed1\u5b9a\u3001manifest\u539f\u59cb\u8eab\u4efd\u4e0e\u58f0\u660e\uff0c\u4ee5\u53ca\u5b9e\u9645\u6d88\u8d39\u7684\u5b9e\u73b0/catalog/\u89c4\u5219\u548c\u5fc5\u8981\u4f9d\u8d56\uff0c\u4e0d\u9012\u5f52\u626b\u63cf\u672a\u6d88\u8d39\u6d4b\u8bd5\u3001\u5386\u53f2\u6216\u5176\u4ed6\u5305\u6210\u5458\uff0c\u4e5f\u4e0d\u4ee5\u8f7b\u91cf\u4e8b\u5b9e\u58f0\u79f0\u5168\u5305\u5065\u5eb7\u3002\u5b8c\u6574\u91c7\u7528\u3001\u8d44\u683c\u548c\u5206\u53d1\u9a8c\u8bc1\u4ecd\u5b8c\u6574\u6838\u5305\uff0c\u4e0d\u628a\u58f0\u660e\u5408\u6210\u4e3a\u5b8c\u6574Facts\u6216\u65b0Proof\uff1b\u4e0d\u52a0\u8de8\u8bf7\u6c42\u7f13\u5b58\u3002\u5f31\u7ed1\u5b9a\u3001\u4ec5\u6807\u8bb0true\u6216\u5b9e\u9645\u6f02\u79fb\u5747\u4e0d\u8db3\uff0c\u672a\u5b8c\u6210\u91c7\u7528\u5148\u6062\u590d\u539f\u4e8b\u52a1\u3002\n\n\u5df2\u77e5taskId\u76f4\u63a5\u8bfb\u8be5\u5361\u53ca\u5fc5\u8981\u9879\u76ee\u4e8b\u5b9e\uff0c\u672a\u77e5\u624d\u8bfb\u7d22\u5f15\u5b9a\u4f4d\uff1bSTATUS\u6309\u5168\u5c40\u4e8b\u5b9e\u5b9e\u9645\u9700\u8981\u8bfb\u53d6\u3002\u7ed1\u5b9a\u5f53\u524d\u8bf7\u6c42\u3001Owner\u3001\u771f\u5b9eactor/role/phase\u3001profile\u3001\u52a8\u4f5c/\u7ed3\u679c\u3001\u7cbe\u786e\u8303\u56f4/\u4fdd\u62a4\u3001\u80fd\u529b\u548c\u9002\u7528Review\u8981\u6c42\uff1b\u65e0\u9002\u7528\u4efb\u52a1\u7684\u53ea\u8bfb\u95ee\u9898\u7528PROJECT_READ_ONLY\uff1b\u9879\u76ee\u5df2\u660e\u786e\u9884\u6388\u6743\u7684\u666e\u901a\u5916\u90e8\u5de5\u5177\u8bf7\u6c42\u7528PROJECT_EXTERNAL\u52a0\u8f7d\u771f\u5b9eEXTERNAL\u610f\u56fe\uff0c\u4e0d\u6539\u79f0NONE\u6216\u7f16\u9020\u4efb\u52a1\u3002\u4e24\u8005\u90fd\u53ea\u53d6\u5f97\u89c4\u5219\uff0c\u4e0d\u6267\u884c\u5de5\u5177\u6216\u4ea7\u751f\u52a8\u4f5c\u51c6\u5165\u3002DISCOVER\u524d\u7531\u5f53\u524d\u6a21\u578b\u6309TOOL_CONTRACT\u552f\u4e00IntentEnvelope\u6bb5\u5f62\u6210\u771f\u5b9e\u610f\u56fe\uff0c\u518d\u6309PR_PROCESS_REQUIREMENTS_PROGRESSIVE_BOUNDARIES\u52a0\u8f7d\u6b63\u6587\u3002\n\n\u65b0\u4e8b\u5b9e\u53ea\u91cd\u5efa\u53d7\u5f71\u54cd\u6765\u6e90\u3001\u51b3\u5b9a\u6216\u6b63\u6587\uff1b\u538b\u7f29/\u6362\u4e3b\u4f53/\u6b63\u6587\u4e0d\u786e\u5b9a\u987b\u5b8c\u6574\u6062\u590d\u5f53\u524d\u5fc5\u9700\u6b63\u6587\uff0c\u5065\u5eb7\u8c03\u7528\u4e0d\u9010\u6b65FULL_COLD\u3002LOAD_PLAN_RESOLVE\u53ea\u670d\u52a1\u652f\u6301\u6750\u6599\u3001Framework\u7ef4\u62a4\u8bf4\u660e\u3001\u539f\u517c\u5bb9\u6216\u65e0\u6cd5\u8bc1\u660e\u6620\u5c04\u65f6\u7684\u6709\u754c\u6a21\u5757\u56de\u9000\uff0c\u4e0d\u7b5bcatalog\u6216\u7ed5\u4fdd\u62a4\u3002\u5b9e\u9645Git\u518d\u6838\u5bf9\u5e94\u4ed3\u5e93\u3002\u666e\u901a\u89c2\u5bdf\u4e0d\u53d6\u9879\u76ee/source\u534f\u8c03\u9501\uff0c\u4e0d\u81ea\u52a8\u91cd\u653epublication journal\uff1b\u771f\u5b9e\u4e8b\u52a1\u5199\u8005\u7ade\u4e89\u7684BUSY\u4fdd\u6301holder=UNKNOWN\uff0c\u6536\u8d77\u672c\u6b21\u5c1d\u8bd5\u3002\u663e\u5f0f\u76f8\u5173journal\u7684IN_PROGRESS\u6cbf\u539f\u6062\u590d\u5165\u53e3\uff1b\u4e0d\u5220\u540c\u6b65\u5bf9\u8c61\u3001\u6539pin\u6216\u8865\u8f7d\u5f00\u53d1\u6a21\u5757\u3002\u62a5\u544a\u771f\u5b9e\u4e0b\u4e00\u52a8\u4f5c\u53ca\u8bc1\u636e\u4e0a\u9650\u3002"},{"unitKey":"380|74AAAADFEE5CFD3AB299B7C38DF4260F60CF98A6D5B463E3B09EEA7FBDA97DA8","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"345|830058EC361FC75E456B012E5BD9BC348D338096DC40818798300D0F8DCC3128","textIdentity":"2361|9F7D0AFE529F34C44C7F01DA458DDA8F002B9A376E1623000242CCE6C73F53B3","orderedDependencies":[],"fullText":"\u62e5\u6709\u7684\u4ed3\u5e93\u5b57\u8282\u53d8\u5316\u5230\u5019\u9009\u3001\u63a5\u53d7\u6216\u4ea4\u4ed8\u8fb9\u754c\u65f6\uff0cOwner\u5728\u539f\u4efb\u52a1\u8bf4\u660e\u4ea7\u7269\u4e0eGit\u53bb\u5411\uff1aREADY\u542b\u5019\u9009/\u8def\u5f84\u3001\u8bc1\u636e\u548c\u5b9e\u9645closer\uff1bDEFERRED\u542b\u7406\u7531\u3001\u89e6\u53d1\u548c\u8d23\u4efb\uff1bEXCLUDED\u542b\u7406\u7531\u3002\u672a\u95ed\u5408\u8d23\u4efb\u5728\u540e\u7eedNONE\u7b54\u590d\u4ecd\u6709\u6548\uff0c\u5168\u7a0b\u53ea\u8bfb\u8c41\u514d\u3002Review/\u63a5\u53d7\u4e0d\u8bc1\u660eGit\u5c31\u7eea\uff0c\u4e0d\u666e\u904d\u65b0\u5efaGit\u4efb\u52a1\uff1b\u4ec5\u5b9e\u9645\u63a5\u6536\u8005\u6709\u4e0b\u4e00\u52a8\u4f5c\u624d\u53d1\u9001\u7ed3\u679c\u3002\n\n\u5148FINALIZE\u6587\u6863/\u4ea7\u7269\u52a8\u4f5c\uff0c\u518d\u4ee5\u5f53\u524d\u5361\u5355\u5bf9\u8c61CONTROL_WRITE\u66f4\u65b0\u4efb\u52a1\u3002\u666e\u901a\u5f53\u524d\u5361\u4e0e\u5176\u4ed6\u5bf9\u8c61\u6df7\u5408\u5199\u96c6\u4ecd\u62d2\u7edd\uff1b\u5f53\u524d\u5361\u5173\u95ed\u5e76\u7269\u7406\u5f52\u6863\u4ec5\u5141\u8bb8\u666e\u901a\u7eafCONTROL_WRITE\u7684\u7cbe\u786eactive+\u540cbasename archive\u4e24\u5bf9\u8c61\uff1aactive\u5b58\u5728\u65f6\u6838\u539f\u5305\u53ca\u524d\u50cf\u5e76\u51c6\u5165\uff0c\u5148\u5b8c\u6574\u4fdd\u5b58\u3001\u8bfb\u56de\u548c\u5b9e\u9645\u9a8c\u8bc1\u95ed\u5408archive\uff0c\u518d\u590d\u6838\u539factive\u540e\u5220\u9664\uff0c\u539fFINALIZE\u6d88\u8d39\u5df2\u9a8c\u8bc1\u7684\u5b9e\u9645archive\u8def\u5f84\uff0c\u6b63\u6587ID\u53ca\u539f\u903b\u8f91\u51c6\u5165\u4fdd\u6301\u3002\u5df2\u6709\u76f8\u540carchive\u53ef\u590d\u7528\uff0c\u4e0d\u540c\u5386\u53f2\u4ec5\u6309\u660e\u786e\u539f\u50cf\u5904\u7406\uff1b\u4e2d\u65ad\u7559\u4e24\u5f20\u6709\u6548\u5361\u6216\u5b8c\u6574archive\u53ef\u6cbf\u539f\u52a8\u4f5c\u8865\u5b8c\uff0c\u4e0d\u9020\u5f52\u6863\u4e8b\u52a1/\u5168\u5c40locator\u3002\u5176\u4ed6\u5408\u6cd5\u6587\u6863\u6279\u6b21\u3001schema1\u771f\u5b9e\u8d23\u4efb\u8f6c\u6362\u53ca\u4e13\u7528\u6839\u91c7\u7528\u6309\u81ea\u8eab\u5408\u540c\uff1b\u4e0d\u6cdb\u5316\u6df7\u5408\u5199\u3001missing\u6216\u7b2c\u4e09\u65b9\u8c41\u514d\u3002\n\nCLOSED\u5199\u660eSUCCESS\u3001CANCELLED\u6216SUPERSEDED\u3001\u5173\u95ed\u4f9d\u636e\u3001\u4ea7\u7269/Git\u53bb\u5411\u548c\u672a\u89e3\u4e49\u52a1\u627f\u63a5\uff0c\u5e76\u91ca\u653ewriter/reviewer/\u52a8\u4f5c\u6388\u6743\u3002SUCCESS\u6ee1\u8db3\u9002\u7528\u9a8c\u6536\uff1b\u53d6\u6d88/\u66ff\u4ee3\u4fdd\u7559\u5b9e\u9645\u672a\u5b8c\u6210\u9879\u4e0e\u51b3\u5b9a\uff0c\u7b49\u5f85/\u963b\u585e\u4fdd\u6301active\u3002\u65e7\u5361\u6309\u5176\u539f\u517c\u5bb9\u68c0\u67e5\uff0c\u4e0d\u6279\u91cf\u4f2a\u8865\u6210\u529f\u3002\u4efb\u52a1\u5361\u5173\u95ed/\u7269\u7406\u5f52\u6863\u3001\u8d23\u4efb\u91ca\u653e\u548c\u5bbf\u4e3b\u4f1a\u8bdd\u5f52\u6863\u5206\u522b\u6838\u5bf9\u3002\u6709\u9650\u6210\u679c\u5df2\u4ea4\u4ed8\u3001\u539f\u7ed3\u679c\u5df2\u88ab\u5b9e\u9645\u6d88\u8d39\u4e14\u4f1a\u8bdd\u65e0\u540e\u7eed\u804c\u8d23\u65f6\uff0c\u7531\u5b9e\u9645\u6536\u5c3e\u8d23\u4efb\u4eba\u5728\u5df2\u6709\u6743\u9650\u5185\u8c03\u7528\u5bbf\u4e3b\u5f52\u6863\u8be5\u4f1a\u8bdd\uff0c\u5e76\u6838\u5bf9\u771f\u5b9e\u8fd4\u56de\uff1b\u53ea\u5199CLOSED\u3001\u91ca\u653e\u6388\u6743\u6216\u6539\u6807\u9898\u4e0d\u7b97\u4f1a\u8bdd\u5df2\u5f52\u6863\u3002\u5f85\u9a8c\u6536\u3001\u4ecd\u6709\u540c\u9879\u8fd4\u4fee\u6216\u771f\u5b9e\u957f\u671f\u804c\u8d23\u65f6\u4fdd\u7559\u3002\u6743\u9650\u7f3a\u5931\u3001\u5931\u8d25\u6216UNKNOWN\u5982\u5b9e\u4fdd\u7559\u5e76\u4ea4\u5b9e\u9645\u8d23\u4efb\u8005\uff0c\u4e0d\u5ba3\u79f0\u5df2\u5b8c\u6210\uff0c\u4e0d\u6279\u91cf\u626b\u63cf\u6216\u64cd\u4f5c\u5386\u53f2\u4f1a\u8bdd\u3002\n\n\u539f\u4efb\u52a1\u81ea\u7136\u6536\u5c3e\u4e00\u6b21\u5904\u7406\u6b63\u5f0f\u6750\u6599\u6301\u4e45\u5f52\u5c5e\u3001\u6709\u6548\u5f15\u7528\u3001\u5df2\u77e5\u4e34\u65f6\u96c6\u5408\u548c\u672a\u89e3\u4f9d\u8d56\uff0c\u751f\u547d\u5468\u671f\u53d6TOOL_CONTRACT\uff1b\u4e0d\u6309\u76ee\u5f55\u5927\u5c0f/\u5e74\u9f84/\u5173\u95ed\u72b6\u6001\u63a8\u5b9a\u53ef\u5220\uff0c\u4e0d\u53e6\u5f00\u6e05\u7406\u6216\u7edf\u8ba1\u56de\u5408\u3002\u5df2\u6709\u8bf7\u6c42\u3001\u5de5\u5177\u3001\u52a0\u8f7d\u3001\u534f\u8c03\u3001\u8fd4\u5de5\u548c\u7528\u6237\u4ecb\u5165\u6570\u636e\u53ef\u7531\u6700\u540e\u6d88\u8d39\u8005\u540c\u6279\u63d0\u53d6\uff0c\u7f3a\u6570\u636e\u4fdd\u7559\u9650\u5236\uff0c\u4e0d\u8bbe\u8d39\u7528\u8bc1\u660e\u95e8\u3002"},{"unitKey":"379|72A4209264804D5B9E19F09E4FF68211BD32185E33FBE17C374A89AD574E2727","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"340|99797FD6D8D20E8A9FF0F63FE9252F212B330718DBBC45BDF0FEDB49651071EB","textIdentity":"675|2A5CD709B28BF4D18462C5F7E773EE3691DF7E1B64917E449C2004CD6D5F13BC","orderedDependencies":[],"fullText":"\u534f\u4f5c\u671f\u95f4\u4e0d\u4ee5wait_threads\u3001wait_agent\u6216\u53cd\u590d\u8bfb\u53d6\u804a\u5929\u3001\u72b6\u6001\u3001\u65e5\u5fd7\u7b49\u5f85\u5176\u4ed6\u4f1a\u8bdd\u3002\u6709\u5b89\u5168\u5de5\u4f5c\u5c31\u7ee7\u7eed\uff0c\u6ca1\u6709\u5c31\u7ed3\u675f\u5f53\u524d\u8f6e\uff0c\u771f\u5b9e\u7ed3\u679c\u9001\u8fbe\u540e\u7eed\u4f5c\u3002\u5bbf\u4e3b\u8981\u6c42\u65b0\u5efa\u540e\u9996\u6b21\u53d6\u5f97\u8fdb\u5ea6\u65f6\uff0c\u6309HOST\u7684\u4e00\u6b21\u6709\u754c\u89c2\u5bdf\u6267\u884c\uff0c\u672a\u5c31\u7eea\u4e0d\u8f6c\u4e3a\u6301\u7eed\u7b49\u5f85\u3002\u5df2\u542f\u52a8\u7684\u5f53\u524d\u547d\u4ee4/\u6d4b\u8bd5\u53ef\u7b49\u5f85\u81ea\u8eab\u5fc5\u8981\u7ed3\u679c\uff1b\u7528\u6237\u4e3b\u52a8\u67e5\u8be2\u53ef\u5355\u6b21\u8bfb\u53d6\u73b0\u72b6\u3002\n\n\u751f\u4ea7/\u81ea\u6d4b\u8f6c\u5165\u65b0\u7684\u4ea4\u5ba1\u5206\u6d3e\u662f\u7ec4\u7ec7\u4e8b\u5b9e\u53d8\u5316\uff0c\u6309PR_REVIEW_ROUTE_PREPARATION\u5904\u7406\u771f\u5b9e\u65b0\u610f\u56fe\u3001\u9009\u62e9\u53ca\u51c6\u5165\u3002\u76f8\u540c\u76ee\u6807\u7684\u5065\u5eb7\u6b63\u6587\u548c\u8bc1\u636e\u53ef\u590d\u7528\uff1b\u6ca1\u6709\u65b0\u5206\u6d3e\u4e0d\u91cd\u590d\u7ec4\u7ec7\u9009\u62e9\uff0c\u4e0d\u91cd\u505a\u5b8c\u6574\u6062\u590d\u6216\u5236\u9020\u7eaf\u8bb0\u8d26\u56de\u5408\u3002"},{"unitKey":"380|067F490BE10267E1167E593921B02F25FFDD105BB524C28F410AEF106EC5F52A","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\TASK_AND_SCOPE.md","normativeIdentity":"342|9053F67D60947808F2DA982D6EA13DBEEA4742F84827AA26C00650C7C6B1F65E","textIdentity":"3967|4114CDE02BE9886F8CFF91BF200E4B8420CB61CF45094F4FEF5D81D6B3EC6D22","orderedDependencies":[],"fullText":"\u5728\u5df2\u63a5\u53d7\u76ee\u6807\u3001\u7cbe\u786e\u6388\u6743\u4e0e\u4fdd\u62a4\u8303\u56f4\u5185\uff0c\u5148\u7406\u89e3\u771f\u5b9e\u673a\u5236\u3001\u76f4\u63a5\u6d88\u8d39\u8005\u53ca\u5931\u8d25\u6062\u590d\uff1b\u6709\u591a\u6761\u5b9e\u8d28\u53ef\u884c\u8def\u7ebf\u65f6\u6bd4\u8f83\u73b0\u6709\u5b9e\u73b0\u3001\u6807\u51c6\u5e93/\u5e73\u53f0\u3001\u5df2\u6388\u6743\u4f9d\u8d56\u548c\u5fc5\u8981\u65b0\u4ee3\u7801\u7684\u6b63\u786e\u6027\u53ca\u603b\u6210\u672c\uff0c\u9009\u62e9\u6700\u5c0f\u5145\u5206\u65b9\u6848\u3002\u590d\u7528\u4e0d\u5b89\u5168\u6216\u9002\u914d\u4ee3\u4ef7\u66f4\u9ad8\u65f6\u53ef\u6709\u636e\u6362\u7528\uff0c\u4e0d\u4e3a\u5047\u8bbe\u672a\u6765\u65b0\u589e\u673a\u5668\u3002\u6210\u679c\u7c7b\u522b\u53ca\u9a8c\u6536\u4ee5\u7528\u6237\u76ee\u6807\u4e3a\u51c6\uff0c\u5206\u6790\u3001\u6d4b\u8bd5\u6216\u539f\u578b\u4e0d\u66ff\u4ee3\u8bf7\u6c42\u7684\u6b63\u5f0f\u4ea7\u7269\u3002\u666e\u901a\u4f4e\u5f71\u54cd\u4fee\u590d\u4e0d\u65b0\u589e\u5199\u524d\u5ba1\u67e5\u6216\u8868\u5355\uff1b\u91cd\u5927\u5951\u7ea6/\u98ce\u9669/\u8303\u56f4\u51b2\u7a81\u53ea\u505c\u6b62\u53d7\u5f71\u54cd\u94fe\u3002\u5065\u5eb7\u5df2\u5ba1\u7ed3\u8bba\u590d\u7528\uff0c\u5b9e\u9645\u65b0\u589e\u8bc1\u636e\u624d\u91cd\u5f00\u3002MICRO\u540c\u6837\u9075\u5b88\u8fd9\u4e9b\u539f\u5219\uff0c\u4e0d\u56e0\u6b64\u52a0\u8f7d\u5b8c\u6574\u4efb\u52a1\u7ef4\u62a4\u7a0b\u5e8f\u3002\n\n\u901a\u7528\u89c4\u5219\u5f52\u7248\u672c\u3001\u9879\u76ee\u6807\u51c6\u5f52\u9879\u76ee\u3001\u65b9\u6848\u5f52\u4efb\u52a1\u3001\u79c1\u6709\u7b97\u6cd5\u5f52\u5b9e\u73b0\u3002\u53ea\u6709\u771f\u5b9e\u5916\u90e8\u6d88\u8d39\u8005\u3001\u517c\u5bb9\u3001\u5b89\u5168\u3001\u786e\u5b9a\u6027\u6216\u5916\u90e8\u6027\u80fd\u627f\u8bfa\u9700\u8981\uff0c\u624d\u628a\u5b9e\u73b0\u673a\u5236\u63d0\u5347\u4e3a\u516c\u5171\u5408\u540c\uff1b\u6d4b\u8bd5\u65b9\u4fbf\u4e0d\u662f\u7406\u7531\uff0c\u5f15\u7528\u4e0d\u5f62\u6210\u7b2c\u4e8c\u6743\u5a01\u3002\u58f0\u79f0\u5b9e\u73b0\u5df2\u63a5\u53d7\u5951\u7ea6\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u7ed1\u5b9a\u5f53\u524d\u6743\u5a01\u3001\u8d1f\u8d23\u63a5\u70b9\u3001\u76f4\u63a5\u6d88\u8d39\u8005/\u6d4b\u8bd5\u4e0e\u8bc1\u636e\uff1b\u6765\u6e90\u5b9e\u8d28\u53d8\u5316\u5148\u91cd\u7ed1\u3002\u5141\u8bb8\u8f7b\u91cf @design-contract <locator> \u5b9a\u4f4d\u539f\u8bbe\u8ba1\u5e76\u4fdd\u7559\u9879\u76ee\u5df2\u6709\u5408\u7406\u6807\u8bb0\uff1b\u4e0d\u590d\u5236\u8bed\u4e49\u3001\u54c8\u5e0c\u6216\u901a\u8fc7\u72b6\u6001\uff0c\u4e0d\u58f0\u79f0\u6807\u8bb0\u8bc1\u660e\u5b9e\u73b0\u4e00\u81f4\uff0c\u4e0d\u8981\u6c42\u5168\u4ed3\u8865\u6807\u3001\u53f0\u8d26\u6216\u626b\u63cf\u3002\u6280\u672f\u4e8b\u5b9e\u5148\u6709\u754c\u67e5\u8bc1\uff0c\u53ea\u628a\u5b9e\u8d28\u76ee\u6807\u3001\u8303\u56f4\u3001\u6743\u9650\u6216\u98ce\u9669\u53d6\u820d\u4ea4\u7528\u6237\uff1b\u4e2d\u95f4\u56de\u7b54\u4e0d\u662f\u6574\u6848\u6388\u6743\uff0c\u4ecd\u6709\u6548\u51b3\u5b9a\u4e0d\u91cd\u590d\u786e\u8ba4\u3002\u91cd\u5927\u51b2\u7a81\u4e0e\u5fc5\u8981\u7528\u6237\u53d6\u820d\u5df2\u89e3\u51b3\u3001\u5269\u4f59\u5047\u8bbe\u6709\u754c\u4e14\u53ef\u9a8c\u8bc1\u548c\u6062\u590d\u65f6\uff0c\u65b9\u6848\u8db3\u591f\u5c31\u7eea\uff0c\u6cbf\u73b0\u6709\u6388\u6743\u63a8\u8fdb\uff1b\u672a\u5904\u7406\u91cd\u5927\u51b2\u7a81\u53ea\u505c\u53d7\u5f71\u54cd\u94fe\u3002\u6309\u5b9e\u9645 Review profile \u4fdd\u7559\u5fc5\u8981\u5ba1\u6838\uff0c\u666e\u901a\u4f4e\u5f71\u54cd\u4fee\u590d\u4e0d\u65b0\u589e\u5199\u524d\u5ba1\u6838\u9636\u6bb5\u3002\n\n\u53d8\u66f4\u5b9e\u9645\u5f71\u54cd\u73b0\u884c\u5951\u7ea6\u6216\u8bf4\u660e\u65f6\uff0c\u5728\u539f\u4efb\u52a1\u5b9a\u4f4d\u53d7\u5f71\u54cd\u5b8c\u6574\u6b63\u6587\u3001\u7ef4\u62a4\u8005\u3001\u57fa\u7ebf\u548c\u76f4\u63a5\u4f9d\u8d56\uff0c\u4fdd\u7559\u6761\u4ef6\u3001\u4f8b\u5916\u53ca\u5e76\u53d1\u6709\u6548\u53d8\u66f4\uff0c\u5f62\u6210\u5408\u5e76\u540e\u5019\u9009\uff1b\u589e\u91cf\u4e0d\u4ee3\u66ff\u539f\u6587\uff0c\u89c4\u683c\u9884\u671f\u4e0d\u4ee3\u66ff\u5b9e\u73b0\u8bc1\u636e\u3002\u5fc5\u8981\u89c4\u8303\u5019\u9009\u968f\u6210\u679c\u5728\u9002\u7528\u5ba1\u6838\u548c\u63a5\u53d7\u524d\u51c6\u5907\uff0cOwner\u6309\u539f\u5408\u540c\u63a5\u53d7\u7cbe\u786e\u5019\u9009\uff1b\u540e\u7eed\u5fc5\u8981\u5199\u5165\u3001\u751f\u6548\u3001\u53d1\u884c\u6216\u91c7\u7528\u4ecd\u9700\u5bf9\u5e94\u6388\u6743\u3002\u843d\u5730\u524d\u590d\u6838\u57fa\u7ebf\uff0c\u65b0\u589e\u8bed\u4e49\u6216\u51b2\u7a81\u987b\u91cd\u7ed1\u5019\u9009\u5e76\u590d\u6838\u53d7\u5f71\u54cd\u90e8\u5206\uff0c\u4e0d\u4ee5\u201c\u540c\u6b65\u201d\u53d1\u5e03\u672a\u5ba1\u53d8\u5316\u3002\u672a\u5b8c\u6210\u672c\u6279\u627f\u8bfa\u7684\u89c4\u8303\u7ef4\u62a4\u4e0d\u5ba3\u79f0\u8be5\u9879\u5b8c\u6210\uff1b\u5408\u6cd5\u540e\u7f6e\u4e8b\u9879\u4fdd\u7559\u771f\u5b9e\u524d\u7f6e\u548c\u539f\u8d23\u4efb\u3002\u6309\u5b9e\u9645\u5f71\u54cd\u89e6\u53d1\uff0c\u4e0d\u5f3a\u5236\u65b0\u5efa\u89c4\u683c\u3001\u52a0\u8f7d\u65b9\u6cd5\u6216\u5168\u5e93\u626b\u63cf\uff1b\u5019\u9009\u5df2\u5728\u6700\u7ec8\u76ee\u5f55\u65f6\u4e0d\u8981\u6c42\u63a5\u53d7\u540e\u518d\u590d\u5236\u3002\u53ef\u9009\u8f6f\u4ef6\u8868\u8fbe\u89c1[\u8f6f\u4ef6\u884c\u4e3a\u89c4\u683c\u4e0e\u53d8\u66f4](knowledge/software/BEHAVIOR_SPEC_CHANGE.md)\u3002\n\n\u9047\u771f\u5b9e\u5931\u8d25\u3001\u4e13\u4e1a\u4e0d\u786e\u5b9a\u6027\u6216\u77e5\u8bc6\u7f3a\u53e3\u65f6\uff0c\u539f\u53c2\u4e0e\u8005\u5728\u539f\u4efb\u52a1\u5148\u533a\u5206\u5df2\u77e5\u7f3a\u9677\u3001\u4f7f\u7528\u504f\u5dee\u3001\u8d44\u6599/\u80fd\u529b\u4e0d\u8db3\u548c\u89c4\u5219\u51b2\u7a81\uff1b\u5df2\u6709\u77e5\u8bc6\u5145\u5206\u5219\u76f4\u63a5\u5e94\u7528\uff0c\u57fa\u7840\u4e0d\u8db3\u53ef\u6309\u76ee\u6807\u7cfb\u7edf\u8865\u5b66\u3002\u6309\u6b20\u7f3a\u7684\u5224\u65ad\u9009\u62e9\u5185\u5bb9\u4e0e\u6765\u6e90\uff0c\u5206\u6e05\u5b9e\u9645\u9605\u8bfb\u3001\u4e13\u4e1a\u89e3\u91ca\u3001\u5f85\u9a8c\u5efa\u8bae\u548c\u771f\u5b9e\u6548\u679c\uff1b\u5173\u952e\u51b2\u7a81\u6216\u80fd\u529b\u7f3a\u53e3\u53ea\u9650\u5236\u53d7\u5f71\u54cd\u51b3\u5b9a\u3002\u5c06\u4f9d\u636e\u843d\u5b9e\u4e3a\u5177\u4f53\u5224\u65ad/\u52a8\u4f5c\u3001\u4e8b\u524d\u9884\u671f\u53ca\u5bf9\u5e94\u9a8c\u8bc1\uff0c\u7531Owner\u6d88\u8d39\u7ed3\u679c\uff0c\u6309\u9700\u5b89\u6392\u6709\u754c\u4e13\u5bb6\u53ca\u5177\u5907\u4e13\u4e1a/\u5de5\u5177\u80fd\u529b\u7684\u9a8c\u8bc1\u8005\uff0c\u72ec\u7acb\u5ba1\u6838\u4ecd\u6ee1\u8db3\u539f\u72ec\u7acb\u6027\u3002\u5df2\u6709\u89c4\u5219\u5145\u5206\u5219\u7559\u6709\u4ef7\u503c\u6848\u4f8b\uff0c\u786e\u6709\u4e49\u52a1\u7f3a\u53e3\u624d\u6cbf\u539f\u89c4\u5219\u53d8\u66f4\u95e8\u4fee\u8ba2\uff1b\u6c89\u6dc0\u4fdd\u7559\u6761\u4ef6\u3001\u5931\u8d25\u3001\u672a\u77e5\u3001\u7ef4\u62a4\u8d23\u4efb\u548c\u4e0b\u6b21\u5165\u53e3\u3002\u4e0a\u8ff0\u4efb\u52a1\u8d23\u4efb\u4e0d\u4f9d\u8d56\u542f\u7528KNOWLEDGE_REFERENCE\u6216\u52a0\u8f7dMETHOD\uff1b\u4e0d\u589e\u52a0\u666e\u904d\u7814\u7a76\u8868\u5355\u3001\u5e38\u9a7b\u961f\u4f0d\u3001\u6bcf\u9898\u8054\u7f51\u6216\u989d\u5916\u6a21\u578b\u8bf7\u6c42\u3002\u5b8c\u6574\u53ef\u9009\u65b9\u6cd5\u89c1[\u95ee\u9898\u9a71\u52a8\u6539\u8fdb](knowledge/cross-domain/PROBLEM_DRIVEN_IMPROVEMENT.md)\uff0c\u4ec5\u5728\u5b9e\u9645\u9700\u8981\u65f6\u8bfb\u53d6\u3002\n\n\u5177\u4f53\u8f6f\u4ef6\u8bbe\u8ba1\u3001\u5b9e\u73b0\u548c\u6d4b\u8bd5\u65b9\u6cd5\u7531\u9879\u76ee\u9009\u62e9\u7684\u5b8c\u6574\u6807\u51c6\u63d0\u4f9b\uff1bFramework\u968f\u5305\u53ef\u9009\u6b63\u6587\u89c1standards/README.md\uff0c\u672a\u91c7\u7528\u4e0d\u81ea\u52a8\u8fdb\u5165\u89c4\u5219\u96c6\u5408\u3002\u751f\u4ea7\u548c\u5ba1\u6838\u5bf9\u540c\u4e00\u6210\u679c\u6d88\u8d39\u540c\u4e00\u9002\u7528\u4e13\u4e1a\u8981\u6c42\uff0c\u804c\u8d23\u7a0b\u5e8f\u4ecd\u6309\u5404\u81ea\u89d2\u8272\u9009\u62e9\u3002"},{"unitKey":"382|4EC4D6338AF443B019ECF9FD99E83D90430FDC2BE7FF3855A41ECA1CA30926FB","sourceKind":"FRAMEWORK","sourceLocator":"C:\\Users\\zheng\\AppData\\Local\\Temp\\g-c8620c49\\aiw-int-p-bc92eadce6444238a81ce929094b31e5\\external-completion-tool\\framework\\versions\\2.0.0\\GIT_AND_EXTERNAL.md","normativeIdentity":"349|7B4E55157B2466CE61E55DF35FD7F8C92B4BE65C9568F23F4D6539CD503C48F7","textIdentity":"3433|EF086205B5EE332D4F346AA9E34B1B5D8C5F0713A54ED767B74B02C8D437BDD8","orderedDependencies":[],"fullText":"\u9879\u76eeexternalAuthorization\u7f3a\u7701PER_ACTION\u3002\u663e\u5f0fPROJECT_PREAUTHORIZED\u5f15\u7528\u65e2\u6709\u9879\u76ee\u8bb8\u53ef\u89c4\u5219\uff0c\u53ea\u6709\u672c\u6d3b\u52a8\u5b9e\u9645\u9002\u7528\u4e14\u5f53\u524d\u4ecd\u8986\u76d6\u8be5\u8c03\u7528\u65f6\uff0c\u6267\u884c\u8005\u76f4\u63a5\u8c03\u7528\u539f\u5de5\u5177\uff1b\u65e0\u9700\u9010\u6b21\u65b0\u5361\u3001\u52a8\u4f5c\u5305\u6216\u6a21\u578bD/A/F\u3002\u5de5\u5177/provider\u3001\u64cd\u4f5c\u3001\u8d26\u53f7/\u6570\u636e\u3001\u8d39\u7528/\u5171\u4eab\u8d44\u6e90\u3001\u53ef\u6267\u884c\u548c\u59d4\u6d3e\u8005\u3001\u91cd\u8bd5/\u505c\u6b62/\u6062\u590d\u7531\u9879\u76ee\u6b63\u6587\u51b3\u5b9a\uff0c\u4e0d\u53e6\u5efa\u6846\u67b6\u8bb8\u53ef\u5f15\u64ce\u3002\u539f\u5de5\u5177/\u5bbf\u4e3b\u8fd4\u56de\u4fdd\u5b9e\u9645\u8bf7\u6c42\u3001\u6b21\u6570\u3001\u8d44\u6e90\u3001\u8f93\u51fa\u4e0eSUCCESS/FAILURE/UNKNOWN\uff1b\u5f53\u524d\u6210\u679c\u7684\u4e13\u4e1a\u9a8c\u6536\u53e6\u6309\u9879\u76ee\u8981\u6c42\u5b8c\u6210\u3002\u672a\u77e5\u6d88\u8d39\u4e0d\u76f2\u91cd\u53d1\uff0c\u4e0d\u80fd\u628a\u540e\u7eed\u653f\u7b56\u53d8\u5316\u5f53\u4f5c\u62b9\u53bb\u5df2\u53d1\u751f\u4e8b\u5b9e\u6216\u5141\u8bb8\u518d\u6b21\u8c03\u7528\u7684\u4f9d\u636e\u3002\n\n\u4ee5\u4e0bbinding1/2\u53ca\u6279\u6b21\u5b57\u6bb5\u7528\u4e8ePER_ACTION\u6216\u660e\u786e\u9009\u62e9\u539f\u6309\u6b21\u5165\u53e3\u7684\u52a8\u4f5c\u3002TASK_OWNER\u53ef\u5728\u5f53\u524d\u9886\u57df\u8d23\u4efb\u548c\u771f\u5b9e\u65e2\u6709\u7528\u6237/\u9879\u76ee\u8d44\u6e90\u8bb8\u53ef\u5185\uff0c\u4e3a\u6709\u9650\u3001\u6709\u5e8f\u4e14\u53ef\u9a8c\u6536\u7684EXTERNAL\u6279\u6b21\u7b7e\u7eaf\u52a8\u4f5c\u5305\u3002\u65e7FREE/0\u5206\u652f\u4fdd\u6301\uff1bexternalBinding2\u53ef\u5f15\u7528\u5df2\u6279\u51c6\u4ed8\u8d39\u6216\u5171\u4eab\u8d44\u6e90\u7684grantRefs\uff0c\u524d\u63d0\u662f\u672c\u6b21\u7528\u9014\u3001provider\u3001\u64cd\u4f5c\u3001payload\u53ca\u539f\u8bb8\u53ef\u5b9e\u9645\u7ea6\u675f\u5b8c\u6574\u53ef\u6838\u5bf9\u3002\u672a\u89c4\u5b9a\u91d1\u989d\u3001\u5e01\u79cd\u6216\u5230\u671f\u65e5\u4e0d\u81ea\u52a8\u7b97UNKNOWN\uff0c\u4e5f\u4e0d\u63a8\u5bfc\u65e0\u9650\u989d\u5ea6\uff1b\u53ea\u6821\u9a8c\u539f\u8bb8\u53ef\u5b9e\u9645\u89c4\u5b9a\u4e14\u672c\u6b21\u4f9d\u8d56\u7684\u6761\u4ef6\u3002\n\n\u540c\u4e00\u6210\u679c\u7684\u65e2\u6709\u8d44\u6e90\u8bb8\u53ef\u4ecd\u6709\u6548\u4e14\u660e\u786e\u5141\u8bb8Owner\u59d4\u6d3e\u65f6\uff0cOwner\u53ef\u76f4\u63a5\u7b7e\u7ed9\u5177\u540d\u539f\u4e13\u4e1a\u6267\u884c\u8005\uff0c\u590d\u7528grantee\u53ca\u539fgrantRefs\uff1bexternalBinding2\u7684grantAssessment\u987b\u660e\u786edelegationPermitted=true\u3002\u7701\u7565\u6216false\u4e0d\u6388\u59d4\u6d3e\uff0c\u65e7binding1\u4ecd\u4ec5Owner\u81ea\u7528\u3002binding2\u4e0bOwner\u4e3b\u8def\u7ebf\u4ecd\u987bactor=Owner\u3001role=TASK_OWNER\uff0c\u4f46\u53ef\u4fdd\u6709\u5f53\u524d\u5408\u6cd5\u4e3bphase\uff1bOwner\u4eb2\u81ea\u6267\u884c\u7684\u6709\u6548\u9636\u6bb5\u4e3aEXTERNAL\uff0c\u5177\u540d\u6267\u884c\u8005\u6309\u4e34\u65f6EXECUTOR/EXTERNAL\u6d88\u8d39\u3002\u5b8c\u6574\u6388\u6743\u5148\u6838\u5bf9\uff0c\u4e24\u8005\u5747\u4e0d\u6539\u53d8Owner\u3001Work route\u6216\u7236\u4efb\u52a1\uff1bbinding1\u4fdd\u7559Owner\u4e3b\u9636\u6bb5EXTERNAL\u53caFREE/0\u65e7\u7ea6\u675f\u3002Owner\u53ca\u63a5\u6536\u8005\u987b\u6838\u539f\u8bb8\u53ef\u7684\u59d4\u6d3e\u8303\u56f4\u3001\u5b9e\u9645\u8d26\u53f7\u3001\u8d39\u7528\u3001\u5171\u4eab\u6761\u4ef6\u4e0e\u5f53\u524d\u64a4\u56de/\u51b2\u7a81\u4e8b\u5b9e\uff1b\u8be5\u58f0\u660e\u4ec5\u4e3aINSTRUCTION_BOUND\u5224\u65ad\uff0c\u4e0d\u662f\u673a\u68b0\u8bed\u4e49\u8bc1\u660e\u3001\u7528\u6237\u8ba4\u8bc1\u6216\u65b0\u8bb8\u53ef\u3002\u8bb8\u53ef\u7981\u8f6c\u6388\u3001\u672a\u77e5\u6216\u9879\u76ee\u4fdd\u7559\u51b3\u5b9a\u4ea4\u5b9e\u9645\u6709\u6743\u8005\uff0c\u4e0d\u9760\u4e3b\u63a7\u7eaf\u8f6c\u7b7e\u6216\u63d0\u5347\u6267\u884c\u8005\u4e3aOwner\u7ed5\u8fc7\u3002\n\n\u6279\u6b21\u7ed1\u5b9a\u7cbe\u786epayload/\u8f93\u51fa\u7528\u9014\u3001\u5fc5\u8981\u6570\u91cf\u4e0e\u91cd\u8bd5\u4e0a\u9650\u3001\u505c\u6b62\u53ca\u6062\u590d\u6761\u4ef6\uff1b\u6ca1\u6709\u9879\u76ee\u6570\u636e\u7684\u64cd\u4f5c\u4ec5\u6309TOOL_CONTRACT\u5c01\u95edZERO_PROJECT_DATA\u7c7b\u522b\u5904\u7406\u3002\u6279\u51c6\u8d44\u6599\u8bfb\u53d6\u4e0d\u81ea\u52a8\u6279\u51c6\u4e0a\u4f20\u6216\u6b63\u5f0f\u8d44\u4ea7\u6fc0\u6d3b\u3002ONE_LOGICAL_ATOMIC_EXECUTION\u53ea\u8868\u793a\u6709\u9650\u6709\u5e8f\u6cbb\u7406\u6279\u6b21\uff0c\u4e0d\u627f\u8bfa\u4f9b\u5e94\u5546\u7269\u7406\u4e8b\u52a1\uff1breissuable=false\u4e0d\u62b9\u53bb\u539f\u8bb8\u53ef\u660e\u786e\u7684\u6bcf\u64cd\u4f5c\u6709\u9650\u91cd\u8bd5\uff0c\u4f46\u7981\u6b62\u6574\u4e2a\u672a\u77e5\u6279\u6b21\u76f2\u91cd\u53d1\u3002UNKNOWN\u53ea\u6