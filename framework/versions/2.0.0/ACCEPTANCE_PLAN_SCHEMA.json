{
  "required": [
    "schemaVersion",
    "stages"
  ],
  "type": "object",
  "title": "AI Workspace acceptance plan 1",
  "$defs": {
    "evidenceConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "originalFinalize"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "CURRENT_CANDIDATE",
            "HISTORICAL_SUCCESS"
          ]
        },
        "originalFinalize": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputRef",
              "resultRef"
            ],
            "properties": {
              "inputRef": {
                "$ref": "#/$defs/objectRef"
              },
              "resultRef": {
                "$ref": "#/$defs/objectRef"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "CURRENT_CANDIDATE"
              }
            }
          },
          "then": {
            "properties": {
              "originalFinalize": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "originalFinalize": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "objectRef": {
      "required": [
        "path",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^\\d+\\|[A-F0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "type": "object"
    },
    "requirementsRef": {
      "required": [
        "path",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^\\d+\\|[A-F0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
        }
      },
      "type": "object"
    },
    "evidenceRef": {
      "required": [
        "path",
        "identity",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^\\d+\\|[A-F0-9]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "SELF_CHECK",
            "REVIEW_VERDICT",
            "RESULT_ACCEPTANCE"
          ]
        }
      },
      "type": "object"
    },
    "candidateRef": {
      "required": [
        "path",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "pattern": "^(?:\\d+\\|[A-F0-9]{64}|MISSING)$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "stages": {
      "maxItems": 128,
      "minItems": 0,
      "items": {
        "required": [
          "id",
          "kind",
          "requiredBy",
          "dependsOn",
          "candidateRef",
          "evidenceRefs"
        ],
        "additionalProperties": false,
        "properties": {
          "evidenceConsumption": {
            "$ref": "#/$defs/evidenceConsumption"
          },
          "kind": {
            "enum": [
              "DESIGN",
              "DESIGN_REVIEW",
              "SELF_CHECK",
              "RESULT_REVIEW",
              "RESULT_ACCEPT",
              "USER_DECISION"
            ]
          },
          "candidateRef": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/candidateRef"
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "requiredBy": {
            "$ref": "#/$defs/requirementsRef"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidenceRef"
            }
          },
          "dependsOn": {
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "type": "array"
          }
        },
        "type": "object",
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "DESIGN",
                    "USER_DECISION"
                  ]
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "evidenceConsumption"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "USER_DECISION"
                }
              }
            },
            "then": {
              "properties": {
                "candidateRef": {
                  "items": {
                    "$ref": "#/$defs/objectRef"
                  }
                }
              }
            }
          }
        ]
      },
      "type": "array"
    },
    "qualityBinding": {
      "type": "object",
      "required": [
        "schemaVersion",
        "policyRef",
        "subject",
        "effectiveStages"
      ],
      "properties": {
        "effectiveStages": {
          "type": "array",
          "items": {
            "enum": [
              "SELF_CHECK",
              "RESULT_REVIEW",
              "RESULT_ACCEPT"
            ]
          },
          "uniqueItems": true
        },
        "policyRef": {
          "type": "object",
          "required": [
            "path",
            "identity"
          ],
          "properties": {
            "identity": {
              "type": "string",
              "pattern": "^\\d+\\|[A-F0-9]{64}$"
            },
            "path": {
              "const": ".ai-workspace/process-policy.json"
            }
          },
          "additionalProperties": false
        },
        "schemaVersion": {
          "const": 1
        },
        "subject": {
          "type": "object",
          "required": [
            "repositoryId",
            "exactPaths",
            "facets"
          ],
          "properties": {
            "exactPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "repositoryId": {
              "type": "string",
              "minLength": 1
            },
            "facets": {
              "type": "object",
              "required": [
                "domain",
                "deliverableType"
              ],
              "properties": {
                "deliverableType": {
                  "type": "object",
                  "required": [
                    "state",
                    "values"
                  ],
                  "properties": {
                    "state": {
                      "const": "KNOWN"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                },
                "domain": {
                  "type": "object",
                  "required": [
                    "state",
                    "values"
                  ],
                  "properties": {
                    "state": {
                      "const": "KNOWN"
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "else": {
        "required": [
          "qualityBinding"
        ]
      },
      "then": {
        "not": {
          "required": [
            "qualityBinding"
          ]
        },
        "properties": {
          "stages": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
