{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workspace.local/framework/1.14.1/project-corrections.schema.json",
  "title": "AI Workspace project corrections",
  "$defs": {
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "roles", "phases", "actionKinds", "resultKinds", "pathPrefixes", "capabilities", "semanticTerms"],
      "properties": {
        "profiles": {"type": "array", "items": {"type": "string"}},
        "roles": {"type": "array", "items": {"type": "string"}},
        "phases": {"type": "array", "items": {"type": "string"}},
        "actionKinds": {"type": "array", "items": {"type": "string"}},
        "resultKinds": {"type": "array", "items": {"type": "string"}},
        "pathPrefixes": {"type": "array", "items": {"type": "string"}},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "semanticTerms": {"type": "array", "items": {"type": "string"}}
      }
    },
    "historicalFields": {
      "type": "object",
      "properties": {
        "correctionId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "introducedAgainstFramework": {"type": "string", "minLength": 1},
        "requirementReason": {"type": "string", "minLength": 1},
        "effectiveRule": {"type": "string", "minLength": 1},
        "applicability": {"type": "string", "minLength": 1},
        "decisionLocator": {"type": "string", "minLength": 1}
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "projectId", "corrections"],
      "properties": {
        "schemaVersion": {"const": 1},
        "contractVersion": {"const": "1.10.0"},
        "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correctionId", "introducedAgainstFramework", "requirementReason", "effectiveRule", "applicability", "decisionLocator"],
            "properties": {
              "correctionId": {"$ref": "#/$defs/historicalFields/properties/correctionId"},
              "introducedAgainstFramework": {"$ref": "#/$defs/historicalFields/properties/introducedAgainstFramework"},
              "requirementReason": {"$ref": "#/$defs/historicalFields/properties/requirementReason"},
              "effectiveRule": {"$ref": "#/$defs/historicalFields/properties/effectiveRule"},
              "applicability": {"$ref": "#/$defs/historicalFields/properties/applicability"},
              "decisionLocator": {"$ref": "#/$defs/historicalFields/properties/decisionLocator"}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "projectId", "corrections"],
      "properties": {
        "schemaVersion": {"const": 2},
        "contractVersion": {"const": "1.14.0"},
        "projectId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correctionId", "introducedAgainstFramework", "requirementReason", "effectiveRule", "applicability", "decisionLocator", "selectors", "preparationRequirements", "resultRequirements", "requiredFacts", "mechanicalCheckRefs"],
            "properties": {
              "correctionId": {"$ref": "#/$defs/historicalFields/properties/correctionId"},
              "introducedAgainstFramework": {"$ref": "#/$defs/historicalFields/properties/introducedAgainstFramework"},
              "requirementReason": {"$ref": "#/$defs/historicalFields/properties/requirementReason"},
              "effectiveRule": {"$ref": "#/$defs/historicalFields/properties/effectiveRule"},
              "applicability": {"$ref": "#/$defs/historicalFields/properties/applicability"},
              "decisionLocator": {"$ref": "#/$defs/historicalFields/properties/decisionLocator"},
              "selectors": {"$ref": "#/$defs/selectors"},
              "preparationRequirements": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
              "resultRequirements": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
              "requiredFacts": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
              "mechanicalCheckRefs": {"type": "array", "items": {"enum": ["CURRENT_AUTHORITY_BOUND", "ACTION_PACKAGE_VALID", "EXACT_SCOPE_BOUND", "TASK_SCOPE_CURRENT", "PROTECTION_BOUNDARY_PROVEN", "REVIEWER_INDEPENDENCE_PROVEN", "SAFE_GIT_STATE_PROVEN", "EXTERNAL_BOUNDARY_AUTHORIZED", "DOMAIN_EXTERNAL_PACKAGE_VALID", "EXTERNAL_PAYLOAD_IDENTITIES_BOUND", "USER_EXTERNAL_DECISION_BOUND"]}}
            }
          }
        }
      }
    }
  ]
}
