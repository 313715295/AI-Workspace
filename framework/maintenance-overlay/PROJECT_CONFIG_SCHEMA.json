{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-Workspace Framework Maintenance sibling configuration (strict historical and current formats)",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "displayName",
        "controlPlaneLayout",
        "repositoryRoot",
        "frameworkVersion",
        "frameworkToolBackend",
        "routineExcludedPaths",
        "frameworkCapabilities",
        "processPolicy",
        "frameworkTarget",
        "sourceBindings"
      ],
      "properties": {
        "schemaVersion": {
          "const": 6
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "controlPlaneLayout": {
          "const": "framework-maintenance-sibling"
        },
        "repositoryRoot": {
          "const": ".."
        },
        "frameworkVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "frameworkToolBackend": {
          "const": "powershell7"
        },
        "routineExcludedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "frameworkCapabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "KNOWLEDGE_REFERENCE": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "sources"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "bindingId",
                      "indexLocator",
                      "selectionHints",
                      "updatePolicy"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      },
                      "bindingId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      },
                      "indexLocator": {
                        "type": "string",
                        "minLength": 1
                      },
                      "selectionHints": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "updatePolicy": {
                        "enum": [
                          "PINNED",
                          "FOLLOW"
                        ]
                      },
                      "indexIdentity": {
                        "type": "string",
                        "pattern": "^\\d+\\|[A-F0-9]{64}$"
                      },
                      "revision": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "enum": [
                              "CONTENT_IDENTITY",
                              "GIT_COMMIT"
                            ]
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "revisionSelector": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "allOf": [
                      {
                        "else": {
                          "not": {
                            "anyOf": [
                              {
                                "required": [
                                  "indexIdentity"
                                ]
                              },
                              {
                                "required": [
                                  "revision"
                                ]
                              }
                            ]
                          },
                          "required": [
                            "revisionSelector"
                          ]
                        },
                        "if": {
                          "properties": {
                            "updatePolicy": {
                              "const": "PINNED"
                            }
                          }
                        },
                        "then": {
                          "not": {
                            "required": [
                              "revisionSelector"
                            ]
                          },
                          "required": [
                            "indexIdentity",
                            "revision"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "processPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "locator"
          ],
          "properties": {
            "schemaVersion": {
              "const": 2
            },
            "locator": {
              "const": ".ai-workspace/process-policy.json"
            }
          }
        },
        "frameworkTarget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryId",
            "siblingDirectory",
            "routineExcludedPaths"
          ],
          "properties": {
