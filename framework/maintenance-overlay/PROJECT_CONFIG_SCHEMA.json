              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "siblingDirectory": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\\\/:*?\"<>|]+$"
            },
            "routineExcludedPaths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
