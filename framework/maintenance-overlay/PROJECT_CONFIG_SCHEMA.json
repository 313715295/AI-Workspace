                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "baseUrl"
                    ],
                    "properties": {
                      "baseUrl": {
                        "type": "string",
                        "pattern": "^https://"
                      }
                    }
                  }
                ]
              },
              "allowedPaths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "locator"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "FILE",
                        "DIRECTORY"
                      ]
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "decisionLocator": {
                "type": "string",
                "minLength": 1
              },
              "credentialRef": {
                "type": "string",
                "minLength": 1
              },
              "transportLimits": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxObjectBytes",
                  "timeoutMs",
                  "maxRedirects"
                ],
                "properties": {
                  "maxObjectBytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "maxRedirects": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "allOf": [
              {
                "then": {
                  "properties": {
                    "locator": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "root"
                      ],
                      "properties": {
                        "root": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "if": {
                  "properties": {
                    "provider": {
                      "const": "LOCAL_DIRECTORY"
                    }
                  }
                }
              },
              {
                "then": {
                  "properties": {
                    "locator": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "repository"
                      ],
                      "properties": {
                        "repository": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "if": {
                  "properties": {
                    "provider": {
                      "const": "GIT_REVISION"
                    }
                  }
                }
              },
              {
                "then": {
                  "properties": {
                    "locator": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "baseUrl"
                      ],
                      "properties": {
                        "baseUrl": {
                          "type": "string",
                          "pattern": "^https://"
                        }
                      }
                    }
                  }
                },
                "if": {
                  "properties": {
                    "provider": {
                      "const": "HTTPS_RESOURCE"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schemaVersion": {
                "const": 4
              }
            }
          },
          "then": {
            "properties": {
              "frameworkCapabilities": {
                "maxProperties": 0
              }
            }
          }
        }
      ]
    },
